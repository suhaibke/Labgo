<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('shop.product') || 'Product' %> - LabGo</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
    <style>
        .product-page {
            padding: 100px 0 60px;
            min-height: 100vh;
        }
        
        .product-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 32px;
            font-size: 14px;
        }
        
        .breadcrumb a {
            color: var(--gray-500);
            text-decoration: none;
        }
        
        .breadcrumb a:hover {
            color: var(--primary);
        }
        
        .breadcrumb span {
            color: var(--gray-400);
        }
        
        .breadcrumb .current {
            color: var(--gray-900);
        }
        
        .product-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }
        
        @media (max-width: 968px) {
            .product-layout {
                grid-template-columns: 1fr;
                gap: 40px;
            }
        }
        
        /* Image Gallery */
        .product-gallery {
            position: sticky;
            top: 100px;
        }
        
        .main-image {
            width: 100%;
            aspect-ratio: 1;
            border-radius: 20px;
            overflow: hidden;
            background: var(--gray-100);
            margin-bottom: 16px;
        }
        
        .main-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .thumbnail-list {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 8px;
        }
        
        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        
        .thumbnail.active {
            border-color: var(--primary);
        }
        
        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* Product Info */
        .product-info {
            padding: 20px 0;
        }
        
        .product-badge {
            display: inline-flex;
            padding: 6px 14px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 16px;
        }
        
        .product-title {
            font-size: 32px;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 16px;
            line-height: 1.3;
        }
        
        .product-category {
            font-size: 14px;
            color: var(--gray-500);
            margin-bottom: 24px;
        }
        
        .product-category a {
            color: var(--primary);
            text-decoration: none;
        }
        
        .product-price-block {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }
        
        .product-current-price {
            font-size: 36px;
            font-weight: 700;
            color: var(--primary);
        }
        
        .product-original-price {
            font-size: 24px;
            color: var(--gray-400);
            text-decoration: line-through;
        }
        
        .discount-label {
            padding: 6px 12px;
            background: rgba(76, 175, 80, 0.15);
            color: var(--success);
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }
        
        .product-description {
            font-size: 15px;
            line-height: 1.8;
            color: var(--gray-600);
            margin-bottom: 32px;
        }
        
        .stock-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            font-size: 14px;
        }
        
        .stock-status.in-stock {
            color: var(--success);
        }
        
        .stock-status.out-of-stock {
            color: var(--error);
        }
        
        .stock-status i {
            font-size: 16px;
        }
        
        /* Quantity Selector */
        .quantity-section {
            margin-bottom: 24px;
        }
        
        .quantity-label {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-700);
            margin-bottom: 12px;
        }
        
        .quantity-selector {
            display: inline-flex;
            align-items: center;
            border: 1px solid var(--gray-200);
            border-radius: 12px;
            overflow: hidden;
        }
        
        .quantity-btn {
            width: 48px;
            height: 48px;
            border: none;
            background: var(--gray-50);
            color: var(--gray-700);
            font-size: 18px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .quantity-btn:hover:not(:disabled) {
            background: var(--gray-100);
        }
        
        .quantity-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .quantity-input {
            width: 60px;
            height: 48px;
            border: none;
            text-align: center;
            font-size: 16px;
            font-weight: 600;
            color: var(--gray-900);
        }
        
        .quantity-input:focus {
            outline: none;
        }
        
        /* Actions */
        .product-actions {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
        }
        
        .add-to-cart-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 16px 32px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .add-to-cart-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(107, 92, 230, 0.3);
        }
        
        .add-to-cart-btn:disabled {
            background: var(--gray-300);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .buy-now-btn {
            padding: 16px 32px;
            background: var(--gray-900);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .buy-now-btn:hover:not(:disabled) {
            background: var(--gray-800);
            transform: translateY(-2px);
        }
        
        .buy-now-btn:disabled {
            background: var(--gray-300);
            cursor: not-allowed;
        }
        
        /* Features */
        .product-features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            padding: 24px;
            background: var(--gray-50);
            border-radius: 16px;
        }
        
        @media (max-width: 500px) {
            .product-features {
                grid-template-columns: 1fr;
            }
        }
        
        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .feature-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 18px;
        }
        
        .feature-text {
            font-size: 14px;
            color: var(--gray-700);
        }
        
        /* Tags */
        .product-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 24px;
        }
        
        .tag {
            padding: 6px 12px;
            background: var(--gray-100);
            color: var(--gray-600);
            border-radius: 8px;
            font-size: 13px;
        }
        
        /* Related Products */
        .related-section {
            padding: 60px 0;
        }
        
        .related-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }
        
        .related-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--gray-900);
        }
        
        .view-all-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .related-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }
        
        @media (max-width: 1024px) {
            .related-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        @media (max-width: 768px) {
            .related-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 500px) {
            .related-grid {
                grid-template-columns: 1fr;
            }
        }
        
        /* Loading */
        .loading-state {
            text-align: center;
            padding: 100px 20px;
        }
        
        .spinner {
            width: 50px;
            height: 50px;
            border: 3px solid var(--gray-200);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="shop-nav">
        <div class="nav-container">
            <a href="/shop" class="nav-logo">
                <img src="/images/logo.png" alt="LabGo" onerror="this.style.display='none'">
      
            </a>
            
            <div class="nav-links">
                <a href="/" class="nav-link"><%= __('nav.home') || 'Home' %></a>
                <a href="/shop" class="nav-link"><%= __('shop.shop') || 'Shop' %></a>
            </div>
            
            <div class="nav-actions">
                <div class="language-selector">
                    <button class="lang-btn" onclick="toggleLangMenu()">
                        <i class="fas fa-globe"></i>
                        <span><%= currentLang.toUpperCase() %></span>
                    </button>
                    <div class="lang-menu" id="langMenu">
                        <a href="?lang=en" class="lang-option <%= currentLang === 'en' ? 'active' : '' %>">English</a>
                        <a href="?lang=ar" class="lang-option <%= currentLang === 'ar' ? 'active' : '' %>">العربية</a>
                        <a href="?lang=ku" class="lang-option <%= currentLang === 'ku' ? 'active' : '' %>">کوردی</a>
                    </div>
                </div>
                <a href="/shop/cart" class="cart-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count" id="cartCount">0</span>
                </a>
            </div>
        </div>
    </nav>
    
    <main class="product-page">
        <div class="product-container">
            <div class="loading-state" id="loadingState">
                <div class="spinner"></div>
                <p><%= __('common.loading') || 'Loading...' %></p>
            </div>
            
            <div id="productContent" style="display: none;"></div>
        </div>
    </main>
    
    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>
    
    <script>
        const currentLang = '<%= currentLang %>';
        const direction = '<%= direction %>';
        const productSlug = '<%= productSlug %>';
        let productData = null;
        let quantity = 1;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadProduct();
            updateCartCount();
        });
        
        // Load product
        async function loadProduct() {
            try {
                const response = await fetch(`/api/shop/products/${productSlug}`);
                const data = await response.json();
                
                if (data.success && data.data.product) {
                    productData = data.data.product;
                    renderProduct(productData);
                    
                    // Update page title
                    document.title = `${productData.name[currentLang] || productData.name.en} - LabGo`;
                    
                    // Render related products if available
                    if (data.data.relatedProducts && data.data.relatedProducts.length > 0) {
                        renderRelatedProducts(data.data.relatedProducts);
                    }
                    
                    // Hide loading, show content
                    document.getElementById('loadingState').style.display = 'none';
                } else {
                    document.getElementById('loadingState').innerHTML = `
                        <i class="fas fa-exclamation-circle" style="font-size: 48px; color: var(--error); margin-bottom: 16px;"></i>
                        <h3><%= __('shop.productNotFound') || 'Product not found' %></h3>
                        <p><a href="/shop"><%= __('shop.backToShop') || 'Back to Shop' %></a></p>
                    `;
                }
            } catch (error) {
                console.error('Load product error:', error);
                document.getElementById('loadingState').innerHTML = `
                    <i class="fas fa-exclamation-circle" style="font-size: 48px; color: var(--error); margin-bottom: 16px;"></i>
                    <h3><%= __('shop.errorLoadingProduct') || 'Error loading product' %></h3>
                    <p><a href="/shop"><%= __('shop.backToShop') || 'Back to Shop' %></a></p>
                `;
            }
        }
        
        // Render product
        function renderProduct(product) {
            const name = product.name[currentLang] || product.name.en;
            const description = product.description?.[currentLang] || product.description?.en || '';
            const categoryName = product.category?.name?.[currentLang] || product.category?.name?.en || '';
            const hasDiscount = product.compareAtPrice && product.compareAtPrice > product.price;
            const inStock = !product.inventory?.trackInventory || product.inventory.quantity > 0 || product.inventory.allowBackorder;
            
            let imagesHtml = '';
            if (product.images && product.images.length > 0) {
                imagesHtml = `
                    <div class="main-image">
                        <img src="${product.images[0].url}" alt="${name}" id="mainImage">
                    </div>
                    ${product.images.length > 1 ? `
                    <div class="thumbnail-list">
                        ${product.images.map((img, i) => `
                            <div class="thumbnail ${i === 0 ? 'active' : ''}" onclick="changeImage('${img.url}', this)">
                                <img src="${img.url}" alt="">
                            </div>
                        `).join('')}
                    </div>
                    ` : ''}
                `;
            } else {
                imagesHtml = `
                    <div class="main-image">
                        <img src="/images/placeholder.png" alt="${name}">
                    </div>
                `;
            }
            
            document.getElementById('productContent').innerHTML = `
                <div class="breadcrumb">
                    <a href="/shop"><%= __('shop.shop') || 'Shop' %></a>
                    <span>/</span>
                    ${product.category ? `<a href="/shop/category/${product.category.slug}">${categoryName}</a><span>/</span>` : ''}
                    <span class="current">${name}</span>
                </div>
                
                <div class="product-layout">
                    <div class="product-gallery">
                        ${imagesHtml}
                    </div>
                    
                    <div class="product-info">
                        ${product.isFeatured ? '<span class="product-badge"><i class="fas fa-star"></i> Featured</span>' : ''}
                        
                        <h1 class="product-title">${name}</h1>
                        
                        ${product.category ? `<p class="product-category"><%= __('shop.category') || 'Category' %>: <a href="/shop/category/${product.category.slug}">${categoryName}</a></p>` : ''}
                        
                        <div class="product-price-block">
                            <span class="product-current-price">${formatPrice(product.price)}</span>
                            ${hasDiscount ? `
                                <span class="product-original-price">${formatPrice(product.compareAtPrice)}</span>
                                <span class="discount-label">-${Math.round((1 - product.price / product.compareAtPrice) * 100)}%</span>
                            ` : ''}
                        </div>
                        
                        <div class="stock-status ${inStock ? 'in-stock' : 'out-of-stock'}">
                            <i class="fas ${inStock ? 'fa-check-circle' : 'fa-times-circle'}"></i>
                            <span>${inStock ? '<%= __("shop.inStock") || "In Stock" %>' : '<%= __("shop.outOfStock") || "Out of Stock" %>'}</span>
                        </div>
                        
                        ${description ? `<p class="product-description">${description}</p>` : ''}
                        
                        <div class="quantity-section">
                            <p class="quantity-label"><%= __('shop.quantity') || 'Quantity' %></p>
                            <div class="quantity-selector">
                                <button class="quantity-btn" onclick="updateQuantity(-1)" id="decreaseBtn">-</button>
                                <input type="number" class="quantity-input" value="1" min="1" id="quantityInput" onchange="validateQuantity()">
                                <button class="quantity-btn" onclick="updateQuantity(1)">+</button>
                            </div>
                        </div>
                        
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart()" ${!inStock ? 'disabled' : ''}>
                                <i class="fas fa-shopping-cart"></i>
                                <span><%= __('shop.addToCart') || 'Add to Cart' %></span>
                            </button>
                            <button class="buy-now-btn" onclick="buyNow()" ${!inStock ? 'disabled' : ''}>
                                <span><%= __('shop.buyNow') || 'Buy Now' %></span>
                            </button>
                        </div>
                        
                        <div class="product-features">
                            <div class="feature-item">
                                <div class="feature-icon"><i class="fas fa-truck"></i></div>
                                <span class="feature-text"><%= __('shop.freeDelivery') || 'Fast Delivery' %></span>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                                <span class="feature-text"><%= __('shop.securePayment') || 'Secure Payment' %></span>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon"><i class="fas fa-headset"></i></div>
                                <span class="feature-text"><%= __('shop.support247') || '24/7 Support' %></span>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon"><i class="fas fa-medal"></i></div>
                                <span class="feature-text"><%= __('shop.qualityAssured') || 'Quality Assured' %></span>
                            </div>
                        </div>
                        
                        ${product.tags && product.tags.length > 0 ? `
                        <div class="product-tags">
                            ${product.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
                        </div>
                        ` : ''}
                    </div>
                </div>
                
                <section class="related-section">
                    <div class="related-header">
                        <h2 class="related-title"><%= __('shop.relatedProducts') || 'Related Products' %></h2>
                        <a href="/shop" class="view-all-link">
                            <span><%= __('shop.viewAll') || 'View All' %></span>
                            <i class="fas fa-arrow-${direction === 'rtl' ? 'left' : 'right'}"></i>
                        </a>
                    </div>
                    <div class="related-grid" id="relatedGrid">
                        <!-- Loaded dynamically -->
                    </div>
                </section>
            `;
            
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('productContent').style.display = 'block';
        }
        
        // Render related products
        function renderRelatedProducts(products) {
            const grid = document.getElementById('relatedGrid');
            if (grid && products.length > 0) {
                grid.innerHTML = products.map(product => createProductCard(product)).join('');
            }
        }
        
        // Load related products (fallback if not included in main response)
        async function loadRelatedProducts() {
            try {
                const categoryId = productData.category?._id || productData.category;
                const params = new URLSearchParams({
                    limit: 4,
                    category: categoryId || '',
                    exclude: productData._id
                });
                
                const response = await fetch(`/api/shop/products?${params}`);
                const data = await response.json();
                
                if (data.success && data.data.length > 0) {
                    renderRelatedProducts(data.data);
                }
            } catch (error) {
                console.error('Load related products error:', error);
            }
        }
        
        // Create product card
        function createProductCard(product) {
            const image = product.images?.[0]?.url || '/images/placeholder.png';
            const name = product.name[currentLang] || product.name.en;
            const hasDiscount = product.compareAtPrice && product.compareAtPrice > product.price;
            
            return `
                <div class="product-card" onclick="window.location.href='/shop/product/${product.slug}'">
                    <div class="product-image">
                        <img src="${image}" alt="${name}">
                        ${hasDiscount ? `<span class="discount-badge">-${Math.round((1 - product.price / product.compareAtPrice) * 100)}%</span>` : ''}
                    </div>
                    <div class="product-info">
                        <h3 class="product-name">${name}</h3>
                        <div class="product-price">
                            <span class="current-price">${formatPrice(product.price)}</span>
                            ${hasDiscount ? `<span class="original-price">${formatPrice(product.compareAtPrice)}</span>` : ''}
                        </div>
                    </div>
                </div>
            `;
        }
        
        // Change main image
        function changeImage(url, thumb) {
            document.getElementById('mainImage').src = url;
            document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        }
        
        // Update quantity
        function updateQuantity(change) {
            const input = document.getElementById('quantityInput');
            let newValue = parseInt(input.value) + change;
            if (newValue < 1) newValue = 1;
            input.value = newValue;
            quantity = newValue;
            document.getElementById('decreaseBtn').disabled = newValue <= 1;
        }
        
        function validateQuantity() {
            const input = document.getElementById('quantityInput');
            let value = parseInt(input.value);
            if (isNaN(value) || value < 1) value = 1;
            input.value = value;
            quantity = value;
            document.getElementById('decreaseBtn').disabled = value <= 1;
        }
        
        // Add to cart
        function addToCart() {
            const name = productData.name[currentLang] || productData.name.en;
            const image = productData.images?.[0]?.url || '/images/placeholder.png';
            
            let cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            const existingItem = cart.find(item => item.productId === productData._id);
            
            if (existingItem) {
                existingItem.quantity += quantity;
            } else {
                cart.push({
                    productId: productData._id,
                    name,
                    price: productData.price,
                    image,
                    quantity
                });
            }
            
            localStorage.setItem('labgo_cart', JSON.stringify(cart));
            updateCartCount();
            showToast('<%= __("shop.addedToCart") || "Added to cart" %>', 'success');
        }
        
        // Buy now
        function buyNow() {
            addToCart();
            window.location.href = '/shop/cart';
        }
        
        // Update cart count
        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            const count = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cartCount').textContent = count;
        }
        
        // Format price
        function formatPrice(price) {
            return new Intl.NumberFormat(currentLang, { style: 'decimal' }).format(price) + ' IQD';
        }
        
        // Language menu
        function toggleLangMenu() {
            document.getElementById('langMenu').classList.toggle('show');
        }
        
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.language-selector')) {
                document.getElementById('langMenu').classList.remove('show');
            }
        });
        
        // Toast
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
</body>
</html>

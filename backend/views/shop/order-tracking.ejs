<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('shop.trackOrder') || 'Track Order' %> - LabGo</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
    <style>
        /* Base styles */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', -apple-system, sans-serif; color: #0f172a; background: #f8fafc; line-height: 1.6; min-height: 100vh; }
        a { text-decoration: none; color: inherit; }
        img { max-width: 100%; display: block; }
        button { border: none; background: none; cursor: pointer; font-family: inherit; }

        /* Navigation */
        .shop-nav { position: fixed; top: 0; left: 0; right: 0; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid #e2e8f0; z-index: 1000; }
        .nav-container { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
        .nav-logo { display: flex; align-items: center; flex-shrink: 0; }
        .nav-logo img { height: 36px; width: auto; }
        .nav-links { display: flex; align-items: center; gap: 8px; }
        .nav-link { padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; color: #64748b; transition: all 0.2s; white-space: nowrap; }
        .nav-link:hover { color: #6366f1; background: rgba(99, 102, 241, 0.08); }
        .nav-link.active { color: #6366f1; background: rgba(99, 102, 241, 0.1); font-weight: 600; }
        .nav-actions { display: flex; align-items: center; gap: 12px; }
        .cart-btn { position: relative; display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 10px; background: #f1f5f9; color: #64748b; transition: all 0.2s; flex-shrink: 0; }
        .cart-btn:hover { background: #e2e8f0; color: #6366f1; }
        .cart-btn.active { background: #6366f1; color: white; }
        .cart-count { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; padding: 0 5px; display: flex; align-items: center; justify-content: center; background: #f43f5e; color: white; font-size: 11px; font-weight: 600; border-radius: 9px; }

        /* Language Selector */
        .language-selector { position: relative; }
        .lang-btn { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; background: #f1f5f9; color: #64748b; font-size: 13px; font-weight: 600; transition: all 0.2s; white-space: nowrap; }
        .lang-btn:hover { background: #e2e8f0; color: #6366f1; }
        .lang-menu { position: absolute; top: calc(100% + 8px); right: 0; min-width: 140px; background: white; border-radius: 12px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15); border: 1px solid #e2e8f0; opacity: 0; visibility: hidden; transform: translateY(-8px); transition: all 0.2s ease; overflow: hidden; }
        .lang-menu.show { opacity: 1; visibility: visible; transform: translateY(0); }
        .lang-option { display: block; padding: 12px 16px; color: #475569; text-decoration: none; font-size: 14px; transition: all 0.15s; border-bottom: 1px solid #f1f5f9; }
        .lang-option:last-child { border-bottom: none; }
        .lang-option:hover { background: #f8fafc; color: #6366f1; }
        .lang-option.active { background: rgba(99, 102, 241, 0.1); color: #6366f1; font-weight: 600; }

        /* Main Content */
        .tracking-main { padding-top: 100px; min-height: 100vh; }
        .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }

        /* Header */
        .tracking-header { text-align: center; margin-bottom: 40px; }
        .tracking-header h1 { font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 8px; }
        .tracking-header p { color: #64748b; font-size: 16px; }

        /* Search Box */
        .search-box { background: white; border-radius: 16px; padding: 32px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0; margin-bottom: 32px; }
        .search-box h2 { font-size: 18px; font-weight: 600; color: #0f172a; margin-bottom: 16px; }
        .search-form { display: flex; gap: 12px; }
        .search-input { flex: 1; padding: 14px 20px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 16px; transition: all 0.2s; outline: none; }
        .search-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1); }
        .search-btn { padding: 14px 32px; background: #6366f1; color: white; border-radius: 12px; font-size: 16px; font-weight: 600; transition: all 0.2s; white-space: nowrap; }
        .search-btn:hover { background: #4f46e5; transform: translateY(-1px); }
        .search-btn:disabled { background: #94a3b8; cursor: not-allowed; transform: none; }

        /* Order Details */
        .order-details { display: none; }
        .order-details.show { display: block; }

        .order-card { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0; margin-bottom: 24px; }
        .order-card-header { background: linear-gradient(135deg, #6366f1, #818cf8); padding: 24px; color: white; }
        .order-number { font-size: 14px; opacity: 0.9; margin-bottom: 8px; }
        .order-status { font-size: 24px; font-weight: 700; }
        .order-status.pending { color: #fbbf24; }
        .order-status.processing { color: #60a5fa; }
        .order-status.done { color: #34d399; }
        .order-status.cancelled { color: #f87171; }

        /* Status Timeline */
        .status-timeline { padding: 24px; }
        .timeline-item { display: flex; gap: 16px; padding-bottom: 24px; position: relative; }
        .timeline-item:last-child { padding-bottom: 0; }
        .timeline-item:not(:last-child)::after { content: ''; position: absolute; left: 20px; top: 40px; bottom: 0; width: 2px; background: #e2e8f0; }
        .timeline-item.completed .timeline-icon { background: #6366f1; color: white; }
        .timeline-item.completed::after { background: #6366f1; }
        .timeline-item.current .timeline-icon { background: #6366f1; color: white; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2); }
        .timeline-item.pending .timeline-icon { background: #e2e8f0; color: #94a3b8; }
        .timeline-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; transition: all 0.3s; }
        .timeline-content { flex: 1; padding-top: 4px; }
        .timeline-title { font-weight: 600; color: #0f172a; margin-bottom: 4px; }
        .timeline-date { font-size: 13px; color: #64748b; }

        /* Order Items */
        .order-items { padding: 24px; border-top: 1px solid #e2e8f0; }
        .order-items-title { font-size: 16px; font-weight: 600; color: #0f172a; margin-bottom: 16px; }
        .order-item { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid #f1f5f9; }
        .order-item:last-child { border-bottom: none; }
        .item-image { width: 80px; height: 80px; border-radius: 12px; object-fit: cover; flex-shrink: 0; background: #f1f5f9; }
        .item-details { flex: 1; }
        .item-name { font-weight: 600; color: #0f172a; margin-bottom: 4px; }
        .item-quantity { font-size: 14px; color: #64748b; }
        .item-price { font-weight: 600; color: #6366f1; text-align: right; }
        .item-price .amount { font-size: 18px; }

        /* Pricing Summary */
        .pricing-summary { padding: 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; }
        .summary-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
        .summary-row.total { border-top: 1px solid #e2e8f0; margin-top: 8px; padding-top: 16px; font-size: 16px; font-weight: 700; }
        .summary-label { color: #64748b; }
        .summary-value { color: #0f172a; font-weight: 600; }
        .summary-row.total .summary-value { color: #6366f1; }

        /* Delivery Info */
        .delivery-info { padding: 24px; border-top: 1px solid #e2e8f0; }
        .delivery-info-title { font-size: 16px; font-weight: 600; color: #0f172a; margin-bottom: 16px; }
        .info-row { display: flex; margin-bottom: 12px; }
        .info-label { width: 120px; color: #64748b; font-size: 14px; flex-shrink: 0; }
        .info-value { color: #0f172a; font-size: 14px; font-weight: 500; }

        /* Error State */
        .error-state { display: none; text-align: center; padding: 60px 24px; }
        .error-state.show { display: block; }
        .error-icon { font-size: 64px; color: #f87171; margin-bottom: 24px; }
        .error-title { font-size: 20px; font-weight: 600; color: #0f172a; margin-bottom: 8px; }
        .error-message { color: #64748b; }

        /* Back Link */
        .back-link { display: inline-flex; align-items: center; gap: 8px; color: #6366f1; font-weight: 500; margin-bottom: 24px; transition: all 0.2s; }
        .back-link:hover { color: #4f46e5; gap: 12px; }

        /* Loading State */
        .loading-state { display: none; text-align: center; padding: 60px 24px; }
        .loading-state.show { display: block; }
        .spinner { width: 48px; height: 48px; border: 4px solid #e2e8f0; border-top-color: #6366f1; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 16px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loading-text { color: #64748b; }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .nav-container { padding: 0 16px; height: 56px; }
            .nav-logo img { height: 28px; }
            .nav-links { gap: 4px; }
            .nav-link { padding: 8px 10px; font-size: 13px; }
            .nav-actions { gap: 8px; }
            .cart-btn { width: 38px; height: 38px; }
            .lang-btn { padding: 6px 10px; font-size: 12px; }
            .tracking-main { padding-top: 80px; }
            .search-box { padding: 24px; }
            .search-form { flex-direction: column; }
            .order-card-header { padding: 20px; }
            .order-status { font-size: 20px; }
            .status-timeline { padding: 20px; }
            .order-items { padding: 20px; }
            .item-image { width: 60px; height: 60px; }
            .pricing-summary { padding: 20px; }
            .delivery-info { padding: 20px; }
            .info-row { flex-direction: column; }
            .info-label { margin-bottom: 4px; }
        }

        /* RTL Support */
        [dir="rtl"] .nav-container { flex-direction: row-reverse; }
        [dir="rtl"] .lang-menu { right: auto; left: 0; }
        [dir="rtl"] .cart-count { right: auto; left: -4px; }
        [dir="rtl"] .timeline-item:not(:last-child)::after { left: auto; right: 20px; }
        [dir="rtl"] .back-link:hover { gap: 12px; }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="shop-nav">
        <div class="nav-container">
            <a href="/shop" class="nav-logo">
                <img src="/images/logo.png" alt="LabGo" onerror="this.style.display='none'">
            </a>

            <div class="nav-links">
                <a href="/" class="nav-link"><%= __('nav.home') || 'Home' %></a>
                <a href="/shop" class="nav-link"><%= __('shop.shop') || 'Shop' %></a>
                <a href="/shop/track-order" class="nav-link active"><%= __('shop.trackOrder') || 'Track Order' %></a>
            </div>

            <div class="nav-actions">
                <div class="language-selector">
                    <button class="lang-btn" onclick="toggleLangMenu()" data-lang="<%= currentLang.toUpperCase() %>">
                        <i class="fas fa-globe"></i>
                        <span><%= currentLang.toUpperCase() %></span>
                    </button>
                    <div class="lang-menu" id="langMenu">
                        <a href="?lang=en" class="lang-option <%= currentLang === 'en' ? 'active' : '' %>">English</a>
                        <a href="?lang=ar" class="lang-option <%= currentLang === 'ar' ? 'active' : '' %>">العربية</a>
                        <a href="?lang=ku" class="lang-option <%= currentLang === 'ku' ? 'active' : '' %>">کوردی</a>
                    </div>
                </div>
                <a href="/shop/cart" class="cart-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count" id="cartCount">0</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="tracking-main">
        <div class="container">
            <a href="/shop" class="back-link">
                <i class="fas fa-arrow-<%= direction === 'rtl' ? 'right' : 'left' %>"></i>
                <%= __('common.back') || 'Back' %>
            </a>

            <!-- Header -->
            <div class="tracking-header">
                <h1><%= __('shop.trackOrder') || 'Track Your Order' %></h1>
                <p><%= __('shop.trackOrderDesc') || 'Enter your order number to see the status and details' %></p>
            </div>

            <!-- Search Box -->
            <div class="search-box">
                <h2><%= __('shop.enterOrderNumber') || 'Enter Order Number' %></h2>
                <form class="search-form" onsubmit="trackOrder(event)">
                    <input type="text" class="search-input" id="orderNumberInput"
                           placeholder="<%= __('shop.orderNumberPlaceholder') || 'e.g., SHP-20250121-ABC123' %>"
                           required>
                    <button type="submit" class="search-btn" id="searchBtn">
                        <i class="fas fa-search"></i>
                        <%= __('shop.track') || 'Track' %>
                    </button>
                </form>
            </div>

            <!-- Loading State -->
            <div class="loading-state" id="loadingState">
                <div class="spinner"></div>
                <p class="loading-text"><%= __('shop.searchingOrder') || 'Searching for your order...' %></p>
            </div>

            <!-- Error State -->
            <div class="error-state" id="errorState">
                <i class="fas fa-exclamation-circle error-icon"></i>
                <h3 class="error-title"><%= __('shop.orderNotFound') || 'Order Not Found' %></h3>
                <p class="error-message"><%= __('shop.orderNotFoundDesc') || 'Please check your order number and try again' %></p>
            </div>

            <!-- Order Details -->
            <div class="order-details" id="orderDetails">
                <!-- Order Card -->
                <div class="order-card">
                    <div class="order-card-header">
                        <div class="order-number"><%= __('shop.order') || 'Order' %>: <span id="displayOrderNumber"></span></div>
                        <div class="order-status" id="orderStatus"></div>
                    </div>

                    <!-- Status Timeline -->
                    <div class="status-timeline" id="statusTimeline">
                        <!-- Timeline items will be inserted here -->
                    </div>

                    <!-- Order Items -->
                    <div class="order-items">
                        <h3 class="order-items-title"><%= __('shop.orderItems') || 'Order Items' %></h3>
                        <div id="orderItemsList">
                            <!-- Items will be inserted here -->
                        </div>
                    </div>

                    <!-- Pricing Summary -->
                    <div class="pricing-summary">
                        <div class="summary-row">
                            <span class="summary-label"><%= __('shop.subtotal') || 'Subtotal' %></span>
                            <span class="summary-value" id="orderSubtotal"></span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label"><%= __('shop.delivery') || 'Delivery' %></span>
                            <span class="summary-value" id="orderDelivery"></span>
                        </div>
                        <div class="summary-row total">
                            <span class="summary-label"><%= __('shop.total') || 'Total' %></span>
                            <span class="summary-value" id="orderTotal"></span>
                        </div>
                    </div>

                    <!-- Delivery Info -->
                    <div class="delivery-info">
                        <h3 class="delivery-info-title"><%= __('shop.deliveryAddress') || 'Delivery Address' %></h3>
                        <div class="info-row">
                            <span class="info-label"><%= __('common.name') || 'Name' %>:</span>
                            <span class="info-value" id="customerName"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label"><%= __('shop.address') || 'Address' %>:</span>
                            <span class="info-value" id="deliveryAddress"></span>
                        </div>
                        <div class="info-row" id="cityRow" style="display: none;">
                            <span class="info-label"><%= __('shop.city') || 'City' %>:</span>
                            <span class="info-value" id="deliveryCity"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        const currentLang = '<%= currentLang %>';
        const direction = '<%= direction %>';

        const statusTexts = {
            pending: '<%= __("shop.pending") || "Pending" %>',
            processing: '<%= __("shop.processing") || "Processing" %>',
            done: '<%= __("shop.done") || "Delivered" %>',
            cancelled: '<%= __("common.cancelled") || "Cancelled" %>'
        };

        const statusIcons = {
            pending: 'fa-clock',
            processing: 'fa-cog fa-spin',
            done: 'fa-check-circle',
            cancelled: 'fa-times-circle'
        };

        const commonTexts = {
            quantity: '<%= __("shop.quantity") || "Quantity" %>',
        };

        // Update cart count
        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            const count = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cartCount').textContent = count;
        }

        // Track order
        async function trackOrder(event) {
            event.preventDefault();

            const orderNumber = document.getElementById('orderNumberInput').value.trim();
            if (!orderNumber) return;

            console.log('Tracking order:', orderNumber);

            // Show loading
            document.getElementById('loadingState').classList.add('show');
            document.getElementById('errorState').classList.remove('show');
            document.getElementById('orderDetails').classList.remove('show');
            document.getElementById('searchBtn').disabled = true;

            try {
                const url = `/api/shop/orders/${encodeURIComponent(orderNumber)}`;
                console.log('Fetching from:', url);

                const response = await fetch(url);
                console.log('Response status:', response.status);

                const data = await response.json();
                console.log('Response data:', data);

                document.getElementById('loadingState').classList.remove('show');
                document.getElementById('searchBtn').disabled = false;

                if (data.success && data.data) {
                    console.log('Order found, displaying details');
                    displayOrderDetails(data.data);
                } else {
                    console.log('Order not found or invalid response');
                    document.getElementById('errorState').classList.add('show');
                }
            } catch (error) {
                console.error('Track order error:', error);
                document.getElementById('loadingState').classList.remove('show');
                document.getElementById('errorState').classList.add('show');
                document.getElementById('searchBtn').disabled = false;
            }
        }

        // Display order details
        function displayOrderDetails(order) {
            // Order number and status
            document.getElementById('displayOrderNumber').textContent = order.orderNumber;
            const statusElement = document.getElementById('orderStatus');
            statusElement.textContent = statusTexts[order.status] || order.status;
            statusElement.className = `order-status ${order.status}`;

            // Status timeline
            const timeline = document.getElementById('statusTimeline');
            const statuses = ['pending', 'processing', 'done'];
            if (order.status === 'cancelled') {
                statuses.length = 0;
                statuses.push('cancelled');
            }

            const currentIndex = statuses.indexOf(order.status);

            timeline.innerHTML = statuses.map((status, index) => {
                const historyItem = order.statusHistory?.find(h => h.status === status);
                const date = historyItem ? new Date(historyItem.changedAt).toLocaleDateString(currentLang) : '';

                let itemClass = 'timeline-item';
                if (index < currentIndex || (status === 'cancelled')) {
                    itemClass += ' completed';
                } else if (index === currentIndex) {
                    itemClass += ' current';
                } else {
                    itemClass += ' pending';
                }

                return `
                    <div class="${itemClass}">
                        <div class="timeline-icon">
                            <i class="fas ${statusIcons[status]}"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="timeline-title">${statusTexts[status]}</div>
                            ${date ? `<div class="timeline-date">${date}</div>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            // Order items
            const itemsList = document.getElementById('orderItemsList');
            itemsList.innerHTML = order.items.map(item => {
                const name = item.name?.[currentLang] || item.name?.en || 'Product';
                const image = item.image || '/images/noimage.jpg';

                return `
                    <div class="order-item">
                        <img src="${image}" alt="${name}" class="item-image" onerror="this.src='/images/noimage.jpg'">
                        <div class="item-details">
                            <div class="item-name">${name}</div>
                            <div class="item-quantity">${commonTexts.quantity}: ${item.quantity}</div>
                        </div>
                        <div class="item-price">
                            <div class="amount">${formatPrice(item.subtotal)}</div>
                        </div>
                    </div>
                `;
            }).join('');

            // Pricing
            document.getElementById('orderSubtotal').textContent = formatPrice(order.pricing.subtotal);
            document.getElementById('orderDelivery').textContent = order.pricing.deliveryFee === 0
                ? `<%= __('shop.free') || 'Free' %>`
                : formatPrice(order.pricing.deliveryFee);
            document.getElementById('orderTotal').textContent = formatPrice(order.pricing.total);

            // Delivery info
            document.getElementById('customerName').textContent = order.customer.name;
            document.getElementById('deliveryAddress').textContent = order.deliveryAddress.address;

            if (order.deliveryAddress.city) {
                document.getElementById('cityRow').style.display = 'flex';
                document.getElementById('deliveryCity').textContent = order.deliveryAddress.city;
            }

            // Show order details
            document.getElementById('orderDetails').classList.add('show');
        }

        // Format price
        function formatPrice(price) {
            return new Intl.NumberFormat(currentLang, { style: 'decimal' }).format(price) + ' IQD';
        }

        // Toggle language menu
        function toggleLangMenu() {
            document.getElementById('langMenu').classList.toggle('show');
        }

        // Close language menu on outside click
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.language-selector')) {
                document.getElementById('langMenu')?.classList.remove('show');
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            updateCartCount();

            // Check for order number in URL
            const urlParams = new URLSearchParams(window.location.search);
            const orderNumber = urlParams.get('order');
            if (orderNumber) {
                document.getElementById('orderNumberInput').value = orderNumber;
                trackOrder(new Event('submit'));
            }
        });
    </script>
</body>
</html>

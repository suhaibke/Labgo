<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LabGo</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/shop.css">
    <style>
        .checkout-page {
            padding: 100px 0 60px;
            min-height: 100vh;
            background: var(--gray-50);
        }
        
        .checkout-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        .checkout-header {
            margin-bottom: 32px;
        }
        
        .checkout-title {
            font-size: 32px;
            font-weight: 700;
            color: var(--gray-900);
        }
        
        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 32px;
        }
        
        @media (max-width: 968px) {
            .checkout-layout {
                grid-template-columns: 1fr;
            }
        }
        
        /* Steps */
        .checkout-steps {
            display: flex;
            gap: 4px;
            margin-bottom: 32px;
        }
        
        .step {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            background: white;
            border-radius: 12px;
        }
        
        .step.active {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }
        
        .step.completed {
            background: var(--success);
            color: white;
        }
        
        .step-number {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
        
        .step:not(.active):not(.completed) .step-number {
            background: var(--gray-100);
            color: var(--gray-500);
        }
        
        .step-text {
            font-size: 14px;
            font-weight: 500;
        }
        
        .step:not(.active):not(.completed) .step-text {
            color: var(--gray-500);
        }
        
        /* Form Card */
        .form-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            padding: 32px;
            margin-bottom: 24px;
        }
        
        .form-card-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .form-card-title i {
            color: var(--primary);
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-700);
            margin-bottom: 8px;
        }
        
        .form-label .required {
            color: var(--error);
        }
        
        .form-input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid var(--gray-200);
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.2s ease;
        }
        
        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
        
        .form-input.error {
            border-color: var(--error);
        }
        
        .form-textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        
        @media (max-width: 500px) {
            .form-row { grid-template-columns: 1fr; }
        }
        
        .error-text {
            color: var(--error);
            font-size: 13px;
            margin-top: 6px;
        }
        
        /* OTP Section */
        .otp-section {
            text-align: center;
            padding: 40px 20px;
        }
        
        .otp-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(99, 102, 241, 0.2));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }
        
        .otp-icon i {
            font-size: 36px;
            color: var(--primary);
        }
        
        .otp-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 8px;
        }
        
        .otp-subtitle {
            color: var(--gray-500);
            margin-bottom: 32px;
        }
        
        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 32px;
        }
        
        .otp-input {
            width: 56px;
            height: 64px;
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            transition: all 0.2s ease;
        }
        
        .otp-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
        
        .otp-input.filled {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.1);
        }
        
        .otp-input.error {
            border-color: var(--error);
            animation: shake 0.5s ease;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }
        
        .resend-link {
            color: var(--gray-500);
            font-size: 14px;
        }
        
        .resend-link button {
            background: none;
            border: none;
            color: var(--primary);
            font-weight: 500;
            cursor: pointer;
        }
        
        .resend-link button:disabled {
            color: var(--gray-400);
            cursor: not-allowed;
        }
        
        /* Order Summary Sidebar */
        .order-summary {
            position: sticky;
            top: 100px;
        }
        
        .summary-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            padding: 28px;
        }
        
        .summary-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--gray-900);
            margin-bottom: 24px;
        }
        
        .summary-items {
            max-height: 300px;
            overflow-y: auto;
            margin-bottom: 20px;
        }
        
        .summary-item {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--gray-100);
        }
        
        .summary-item:last-child {
            border-bottom: none;
        }
        
        .summary-item-image {
            width: 60px;
            height: 60px;
            border-radius: 10px;
            overflow: hidden;
            background: var(--gray-100);
        }
        
        .summary-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .summary-item-details {
            flex: 1;
        }
        
        .summary-item-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-900);
            margin-bottom: 4px;
        }
        
        .summary-item-qty {
            font-size: 13px;
            color: var(--gray-500);
        }
        
        .summary-item-price {
            font-weight: 600;
            color: var(--gray-900);
        }
        
        .summary-divider {
            height: 1px;
            background: var(--gray-100);
            margin: 16px 0;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 14px;
        }
        
        .summary-row .label {
            color: var(--gray-600);
        }
        
        .summary-row .value {
            font-weight: 500;
            color: var(--gray-900);
        }
        
        .summary-total {
            display: flex;
            justify-content: space-between;
            padding: 16px 0;
            font-size: 20px;
            border-top: 2px solid var(--gray-200);
            margin-top: 12px;
        }
        
        .summary-total .label {
            font-weight: 600;
            color: var(--gray-900);
        }
        
        .summary-total .value {
            font-weight: 700;
            color: var(--primary);
        }
        
        /* Buttons */
        .btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
        }
        
        .btn-primary:disabled {
            background: var(--gray-300);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-secondary {
            padding: 14px 24px;
            background: var(--gray-100);
            color: var(--gray-700);
            border: none;
            border-radius: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .btn-secondary:hover {
            background: var(--gray-200);
        }
        
        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        
        /* Loading */
        .btn-loading .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* Payment Options */
        .payment-option {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px;
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-bottom: 12px;
        }
        
        .payment-option:hover {
            border-color: var(--primary-light);
        }
        
        .payment-option.selected {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.1);
        }
        
        .payment-radio {
            width: 20px;
            height: 20px;
            border: 2px solid var(--gray-300);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .payment-option.selected .payment-radio {
            border-color: var(--primary);
        }
        
        .payment-option.selected .payment-radio::after {
            content: '';
            width: 10px;
            height: 10px;
            background: var(--primary);
            border-radius: 50%;
        }
        
        .payment-icon {
            width: 48px;
            height: 32px;
            background: var(--gray-100);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--gray-500);
        }
        
        .payment-info h4 {
            font-size: 15px;
            font-weight: 600;
            color: var(--gray-900);
        }
        
        .payment-info p {
            font-size: 13px;
            color: var(--gray-500);
        }

        /* Loading Overlay */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(4px);
            z-index: 5000;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
        }

        .loading-overlay.show {
            display: flex;
        }

        .loading-spinner {
            width: 48px;
            height: 48px;
            border: 4px solid rgba(255, 255, 255, 0.2);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .loading-text {
            color: white;
            font-size: 16px;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="shop-nav">
        <div class="nav-container">
            <a href="/shop" class="nav-logo">
                <img src="/images/logo.png" alt="LabGo" onerror="this.style.display='none'">

            </a>
            
            <div class="nav-actions">
                <a href="/shop/cart" class="cart-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count" id="cartCount">0</span>
                </a>
            </div>
        </div>
    </nav>
    
    <main class="checkout-page">
        <div class="checkout-container">
            <div class="checkout-header">
                <h1 class="checkout-title"><%= __('shop.checkout') || 'Checkout' %></h1>
            </div>
            
            <!-- Steps -->
            <div class="checkout-steps">
                <div class="step active" id="step1">
                    <span class="step-number">1</span>
                    <span class="step-text"><%= __('shop.customerInfo') || 'Customer Info' %></span>
                </div>
                <div class="step" id="step2">
                    <span class="step-number">2</span>
                    <span class="step-text"><%= __('shop.verification') || 'Verification' %></span>
                </div>
                <div class="step" id="step3">
                    <span class="step-number">3</span>
                    <span class="step-text"><%= __('shop.confirmation') || 'Confirmation' %></span>
                </div>
            </div>
            
            <div class="checkout-layout">
                <!-- Main Content -->
                <div class="checkout-main">
                    <!-- Step 1: Customer Info -->
                    <div id="stepContent1">
                        <form id="customerForm">
                            <div class="form-card">
                                <h2 class="form-card-title">
                                    <i class="fas fa-user"></i>
                                    <%= __('shop.contactInfo') || 'Contact Information' %>
                                </h2>
                                
                                <div class="form-group">
                                    <label class="form-label"><%= __('common.fullName') || 'Full Name' %> <span class="required">*</span></label>
                                    <input type="text" class="form-input" id="customerName" required placeholder="<%= __('shop.enterFullName') || 'Enter your full name' %>">
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="form-label"><%= __('common.phone') || 'Phone' %> <span class="required">*</span></label>
                                        <input type="tel" class="form-input" id="customerPhone" required placeholder="07XXXXXXXXX" dir="ltr">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label"><%= __('common.email') || 'Email' %></label>
                                        <input type="email" class="form-input" id="customerEmail" placeholder="email@example.com" dir="ltr">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-card">
                                <h2 class="form-card-title">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <%= __('shop.deliveryAddress') || 'Delivery Address' %>
                                </h2>
                                
                                <div class="form-group">
                                    <label class="form-label"><%= __('shop.city') || 'City' %> <span class="required">*</span></label>
                                    <input type="text" class="form-input" id="city" required placeholder="<%= __('shop.enterCity') || 'Enter your city' %>">
                                </div>
                                
                                <div class="form-group">
                                    <label class="form-label"><%= __('shop.fullAddress') || 'Full Address' %> <span class="required">*</span></label>
                                    <textarea class="form-input form-textarea" id="fullAddress" required placeholder="<%= __('shop.addressPlaceholder') || 'Street, building, floor, apartment number...' %>"></textarea>
                                </div>
                                
                                <div class="form-group">
                                    <label class="form-label"><%= __('shop.deliveryNotes') || 'Delivery Notes' %></label>
                                    <textarea class="form-input form-textarea" id="deliveryNotes" placeholder="<%= __('shop.notesPlaceholder') || 'Any special instructions for delivery...' %>"></textarea>
                                </div>
                            </div>
                            
                            <div class="form-card">
                                <h2 class="form-card-title">
                                    <i class="fas fa-credit-card"></i>
                                    <%= __('shop.paymentMethod') || 'Payment Method' %>
                                </h2>
                                
                                <div class="payment-option selected" onclick="selectPayment('cod')">
                                    <span class="payment-radio"></span>
                                    <span class="payment-icon"><i class="fas fa-money-bill-wave"></i></span>
                                    <div class="payment-info">
                                        <h4><%= __('shop.cashOnDelivery') || 'Cash on Delivery' %></h4>
                                        <p><%= __('shop.codDesc') || 'Pay when you receive your order' %></p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-actions">
                                <a href="/shop/cart" class="btn-secondary">
                                    <i class="fas fa-arrow-<%= direction === 'rtl' ? 'right' : 'left' %>"></i>
                                    <%= __('shop.backToCart') || 'Back to Cart' %>
                                </a>
                                <button type="submit" class="btn-primary" style="flex: 1;">
                                    <span><%= __('shop.sendVerificationCode') || 'Send Verification Code' %></span>
                                    <i class="fas fa-arrow-<%= direction === 'rtl' ? 'left' : 'right' %>"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Step 2: OTP Verification -->
                    <div id="stepContent2" style="display: none;">
                        <div class="form-card">
                            <div class="otp-section">
                                <div class="otp-icon">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <h2 class="otp-title"><%= __('shop.verifyPhone') || 'Verify Your Phone' %></h2>
                                <p class="otp-subtitle"><%= __('shop.otpSent') || 'We sent a verification code to' %> <strong id="displayPhone"></strong></p>
                                
                                <div class="otp-inputs" dir="ltr" style="direction: ltr;">
                                    <input type="text" class="otp-input" maxlength="1" data-index="0" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" class="otp-input" maxlength="1" data-index="1" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" class="otp-input" maxlength="1" data-index="2" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" class="otp-input" maxlength="1" data-index="3" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" class="otp-input" maxlength="1" data-index="4" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" class="otp-input" maxlength="1" data-index="5" inputmode="numeric" pattern="[0-9]*">
                                </div>
                                
                                <p class="resend-link">
                                    <span id="resendTimer"><%= __('shop.resendIn') || 'Resend code in' %> <span id="countdown">60</span><%= direction === 'rtl' ? ' ثانية' : 's' %></span>
                                    <button id="resendBtn" style="display: none;" onclick="resendOtp()"><%= __('shop.resendCode') || 'Resend Code' %></button>
                                </p>
                            </div>
                            
                            <div class="form-actions" style="justify-content: center;">
                                <button class="btn-secondary" onclick="goToStep(1)">
                                    <i class="fas fa-arrow-<%= direction === 'rtl' ? 'right' : 'left' %>"></i>
                                    <%= __('common.back') || 'Back' %>
                                </button>
                                <button class="btn-primary" style="flex: 1; max-width: 300px;" onclick="verifyOtpAndPlaceOrder()" id="verifyBtn">
                                    <span><%= __('shop.verifyAndOrder') || 'Verify & Place Order' %></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Order Summary Sidebar -->
                <div class="order-summary">
                    <div class="summary-card">
                        <h2 class="summary-title"><%= __('shop.orderSummary') || 'Order Summary' %></h2>
                        
                        <div class="summary-items" id="summaryItems">
                            <!-- Items loaded dynamically -->
                        </div>
                        
                        <div class="summary-divider"></div>
                        
                        <div class="summary-row">
                            <span class="label"><%= __('shop.subtotal') || 'Subtotal' %></span>
                            <span class="value" id="summarySubtotal">0 IQD</span>
                        </div>
                        <div class="summary-row">
                            <span class="label"><%= __('shop.delivery') || 'Delivery' %></span>
                            <span class="value" id="summaryDelivery"><%= __('shop.free') || 'Free' %></span>
                        </div>
                        
                        <div class="summary-total">
                            <span class="label"><%= __('shop.total') || 'Total' %></span>
                            <span class="value" id="summaryTotal">0 IQD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
        <p class="loading-text" id="loadingText"><%= __('shop.sendingCode') || 'Sending verification code...' %></p>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>
    
    <script>
        const currentLang = '<%= currentLang %>';
        const direction = '<%= direction %>';
        let customerData = {};
        let countdownInterval;
        let otpMessageId = null;
        
        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            
            if (cart.length === 0) {
                window.location.href = '/shop/cart';
                return;
            }
            
            renderSummary();
            updateCartCount();
            setupOtpInputs();
        });
        
        // Render order summary
        function renderSummary() {
            const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            const itemsContainer = document.getElementById('summaryItems');
            
            itemsContainer.innerHTML = cart.map(item => `
                <div class="summary-item">
                    <div class="summary-item-image">
                        <img src="${item.image}" alt="${item.name}">
                    </div>
                    <div class="summary-item-details">
                        <p class="summary-item-name">${item.name}</p>
                        <p class="summary-item-qty">× ${item.quantity}</p>
                    </div>
                    <span class="summary-item-price">${formatPrice(item.price * item.quantity)}</span>
                </div>
            `).join('');
            
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            document.getElementById('summarySubtotal').textContent = formatPrice(subtotal);
            document.getElementById('summaryTotal').textContent = formatPrice(subtotal);
        }
        
        // Handle customer form submission
        document.getElementById('customerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();
            const email = document.getElementById('customerEmail').value.trim();
            const city = document.getElementById('city').value;
            const fullAddress = document.getElementById('fullAddress').value.trim();
            const notes = document.getElementById('deliveryNotes').value.trim();
            
            // Validate phone
            if (!phone.match(/^07[0-9]{9}$/)) {
                showToast('<%= __("shop.invalidPhone") || "Please enter a valid Iraqi phone number (07XXXXXXXXX)" %>', 'error');
                return;
            }
            
            customerData = { name, phone, email, city, fullAddress, notes };
            
            // Show loading overlay
            showLoading('<%= __('shop.sendingCode') || 'Sending verification code...' %>');
            
            // Send OTP
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            
            try {
                const response = await fetch('/api/shop/checkout/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone })
                });
                
                const data = await response.json();
                
                hideLoading();
                
                if (data.success) {
                    otpMessageId = data.messageId;
                    document.getElementById('displayPhone').textContent = phone;
                    goToStep(2);
                    startCountdown();
                    setupOtpInputs();
                } else {
                    showToast(data.message || '<%= __("shop.otpError") || "Failed to send verification code" %>', 'error');
                }
            } catch (error) {
                console.error('Send OTP error:', error);
                hideLoading();
                showToast('<%= __("shop.otpError") || "Failed to send verification code" %>', 'error');
            } finally {
                btn.disabled = false;
            }
        });
        
        // Setup OTP inputs
        function setupOtpInputs() {
            const inputs = document.querySelectorAll('.otp-input');
            
            inputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    const value = e.target.value;
                    
                    if (value) {
                        input.classList.add('filled');
                        if (index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        }
                    } else {
                        input.classList.remove('filled');
                    }
                });
                
                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !input.value && index > 0) {
                        inputs[index - 1].focus();
                    }
                });
                
                input.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pasteData = e.clipboardData.getData('text').slice(0, 6);
                    pasteData.split('').forEach((char, i) => {
                        if (inputs[i]) {
                            inputs[i].value = char;
                            inputs[i].classList.add('filled');
                        }
                    });
                    if (inputs[pasteData.length - 1]) {
                        inputs[pasteData.length - 1].focus();
                    }
                });
            });
        }
        
        // Get OTP value
        function getOtpValue() {
            const inputs = document.querySelectorAll('.otp-input');
            return Array.from(inputs).map(i => i.value).join('');
        }
        
        // Verify OTP and place order
        async function verifyOtpAndPlaceOrder() {
            const otp = getOtpValue();
            
            if (otp.length !== 6) {
                document.querySelectorAll('.otp-input').forEach(i => i.classList.add('error'));
                setTimeout(() => document.querySelectorAll('.otp-input').forEach(i => i.classList.remove('error')), 500);
                showToast('<%= __("shop.enterFullOtp") || "Please enter the complete verification code" %>', 'error');
                return;
            }
            
            const btn = document.getElementById('verifyBtn');
            btn.disabled = true;
            
            // Show loading
            showLoading('<%= __("shop.verifyingCode") || "Verifying code..." %>');
            
            try {
                // Verify OTP
                const verifyResponse = await fetch('/api/shop/checkout/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: customerData.phone, messageId: otpMessageId, code: otp })
                });
                
                const verifyData = await verifyResponse.json();
                
                if (!verifyData.success) {
                    hideLoading();
                    document.querySelectorAll('.otp-input').forEach(i => i.classList.add('error'));
                    setTimeout(() => document.querySelectorAll('.otp-input').forEach(i => i.classList.remove('error')), 500);
                    showToast(verifyData.message || '<%= __("shop.invalidOtp") || "Invalid verification code" %>', 'error');
                    btn.disabled = false;
                    return;
                }
                
                // Update loading text
                showLoading('<%= __("shop.placingOrder") || "Placing your order..." %>');
                
                // Place order
                const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
                const orderData = {
                    customer: {
                        name: customerData.name,
                        phone: customerData.phone,
                        email: customerData.email
                    },
                    deliveryAddress: {
                        address: customerData.fullAddress,
                        city: customerData.city,
                        notes: customerData.notes
                    },
                    items: cart.map(item => ({
                        productId: item.productId,
                        quantity: item.quantity
                    })),
                    payment: { method: 'cod' }
                };
                
                const orderResponse = await fetch('/api/shop/checkout/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                });
                
                const orderResult = await orderResponse.json();
                
                if (orderResult.success) {
                    localStorage.removeItem('labgo_cart');
                    window.location.href = `/shop/order-confirmation/${orderResult.data.orderNumber}`;
                } else {
                    hideLoading();
                    showToast(orderResult.message || '<%= __("shop.orderError") || "Failed to place order" %>', 'error');
                    btn.disabled = false;
                }
            } catch (error) {
                console.error('Place order error:', error);
                hideLoading();
                showToast('<%= __("shop.orderError") || "Failed to place order" %>', 'error');
                btn.disabled = false;
            }
        }
        
        // Countdown
        function startCountdown() {
            let seconds = 60;
            document.getElementById('countdown').textContent = seconds;
            document.getElementById('resendTimer').style.display = 'inline';
            document.getElementById('resendBtn').style.display = 'none';
            
            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                seconds--;
                document.getElementById('countdown').textContent = seconds;
                
                if (seconds <= 0) {
                    clearInterval(countdownInterval);
                    document.getElementById('resendTimer').style.display = 'none';
                    document.getElementById('resendBtn').style.display = 'inline';
                }
            }, 1000);
        }
        
        // Resend OTP
        async function resendOtp() {
            const btn = document.getElementById('resendBtn');
            btn.disabled = true;
            btn.textContent = '<%= __("shop.sending") || "Sending..." %>';
            
            try {
                const response = await fetch('/api/shop/checkout/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: customerData.phone })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    otpMessageId = data.messageId;
                    showToast('<%= __("shop.otpResent") || "Verification code sent" %>', 'success');
                    startCountdown();
                    document.querySelectorAll('.otp-input').forEach(i => { i.value = ''; i.classList.remove('filled'); });
                } else {
                    showToast(data.message || '<%= __("shop.otpError") || "Failed to send code" %>', 'error');
                }
            } catch (error) {
                showToast('<%= __("shop.otpError") || "Failed to send code" %>', 'error');
            } finally {
                btn.disabled = false;
                btn.textContent = '<%= __("shop.resendCode") || "Resend Code" %>';
            }
        }
        
        // Go to step
        function goToStep(step) {
            // Update steps UI
            for (let i = 1; i <= 3; i++) {
                const stepEl = document.getElementById(`step${i}`);
                stepEl.classList.remove('active', 'completed');
                if (i < step) stepEl.classList.add('completed');
                if (i === step) stepEl.classList.add('active');
            }
            
            // Show/hide content
            for (let i = 1; i <= 2; i++) {
                const content = document.getElementById(`stepContent${i}`);
                if (content) {
                    content.style.display = i === step ? 'block' : 'none';
                }
            }
        }
        
        // Payment selection
        function selectPayment(method) {
            document.querySelectorAll('.payment-option').forEach(o => o.classList.remove('selected'));
            event.currentTarget.classList.add('selected');
        }
        
        // Show loading overlay
        function showLoading(text) {
            const overlay = document.getElementById('loadingOverlay');
            const loadingText = document.getElementById('loadingText');
            if (text) loadingText.textContent = text;
            overlay.classList.add('show');
        }
        
        // Hide loading overlay
        function hideLoading() {
            document.getElementById('loadingOverlay').classList.remove('show');
        }
        
        // Update cart count
        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('labgo_cart') || '[]');
            const count = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cartCount').textContent = count;
        }
        
        // Format price
        function formatPrice(price) {
            return new Intl.NumberFormat(currentLang, { style: 'decimal' }).format(price) + ' IQD';
        }
        
        // Toast
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
</body>
</html>

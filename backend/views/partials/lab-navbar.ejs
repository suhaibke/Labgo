<%#
  Lab dashboard shell — side bar (desktop), floating bottom bar (mobile) and top bar.
  Same look and motion as the LabGo Lab mobile app. Styles: /css/lab-app.css.
%>
<%
  const _active = (typeof activeSection !== 'undefined' && activeSection) ||
                  (typeof activePage !== 'undefined' && activePage) || '';
  const _lang = (typeof currentLang !== 'undefined' && currentLang) || 'ar';
  const _langBadge = { ar: 'AR', en: 'EN', ku: 'KU', tr: 'TR' }[_lang] || 'AR';
  const _u = (typeof user !== 'undefined' && user) || {};
  const _labName = (typeof lab !== 'undefined' && lab && lab.name) || 'LabGo';
  const _initial = (_u.name || _labName || 'L').trim().charAt(0).toUpperCase();
  const _nav = [
    { id: 'overview', href: '/lab/dashboard', icon: 'house', label: __('navigation.dashboard') },
    { id: 'orders', href: '/lab/orders', icon: 'clipboard-list', label: __('navigation.orders') },
    { id: 'patient-tests', href: '/lab/patient-tests', icon: 'test-tube', label: __('navigation.patientTests') },
    { id: 'external-transfers', href: '/lab/external-transfers', icon: 'arrow-left-right', label: __('navigation.externalTransfers') },
    { id: 'tests', href: '/lab/tests', icon: 'flask-conical', label: __('navigation.tests') },
    { id: 'offers', href: '/lab/offers', icon: 'tag', label: __('navigation.offers') },
    { id: 'packages', href: '/lab/packages', icon: 'package', label: __('navigation.packages') },
    { id: 'services', href: '/lab/services', icon: 'zap', label: __('navigation.quickServices') },
    { id: 'reports', href: '/lab/reports', icon: 'chart-line', label: __('navigation.reports') },
  ];
  const _navEnd = [
    { id: 'profile', href: '/lab/profile', icon: 'user', label: __('navigation.profile') },
    { id: 'settings', href: '/lab/settings', icon: 'settings', label: __('navigation.settings') },
  ];
  const _bottom = ['overview', 'orders', 'patient-tests', 'reports', 'settings'];
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/lab-app.css">
<script>
  // Apply the app look before paint: theme + accent are kept per browser.
  (function () {
    var d = document.documentElement;
    d.classList.add('la');
    try {
      var t = localStorage.getItem('la-theme');
      if (t === 'dark') d.setAttribute('data-theme', 'dark');
      var a = localStorage.getItem('la-accent');
      if (a) d.style.setProperty('--accent', a);
    } catch (e) {}
  })();
</script>
<%- include('lab-icons') %>

<aside class="la-side" aria-label="<%= __('navigation.dashboard') %>">
  <a href="/lab/dashboard" class="la-brand">
    <span class="la-brand-logo"><img src="/images/logo.png" alt="LabGo"></span>
    <span><b>LabGo</b><span><%= _labName %></span></span>
  </a>
  <nav class="la-nav">
    <% _nav.forEach(function (n) { %>
      <a href="<%= n.href %>" class="la-nav-item press <%= _active === n.id ? 'active' : '' %>">
        <span class="la-nav-ic"><svg class="ic"><use href="#i-<%= n.icon %>"/></svg></span>
        <span><%= n.label %></span>
      </a>
    <% }); %>
    <div class="la-nav-sep"></div>
    <% _navEnd.forEach(function (n) { %>
      <a href="<%= n.href %>" class="la-nav-item press <%= _active === n.id ? 'active' : '' %>">
        <span class="la-nav-ic"><svg class="ic"><use href="#i-<%= n.icon %>"/></svg></span>
        <span><%= n.label %></span>
      </a>
    <% }); %>
  </nav>
  <div class="la-side-foot">
    <a href="/auth/logout" class="la-btn gradient block press" style="border-radius:16px;height:52px">
      <svg class="ic flip-rtl"><use href="#i-log-out"/></svg><span><%= __('navigation.logout') %></span>
    </a>
  </div>
</aside>

<nav class="la-bottom" aria-label="<%= __('navigation.dashboard') %>">
  <% _nav.concat(_navEnd).filter(function (n) { return _bottom.indexOf(n.id) !== -1; }).forEach(function (n) { %>
    <a href="<%= n.href %>" class="press-90 <%= _active === n.id ? 'active' : '' %>" aria-label="<%= n.label %>">
      <svg class="ic"><use href="#i-<%= n.icon %>"/></svg>
    </a>
  <% }); %>
</nav>

<header class="la-top">
  <div class="la-top-group">
    <div style="position:relative">
      <button class="la-circle avatar press-90" id="laUserBtn" aria-label="<%= __('navigation.profile') %>">
        <% if (_u.profileImage) { %><img src="<%= _u.profileImage %>" alt=""><% } else { %><%= _initial %><% } %>
      </button>
      <div class="la-menu" id="laUserMenu" style="left:0;right:auto">
        <div style="padding:8px 12px 10px">
          <b style="display:block;font-size:14px"><%= _u.name || _labName %></b>
          <span style="font-size:12px;color:var(--muted)"><%= _u.email || '' %></span>
        </div>
        <a href="/lab/profile"><svg class="ic"><use href="#i-user"/></svg><%= __('navigation.profile') %></a>
        <a href="/lab/settings"><svg class="ic"><use href="#i-settings"/></svg><%= __('navigation.settings') %></a>
        <a href="/auth/logout" style="color:var(--red)"><svg class="ic flip-rtl"><use href="#i-log-out"/></svg><%= __('navigation.logout') %></a>
      </div>
    </div>
    <a class="la-circle press-90" href="/lab/orders" aria-label="<%= __('navigation.orders') %>">
      <svg class="ic"><use href="#i-bell"/></svg>
    </a>
    <button class="la-theme" id="laThemeBtn" aria-label="Theme">
      <svg class="ic sun"><use href="#i-sun"/></svg>
      <svg class="ic moon"><use href="#i-moon"/></svg>
      <span class="knob"></span>
    </button>
  </div>
  <div class="la-top-group">
    <a class="la-circle press-90" href="/shop" aria-label="Store"><svg class="ic" style="width:19px;height:19px;stroke-width:1.8"><use href="#i-store"/></svg></a>
    <div style="position:relative">
      <button class="la-circle la-lang press-90" id="laLangBtn" aria-label="Language">
        <svg class="ic"><use href="#i-globe"/></svg><span><%= _langBadge %></span>
      </button>
      <div class="la-menu" id="laLangMenu">
        <% [['ar','العربية'],['en','English'],['ku','کوردی'],['tr','Türkçe']].forEach(function (l) { %>
          <button class="la-lang-opt <%= _lang === l[0] ? 'on' : '' %>" data-lang="<%= l[0] %>"><svg class="ic"><use href="#i-globe"/></svg><%= l[1] %></button>
        <% }); %>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    function toggle(menuId, e) {
      e.stopPropagation();
      document.querySelectorAll('.la-menu').forEach(function (m) { if (m.id !== menuId) m.classList.remove('open'); });
      document.getElementById(menuId).classList.toggle('open');
    }
    document.getElementById('laUserBtn').addEventListener('click', function (e) { toggle('laUserMenu', e); });
    document.getElementById('laLangBtn').addEventListener('click', function (e) { toggle('laLangMenu', e); });
    document.addEventListener('click', function () {
      document.querySelectorAll('.la-menu.open').forEach(function (m) { m.classList.remove('open'); });
    });
    document.getElementById('laThemeBtn').addEventListener('click', function () {
      var d = document.documentElement;
      var dark = d.getAttribute('data-theme') !== 'dark';
      if (dark) d.setAttribute('data-theme', 'dark'); else d.removeAttribute('data-theme');
      try { localStorage.setItem('la-theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
    // Language: same API as before (sets the cookie on the server), then reload.
    document.querySelectorAll('.la-lang-opt').forEach(function (b) {
      b.addEventListener('click', function () {
        fetch('/api/language/set', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ language: b.dataset.lang })
        }).then(function (r) { return r.json(); })
          .then(function (d) { if (d.success) window.location.reload(); })
          .catch(function (err) { console.error('Error setting language:', err); });
      });
    });
    // Shared toast used by redesigned pages: window.laToast('text')
    var timer;
    window.laToast = function (text) {
      var t = document.getElementById('laToast');
      if (!t) { t = document.createElement('div'); t.id = 'laToast'; t.className = 'la-toast pop-in'; document.body.appendChild(t); }
      t.textContent = text; t.style.display = 'block';
      t.classList.remove('pop-in'); void t.offsetWidth; t.classList.add('pop-in');
      clearTimeout(timer); timer = setTimeout(function () { t.style.display = 'none'; }, 2600);
    };
  })();
</script>

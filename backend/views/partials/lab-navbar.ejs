<%#
  Lab dashboard shell — side bar (desktop), floating bottom bar (mobile) and top bar.
  One identity with the lab app: floating side bar, round white chips in the top bar,
  the app's theme switch and bottom bar on phones. Styles: /css/lab-app.css.
%>
<%
  const _active = (typeof activeSection !== 'undefined' && activeSection) ||
                  (typeof activePage !== 'undefined' && activePage) || '';
  const _lang = (typeof currentLang !== 'undefined' && currentLang) || 'ar';
  const _langBadge = { ar: 'AR', en: 'EN', ku: 'KU', tr: 'TR' }[_lang] || 'AR';
  const _u = (typeof user !== 'undefined' && user) || {};
  const _labName = (typeof lab !== 'undefined' && lab && lab.name) || 'LabGo';
  const _initial = (_u.name || _labName || 'L').trim().charAt(0).toUpperCase();
  const _groups = [
    { label: __('labWeb.groupDaily'), items: [
      { id: 'overview', href: '/lab/dashboard', icon: 'layout-dashboard', label: __('navigation.dashboard') },
      { id: 'orders', href: '/lab/orders', icon: 'clipboard-list', label: __('navigation.orders') },
      { id: 'results', href: '/lab/results', icon: 'file-check', label: __('results.title') },
      { id: 'add-patient', href: '/lab/patients/new', icon: 'user-plus', label: __('labApp.addPatient') },
      { id: 'patient-tests', href: '/lab/patient-tests', icon: 'test-tube', label: __('navigation.patientTests') },
      { id: 'external-transfers', href: '/lab/external-transfers', icon: 'arrow-left-right', label: __('navigation.externalTransfers') },
    ] },
    { label: __('labWeb.groupCatalog'), items: [
      { id: 'tests', href: '/lab/tests', icon: 'flask-conical', label: __('navigation.tests') },
      { id: 'offers', also: ['packages'], href: '/lab/offers', icon: 'tag', label: __('labApp.offersPackages') },
      { id: 'services', href: '/lab/services', icon: 'zap', label: __('navigation.quickServices') },
    ] },
    { label: __('labWeb.groupManage'), items: [
      { id: 'reports', also: ['finance'], href: '/lab/reports', icon: 'chart-line', label: __('navigation.reports') },
      { id: 'waste', href: '/lab/waste', icon: 'trash-2', label: __('waste.title') },
      { id: 'market', href: '/lab/market', icon: 'store', label: __('labWeb.market') },
      { id: 'supplies', href: '/lab/supplies', icon: 'boxes', label: __('labWeb.supplies') },
    ] },
  ];
  const _navEnd = [
    { id: 'settings', also: ['profile', 'users'], href: '/lab/settings', icon: 'settings', label: __('navigation.settings') },
    { id: 'support', href: '/lab/support', icon: 'life-buoy', label: __('labWeb.support') },
  ];
  const _bottom = ['overview', 'orders', 'add-patient', 'results', 'settings'];
  // Only pages this account may open (staff permissions). Settings opens the first allowed tab.
  const _can = typeof labCan === 'function' ? labCan : function () { return true; };
  _navEnd.forEach(function (n) {
    if (n.id === 'settings') n.href = ['/lab/settings', '/lab/users', '/lab/profile'].filter(_can)[0];
  });
  const _navEndOk = _navEnd.filter(function (n) { return n.href && _can(n.href); });
  _groups.forEach(function (g) { g.items = g.items.filter(function (n) { return _can(n.href); }); });
  const _nav = [].concat.apply([], _groups.map(function (g) { return g.items; }));
  const _isActive = function (n) { return _active === n.id || (n.also || []).indexOf(_active) !== -1; };
  const _current = _nav.concat(_navEndOk).filter(_isActive)[0];
%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/lab-app.css">
<script>
  // Apply theme + accent before paint (kept per browser, same keys as before).
  (function () {
    var d = document.documentElement;
    d.classList.add('la');
    try {
      var t = localStorage.getItem('la-theme');
      if (t === 'dark') d.setAttribute('data-theme', 'dark');
      var a = localStorage.getItem('la-accent');
      if (a) d.style.setProperty('--accent', a);
    } catch (e) {}
  })();
</script>
<%- include('lab-icons') %>

<aside class="la-side" aria-label="<%= __('navigation.dashboard') %>">
  <a href="/lab/dashboard" class="la-brand">
    <span class="la-brand-logo"><img src="<%= (typeof lab !== 'undefined' && lab && lab.logo) || '/images/logo.png' %>" alt=""></span>
    <span><b><%= _labName %></b><span>LabGo · <%= __('labWeb.workspace') %></span></span>
  </a>
  <nav class="la-nav">
    <% _groups.forEach(function (g) { if (!g.items.length) return; %>
      <div class="la-nav-group"><%= g.label %></div>
      <% g.items.forEach(function (n) { %>
        <a href="<%= n.href %>" class="la-nav-item press <%= _isActive(n) ? 'active' : '' %>" title="<%= n.label %>">
          <span class="la-nav-ic"><svg class="ic"><use href="#i-<%= n.icon %>"/></svg></span>
          <span><%= n.label %></span>
        </a>
      <% }); %>
    <% }); %>
    <div class="la-nav-sep"></div>
    <% _navEndOk.forEach(function (n) { %>
      <a href="<%= n.href %>" class="la-nav-item press <%= _isActive(n) ? 'active' : '' %>" title="<%= n.label %>">
        <span class="la-nav-ic"><svg class="ic"><use href="#i-<%= n.icon %>"/></svg></span>
        <span><%= n.label %></span>
      </a>
    <% }); %>
  </nav>
  <div class="la-side-foot" style="position:relative">
    <button type="button" class="la-user" id="laUserBtn" aria-label="<%= __('navigation.profile') %>">
      <span class="la-user-av"><% if (_u.profileImage) { %><img src="<%= _u.profileImage %>" alt=""><% } else { %><%= _initial %><% } %></span>
      <span class="la-user-txt"><b><%= _u.name || _labName %></b><span><%= _u.email || _u.phone || '' %></span></span>
      <svg class="ic"><use href="#i-chevrons-up-down"/></svg>
    </button>
    <div class="la-menu up" id="laUserMenu" style="min-width:220px">
      <a href="/lab/profile"><svg class="ic"><use href="#i-user"/></svg><%= __('navigation.profile') %></a>
      <% if (_can('/lab/settings')) { %><a href="/lab/settings"><svg class="ic"><use href="#i-settings"/></svg><%= __('navigation.settings') %></a><% } %>
      <hr>
      <a href="/auth/logout" class="danger"><svg class="ic flip-rtl"><use href="#i-log-out"/></svg><%= __('navigation.logout') %></a>
    </div>
  </div>
</aside>

<nav class="la-bottom" aria-label="<%= __('navigation.dashboard') %>">
  <% _nav.concat(_navEndOk).filter(function (n) { return _bottom.indexOf(n.id) !== -1; }).forEach(function (n) { %>
    <a href="<%= n.href %>" class="<%= n.id === 'add-patient' ? 'primary' : (_isActive(n) ? 'active' : '') %>" aria-label="<%= n.label %>">
      <svg class="ic"><use href="#i-<%= n.id === 'add-patient' ? 'plus' : n.icon %>"/></svg>
    </a>
  <% }); %>
</nav>

<header class="la-top">
  <div class="la-crumbs">
    <span class="la-crumb-root"><%= _labName %></span>
    <svg class="ic flip-ltr la-crumb-sep"><use href="#i-chevron-left"/></svg>
    <b><%= _current ? _current.label : (typeof title !== 'undefined' ? title : '') %></b>
  </div>
  <div class="la-top-group">
    <div style="position:relative" class="la-only-phone-menu">
      <button class="la-circle" id="laMoreBtn" aria-label="Menu"><svg class="ic"><use href="#i-menu"/></svg></button>
      <div class="la-menu" id="laMoreMenu">
        <% _nav.concat(_navEndOk).filter(function (n) { return _bottom.indexOf(n.id) === -1; }).forEach(function (n) { %>
          <a href="<%= n.href %>"><svg class="ic"><use href="#i-<%= n.icon %>"/></svg><%= n.label %></a>
        <% }); %>
        <hr>
        <a href="/auth/logout" class="danger"><svg class="ic flip-rtl"><use href="#i-log-out"/></svg><%= __('navigation.logout') %></a>
      </div>
    </div>
    <% if (_can('/lab/market')) { %>
    <a class="la-circle press-90" href="/lab/market" aria-label="<%= __('labWeb.market') %>" title="<%= __('labWeb.market') %>">
      <svg class="ic" style="width:19px;height:19px;stroke-width:1.8"><use href="#i-store"/></svg>
    </a>
    <% } %>
    <div style="position:relative">
      <button class="la-circle la-lang" id="laLangBtn" aria-label="<%= __('labWeb.language') %>">
        <svg class="ic"><use href="#i-globe"/></svg><span><%= _langBadge %></span>
      </button>
      <div class="la-menu" id="laLangMenu">
        <% [['ar','العربية'],['en','English'],['ku','کوردی'],['tr','Türkçe']].forEach(function (l) { %>
          <button class="la-lang-opt <%= _lang === l[0] ? 'on' : '' %>" data-lang="<%= l[0] %>"><%= l[1] %></button>
        <% }); %>
      </div>
    </div>
    <button class="la-theme" id="laThemeBtn" aria-label="<%= __('labWeb.theme') %>" title="<%= __('labWeb.theme') %>">
      <span class="knob"></span>
      <svg class="ic sun"><use href="#i-sun"/></svg>
      <svg class="ic moon"><use href="#i-moon"/></svg>
    </button>
    <div style="position:relative">
      <button class="la-circle la-bell" id="laBellBtn" aria-label="<%= __('labNotifications.title') %>">
        <svg class="ic"><use href="#i-bell"/></svg><span class="la-bell-dot" id="laBellDot" hidden></span>
      </button>
      <div class="la-menu la-notif" id="laNotifMenu">
        <div class="la-notif-head"><b><%= __('labNotifications.title') %></b><button type="button" id="laNotifAll"><%= __('labNotifications.markAll') %></button></div>
        <div id="laNotifList"><p class="la-notif-empty"><%= __('labNotifications.empty') %></p></div>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    function toggle(menuId, e) {
      e.stopPropagation();
      document.querySelectorAll('.la-menu').forEach(function (m) { if (m.id !== menuId) m.classList.remove('open'); });
      document.getElementById(menuId).classList.toggle('open');
    }
    document.getElementById('laUserBtn').addEventListener('click', function (e) { toggle('laUserMenu', e); });
    document.getElementById('laMoreBtn').addEventListener('click', function (e) { toggle('laMoreMenu', e); });
    document.getElementById('laLangBtn').addEventListener('click', function (e) { toggle('laLangMenu', e); });
    // Lab notifications (samples sent to / received by / results from other labs).
    var bellCopy = { empty: <%- JSON.stringify(__('labNotifications.empty')) %> };
    function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
    function notifHref(d) {
      if (d.type === 'transfer_incoming') return '/lab/external-transfers?tab=incoming';
      if (d.type === 'transfer_received' || d.type === 'transfer_result') return '/lab/external-transfers';
      return '';
    }
    function ago(iso) {
      var m = Math.max(0, Math.round((Date.now() - new Date(iso)) / 60000));
      try {
        var f = new Intl.RelativeTimeFormat(document.documentElement.lang || 'en', { numeric: 'auto' });
        if (m < 60) return f.format(-m, 'minute');
        if (m < 1440) return f.format(-Math.round(m / 60), 'hour');
        return f.format(-Math.round(m / 1440), 'day');
      } catch (e) { return new Date(iso).toLocaleString(); }
    }
    var bellItems = [];
    function loadBell() {
      fetch('/lab/api/notifications', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.success) return;
          bellItems = d.data.items;
          var dot = document.getElementById('laBellDot');
          if (d.data.unread > (window.__laUnread || 0) && window.__laUnread !== undefined) {
            var bb = document.getElementById('laBellBtn'); bb.classList.remove('ring'); void bb.offsetWidth; bb.classList.add('ring');
          }
          window.__laUnread = d.data.unread || 0;
          dot.hidden = !d.data.unread;
          dot.textContent = d.data.unread > 9 ? '9+' : String(d.data.unread || '');
          var list = document.getElementById('laNotifList');
          list.innerHTML = bellItems.length ? bellItems.map(function (n) {
            var href = notifHref(n.data || {});
            return '<a class="la-notif-item' + (n.isRead ? '' : ' unread') + '" data-id="' + esc(n.id) + '" href="' + (href || '#') + '">'
              + '<b>' + esc(n.title) + '</b><span>' + esc(n.body) + '</span><small>' + esc(ago(n.createdAt)) + '</small></a>';
          }).join('') : '<p class="la-notif-empty">' + esc(bellCopy.empty) + '</p>';
        }).catch(function () {});
    }
    function markRead(ids) {
      return fetch('/lab/api/notifications/read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(ids ? { ids: ids } : {}) })
        .then(loadBell).catch(function () {});
    }
    document.getElementById('laBellBtn').addEventListener('click', function (e) { toggle('laNotifMenu', e); });
    document.getElementById('laNotifMenu').addEventListener('click', function (e) { e.stopPropagation(); });
    document.getElementById('laNotifAll').addEventListener('click', function () { markRead(null); });
    document.getElementById('laNotifList').addEventListener('click', function (e) {
      var a = e.target.closest('.la-notif-item');
      if (!a) return;
      if (a.getAttribute('href') === '#') e.preventDefault();
      if (a.classList.contains('unread')) {
        var nav = a.getAttribute('href');
        e.preventDefault();
        markRead([a.dataset.id]).then(function () { if (nav !== '#') window.location.href = nav; });
      }
    });
    loadBell();
    setInterval(function () { if (!document.hidden) loadBell(); }, 60000);
    document.addEventListener('click', function () {
      document.querySelectorAll('.la-menu.open').forEach(function (m) { m.classList.remove('open'); });
    });
    document.getElementById('laThemeBtn').addEventListener('click', function () {
      var d = document.documentElement;
      var dark = d.getAttribute('data-theme') !== 'dark';
      if (dark) d.setAttribute('data-theme', 'dark'); else d.removeAttribute('data-theme');
      try { localStorage.setItem('la-theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
    // Language: same API as before (sets the cookie on the server), then reload.
    document.querySelectorAll('.la-lang-opt').forEach(function (b) {
      b.addEventListener('click', function () {
        fetch('/api/language/set', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ language: b.dataset.lang })
        }).then(function (r) { return r.json(); })
          .then(function (d) { if (d.success) window.location.reload(); })
          .catch(function (err) { console.error('Error setting language:', err); });
      });
    });
    // Shared toast used by redesigned pages: window.laToast('text')
    var timer;
    window.laToast = function (text) {
      var t = document.getElementById('laToast');
      if (!t) { t = document.createElement('div'); t.id = 'laToast'; t.className = 'la-toast pop-in'; document.body.appendChild(t); }
      t.textContent = text; t.style.display = 'block';
      t.classList.remove('pop-in'); void t.offsetWidth; t.classList.add('pop-in');
      clearTimeout(timer); timer = setTimeout(function () { t.style.display = 'none'; }, 2600);
    };
  })();
</script>
<script>
  // Live sync with the lab app and other browsers (same lab, same permissions).
  // A change made elsewhere refreshes this page when it is idle; while you are
  // typing or a dialog is open it shows a bar instead, so nothing typed is lost.
  (function () {
    if (!window.EventSource || window.__labLive) return;
    window.__labLive = true;
    var ar = (document.documentElement.lang || '').indexOf('en') !== 0;
    var me = Math.random().toString(36).slice(2, 10);
    // Tag this tab's own requests, so its own saves do not refresh it.
    var origFetch = window.fetch;
    if (origFetch) {
      window.fetch = function (input, init) {
        try {
          var url = typeof input === 'string' ? input : (input && input.url) || '';
          if (!/^https?:/i.test(url) || url.indexOf(location.origin) === 0) {
            init = init || {};
            var h = new Headers(init.headers || (input && input.headers) || {});
            h.set('X-Live-Client', me);
            init.headers = h;
          }
        } catch (e) {}
        return origFetch.call(this, input, init);
      };
    }
    var origOpen = XMLHttpRequest.prototype.open, origSend = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (m, url) { this.__live = !/^https?:/i.test(url) || String(url).indexOf(location.origin) === 0; return origOpen.apply(this, arguments); };
    XMLHttpRequest.prototype.send = function () { try { if (this.__live) this.setRequestHeader('X-Live-Client', me); } catch (e) {} return origSend.apply(this, arguments); };
    // A normal form post from this tab is also its own change.
    var ownUntil = 0;
    document.addEventListener('submit', function () { ownUntil = Date.now() + 4000; dirty = false; }, true);

    // Which changes matter to this page.
    var p = location.pathname;
    var kinds = /\/(orders|patient-tests|results|patients)/.test(p) ? ['orders', 'results', 'transfers']
      : /\/external-transfers/.test(p) ? ['transfers', 'results', 'orders']
      : /\/tests/.test(p) ? ['tests']
      : /\/(packages|offers|services)/.test(p) ? ['packages', 'tests']
      : /\/(finance|reports|transactions)/.test(p) ? ['finance', 'orders']
      : /\/users/.test(p) ? ['staff']
      : /\/(profile|settings)/.test(p) ? ['lab', 'staff']
      : /\/waste/.test(p) ? ['waste']
      : /\/(market|supplies|support)/.test(p) ? ['store', 'maintenance']
      : null; // dashboard and others: everything

    var dirty = false;
    document.addEventListener('input', function (e) { if (e.target && e.target.closest && e.target.closest('form, [contenteditable], .la-modal, dialog')) dirty = true; }, true);
    function busy() {
      var a = document.activeElement;
      if (a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName) && a.type !== 'button' && a.type !== 'submit') return true;
      if (document.querySelector('dialog[open], .modal.show, .la-modal.open, .la-sheet.open, [aria-modal="true"]')) return true;
      return dirty;
    }
    // Keep the scroll position across the refresh.
    try {
      var y = sessionStorage.getItem('labLiveY:' + p);
      if (y) { sessionStorage.removeItem('labLiveY:' + p); window.scrollTo(0, Number(y)); }
    } catch (e) {}
    function reload() {
      try { sessionStorage.setItem('labLiveY:' + p, String(window.scrollY)); } catch (e) {}
      location.reload();
    }
    var bar;
    function showBar() {
      if (bar) return;
      bar = document.createElement('button');
      bar.type = 'button';
      bar.textContent = ar ? 'تم تحديث البيانات من جهاز آخر — اضغط للتحديث' : 'Data changed on another device — tap to refresh';
      bar.style.cssText = 'position:fixed;left:50%;top:12px;transform:translateX(-50%);z-index:99999;padding:10px 18px;border-radius:999px;border:1px solid rgba(255,255,255,.25);background:rgba(20,20,22,.82);color:#fff;font:600 13px/1.3 inherit;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 8px 24px rgba(0,0,0,.18);cursor:pointer';
      bar.onclick = reload;
      document.body.appendChild(bar);
    }
    var timer;
    function changed() {
      clearTimeout(timer);
      timer = setTimeout(function () {
        if (document.hidden) { pendingOnShow = true; return; }
        busy() ? showBar() : reload();
      }, 900);
    }
    var pendingOnShow = false;
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) return;
      if (!es || es.readyState === 2) connect();
      if (pendingOnShow) { pendingOnShow = false; changed(); }
    });

    var es, lastId = '', backoff = 1000, bootId = '';
    function connect() {
      if (es) es.close();
      es = new EventSource('/lab/api/live' + (lastId ? '?lastEventId=' + encodeURIComponent(lastId) : ''));
      es.addEventListener('hello', function (e) {
        backoff = 1000;
        try {
          var d = JSON.parse(e.data);
          // The server restarted while we were away: anything may have changed.
          if (bootId && d.bootId !== bootId && !lastId) changed();
          bootId = d.bootId;
        } catch (err) {}
      });
      es.addEventListener('change', function (e) {
        lastId = e.lastEventId || lastId;
        var d; try { d = JSON.parse(e.data); } catch (err) { return; }
        if (d.client && d.client === me) return; // this tab's own save
        if (!d.client && d.source === 'web' && Date.now() < ownUntil) return;
        if (kinds && kinds.indexOf(d.kind) < 0) return;
        changed();
      });
      es.addEventListener('resync', function () { changed(); });
      es.addEventListener('reauth', function () { es.close(); setTimeout(connect, 500); }); // access changed: check again
      es.onerror = function () {
        if (es.readyState === 2) { // closed for good (signed out, no access, server down)
          setTimeout(connect, backoff);
          backoff = Math.min(backoff * 2, 30000);
        }
      };
    }
    window.addEventListener('online', function () { connect(); changed(); });
    connect();
  })();
</script>

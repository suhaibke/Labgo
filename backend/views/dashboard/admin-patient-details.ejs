<%
// Server-side helper functions
function formatDateServer(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });
}

function formatCurrencyServer(amount) {
    return new Intl.NumberFormat('en-IQ', {
        style: 'decimal',
        minimumFractionDigits: 0
    }).format(Math.round(amount)) + ' IQD';
}
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= patient.name %> - <%= __('patientManagement.patientDetails') %> - LabGo Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-patient-details.css">
    <style>
        body {
            font-family: <%= font %>;
        }
    </style>
</head>

<body>
    <!-- Admin Navbar -->
    <%- include('../partials/admin-navbar') %>

    <!-- Main Content -->
    <main class="admin-dashboard">
        <div class="patient-details-container">

            <!-- Back Button & Header -->
            <div class="page-header">
                <div class="header-left">
                    <button class="back-btn" onclick="window.location.href='/admin/patients'">
                        <i class="fas fa-arrow-left"></i>
                        <span><%= __('patientManagement.backToPatients') %></span>
                    </button>
                    <h1><%= __('patientManagement.patientDetails') %></h1>
                </div>
                <div class="header-actions">
                    <% if (patient.status === 'active') { %>
                        <button class="modern-btn danger-btn" onclick="showBlockModal()">
                            <i class="fas fa-ban"></i>
                            <span><%= __('patientManagement.blockPatient') %></span>
                        </button>
                    <% } else { %>
                        <button class="modern-btn success-btn" onclick="showUnblockModal()">
                            <i class="fas fa-check"></i>
                            <span><%= __('patientManagement.unblockPatient') %></span>
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- Patient Profile Section -->
            <section class="profile-section">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="profile-info">
                        <h2 class="profile-name"><%= patient.name %></h2>
                        <p class="profile-email"><%= patient.email %></p>
                        <span class="status-badge <%= patient.status %>"><% if (patient.status === 'active') { %><%= __('patientManagement.active') %><% } else if (patient.status === 'blocked') { %><%= __('patientManagement.blocked') %><% } else if (patient.status === 'suspended') { %><%= __('patientManagement.suspended') %><% } else { %><%= patient.status %><% } %></span>
                    </div>
                </div>

                <!-- Personal Information Grid -->
                <div class="info-grid">
                    <div class="info-card">
                        <div class="info-icon"><i class="fas fa-envelope"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.email') %></span>
                            <span class="info-value"><%= patient.email %></span>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon"><i class="fas fa-phone"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.phone') %></span>
                            <span class="info-value"><%= patient.phone || '-' %></span>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon"><i class="fas fa-venus-mars"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.gender') %></span>
                            <span class="info-value"><%= patient.gender || '-' %></span>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon"><i class="fas fa-calendar-alt"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.dateOfBirth') %></span>
                            <span class="info-value"><%= patient.birthDate ? formatDateServer(patient.birthDate) : '-' %></span>
                        </div>
                    </div>
                    <div class="info-card">
                        <div class="info-icon"><i class="fas fa-calendar-check"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.joinedDate') %></span>
                            <span class="info-value"><%= formatDateServer(patient.createdAt) %></span>
                        </div>
                    </div>
                    <% if (patient.blockedAt) { %>
                    <div class="info-card blocked">
                        <div class="info-icon"><i class="fas fa-ban"></i></div>
                        <div class="info-content">
                            <span class="info-label"><%= __('patientManagement.blockedAt') %></span>
                            <span class="info-value"><%= formatDateServer(patient.blockedAt) %></span>
                        </div>
                    </div>
                    <% } %>
                </div>

                <% if (patient.blockedAt && patient.blockReason) { %>
                <div class="block-reason-card">
                    <div class="block-reason-header">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span><%= __('patientManagement.blockReason') %></span>
                    </div>
                    <p class="block-reason-text"><%= patient.blockReason %></p>
                    <% if (patient.blockedBy) { %>
                    <p class="blocked-by"><%= __('patientManagement.blockedBy') %>: <%= patient.blockedBy.name %></p>
                    <% } %>
                </div>
                <% } %>
            </section>

            <!-- Statistics Section -->
            <section class="statistics-section">
                <h3 class="section-title"><i class="fas fa-chart-bar"></i> <%= __('patientManagement.orderStatistics') %></h3>
                <div class="stats-grid">
                    <div class="stat-card primary">
                        <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
                        <div class="stat-content">
                            <span class="stat-value"><%= stats.totalOrders || 0 %></span>
                            <span class="stat-label"><%= __('patientManagement.totalOrders') %></span>
                        </div>
                    </div>
                    <div class="stat-card success">
                        <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                        <div class="stat-content">
                            <span class="stat-value"><%= stats.completedOrders || 0 %></span>
                            <span class="stat-label"><%= __('patientManagement.completedOrders') %></span>
                        </div>
                    </div>
                    <div class="stat-card warning">
                        <div class="stat-icon"><i class="fas fa-clock"></i></div>
                        <div class="stat-content">
                            <span class="stat-value"><%= stats.pendingOrders || 0 %></span>
                            <span class="stat-label"><%= __('patientManagement.pendingOrders') %></span>
                        </div>
                    </div>
                    <div class="stat-card danger">
                        <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
                        <div class="stat-content">
                            <span class="stat-value"><%= stats.cancelledOrders || 0 %></span>
                            <span class="stat-label"><%= __('patientManagement.cancelledOrders') %></span>
                        </div>
                    </div>
                    <div class="stat-card info">
                        <div class="stat-icon"><i class="fas fa-money-bill-wave"></i></div>
                        <div class="stat-content">
                            <span class="stat-value"><%= formatCurrencyServer(stats.totalSpent || 0) %></span>
                            <span class="stat-label"><%= __('patientManagement.totalSpent') %></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Orders Section -->
            <section class="orders-section">
                <div class="section-header">
                    <h3 class="section-title"><i class="fas fa-list"></i> <%= __('patientManagement.allOrders') %></h3>
                    <span class="count-badge"><%= orders.length %></span>
                </div>
                <div class="orders-table-container">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th><%= __('orders.orderId') %></th>
                                <th><%= __('orders.lab') %></th>
                                <th><%= __('orders.nurse') %></th>
                                <th><%= __('common.status') %></th>
                                <th><%= __('orders.amount') %></th>
                                <th><%= __('orders.orderDate') %></th>
                                <th><%= __('common.actions') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (orders.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="empty-cell">
                                        <i class="fas fa-inbox"></i>
                                        <%= __('patientManagement.noOrdersFound') %>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% orders.forEach(order => { %>
                                    <tr class="order-row" onclick="window.location.href='/admin/orders/<%= order._id %>/details'">
                                        <td class="order-id">
                                            <span class="qr-code"><%= order.qrCode || order._id.slice(-8).toUpperCase() %></span>
                                        </td>
                                        <td>
                                            <%= order.labId ? order.labId.name : '-' %>
                                            <% if (order.labId && order.labId.city) { %>
                                                <span class="sub-text"><%= order.labId.city %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <%= order.nurseId ? order.nurseId.name : '-' %>
                                            <% if (order.nurseId && order.nurseId.phone) { %>
                                                <span class="sub-text"><%= order.nurseId.phone %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="status-badge <%= order.status %>"><% if (order.status === 'pending') { %><%= __('patientManagement.pending') %><% } else if (order.status === 'confirmed') { %><%= __('patientManagement.confirmed') %><% } else if (order.status === 'nurse_assigned') { %><%= __('orders.statusValues.nurseAssigned') %><% } else if (order.status === 'sample_collected') { %><%= __('orders.statusValues.sampleCollected') %><% } else if (order.status === 'at_lab') { %><%= __('orders.statusValues.atLab') %><% } else if (order.status === 'completed') { %><%= __('patientManagement.completed') %><% } else if (order.status === 'cancelled') { %><%= __('patientManagement.cancelled') %><% } else { %><%= order.status %><% } %></span>
                                        </td>
                                        <td class="amount">
                                            <%= formatCurrencyServer(order.pricing ? order.pricing.total : 0) %>
                                        </td>
                                        <td class="date">
                                            <%= formatDateServer(order.createdAt) %>
                                        </td>
                                        <td class="actions">
                                            <button class="action-btn view-order" title="<%= __('patientManagement.viewOrderDetails') %>">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>

        </div>
    </main>

    <!-- Block Patient Modal -->
    <div class="modal-overlay" id="blockPatientModal">
        <div class="modal-container block-modal">
            <div class="modal-header">
                <h3><%= __('patientManagement.blockPatient') %></h3>
                <button class="modal-close-btn" onclick="closeBlockModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <p class="modal-description"><%= __('patientManagement.blockPatientDescription') %></p>
                <div class="form-group">
                    <label for="blockReason"><%= __('patientManagement.blockReason') %></label>
                    <textarea id="blockReason" class="form-control" rows="4"
                        placeholder="<%= __('patientManagement.blockReasonPlaceholder') %>"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modern-btn" onclick="closeBlockModal()">
                    <span><%= __('common.cancel') %></span>
                </button>
                <button class="modern-btn danger-btn" onclick="submitBlockPatient()">
                    <i class="fas fa-ban"></i>
                    <span><%= __('patientManagement.confirmBlock') %></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Unblock Patient Modal -->
    <div class="modal-overlay" id="unblockPatientModal">
        <div class="modal-container confirm-modal">
            <div class="modal-header">
                <h3><%= __('patientManagement.unblockPatient') %></h3>
                <button class="modal-close-btn" onclick="closeUnblockModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <p class="modal-description"><%= __('patientManagement.unblockPatientDescription') %></p>
            </div>
            <div class="modal-footer">
                <button class="modern-btn" onclick="closeUnblockModal()">
                    <span><%= __('common.cancel') %></span>
                </button>
                <button class="modern-btn success-btn" onclick="submitUnblockPatient()">
                    <i class="fas fa-check"></i>
                    <span><%= __('patientManagement.confirmUnblock') %></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toast">
        <div class="toast-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="toast-content">
            <h4 class="toast-title" id="toastTitle"><%= __('common.success') %></h4>
            <p class="toast-message" id="toastMessage"></p>
        </div>
        <button class="toast-close" onclick="hideToast()">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <script>
        const API_BASE = '/api/admin/patients';
        const PATIENT_ID = '<%= patient._id %>';

        // Utility functions
        function getStatusLabel(status) {
            const statusMap = {
                'active': "<%= __('patientManagement.active') %>",
                'blocked': "<%= __('patientManagement.blocked') %>",
                'suspended': "<%= __('patientManagement.suspended') %>",
                'pending': "<%= __('patientManagement.pending') %>",
                'confirmed': "<%= __('patientManagement.confirmed') %>",
                'nurse_assigned': "<%= __('orders.statusValues.nurseAssigned') %>",
                'sample_collected': "<%= __('orders.statusValues.sampleCollected') %>",
                'at_lab': "<%= __('orders.statusValues.atLab') %>",
                'completed': "<%= __('patientManagement.completed') %>",
                'cancelled': "<%= __('patientManagement.cancelled') %>"
            };
            return statusMap[status] || status;
        }

        function formatDateServer(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            return date.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-IQ', {
                style: 'decimal',
                minimumFractionDigits: 0
            }).format(Math.round(amount)) + ' IQD';
        }

        function getToken() {
            return localStorage.getItem('token') || '';
        }

        function showToast(type, message) {
            const toast = document.getElementById('toast');
            const icon = toast.querySelector('.toast-icon i');
            const title = toast.querySelector('.toast-title');
            const msg = toast.querySelector('.toast-message');

            icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            toast.classList.remove('success', 'error');
            toast.classList.add(type);
            title.textContent = type === 'success' ? "<%= __('common.success') %>" : "<%= __('common.error') %>";
            msg.textContent = message;

            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function hideToast() {
            document.getElementById('toast').classList.remove('show');
        }

        // Block/Unblock functions
        function showBlockModal() {
            document.getElementById('blockReason').value = '';
            document.getElementById('blockPatientModal').classList.add('show');
        }

        function closeBlockModal() {
            document.getElementById('blockPatientModal').classList.remove('show');
            document.getElementById('blockReason').value = '';
        }

        async function submitBlockPatient() {
            const reason = document.getElementById('blockReason').value.trim();

            if (!reason) {
                showToast('error', "<%= __('patientManagement.blockReasonRequired') %>");
                return;
            }

            try {
                const response = await fetch(`${API_BASE}/${PATIENT_ID}/block`, {
                    method: 'PATCH',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ reason })
                });

                const data = await response.json();

                if (data.success) {
                    showToast('success', "<%= __('patientManagement.patientBlocked') %>");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', data.message);
                }
            } catch (error) {
                showToast('error', "<%= __('common.error') %>");
            }
        }

        function showUnblockModal() {
            document.getElementById('unblockPatientModal').classList.add('show');
        }

        function closeUnblockModal() {
            document.getElementById('unblockPatientModal').classList.remove('show');
        }

        async function submitUnblockPatient() {
            try {
                const response = await fetch(`${API_BASE}/${PATIENT_ID}/unblock`, {
                    method: 'PATCH',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`
                    }
                });

                const data = await response.json();

                if (data.success) {
                    showToast('success', "<%= __('patientManagement.patientUnblocked') %>");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', data.message);
                }
            } catch (error) {
                showToast('error', "<%= __('common.error') %>");
            }
        }

        // Close modals on overlay click
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                }
            });
        });

        // Close modals with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay').forEach(modal => {
                    modal.classList.remove('show');
                });
            }
        });
    </script>
</body>

</html>

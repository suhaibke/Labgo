<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/lab-tests.css">
</head>
<body>
    <!-- Lab Navbar -->
    <%- include('../partials/lab-navbar') %>

    <!-- Main Content Wrapper -->
    <div class="lab-wrapper">
        <main class="lab-dashboard">
        <div class="dashboard-container">
            <!-- Page Header -->
            <div class="tests-page-header">
                <div class="header-content">
                    <div class="header-title">
                        <h1>
                            <svg class="ic"><use href="#i-flask-conical"/></svg>
                            <%= __('tests.catalogManagement') %>
                        </h1>
                        <p><%= __('tests.manageTests') %></p>
                    </div>
                    <div class="header-actions">
                        <button class="btn btn-outline" onclick="importTests()">
                            <svg class="ic"><use href="#i-upload"/></svg>
                            <%= __('tests.import') %>
                        </button>
                        <button class="btn btn-primary" onclick="showAddTestModal()">
                            <svg class="ic"><use href="#i-plus"/></svg>
                            <%= __('tests.addNewTest') %>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="stats-grid">
                <div class="stat-card primary">
                    <div class="stat-icon">
                        <svg class="ic"><use href="#i-test-tube"/></svg>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= tests ? tests.length : 0 %></h3>
                        <p class="stat-label"><%= __('tests.totalTests') %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <svg class="ic"><use href="#i-coins"/></svg>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= tests && tests.length > 0 ? Math.round(tests.reduce((sum, test) => sum + test.price, 0) / tests.length) : 0 %></h3>
                        <p class="stat-label"><%= __('tests.averagePrice') %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <svg class="ic"><use href="#i-users"/></svg>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= lab ? lab.totalPatientsServed || 0 : 0 %></h3>
                        <p class="stat-label"><%= __('tests.totalPatients') %></p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <svg class="ic"><use href="#i-microscope"/></svg>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= lab ? lab.totalTestsPerformed || 0 : 0 %></h3>
                        <p class="stat-label"><%= __('tests.testsPerformed') %></p>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="filters-section">
                <div class="filters-header">
                    <div class="filters-title">
                        <svg class="ic"><use href="#i-filter"/></svg>
                        <%= __('tests.filtersSearch') %>
                    </div>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="grid" onclick="setView('grid')" title="Grid View">
                            <svg class="ic"><use href="#i-layout-grid"/></svg>
                        </button>
                        <button class="view-btn" data-view="table" onclick="setView('table')" title="Table View">
                            <svg class="ic"><use href="#i-list"/></svg>
                        </button>
                    </div>
                </div>
                <div class="filters-content">
                    <div class="search-box">
                        <svg class="ic"><use href="#i-search"/></svg>
                        <input type="text" id="searchInput" placeholder="<%= __('tests.searchPlaceholder') %>" onkeyup="filterTests()">
                    </div>
                    <div class="filter-dropdown">
                        <select id="categoryFilter" onchange="filterTests()">
                            <option value=""><%= __('tests.allCategories') %></option>
                            <% if (labSpecializations && labSpecializations.length > 0) { %>
                                <% labSpecializations.forEach(spec => { %>
                                    <option value="<%= spec %>"><%= __('tests.specializations.' + spec, spec) %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="filter-dropdown">
                        <select id="sortBy" onchange="sortTests()">
                            <option value="name"><%= __('tests.sortByName') %></option>
                            <option value="price-low"><%= __('tests.priceLowToHigh') %></option>
                            <option value="price-high"><%= __('tests.priceHighToLow') %></option>
                            <option value="category"><%= __('tests.sortByCategory') %></option>
                            <option value="recent"><%= __('tests.recentlyAdded') %></option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Tests Grid -->
            <div class="tests-grid" id="testsGrid">
                <% if (tests && tests.length > 0) { %>
                    <% tests.forEach(test => { %>
                        <div class="test-card" data-category="<%= test.category %>" data-name="<%= (test.nameAr || test.name).toLowerCase() %> <%= (test.name || '').toLowerCase() %>" data-price="<%= test.price %>">
                            <div class="test-card-header">
                                <div class="test-title-row">
                                    <h3 class="test-name"><%= test.nameAr || test.name %></h3>
                                    <% if (test.nameAr && test.name && test.nameAr !== test.name) { %>
                                        <p class="test-name-en"><%= test.name %></p>
                                    <% } %>
                                    <span class="test-category" data-specialization="<%= test.category %>">
                                        <%= __('tests.specializations.' + test.category, test.category) %>
                                    </span>
                                </div>
                                <% if (test.description) { %>
                                    <div class="test-meta">
                                        <div class="test-meta-item">
                                            <svg class="ic"><use href="#i-info"/></svg>
                                            <%= __('tests.detailed') %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <div class="test-card-body">
                                <% if (test.description) { %>
                                    <p class="test-description"><%= test.description %></p>
                                <% } %>
                                <div class="test-price">
                                    <%= Math.round(test.price).toLocaleString('en-US') %> <span style="font-size:13px;font-weight:700;color:var(--muted)">IQD</span>
                                </div>
                            </div>
                            <div class="test-card-footer">
                                <div class="test-actions">
                                    <button class="btn btn-secondary btn-sm btn-edit" onclick="editTest('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-pencil"/></svg>
                                        <%= __('common.edit') %>
                                    </button>
                                    <button class="btn btn-secondary btn-sm btn-edit" onclick="viewTestDetails('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-eye"/></svg>
                                        <%= __('tests.view') %>
                                    </button>
                                    <button class="btn btn-secondary btn-sm btn-delete" onclick="deleteTest('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-trash-2"/></svg>
                                        <%= __('common.delete') %>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <div class="empty-state-icon">
                            <svg class="ic"><use href="#i-test-tube"/></svg>
                        </div>
                        <h3 class="empty-state-title"><%= __('tests.noTestsAvailable') %></h3>
                        <p class="empty-state-description"><%= __('tests.noTestsDescription') %></p>
                        <button class="btn btn-primary" onclick="showAddTestModal()">
                            <svg class="ic"><use href="#i-plus"/></svg>
                            <%= __('tests.addFirstTest') %>
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Tests Table View -->
            <div class="tests-table-container" id="testsTable">
                <% if (tests && tests.length > 0) { %>
                <table class="tests-table">
                    <thead>
                        <tr>
                            <th><%= __('tests.testName') %></th>
                            <th><%= __('tests.category') %></th>
                            <th><%= __('tests.description') %></th>
                            <th><%= __('tests.price') %></th>
                            <th><%= __('tests.actions') %></th>
                        </tr>
                    </thead>
                    <tbody id="testsTableBody">
                        <% tests.forEach(test => { %>
                        <tr class="test-row" data-category="<%= test.category %>" data-name="<%= (test.nameAr || test.name).toLowerCase() %> <%= (test.name || '').toLowerCase() %>" data-price="<%= test.price %>">
                            <td>
                                <div class="table-test-name">
                                    <div class="table-test-icon">
                                        <svg class="ic"><use href="#i-flask-conical"/></svg>
                                    </div>
                                    <div>
                                        <span><%= test.nameAr || test.name %></span>
                                        <% if (test.nameAr && test.name && test.nameAr !== test.name) { %>
                                            <small class="table-test-name-en"><%= test.name %></small>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="table-category" data-specialization="<%= test.category %>">
                                    <%= __('tests.specializations.' + test.category, test.category) %>
                                </span>
                            </td>
                            <td>
                                <span class="table-description" title="<%= test.description || '' %>">
                                    <%= test.description ? test.description.substring(0, 50) + (test.description.length > 50 ? '...' : '') : '-' %>
                                </span>
                            </td>
                            <td>
                                <span class="table-price"><%= Math.round(test.price).toLocaleString() %></span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn btn-secondary btn-sm btn-edit" onclick="editTest('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-pencil"/></svg>
                                    </button>
                                    <button class="btn btn-secondary btn-sm btn-edit" onclick="viewTestDetails('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-eye"/></svg>
                                    </button>
                                    <button class="btn btn-secondary btn-sm btn-delete" onclick="deleteTest('<%= test._id %>')">
                                        <svg class="ic"><use href="#i-trash-2"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } else { %>
                <div class="empty-state" style="margin: 2rem;">
                    <div class="empty-state-icon">
                        <svg class="ic"><use href="#i-test-tube"/></svg>
                    </div>
                    <h3 class="empty-state-title"><%= __('tests.noTestsAvailable') %></h3>
                    <p class="empty-state-description"><%= __('tests.noTestsDescription') %></p>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Add/Edit Test Modal -->
    <div id="testModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal()">
                <svg class="ic"><use href="#i-x"/></svg>
            </button>
            <div class="modal-header">
                <h2 class="modal-title">
                    <svg class="ic"><use href="#i-flask-conical"/></svg>
                    <span id="modalTitle"><%= __('tests.addNewTest') %></span>
                </h2>
            </div>
            <form id="testForm" onsubmit="saveTest(event)">
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="testNameAr"><%= __('tests.testNameAr') %> *</label>
                            <input type="text" id="testNameAr" name="nameAr" class="form-input" required dir="rtl" placeholder="<%= __('tests.testNameArPlaceholder') %>">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="testName"><%= __('tests.testNameEn') %> *</label>
                            <input type="text" id="testName" name="name" class="form-input" required placeholder="<%= __('tests.testNameEnPlaceholder') %>">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="testPrice"><%= __('tests.price') %> *</label>
                            <div class="price-input-group">
                                <input type="number" id="testPrice" name="price" class="form-input" required min="0" step="1000" placeholder="<%= __('tests.pricePlaceholder') %>">
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="testCategory"><%= __('tests.category') %> *</label>
                        <select id="testCategory" name="category" class="form-select" required>
                            <option value=""><%= __('tests.selectCategory') %></option>
                            <% if (labSpecializations && labSpecializations.length > 0) { %>
                                <% labSpecializations.forEach(spec => { %>
                                    <option value="<%= spec %>"><%= __('tests.specializations.' + spec, spec) %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label class="form-label" for="testDescription"><%= __('tests.description') %></label>
                        <textarea id="testDescription" name="description" class="form-textarea" placeholder="<%= __('tests.descriptionPlaceholder') %>"></textarea>
                    </div>
                    <div class="form-group full-width">
                        <label class="form-label" for="testInstructions"><%= __('tests.specialInstructions') %></label>
                        <textarea id="testInstructions" name="instructions" class="form-textarea" placeholder="<%= __('tests.instructionsPlaceholder') %>"></textarea>
                    </div>
                    <div class="form-group full-width">
                        <label class="form-label" for="testImage">صورة الفحص (اختياري)</label>
                        <input type="file" id="testImage" name="image" class="form-input" accept="image/*">
                        <div class="icon-hint">
                            إذا أضفت صورة ستظهر في التطبيق بدل أيقونة الأنبوب
                        </div>
                        <div id="testImagePreviewWrap" style="display:none;margin-top:10px;align-items:center;gap:10px;">
                            <img id="testImagePreview" src="" alt="preview" style="width:56px;height:56px;border-radius:var(--r-sm);object-fit:cover;border:1px solid #e5e7eb;">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="clearTestImage()">إزالة الصورة</button>
                        </div>
                        <input type="hidden" id="removeTestImage" name="removeImage" value="false">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()"><%= __('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary">
                        <svg class="ic"><use href="#i-save"/></svg>
                        <%= __('common.save') %>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentEditingId = null;
        let testsData = [];
        let tableRowsData = [];
        let currentView = 'grid';
        let existingTestImage = null;

        function clearTestImage() {
            const input = document.getElementById('testImage');
            input.value = '';
            existingTestImage = null;
            document.getElementById('removeTestImage').value = 'true';
            document.getElementById('testImagePreviewWrap').style.display = 'none';
            document.getElementById('testImagePreview').src = '';
        }

        function showTestImagePreview(url) {
            if (!url) {
                document.getElementById('testImagePreviewWrap').style.display = 'none';
                return;
            }
            document.getElementById('testImagePreview').src = url;
            document.getElementById('testImagePreviewWrap').style.display = 'flex';
            document.getElementById('removeTestImage').value = 'false';
        }

        document.getElementById('testImage')?.addEventListener('change', function () {
            const file = this.files?.[0];
            if (!file) return;
            document.getElementById('removeTestImage').value = 'false';
            showTestImagePreview(URL.createObjectURL(file));
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Store test data for filtering
            testsData = Array.from(document.querySelectorAll('.test-card'));
            tableRowsData = Array.from(document.querySelectorAll('.test-row'));

            // Load saved view preference
            const savedView = localStorage.getItem('labTestsView');
            if (savedView) {
                setView(savedView);
            }
        });

        function setView(view) {
            currentView = view;
            const grid = document.getElementById('testsGrid');
            const table = document.getElementById('testsTable');
            const viewBtns = document.querySelectorAll('.view-btn');

            // Update button states
            viewBtns.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.view === view);
            });

            // Toggle views
            if (view === 'grid') {
                grid.classList.remove('hidden');
                table.classList.remove('active');
            } else {
                grid.classList.add('hidden');
                table.classList.add('active');
            }

            // Save preference
            localStorage.setItem('labTestsView', view);
        }

        function showAddTestModal() {
            currentEditingId = null;
            existingTestImage = null;
            document.getElementById('modalTitle').textContent = '<%= __("tests.addNewTest") %>';
            document.getElementById('testForm').reset();
            clearTestImage();
            document.getElementById('removeTestImage').value = 'false';
            document.getElementById('testModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function editTest(testId) {
            currentEditingId = testId;
            document.getElementById('modalTitle').textContent = '<%= __("tests.editTest") %>';

            // Fetch test data from backend
            fetch(`/lab/api/tests/${testId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const test = data.test;

                        // Populate form with fetched data
                        document.getElementById('testNameAr').value = test.nameAr || '';
                        document.getElementById('testName').value = test.name || '';
                        document.getElementById('testPrice').value = Math.round(test.price) || '';
                        document.getElementById('testCategory').value = test.category || '';
                        document.getElementById('testDescription').value = test.description || '';
                        document.getElementById('testInstructions').value = test.instructions || '';
                        document.getElementById('testImage').value = '';
                        existingTestImage = test.image || null;
                        document.getElementById('removeTestImage').value = 'false';
                        showTestImagePreview(existingTestImage);

                        // Show modal
                        document.getElementById('testModal').classList.add('active');
                        document.body.style.overflow = 'hidden';
                    } else {
                        showNotification(data.message || 'Error loading test data', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error fetching test data:', error);
                    showNotification('Error loading test data', 'error');
                });
        }

        function viewTestDetails(testId) {
            // Implement view details functionality
            window.location.href = `/lab/tests/${testId}`;
        }

        function deleteTest(testId) {
            if (confirm('<%= __("tests.confirmDelete") %>')) {
                // Send delete request to backend
                fetch(`/lab/api/tests/${testId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Remove from UI
                        const testCard = document.querySelector(`[onclick="deleteTest('${testId}')"]`).closest('.test-card');
                        testCard.style.transform = 'scale(0.9)';
                        testCard.style.opacity = '0.5';

                        setTimeout(() => {
                            testCard.remove();
                            checkEmptyState();
                        }, 300);
                    } else {
                        alert(data.message || 'Error deleting test');
                    }
                })
                .catch(error => {
                    console.error('Error deleting test:', error);
                    alert('Error deleting test');
                });
            }
        }

        function closeModal() {
            document.getElementById('testModal').classList.remove('active');
            document.body.style.overflow = 'auto';
            document.getElementById('testForm').reset();
            clearTestImage();
            document.getElementById('removeTestImage').value = 'false';
            currentEditingId = null;
            existingTestImage = null;
        }

        function saveTest(event) {
            event.preventDefault();

            const form = event.target;
            const formData = new FormData(form);
            // Keep removeImage flag even when no new file selected
            formData.set('removeImage', document.getElementById('removeTestImage').value);

            const url = currentEditingId ? `/lab/api/tests/${currentEditingId}` : '/lab/api/tests';
            const method = currentEditingId ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const successMessage = currentEditingId ? '<%= __("tests.testUpdated") %>' : '<%= __("tests.testAdded") %>';

                    // Show success notification
                    showNotification(successMessage, 'success');

                    // Reload page to show updated data
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);

                    closeModal();
                } else {
                    showNotification(data.message || 'Error saving test', 'error');
                }
            })
            .catch(error => {
                console.error('Error saving test:', error);
                showNotification('Error saving test', 'error');
            });
        }

        function showNotification(message, type = 'success') {
            // App-style dark pill toast (shared helper from the navbar partial)
            if (window.laToast) window.laToast(message);
        }

        function filterTests() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value;

            // Filter grid cards
            testsData.forEach(card => {
                const matchesSearch = card.dataset.name.includes(searchTerm) ||
                                     card.querySelector('.test-description')?.textContent.toLowerCase().includes(searchTerm);
                const matchesCategory = !categoryFilter || card.dataset.category === categoryFilter;

                if (matchesSearch && matchesCategory) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            // Filter table rows
            tableRowsData.forEach(row => {
                const matchesSearch = row.dataset.name.includes(searchTerm) ||
                                     row.querySelector('.table-description')?.textContent.toLowerCase().includes(searchTerm);
                const matchesCategory = !categoryFilter || row.dataset.category === categoryFilter;

                if (matchesSearch && matchesCategory) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            checkEmptyState();
        }

        function sortTests() {
            const sortBy = document.getElementById('sortBy').value;
            const grid = document.getElementById('testsGrid');
            const cards = Array.from(grid.querySelectorAll('.test-card'));

            cards.sort((a, b) => {
                switch(sortBy) {
                    case 'name':
                        return a.dataset.name.localeCompare(b.dataset.name);
                    case 'price-low':
                        return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                    case 'price-high':
                        return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                    case 'category':
                        return a.dataset.category.localeCompare(b.dataset.category);
                    case 'recent':
                        // For demo purposes, just reverse the order
                        return -1;
                    default:
                        return 0;
                }
            });

            // Re-append sorted cards
            cards.forEach(card => grid.appendChild(card));
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = '';
            document.getElementById('sortBy').value = 'name';

            testsData.forEach(card => {
                card.style.display = 'block';
            });
        }

        function checkEmptyState() {
            const grid = document.getElementById('testsGrid');
            const visibleCards = grid.querySelectorAll('.test-card:not([style*="display: none"])');
            const existingEmptyState = grid.querySelector('.empty-state');

            if (visibleCards.length === 0 && !existingEmptyState) {
                const emptyState = document.createElement('div');
                emptyState.className = 'empty-state';
                emptyState.style.cssText = 'grid-column: 1 / -1;';
                emptyState.innerHTML = `
                    <div class="empty-state-icon">
                        <svg class="ic"><use href="#i-search"/></svg>
                    </div>
                    <h3 class="empty-state-title"><%= __("tests.noTestsFound") %></h3>
                    <p class="empty-state-description"><%= __("tests.noTestsFoundDescription") %></p>
                    <button class="btn btn-primary" onclick="resetFilters()">
                        <svg class="ic"><use href="#i-rotate-cw"/></svg>
                        <%= __("tests.reset") %> <%= __("common.filter") %>
                    </button>
                `;
                grid.appendChild(emptyState);
            } else if (visibleCards.length > 0 && existingEmptyState) {
                existingEmptyState.remove();
            }
        }

        function exportTests() {
            // Export tests to CSV
            window.location.href = '/lab/api/tests/export';
        }

        function importTests() {
            // Initialize import modal event listeners
            initializeImportModal();
            // Show import modal
            document.getElementById('importModal').style.display = 'flex';
        }

        function uploadTests() {
            const fileInput = document.getElementById('importFileInput');
            const file = fileInput.files[0];

            if (!file) {
                alert('Please select a file');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            // Show loading state
            const uploadBtn = document.querySelector('.upload-btn');
            uploadBtn.disabled = true;
            uploadBtn.innerHTML = '<svg class="ic la-spin"><use href="#i-loader-circle"/></svg> Uploading...';

            fetch('/lab/api/tests/import', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showImportResults(data.results);
                    // Refresh page after short delay
                    setTimeout(() => location.reload(), 3000);
                } else {
                    alert('Error: ' + data.message);
                    uploadBtn.disabled = false;
                    uploadBtn.innerHTML = 'Upload';
                }
            })
            .catch(error => {
                alert('Error uploading file: ' + error.message);
                uploadBtn.disabled = false;
                uploadBtn.innerHTML = 'Upload';
            });
        }

        function showImportResults(results) {
            const modal = document.getElementById('importModal');
            const content = modal.querySelector('.modal-content');

            let html = `
                <div class="import-results">
                    <h2><svg class="ic" style="color: #10b981;"><use href="#i-circle-check"/></svg> Import Complete!</h2>
                    <div class="results-summary">
                        <div class="result-item success">
                            <svg class="ic"><use href="#i-circle-plus"/></svg>
                            <span>${results.success.length} tests added</span>
                        </div>
                        <div class="result-item warning">
                            <svg class="ic"><use href="#i-triangle-alert"/></svg>
                            <span>${results.skipped.length} skipped (already exist)</span>
                        </div>
                        ${results.errors.length > 0 ? `
                        <div class="result-item error">
                            <svg class="ic"><use href="#i-circle-x"/></svg>
                            <span>${results.errors.length} errors</span>
                        </div>
                        ` : ''}
                    </div>
                    ${results.errors.length > 0 ? `
                    <div class="errors-list">
                        <h4>Errors:</h4>
                        ${results.errors.slice(0, 10).map(e =>
                            `<div>Row ${e.row}: ${e.message}</div>`
                        ).join('')}
                        ${results.errors.length > 10 ? `<div>...and ${results.errors.length - 10} more</div>` : ''}
                    </div>
                    ` : ''}
                    <button class="btn btn-primary" onclick="location.reload()">Done</button>
                </div>
            `;

            content.innerHTML = html;
        }

        function closeImportModal() {
            document.getElementById('importModal').style.display = 'none';
        }

        // Close modal when clicking outside
        document.getElementById('testModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideInRight {
                from {
                    transform: translateX(100%);
                    opacity: 0;
                }
                to {
                    transform: translateX(0);
                    opacity: 1;
                }
            }

            @keyframes slideOutRight {
                from {
                    transform: translateX(0);
                    opacity: 1;
                }
                to {
                    transform: translateX(100%);
                    opacity: 0;
                }
            }

            .notification {
                animation: slideInRight 0.3s ease;
            }
        `;
        document.head.appendChild(style);

        // Import modal elements will be initialized when importTests() is called
        let uploadArea = null;
        let fileInput = null;

        function initializeImportModal() {
            uploadArea = document.getElementById('uploadArea');
            fileInput = document.getElementById('importFileInput');

            if (!uploadArea || !fileInput) return;

            // Remove existing listeners to avoid duplicates
            uploadArea.removeEventListener('click', handleUploadClick);

            // Add click listener
            uploadArea.addEventListener('click', handleUploadClick);

            // Add drag-and-drop listeners
            uploadArea.addEventListener('dragover', handleDragOver);
            uploadArea.addEventListener('dragleave', handleDragLeave);
            uploadArea.addEventListener('drop', handleDrop);

            // Add change listener to file input
            fileInput.addEventListener('change', handleFileSelect);
        }

        function handleUploadClick() {
            if (fileInput) fileInput.click();
        }

        function handleDragOver(e) {
            e.preventDefault();
            uploadArea.style.borderColor = '#5568d3';
            uploadArea.style.background = '#f8f9ff';
        }

        function handleDragLeave() {
            uploadArea.style.borderColor = '#667eea';
            uploadArea.style.background = '';
        }

        function handleDrop(e) {
            e.preventDefault();
            uploadArea.style.borderColor = '#667eea';
            uploadArea.style.background = '';

            const files = e.dataTransfer.files;
            if (files.length > 0 && fileInput) {
                fileInput.files = files;
                document.getElementById('fileInfo').textContent = files[0].name;
            }
        }

        function handleFileSelect() {
            if (fileInput && fileInput.files.length > 0) {
                document.getElementById('fileInfo').textContent = fileInput.files[0].name;
            }
        }
    </script>

    <!-- Import Modal -->
    <div id="importModal" class="modal" style="display: none;">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h2><svg class="ic"><use href="#i-file-spreadsheet"/></svg> Import Tests</h2>
                <button class="close-btn" onclick="closeImportModal()" aria-label="close"><svg class="ic"><use href="#i-x"/></svg></button>
            </div>
            <div class="modal-body">
                <div class="upload-area" id="uploadArea">
                    <svg class="ic"><use href="#i-upload"/></svg>
                    <h3>Drop your Excel file here</h3>
                    <p>or click to browse</p>
                    <input type="file" id="importFileInput" accept=".xls,.xlsx,.csv" style="display: none;">
                    <p class="file-info" id="fileInfo"></p>
                </div>
                <div class="format-info">
                    <h4>Expected Format:</h4>
                    <table class="format-table">
                        <thead>
                            <tr>
                                <th>name</th>
                                <th>price</th>
                                <th>category</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Blood Test A</td>
                                <td>15000</td>
                                <td>Blood Tests</td>
                            </tr>
                            <tr>
                                <td>X-Ray Chest</td>
                                <td>25000</td>
                                <td>X-Ray</td>
                            </tr>
                        </tbody>
                    </table>
                    <small>Valid categories: Blood Tests, X-Ray, MRI, CT Scan, Ultrasound, Pathology, Microbiology, Biochemistry, Genetics, Allergy, Cardiology, Neurology, General</small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeImportModal()">Cancel</button>
                <button class="btn btn-primary upload-btn" onclick="uploadTests()">Upload</button>
            </div>
        </div>
    </div>



        </main>
    </div>
</body>
</html>
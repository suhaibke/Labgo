<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/lab-order-details.css">
</head>

<body>
    <!-- Lab Navbar -->
    <%- include('../partials/lab-navbar') %>

        <!-- Main Content -->
        <div class="lab-wrapper">
            <main class="lab-orders-page">
                <div class="order-details-container">
                    <!-- Page Header -->
                    <div class="page-header">
                        <div class="header-left">
                            <button class="back-btn" onclick="goBack()">
                                <svg class="ic flip-rtl"><use href="#i-arrow-left"/></svg>
                                <span>
                                    <%= __('common.back') %>
                                </span>
                            </button>
                            <div class="header-title">
                                <h1>
                                    <%= __('orders.orderDetails') %>
                                </h1>
                                <p class="order-subtitle">
                                    <%= order.qrCode %>
                                </p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <% if (order.status==='sample_collected' ) { %>
                                <button class="modern-btn receive-btn" onclick="receiveSample()">
                                    <svg class="ic"><use href="#i-check"/></svg>
                                    <span>
                                        <%= __('labOrders.receiveSample') || 'Receive Sample' %>
                                    </span>
                                </button>
                                <% } %>
                                    <% if (order.status==='at_lab' ) { %>
                                        <button class="modern-btn complete-btn" onclick="openUploadModal()">
                                            <svg class="ic"><use href="#i-upload"/></svg>
                                            <span>
                                                <%= __('labOrders.completeOrder') || 'Complete Order' %>
                                            </span>
                                        </button>
                                        <% } %>
                                            <button class="modern-btn print-btn" onclick="window.print()">
                                                <svg class="ic"><use href="#i-printer"/></svg>
                                            </button>
                                            <% if (!externalTransfer && order.status !== 'cancelled' && order.status !== 'completed') { %>
                                                <a class="modern-btn send-to-lab-btn" href="/lab/external-transfers?orderId=<%= order._id %>" >
                                                    <svg class="ic"><use href="#i-share-2"/></svg>
                                                    <span><%= __('labOrders.sendToAnotherLab') || 'Send to Another Lab' %></span>
                                                </a>
                                            <% } else if (externalTransfer) { %>
                                                <a class="modern-btn send-to-lab-btn" href="/lab/external-transfers" data-variant="soft">
                                                    <svg class="ic"><use href="#i-arrow-left-right"/></svg>
                                                    <span><%= __('navigation.externalTransfers') %></span>
                                                </a>
                                            <% } %>
                        </div>
                    </div>

                    <% if (externalTransfer) { %>
                    <div class="sent-to-lab-card" id="sentToLabCard">
                        <div class="sent-to-lab-header">
                            <div class="sent-to-lab-icon">
                                <svg class="ic"><use href="#i-share-2"/></svg>
                            </div>
                            <h3><%= __('labOrders.sentToAnotherLab') || 'تم الإرسال إلى مختبر آخر' %></h3>
                        </div>
                        <div class="sent-to-lab-body">
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.labName') %>:</span>
                                <span class="sent-to-lab-value"><%= externalTransfer.externalLab?.name %></span>
                            </div>
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.sentAt') %>:</span>
                                <span class="sent-to-lab-value"><%= new Date(externalTransfer.sentAt).toLocaleDateString(currentLang) %></span>
                            </div>
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.status') %>:</span>
                                <span class="sent-to-lab-value"><%= externalTransfer.status === 'completed' ? __('externalTransfers.statusCompleted') : __('externalTransfers.statusSent') %></span>
                            </div>
                            <a class="sent-to-lab-link" href="/lab/external-transfers"><%= __('navigation.externalTransfers') %> <svg class="ic flip-ltr"><use href="#i-arrow-left"/></svg></a>
                        </div>
                    </div>
                    <% } %>

                    <div class="details-grid">
                        <!-- Hero Section -->
                        <div class="detail-card hero-section">
                            <div class="hero-qr">
                                <div class="qr-code-display">
                                    <svg class="ic"><use href="#i-qr-code"/></svg>
                                    <span class="qr-text">
                                        <%= order.qrCode %>
                                    </span>
                                </div>
                                <div class="hero-info">
                                    <h2>
                                        <%= order.tests?.length || 0 %>
                                            <%= __('common.tests') %>
                                    </h2>
                                    <div class="hero-date">
                                        <svg class="ic"><use href="#i-calendar"/></svg>
                                        <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
                                            •
                                            <%= new Date(order.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit'
                                                , minute: '2-digit' }) %>
                                    </div>
                                </div>
                            </div>
                            <div class="hero-status">
                                <span class="status-badge <%= order.status %>">
                                    <%= order.status==='pending' ? __('orders.statusValues.pending') :
                                        order.status==='confirmed' ? __('orders.statusValues.confirmed') :
                                        order.status==='nurse_assigned' ? __('orders.statusValues.nurseAssigned') :
                                        order.status==='sample_collected' ? __('orders.statusValues.sampleCollected') :
                                        order.status==='at_lab' ? __('orders.statusValues.atLab') :
                                        order.status==='completed' ? __('orders.statusValues.completed') :
                                        order.status==='cancelled' ? __('orders.statusValues.cancelled') : order.status
                                        %>
                                </span>
                            </div>
                        </div>

                        <!-- Patient Info -->
                        <div class="detail-card">
                            <div class="card-header">
                                <div class="header-icon blue">
                                    <svg class="ic"><use href="#i-user"/></svg>
                                </div>
                                <h3>
                                    <%= __('labOrderDetails.patientInfo') || 'Patient Information' %>
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="info-row">
                                    <span class="label">
                                        <%= __('orders.name') || 'Name' %>
                                    </span>
                                    <span class="value">
                                        <%= patientInfo.name || '-' %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label"><%= __('common.gender') %></span>
                                    <span class="value">
                                        <%= patientInfo.gender === 'male' ? __('common.male') :
                                            patientInfo.gender === 'female' ? __('common.female') : __('common.notAvailable') %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label"><%= __('common.age') %></span>
                                    <span class="value">
                                        <%= Number.isInteger(patientInfo.age) ? `${patientInfo.age} ${__('common.years')}` : __('common.notAvailable') %>
                                    </span>
                                </div>
                                <% if (patientInfo.birthDate) { %>
                                    <div class="info-row">
                                        <span class="label"><%= __('auth.register.birthDate') %></span>
                                        <span class="value"><%= new Date(patientInfo.birthDate).toLocaleDateString(currentLang) %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Nurse Info -->
                        <% if (order.nurseId) { %>
                            <div class="detail-card">
                                <div class="card-header">
                                    <div class="header-icon purple">
                                        <svg class="ic"><use href="#i-stethoscope"/></svg>
                                    </div>
                                    <h3>
                                        <%= __('labOrderDetails.nurseInfo') || 'Nurse Information' %>
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="info-row">
                                        <span class="label">
                                            <%= __('orders.name') || 'Name' %>
                                        </span>
                                        <span class="value">
                                            <%= order.nurseId?.name || '-' %>
                                        </span>
                                    </div>
                                    <% if (order.nurseAssignment?.acceptedAt) { %>
                                        <div class="info-row">
                                            <span class="label">
                                                <%= __('orders.assignedAt') || 'Assigned At' %>
                                            </span>
                                            <span class="value">
                                                <%= new Date(order.nurseAssignment.acceptedAt).toLocaleDateString() %>
                                            </span>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% } %>

                                <!-- Beneficiary Info -->
                                <% if (order.beneficiary?.isForOtherPerson) { %>
                                    <div class="detail-card">
                                        <div class="card-header">
                                            <div class="header-icon teal">
                                                <svg class="ic"><use href="#i-user-plus"/></svg>
                                            </div>
                                            <h3>
                                                <%= __('labOrderDetails.beneficiary') || 'Beneficiary' %>
                                            </h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="info-row">
                                                <span class="label">
                                                    <%= __('orders.name') || 'Name' %>
                                                </span>
                                                <span class="value">
                                                    <%= order.beneficiary.name || '-' %>
                                                </span>
                                            </div>
                                            <% if (order.beneficiary.gender) { %>
                                                <div class="info-row">
                                                    <span class="label">
                                                        <%= __('orders.gender') || 'Gender' %>
                                                    </span>
                                                    <span class="value">
                                                        <%= order.beneficiary.gender %>
                                                    </span>
                                                </div>
                                                <% } %>
                                                    <% if (order.beneficiary.relationship) { %>
                                                        <div class="info-row">
                                                            <span class="label">
                                                                <%= __('orders.relationship') || 'Relationship' %>
                                                            </span>
                                                            <span class="value">
                                                                <%= order.beneficiary.relationship %>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Tests -->
                                        <div class="detail-card">
                                            <div class="card-header">
                                                <div class="header-icon green">
                                                    <svg class="ic"><use href="#i-test-tube"/></svg>
                                                </div>
                                                <h3>
                                                    <%= __('common.tests') %> (<%= order.tests?.length || 0 %>)
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="tests-list">
                                                    <% if (order.tests && order.tests.length> 0) { %>
                                                        <% order.tests.forEach(test=> { %>
                                                            <div class="test-item">
                                                                <span class="test-name">
                                                                    <svg class="ic"><use href="#i-flask-conical"/></svg>
                                                                    <%= test.testName %>
                                                                </span>
                                                                <span class="test-price">
                                                                    <%= new Intl.NumberFormat('en-IQ', {
                                                                        style: 'currency' , currency: 'IQD' ,
                                                                        maximumFractionDigits: 0 }).format(test.price)
                                                                        %>
                                                                </span>
                                                            </div>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <p class="la-empty">—</p>
                                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Pricing -->
                                        <div class="detail-card">
                                            <div class="card-header">
                                                <div class="header-icon orange">
                                                    <svg class="ic"><use href="#i-receipt"/></svg>
                                                </div>
                                                <h3>
                                                    <%= __('labOrderDetails.pricing') || 'Pricing' %>
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <% const orderTotal=order.pricing?.total || 0; const
                                                    commissionRate=order.financials?.labCommissionRate ||
                                                    lab.commissionRate || 0; const appCommission=Math.round(orderTotal *
                                                    (commissionRate / 100)); const labTotal=orderTotal - appCommission;
                                                    %>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.orderPrice') || 'Order Price' %>
                                                        </span>
                                                        <span class="value">
                                                            <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(orderTotal) %>
                                                        </span>
                                                    </div>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.appCommission') || 'App Commission'
                                                                %> (<%= commissionRate %>%)
                                                        </span>
                                                        <span class="value" style="color: var(--red);">
                                                            - <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(appCommission) %>
                                                        </span>
                                                    </div>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('orders.paymentStatus') || 'Payment Status' %>
                                                        </span>
                                                        <span class="value">
                                                            <span
                                                                class="status-badge <%= order.payment?.status === 'paid' ? 'completed' : 'pending' %>">
                                                                <%= order.payment?.status==='paid' ?
                                                                    __('orders.statusValues.completed') :
                                                                    __('orders.statusValues.pending') %>
                                                            </span>
                                                        </span>
                                                    </div>
                                                    <div class="pricing-total">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.labTotal') || 'Lab Total' %>
                                                        </span>
                                                        <span class="value">
                                                            <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(order.financials?.labAmount || labTotal) %>
                                                        </span>
                                                    </div>
                                            </div>
                                        </div>

                                        <!-- Order Timeline -->
                                        <div class="detail-card timeline-section">
                                            <div class="card-header">
                                                <div class="header-icon purple">
                                                    <svg class="ic"><use href="#i-history"/></svg>
                                                </div>
                                                <h3>
                                                    <%= __('labOrderDetails.timeline') || 'Order Timeline' %>
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="timeline">
                                                    <% if (order.statusHistory && order.statusHistory.length> 0) { %>
                                                        <% order.statusHistory.slice().reverse().forEach((history,
                                                            index)=> { %>
                                                            <div
                                                                class="timeline-item <%= index === 0 ? 'active' : 'completed' %>">
                                                                <div class="timeline-status">
                                                                    <%= history.status==='pending' ?
                                                                        __('orders.statusValues.pending') :
                                                                        history.status==='confirmed' ?
                                                                        __('orders.statusValues.confirmed') :
                                                                        history.status==='nurse_assigned' ?
                                                                        __('orders.statusValues.nurseAssigned') :
                                                                        history.status==='sample_collected' ?
                                                                        __('orders.statusValues.sampleCollected') :
                                                                        history.status==='at_lab' ?
                                                                        __('orders.statusValues.atLab') :
                                                                        history.status==='completed' ?
                                                                        __('orders.statusValues.completed') :
                                                                        history.status==='cancelled' ?
                                                                        __('orders.statusValues.cancelled') :
                                                                        history.status %>
                                                                </div>
                                                                <div class="timeline-date">
                                                                    <%= new
                                                                        Date(history.timestamp).toLocaleDateString('en-GB',
                                                                        { day: '2-digit' , month: 'short' ,
                                                                        year: 'numeric' , hour: '2-digit' ,
                                                                        minute: '2-digit' }) %>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <div class="timeline-item active">
                                                                        <div class="timeline-status">
                                                                            <%= __('orders.statusValues.pending') %>
                                                                        </div>
                                                                        <div class="timeline-date">
                                                                            <%= new
                                                                                Date(order.createdAt).toLocaleDateString()
                                                                                %>
                                                                        </div>
                                                                    </div>
                                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Rating (if completed) -->
                                        <% if (order.status==='completed' && (order.rating?.labRating ||
                                            order.rating?.nurseRating)) { %>
                                            <div class="detail-card full-width">
                                                <div class="card-header">
                                                    <div class="header-icon orange">
                                                        <svg class="ic"><use href="#i-star"/></svg>
                                                    </div>
                                                    <h3>
                                                        <%= __('labOrderDetails.rating') || 'Rating' %>
                                                    </h3>
                                                </div>
                                                <div class="card-body">
                                                    <% if (order.rating?.labRating) { %>
                                                        <div class="info-row">
                                                            <span class="label">
                                                                <%= __('reports.lab') || 'Lab' %> Rating
                                                            </span>
                                                            <span class="value">
                                                                <div class="rating-stars">
                                                                    <% for (let i=1; i <=5; i++) { %>
                                                                        <svg class="ic star <%= i <= order.rating.labRating ? '' : 'empty' %>"><use href="#i-star"/></svg>
                                                                        <% } %>
                                                                </div>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                                            <% if (order.rating?.nurseRating) { %>
                                                                <div class="info-row">
                                                                    <span class="label">
                                                                        <%= __('reports.nurse') || 'Nurse' %> Rating
                                                                    </span>
                                                                    <span class="value">
                                                                        <div class="rating-stars">
                                                                            <% for (let i=1; i <=5; i++) { %>
                                                                                <svg class="ic star <%= i <= order.rating.nurseRating ? '' : 'empty' %>"><use href="#i-star"/></svg>
                                                                                <% } %>
                                                                        </div>
                                                                    </span>
                                                                </div>
                                                                <% } %>
                                                                    <% if (order.rating?.feedback) { %>
                                                                        <div class="info-row">
                                                                            <span class="label">
                                                                                <%= __('labOrderDetails.feedback')
                                                                                    || 'Feedback' %>
                                                                            </span>
                                                                            <span class="value">
                                                                                <%= order.rating.feedback %>
                                                                            </span>
                                                                        </div>
                                                                        <% } %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- Result (if completed) -->
                                                <% if (order.status==='completed' && order.results?.reportUrl) { %>
                                                    <div class="detail-card full-width">
                                                        <div class="card-header">
                                                            <div class="header-icon green">
                                                                <svg class="ic"><use href="#i-file-check"/></svg>
                                                            </div>
                                                            <h3>
                                                                <%= __('labOrderDetails.result') || 'Test Result' %>
                                                            </h3>
                                                        </div>
                                                        <div class="card-body">
                                                            <a href="<%= order.results.reportUrl %>" target="_blank"
                                                                class="modern-btn complete-btn"
                                                                style="width: 100%; justify-content: center;">
                                                                <svg class="ic"><use href="#i-download"/></svg>
                                                                <%= __('labOrderDetails.viewResult')
                                                                    || 'View/Download Result' %>
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <% } %>
                    </div>
                </div>
            </main>
        </div>

        <!-- Upload Modal -->
        <div class="modal-overlay" id="uploadModal">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>
                        <%= __('labOrders.fileUpload.title') || 'Upload Test Result' %>
                    </h3>
                    <button class="modal-close" onclick="closeUploadModal()">
                        <svg class="ic"><use href="#i-x"/></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="uploadForm" enctype="multipart/form-data">
                        <div class="file-upload-area" id="fileUploadArea">
                            <label for="resultFile" style="cursor: pointer;">
                                <div class="upload-icon">
                                    <svg class="ic"><use href="#i-upload"/></svg>
                                </div>
                                <p>
                                    <%= __('labOrders.fileUpload.dragDrop') || 'Drag & drop or click to upload' %>
                                </p>
                                <p class="la-sub">PDF, JPG, PNG (max 5MB)</p>
                            </label>
                            <input type="file" id="resultFile" name="resultFile" accept=".pdf,.jpg,.jpeg,.png"
                                style="display: none;">
                        </div>
                        <div id="filePreview"
                            style="display: none;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="modern-btn print-btn" onclick="closeUploadModal()">
                        <%= __('common.cancel') %>
                    </button>
                    <button class="modern-btn complete-btn" id="confirmUploadBtn" disabled onclick="handleUpload()">
                        <svg class="ic"><use href="#i-check"/></svg>
                        <%= __('labOrders.completeOrder') || 'Complete Order' %>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast -->
        <div class="toast" id="toast"></div>

        <script>
            const orderId = '<%= order._id %>';
            const qrCode = '<%= order.qrCode %>';
            const API_BASE = '/lab/api';

            function goBack() {
                if (document.referrer && document.referrer.includes('/lab/')) {
                    window.history.back();
                } else {
                    window.location.href = '/lab/orders';
                }
            }

            async function receiveSample() {
                try {
                    const response = await fetch(`${API_BASE}/orders/scan-qr`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ qrCode: qrCode })
                    });
                    const data = await response.json();
                    if (data.success) {
                        showToast('Sample received successfully', 'success');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        showToast(data.message || 'Error receiving sample', 'error');
                    }
                } catch (error) {
                    showToast('Error receiving sample', 'error');
                }
            }

            function openUploadModal() {
                document.getElementById('uploadModal').classList.add('active');
            }

            function closeUploadModal() {
                document.getElementById('uploadModal').classList.remove('active');
                document.getElementById('resultFile').value = '';
                document.getElementById('filePreview').style.display = 'none';
                document.getElementById('confirmUploadBtn').disabled = true;
            }

            document.getElementById('resultFile').addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        showToast('File too large (max 5MB)', 'error');
                        return;
                    }
                    document.getElementById('filePreview').style.display = 'block';
                    document.getElementById('filePreview').innerHTML = `
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <svg class="ic" style="width:24px;height:24px;color:var(--accent)"><use href="#i-file"/></svg>
                        <div>
                            <div style="font-weight: 500;">${file.name}</div>
                            <div style="font-size: 12px; color: #6b7280;">${(file.size / 1024).toFixed(1)} KB</div>
                        </div>
                    </div>
                `;
                    document.getElementById('confirmUploadBtn').disabled = false;
                }
            });

            async function handleUpload() {
                const file = document.getElementById('resultFile').files[0];
                if (!file) return;

                document.getElementById('confirmUploadBtn').disabled = true;

                try {
                    // Upload file
                    const formData = new FormData();
                    formData.append('resultFile', file);

                    const uploadResponse = await fetch(`${API_BASE}/orders/${orderId}/upload-result`, {
                        method: 'POST',
                        body: formData
                    });
                    const uploadData = await uploadResponse.json();

                    if (!uploadData.success) {
                        showToast(uploadData.message || 'Upload failed', 'error');
                        document.getElementById('confirmUploadBtn').disabled = false;
                        return;
                    }

                    // Complete order
                    const completeResponse = await fetch(`${API_BASE}/orders/${orderId}/complete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reportUrl: uploadData.data.fileUrl })
                    });
                    const completeData = await completeResponse.json();

                    if (completeData.success) {
                        showToast('Order completed successfully', 'success');
                        closeUploadModal();
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        showToast(completeData.message || 'Failed to complete order', 'error');
                        document.getElementById('confirmUploadBtn').disabled = false;
                    }
                } catch (error) {
                    showToast('Error completing order', 'error');
                    document.getElementById('confirmUploadBtn').disabled = false;
                }
            }

            function showToast(message, type = 'info') {
                const toast = document.getElementById('toast');
                toast.textContent = message;
                toast.className = `toast ${type} show`;
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3000);
            }
        </script>
</body>

</html>

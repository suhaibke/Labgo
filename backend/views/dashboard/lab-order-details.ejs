<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= __('orders.orderDetails') %> - <%= order.qrCode %>
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/lab-dashboard.css">
    <style>
        body {
            font-family: <%=font %>;
        }

        .order-details-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .back-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            color: #374151;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .back-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

        .header-title h1 {
            font-size: 24px;
            font-weight: 700;
            color: #1d1d1f;
            margin: 0;
        }

        .order-subtitle {
            color: #6b7280;
            font-size: 14px;
            margin: 4px 0 0 0;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .modern-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .receive-btn {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }

        .receive-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        }

        .complete-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .complete-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .print-btn {
            background: white;
            border: 1px solid #e5e7eb;
            color: #374151;
        }

        .print-btn:hover {
            background: #f9fafb;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-bottom: 24px;
        }

        .details-grid.two-cols {
            grid-template-columns: repeat(2, 1fr);
        }

        .detail-card {
            background: white;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            border-bottom: 1px solid #f3f4f6;
            background: #fafafa;
        }

        .header-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .header-icon.blue {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
        }

        .header-icon.green {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
        }

        .header-icon.purple {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
        }

        .header-icon.orange {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }

        .header-icon.red {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .header-icon.teal {
            background: rgba(20, 184, 166, 0.1);
            color: #14b8a6;
        }

        .card-header h3 {
            font-size: 16px;
            font-weight: 600;
            color: #1d1d1f;
            margin: 0;
        }

        .card-body {
            padding: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f3f4f6;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row .label {
            color: #6b7280;
            font-size: 14px;
        }

        .info-row .value {
            color: #1d1d1f;
            font-weight: 500;
            font-size: 14px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .status-badge.pending {
            background: #fef3c7;
            color: #d97706;
        }

        .status-badge.confirmed {
            background: #dbeafe;
            color: #2563eb;
        }

        .status-badge.nurse_assigned {
            background: #e0e7ff;
            color: #4f46e5;
        }

        .status-badge.sample_collected {
            background: #fce7f3;
            color: #db2777;
        }

        .status-badge.at_lab {
            background: #d1fae5;
            color: #059669;
        }

        .status-badge.completed {
            background: #dcfce7;
            color: #16a34a;
        }

        .status-badge.cancelled {
            background: #fee2e2;
            color: #dc2626;
        }

        .hero-section {
            grid-column: span 3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 24px 32px;
            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
            color: white;
        }

        .hero-qr {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .qr-code-display {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 16px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 12px;
        }

        .qr-code-display i {
            font-size: 48px;
        }

        .qr-text {
            font-family: 'Courier New', monospace;
            font-size: 16px;
            font-weight: 700;
        }

        .hero-info h2 {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

        .hero-date {
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.9;
            font-size: 14px;
        }

        .hero-status .status-badge {
            background: white;
            font-size: 14px;
            padding: 8px 16px;
        }

        .tests-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .test-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background: #f9fafb;
            border-radius: 10px;
        }

        .test-name {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 500;
            color: #1d1d1f;
        }

        .test-name i {
            color: #3b82f6;
        }

        .test-price {
            font-weight: 600;
            color: #059669;
        }

        .timeline-section .card-body {
            padding: 16px 20px;
        }

        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e5e7eb;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }

        .timeline-item:last-child {
            padding-bottom: 0;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -24px;
            top: 4px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #d1d5db;
            border: 2px solid white;
        }

        .timeline-item.active::before {
            background: #3b82f6;
        }

        .timeline-item.completed::before {
            background: #10b981;
        }

        .timeline-status {
            font-weight: 600;
            color: #1d1d1f;
            margin-bottom: 4px;
        }

        .timeline-date {
            font-size: 12px;
            color: #6b7280;
        }

        .pricing-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border-radius: 12px;
            color: white;
            margin-top: 12px;
        }

        .pricing-total .label {
            font-size: 16px;
            font-weight: 500;
        }

        .pricing-total .value {
            font-size: 24px;
            font-weight: 700;
        }

        .location-map-link {
            margin-top: 16px;
        }

        .location-map-link a {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .location-map-link a:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        .rating-stars {
            display: flex;
            gap: 4px;
        }

        .rating-stars i {
            color: #fbbf24;
            font-size: 18px;
        }

        .rating-stars i.empty {
            color: #d1d5db;
        }

        .full-width {
            grid-column: span 3;
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 24px;
            background: #1d1d1f;
            color: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 9999;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast.success {
            background: #10b981;
        }

        .toast.error {
            background: #ef4444;
        }

        /* Sent to Lab Card */
        .sent-to-lab-card {
            background: white;
            border-radius: 16px;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.2);
        }

        .sent-to-lab-header {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sent-to-lab-icon {
            width: 36px;
            height: 36px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
        }

        .sent-to-lab-header h3 {
            margin: 0;
            color: white;
            font-size: 16px;
            font-weight: 600;
            flex: 1;
        }

        .sent-to-lab-close {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            padding: 4px;
            opacity: 0.8;
            transition: opacity 0.2s;
        }

        .sent-to-lab-close:hover {
            opacity: 1;
        }

        .sent-to-lab-body {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .sent-to-lab-detail {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-inline-end: 20px;
        }

        .sent-to-lab-link {
            margin-inline-start: auto;
            color: #4f46e5;
            font-weight: 600;
            text-decoration: none;
        }

        .sent-to-lab-label {
            color: #6b7280;
            font-size: 14px;
        }

        .sent-to-lab-value {
            font-weight: 600;
            color: #6366f1;
            font-size: 16px;
        }

        .send-to-lab-btn {
            gap: 8px;
        }

        /* Upload Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9998;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: white;
            border-radius: 20px;
            width: 90%;
            max-width: 500px;
            overflow: hidden;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid #f3f4f6;
        }

        .modal-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 20px;
            color: #6b7280;
            cursor: pointer;
        }

        .modal-body {
            padding: 24px;
        }

        .file-upload-area {
            border: 2px dashed #d1d5db;
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .file-upload-area:hover,
        .file-upload-area.dragover {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.05);
        }

        .upload-icon {
            font-size: 48px;
            color: #3b82f6;
            margin-bottom: 16px;
        }

        .modal-footer {
            display: flex;
            gap: 12px;
            padding: 20px 24px;
            border-top: 1px solid #f3f4f6;
            justify-content: flex-end;
        }

        @media (max-width: 1024px) {
            .details-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero-section,
            .full-width {
                grid-column: span 2;
            }
        }

        @media (max-width: 768px) {
            .details-grid {
                grid-template-columns: 1fr;
            }

            .hero-section,
            .full-width {
                grid-column: span 1;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>
    <!-- Lab Navbar -->
    <%- include('../partials/lab-navbar') %>

        <!-- Main Content -->
        <div class="lab-wrapper">
            <main class="lab-orders-page">
                <div class="order-details-container">
                    <!-- Page Header -->
                    <div class="page-header">
                        <div class="header-left">
                            <button class="back-btn" onclick="goBack()">
                                <i class="fas fa-arrow-<%= direction === 'rtl' ? 'right' : 'left' %>"></i>
                                <span>
                                    <%= __('common.back') %>
                                </span>
                            </button>
                            <div class="header-title">
                                <h1>
                                    <%= __('orders.orderDetails') %>
                                </h1>
                                <p class="order-subtitle">
                                    <%= order.qrCode %>
                                </p>
                            </div>
                        </div>
                        <div class="header-actions">
                            <% if (order.status==='sample_collected' ) { %>
                                <button class="modern-btn receive-btn" onclick="receiveSample()">
                                    <i class="fas fa-check"></i>
                                    <span>
                                        <%= __('labOrders.receiveSample') || 'Receive Sample' %>
                                    </span>
                                </button>
                                <% } %>
                                    <% if (order.status==='at_lab' ) { %>
                                        <button class="modern-btn complete-btn" onclick="openUploadModal()">
                                            <i class="fas fa-upload"></i>
                                            <span>
                                                <%= __('labOrders.completeOrder') || 'Complete Order' %>
                                            </span>
                                        </button>
                                        <% } %>
                                            <button class="modern-btn print-btn" onclick="window.print()">
                                                <i class="fas fa-print"></i>
                                            </button>
                                            <% if (!externalTransfer && order.status !== 'cancelled' && order.status !== 'completed') { %>
                                                <a class="modern-btn send-to-lab-btn" href="/lab/external-transfers?orderId=<%= order._id %>" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; text-decoration: none;">
                                                    <i class="fas fa-share"></i>
                                                    <span><%= __('labOrders.sendToAnotherLab') || 'Send to Another Lab' %></span>
                                                </a>
                                            <% } else if (externalTransfer) { %>
                                                <a class="modern-btn send-to-lab-btn" href="/lab/external-transfers" style="background: #eef2ff; color: #4f46e5; text-decoration: none;">
                                                    <i class="fas fa-book-medical"></i>
                                                    <span><%= __('navigation.externalTransfers') %></span>
                                                </a>
                                            <% } %>
                        </div>
                    </div>

                    <% if (externalTransfer) { %>
                    <div class="sent-to-lab-card" id="sentToLabCard">
                        <div class="sent-to-lab-header">
                            <div class="sent-to-lab-icon">
                                <i class="fas fa-share"></i>
                            </div>
                            <h3><%= __('labOrders.sentToAnotherLab') || 'تم الإرسال إلى مختبر آخر' %></h3>
                        </div>
                        <div class="sent-to-lab-body">
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.labName') %>:</span>
                                <span class="sent-to-lab-value"><%= externalTransfer.externalLab?.name %></span>
                            </div>
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.sentAt') %>:</span>
                                <span class="sent-to-lab-value"><%= new Date(externalTransfer.sentAt).toLocaleDateString(currentLang) %></span>
                            </div>
                            <div class="sent-to-lab-detail">
                                <span class="sent-to-lab-label"><%= __('externalTransfers.status') %>:</span>
                                <span class="sent-to-lab-value"><%= externalTransfer.status === 'completed' ? __('externalTransfers.statusCompleted') : __('externalTransfers.statusSent') %></span>
                            </div>
                            <a class="sent-to-lab-link" href="/lab/external-transfers"><%= __('navigation.externalTransfers') %> <i class="fas fa-arrow-<%= direction === 'rtl' ? 'left' : 'right' %>"></i></a>
                        </div>
                    </div>
                    <% } %>

                    <div class="details-grid">
                        <!-- Hero Section -->
                        <div class="detail-card hero-section">
                            <div class="hero-qr">
                                <div class="qr-code-display">
                                    <i class="fas fa-qrcode"></i>
                                    <span class="qr-text">
                                        <%= order.qrCode %>
                                    </span>
                                </div>
                                <div class="hero-info">
                                    <h2>
                                        <%= order.tests?.length || 0 %>
                                            <%= __('common.tests') %>
                                    </h2>
                                    <div class="hero-date">
                                        <i class="far fa-calendar"></i>
                                        <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>
                                            •
                                            <%= new Date(order.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit'
                                                , minute: '2-digit' }) %>
                                    </div>
                                </div>
                            </div>
                            <div class="hero-status">
                                <span class="status-badge <%= order.status %>">
                                    <%= order.status==='pending' ? __('orders.statusValues.pending') :
                                        order.status==='confirmed' ? __('orders.statusValues.confirmed') :
                                        order.status==='nurse_assigned' ? __('orders.statusValues.nurseAssigned') :
                                        order.status==='sample_collected' ? __('orders.statusValues.sampleCollected') :
                                        order.status==='at_lab' ? __('orders.statusValues.atLab') :
                                        order.status==='completed' ? __('orders.statusValues.completed') :
                                        order.status==='cancelled' ? __('orders.statusValues.cancelled') : order.status
                                        %>
                                </span>
                            </div>
                        </div>

                        <!-- Patient Info -->
                        <div class="detail-card">
                            <div class="card-header">
                                <div class="header-icon blue">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h3>
                                    <%= __('labOrderDetails.patientInfo') || 'Patient Information' %>
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="info-row">
                                    <span class="label">
                                        <%= __('orders.name') || 'Name' %>
                                    </span>
                                    <span class="value">
                                        <%= patientInfo.name || '-' %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label"><%= __('common.gender') %></span>
                                    <span class="value">
                                        <%= patientInfo.gender === 'male' ? __('common.male') :
                                            patientInfo.gender === 'female' ? __('common.female') : __('common.notAvailable') %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label"><%= __('common.age') %></span>
                                    <span class="value">
                                        <%= Number.isInteger(patientInfo.age) ? `${patientInfo.age} ${__('common.years')}` : __('common.notAvailable') %>
                                    </span>
                                </div>
                                <% if (patientInfo.birthDate) { %>
                                    <div class="info-row">
                                        <span class="label"><%= __('auth.register.birthDate') %></span>
                                        <span class="value"><%= new Date(patientInfo.birthDate).toLocaleDateString(currentLang) %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Nurse Info -->
                        <% if (order.nurseId) { %>
                            <div class="detail-card">
                                <div class="card-header">
                                    <div class="header-icon purple">
                                        <i class="fas fa-user-nurse"></i>
                                    </div>
                                    <h3>
                                        <%= __('labOrderDetails.nurseInfo') || 'Nurse Information' %>
                                    </h3>
                                </div>
                                <div class="card-body">
                                    <div class="info-row">
                                        <span class="label">
                                            <%= __('orders.name') || 'Name' %>
                                        </span>
                                        <span class="value">
                                            <%= order.nurseId?.name || '-' %>
                                        </span>
                                    </div>
                                    <% if (order.nurseAssignment?.acceptedAt) { %>
                                        <div class="info-row">
                                            <span class="label">
                                                <%= __('orders.assignedAt') || 'Assigned At' %>
                                            </span>
                                            <span class="value">
                                                <%= new Date(order.nurseAssignment.acceptedAt).toLocaleDateString() %>
                                            </span>
                                        </div>
                                        <% } %>
                                </div>
                            </div>
                            <% } %>

                                <!-- Beneficiary Info -->
                                <% if (order.beneficiary?.isForOtherPerson) { %>
                                    <div class="detail-card">
                                        <div class="card-header">
                                            <div class="header-icon teal">
                                                <i class="fas fa-user-plus"></i>
                                            </div>
                                            <h3>
                                                <%= __('labOrderDetails.beneficiary') || 'Beneficiary' %>
                                            </h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="info-row">
                                                <span class="label">
                                                    <%= __('orders.name') || 'Name' %>
                                                </span>
                                                <span class="value">
                                                    <%= order.beneficiary.name || '-' %>
                                                </span>
                                            </div>
                                            <% if (order.beneficiary.gender) { %>
                                                <div class="info-row">
                                                    <span class="label">
                                                        <%= __('orders.gender') || 'Gender' %>
                                                    </span>
                                                    <span class="value">
                                                        <%= order.beneficiary.gender %>
                                                    </span>
                                                </div>
                                                <% } %>
                                                    <% if (order.beneficiary.relationship) { %>
                                                        <div class="info-row">
                                                            <span class="label">
                                                                <%= __('orders.relationship') || 'Relationship' %>
                                                            </span>
                                                            <span class="value">
                                                                <%= order.beneficiary.relationship %>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Tests -->
                                        <div class="detail-card">
                                            <div class="card-header">
                                                <div class="header-icon green">
                                                    <i class="fas fa-vial"></i>
                                                </div>
                                                <h3>
                                                    <%= __('common.tests') %> (<%= order.tests?.length || 0 %>)
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="tests-list">
                                                    <% if (order.tests && order.tests.length> 0) { %>
                                                        <% order.tests.forEach(test=> { %>
                                                            <div class="test-item">
                                                                <span class="test-name">
                                                                    <i class="fas fa-flask"></i>
                                                                    <%= test.testName %>
                                                                </span>
                                                                <span class="test-price">
                                                                    <%= new Intl.NumberFormat('en-IQ', {
                                                                        style: 'currency' , currency: 'IQD' ,
                                                                        maximumFractionDigits: 0 }).format(test.price)
                                                                        %>
                                                                </span>
                                                            </div>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <p style="color: #6b7280; text-align: center;">No
                                                                        tests</p>
                                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Pricing -->
                                        <div class="detail-card">
                                            <div class="card-header">
                                                <div class="header-icon orange">
                                                    <i class="fas fa-receipt"></i>
                                                </div>
                                                <h3>
                                                    <%= __('labOrderDetails.pricing') || 'Pricing' %>
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <% const orderTotal=order.pricing?.total || 0; const
                                                    commissionRate=order.financials?.labCommissionRate ||
                                                    lab.commissionRate || 0; const appCommission=Math.round(orderTotal *
                                                    (commissionRate / 100)); const labTotal=orderTotal - appCommission;
                                                    %>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.orderPrice') || 'Order Price' %>
                                                        </span>
                                                        <span class="value">
                                                            <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(orderTotal) %>
                                                        </span>
                                                    </div>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.appCommission') || 'App Commission'
                                                                %> (<%= commissionRate %>%)
                                                        </span>
                                                        <span class="value" style="color: #ef4444;">
                                                            - <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(appCommission) %>
                                                        </span>
                                                    </div>
                                                    <div class="info-row">
                                                        <span class="label">
                                                            <%= __('orders.paymentStatus') || 'Payment Status' %>
                                                        </span>
                                                        <span class="value">
                                                            <span
                                                                class="status-badge <%= order.payment?.status === 'paid' ? 'completed' : 'pending' %>">
                                                                <%= order.payment?.status==='paid' ?
                                                                    __('orders.statusValues.completed') :
                                                                    __('orders.statusValues.pending') %>
                                                            </span>
                                                        </span>
                                                    </div>
                                                    <div class="pricing-total">
                                                        <span class="label">
                                                            <%= __('labOrderDetails.labTotal') || 'Lab Total' %>
                                                        </span>
                                                        <span class="value">
                                                            <%= new Intl.NumberFormat('en-IQ', { style: 'currency' ,
                                                                currency: 'IQD' , maximumFractionDigits: 0
                                                                }).format(order.financials?.labAmount || labTotal) %>
                                                        </span>
                                                    </div>
                                            </div>
                                        </div>

                                        <!-- Order Timeline -->
                                        <div class="detail-card timeline-section">
                                            <div class="card-header">
                                                <div class="header-icon purple">
                                                    <i class="fas fa-history"></i>
                                                </div>
                                                <h3>
                                                    <%= __('labOrderDetails.timeline') || 'Order Timeline' %>
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="timeline">
                                                    <% if (order.statusHistory && order.statusHistory.length> 0) { %>
                                                        <% order.statusHistory.slice().reverse().forEach((history,
                                                            index)=> { %>
                                                            <div
                                                                class="timeline-item <%= index === 0 ? 'active' : 'completed' %>">
                                                                <div class="timeline-status">
                                                                    <%= history.status==='pending' ?
                                                                        __('orders.statusValues.pending') :
                                                                        history.status==='confirmed' ?
                                                                        __('orders.statusValues.confirmed') :
                                                                        history.status==='nurse_assigned' ?
                                                                        __('orders.statusValues.nurseAssigned') :
                                                                        history.status==='sample_collected' ?
                                                                        __('orders.statusValues.sampleCollected') :
                                                                        history.status==='at_lab' ?
                                                                        __('orders.statusValues.atLab') :
                                                                        history.status==='completed' ?
                                                                        __('orders.statusValues.completed') :
                                                                        history.status==='cancelled' ?
                                                                        __('orders.statusValues.cancelled') :
                                                                        history.status %>
                                                                </div>
                                                                <div class="timeline-date">
                                                                    <%= new
                                                                        Date(history.timestamp).toLocaleDateString('en-GB',
                                                                        { day: '2-digit' , month: 'short' ,
                                                                        year: 'numeric' , hour: '2-digit' ,
                                                                        minute: '2-digit' }) %>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <div class="timeline-item active">
                                                                        <div class="timeline-status">
                                                                            <%= __('orders.statusValues.pending') %>
                                                                        </div>
                                                                        <div class="timeline-date">
                                                                            <%= new
                                                                                Date(order.createdAt).toLocaleDateString()
                                                                                %>
                                                                        </div>
                                                                    </div>
                                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Rating (if completed) -->
                                        <% if (order.status==='completed' && (order.rating?.labRating ||
                                            order.rating?.nurseRating)) { %>
                                            <div class="detail-card full-width">
                                                <div class="card-header">
                                                    <div class="header-icon orange">
                                                        <i class="fas fa-star"></i>
                                                    </div>
                                                    <h3>
                                                        <%= __('labOrderDetails.rating') || 'Rating' %>
                                                    </h3>
                                                </div>
                                                <div class="card-body">
                                                    <% if (order.rating?.labRating) { %>
                                                        <div class="info-row">
                                                            <span class="label">
                                                                <%= __('reports.lab') || 'Lab' %> Rating
                                                            </span>
                                                            <span class="value">
                                                                <div class="rating-stars">
                                                                    <% for (let i=1; i <=5; i++) { %>
                                                                        <i
                                                                            class="fas fa-star <%= i <= order.rating.labRating ? '' : 'empty' %>"></i>
                                                                        <% } %>
                                                                </div>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                                            <% if (order.rating?.nurseRating) { %>
                                                                <div class="info-row">
                                                                    <span class="label">
                                                                        <%= __('reports.nurse') || 'Nurse' %> Rating
                                                                    </span>
                                                                    <span class="value">
                                                                        <div class="rating-stars">
                                                                            <% for (let i=1; i <=5; i++) { %>
                                                                                <i
                                                                                    class="fas fa-star <%= i <= order.rating.nurseRating ? '' : 'empty' %>"></i>
                                                                                <% } %>
                                                                        </div>
                                                                    </span>
                                                                </div>
                                                                <% } %>
                                                                    <% if (order.rating?.feedback) { %>
                                                                        <div class="info-row">
                                                                            <span class="label">
                                                                                <%= __('labOrderDetails.feedback')
                                                                                    || 'Feedback' %>
                                                                            </span>
                                                                            <span class="value">
                                                                                <%= order.rating.feedback %>
                                                                            </span>
                                                                        </div>
                                                                        <% } %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- Result (if completed) -->
                                                <% if (order.status==='completed' && order.results?.reportUrl) { %>
                                                    <div class="detail-card full-width">
                                                        <div class="card-header">
                                                            <div class="header-icon green">
                                                                <i class="fas fa-file-medical-alt"></i>
                                                            </div>
                                                            <h3>
                                                                <%= __('labOrderDetails.result') || 'Test Result' %>
                                                            </h3>
                                                        </div>
                                                        <div class="card-body">
                                                            <a href="<%= order.results.reportUrl %>" target="_blank"
                                                                class="modern-btn complete-btn"
                                                                style="width: 100%; justify-content: center;">
                                                                <i class="fas fa-download"></i>
                                                                <%= __('labOrderDetails.viewResult')
                                                                    || 'View/Download Result' %>
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <% } %>
                    </div>
                </div>
            </main>
        </div>

        <!-- Upload Modal -->
        <div class="modal-overlay" id="uploadModal">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>
                        <%= __('labOrders.fileUpload.title') || 'Upload Test Result' %>
                    </h3>
                    <button class="modal-close" onclick="closeUploadModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="uploadForm" enctype="multipart/form-data">
                        <div class="file-upload-area" id="fileUploadArea">
                            <label for="resultFile" style="cursor: pointer;">
                                <div class="upload-icon">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <p>
                                    <%= __('labOrders.fileUpload.dragDrop') || 'Drag & drop or click to upload' %>
                                </p>
                                <p style="font-size: 12px; color: #6b7280;">PDF, JPG, PNG (max 5MB)</p>
                            </label>
                            <input type="file" id="resultFile" name="resultFile" accept=".pdf,.jpg,.jpeg,.png"
                                style="display: none;">
                        </div>
                        <div id="filePreview"
                            style="display: none; margin-top: 16px; padding: 12px; background: #f3f4f6; border-radius: 8px;">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="modern-btn print-btn" onclick="closeUploadModal()">
                        <%= __('common.cancel') %>
                    </button>
                    <button class="modern-btn complete-btn" id="confirmUploadBtn" disabled onclick="handleUpload()">
                        <i class="fas fa-check"></i>
                        <%= __('labOrders.completeOrder') || 'Complete Order' %>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast -->
        <div class="toast" id="toast"></div>

        <script>
            const orderId = '<%= order._id %>';
            const qrCode = '<%= order.qrCode %>';
            const API_BASE = '/lab/api';

            function goBack() {
                if (document.referrer && document.referrer.includes('/lab/')) {
                    window.history.back();
                } else {
                    window.location.href = '/lab/orders';
                }
            }

            async function receiveSample() {
                try {
                    const response = await fetch(`${API_BASE}/orders/scan-qr`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ qrCode: qrCode })
                    });
                    const data = await response.json();
                    if (data.success) {
                        showToast('Sample received successfully', 'success');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        showToast(data.message || 'Error receiving sample', 'error');
                    }
                } catch (error) {
                    showToast('Error receiving sample', 'error');
                }
            }

            function openUploadModal() {
                document.getElementById('uploadModal').classList.add('active');
            }

            function closeUploadModal() {
                document.getElementById('uploadModal').classList.remove('active');
                document.getElementById('resultFile').value = '';
                document.getElementById('filePreview').style.display = 'none';
                document.getElementById('confirmUploadBtn').disabled = true;
            }

            document.getElementById('resultFile').addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        showToast('File too large (max 5MB)', 'error');
                        return;
                    }
                    document.getElementById('filePreview').style.display = 'block';
                    document.getElementById('filePreview').innerHTML = `
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <i class="fas fa-file" style="font-size: 24px; color: #3b82f6;"></i>
                        <div>
                            <div style="font-weight: 500;">${file.name}</div>
                            <div style="font-size: 12px; color: #6b7280;">${(file.size / 1024).toFixed(1)} KB</div>
                        </div>
                    </div>
                `;
                    document.getElementById('confirmUploadBtn').disabled = false;
                }
            });

            async function handleUpload() {
                const file = document.getElementById('resultFile').files[0];
                if (!file) return;

                document.getElementById('confirmUploadBtn').disabled = true;

                try {
                    // Upload file
                    const formData = new FormData();
                    formData.append('resultFile', file);

                    const uploadResponse = await fetch(`${API_BASE}/orders/${orderId}/upload-result`, {
                        method: 'POST',
                        body: formData
                    });
                    const uploadData = await uploadResponse.json();

                    if (!uploadData.success) {
                        showToast(uploadData.message || 'Upload failed', 'error');
                        document.getElementById('confirmUploadBtn').disabled = false;
                        return;
                    }

                    // Complete order
                    const completeResponse = await fetch(`${API_BASE}/orders/${orderId}/complete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reportUrl: uploadData.data.fileUrl })
                    });
                    const completeData = await completeResponse.json();

                    if (completeData.success) {
                        showToast('Order completed successfully', 'success');
                        closeUploadModal();
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        showToast(completeData.message || 'Failed to complete order', 'error');
                        document.getElementById('confirmUploadBtn').disabled = false;
                    }
                } catch (error) {
                    showToast('Error completing order', 'error');
                    document.getElementById('confirmUploadBtn').disabled = false;
                }
            }

            function showToast(message, type = 'info') {
                const toast = document.getElementById('toast');
                toast.textContent = message;
                toast.className = `toast ${type} show`;
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3000);
            }
        </script>
</body>

</html>

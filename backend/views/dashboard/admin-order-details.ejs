            // Initialize test search component
            function initTestSearch() {
                const searchInput = document.getElementById('testSearchInput');
                const searchClear = document.getElementById('testSearchClear');
                const searchContainer = document.getElementById('testSearchContainer');

                // Debounce timer
                let debounceTimer;

                // Input event with debounce
                searchInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        const query = this.value.trim();
                        if (query.length > 0) {
                            searchClear.style.display = 'block';
                            performFuzzySearch(query);
                        } else {
                            searchClear.style.display = 'none';
                            hideTestDropdown();
                        }
                    }, 150);
                });

                // Clear button
                searchClear.addEventListener('click', function () {
                    searchInput.value = '';
                    searchClear.style.display = 'none';
                    selectedTest = null;
                    document.getElementById('selectedTestInput').value = '';
                    hideTestDropdown();
                    searchInput.focus();
                });

                // Focus show all tests
                searchInput.addEventListener('focus', function () {
                    if (this.value.trim().length === 0 && labTests.length > 0) {
                        showAllTests();
                    }
                });

                // Keyboard navigation
                searchInput.addEventListener('keydown', function (e) {
                    const dropdown = document.getElementById('testSearchDropdown');
                    const results = document.querySelectorAll('.test-search-result-item');

                    if (dropdown.style.display !== 'none' && results.length > 0) {
                        if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            searchHighlightIndex = Math.min(searchHighlightIndex + 1, results.length - 1);
                            updateHighlight(results);
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            searchHighlightIndex = Math.max(searchHighlightIndex - 1, 0);
                            updateHighlight(results);
                        } else if (e.key === 'Enter') {
                            e.preventDefault();
                            if (results[searchHighlightIndex]) {
                                const testIndex = parseInt(results[searchHighlightIndex].dataset.index);
                                selectTest(filteredTests[testIndex]);
                            }
                        } else if (e.key === 'Escape') {
                            hideTestDropdown();
                        }
                    }
                });

                // Click outside to close
                document.addEventListener('click', function (e) {
                    if (!searchContainer.contains(e.target)) {
                        hideTestDropdown();
                    }
                });
            }

            // Fuzzy search algorithm
            function performFuzzySearch(query) {
                const normalizedQuery = query.toLowerCase();
                const results = [];

                labTests.forEach(test => {
                    const testName = test.name.toLowerCase();
                    const testCode = test.code ? test.code.toLowerCase() : '';
                    const score = calculateFuzzyScore(testName, normalizedQuery, testCode);

                    if (score > 0) {
                        results.push({ test, score });
                    }
                });

                // Sort by score (highest first)
                results.sort((a, b) => b.score - a.score);

                filteredTests = results.map(r => r.test);
                showTestDropdown(filteredTests, query);
            }

            // Calculate fuzzy match score
            function calculateFuzzyScore(text, query, code) {
                let maxScore = 0;

                // Check name match
                const nameScore = scoreString(text, query);
                maxScore = Math.max(maxScore, nameScore);

                // Check code match
                if (code) {
                    const codeScore = scoreString(code, query);
                    maxScore = Math.max(maxScore, codeScore * 1.5); // Boost code matches
                }

                return maxScore;
            }

            // Score a string against a query
            function scoreString(text, query) {
                if (!text || !query) return 0;

                // Exact match bonus
                if (text === query) return 100;

                // Starts with query bonus
                if (text.startsWith(query)) return 80;

                // Contains query bonus
                if (text.includes(query)) return 60;

                // Fuzzy character match
                let score = 0;
                let textIndex = 0;
                let queryIndex = 0;
                let consecutiveMatches = 0;

                while (textIndex < text.length && queryIndex < query.length) {
                    if (text[textIndex] === query[queryIndex]) {
                        score += 10;
                        consecutiveMatches++;
                        queryIndex++;
                        // Bonus for consecutive matches
                        if (consecutiveMatches > 1) {
                            score += consecutiveMatches * 2;
                        }
                    } else {
                        consecutiveMatches = 0;
                        // Small penalty for gap
                        score -= 1;
                    }
                    textIndex++;
                }

                // Bonus if we matched all characters
                if (queryIndex === query.length) {
                    score += 20;
                }

                // Bonus for word boundary matches
                const words = text.split(/\s+/);
                words.forEach(word => {
                    if (word.startsWith(query[0])) {
                        score += 5;
                    }
                });

                return Math.max(0, score);
            }

            // Highlight matched characters
            function highlightMatch(text, query) {
                if (!query) return text;

                const normalizedText = text.toLowerCase();
                const normalizedQuery = query.toLowerCase();
                let result = '';
                let textIndex = 0;
                let queryIndex = 0;
                const matchedIndices = [];

                // Find matching positions
                while (textIndex < text.length && queryIndex < normalizedQuery.length) {
                    if (normalizedText[textIndex] === normalizedQuery[queryIndex]) {
                        matchedIndices.push(textIndex);
                        queryIndex++;
                    }
                    textIndex++;
                }

                // Build highlighted string
                for (let i = 0; i < text.length; i++) {
                    if (matchedIndices.includes(i)) {
                        result += `<mark class="test-search-highlight">${text[i]}</mark>`;
                    } else {
                        result += text[i];
                    }
                }

                return result;
            }

            // Show all tests when input is empty
            function showAllTests() {
                filteredTests = labTests.slice(0, 10); // Show first 10
                showTestDropdown(filteredTests, '');
            }

            // Show test dropdown with results
            function showTestDropdown(tests, query) {
                const dropdown = document.getElementById('testSearchDropdown');
                const resultsContainer = document.getElementById('testSearchResults');

                if (tests.length === 0) {
                    resultsContainer.innerHTML = `
                        <div class="test-search-no-results">
                            <i class="fas fa-search"></i>
                            <span>No tests found</span>
                        </div>
                    `;
                } else {
                    resultsContainer.innerHTML = tests.map((test, index) => `
                        <div class="test-search-result-item" data-index="${index}"
                            onclick="selectTestFromDropdown(${index})">
                            <div class="test-result-main">
                                <span class="test-result-name">${highlightMatch(test.name, query)}</span>
                                <span class="test-result-code">${test.code || ''}</span>
                            </div>
                            <div class="test-result-meta">
                                <span class="test-result-price">${new Intl.NumberFormat('en-IQ', { style: 'currency', currency: 'IQD', maximumFractionDigits: 0 }).format(test.price)}</span>
                                <span class="test-result-category">${test.category || ''}</span>
                            </div>
                        </div>
                    `).join('');
                }

                dropdown.style.display = 'block';
                searchHighlightIndex = 0;
                updateHighlight(document.querySelectorAll('.test-search-result-item'));
            }

            // Hide test dropdown
            function hideTestDropdown() {
                document.getElementById('testSearchDropdown').style.display = 'none';
                searchHighlightIndex = 0;
            }

            // Update highlight on keyboard navigation
            function updateHighlight(results) {
                results.forEach((item, index) => {
                    if (index === searchHighlightIndex) {
                        item.classList.add('test-search-result-highlighted');
                        item.scrollIntoView({ block: 'nearest' });
                    } else {
                        item.classList.remove('test-search-result-highlighted');
                    }
                });
            }

            // Select test from dropdown
            function selectTestFromDropdown(index) {
                selectTest(filteredTests[index]);
            }

            // Select a test
            function selectTest(test) {
                if (!test) return;

                selectedTest = {
                    testId: test._id || test.name,
                    testName: test.name,
                    testCode: test.code,
                    price: test.price,
                    category: test.category
                };

                const searchInput = document.getElementById('testSearchInput');
                const searchClear = document.getElementById('testSearchClear');

                searchInput.value = test.name;
                searchClear.style.display = 'block';
                document.getElementById('selectedTestInput').value = JSON.stringify(selectedTest);

                hideTestDropdown();
            }

            // Toggle edit mode
            function toggleEditMode() {
                isEditMode = !isEditMode;

                const editBtn = document.querySelector('.edit-tests-btn');
                const addTestForm = document.getElementById('addTestForm');
                const removeBtns = document.querySelectorAll('.remove-test-btn');

                if (isEditMode) {
                    editBtn.classList.add('active');
                    addTestForm.style.display = 'flex';
                    removeBtns.forEach(btn => btn.style.display = 'flex');
                } else {
                    editBtn.classList.remove('active');
                    addTestForm.style.display = 'none';
                    removeBtns.forEach(btn => btn.style.display = 'none');
                }
            }

            // Add test to order
            async function addTest() {
                if (!selectedTest) {
                    showToast('error', 'Please select a test');
                    return;
                }

                const testData = selectedTest;

                try {
                    const response = await fetch(`${API_BASE}/${orderId}/tests`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(testData)
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('success', 'Test added successfully');

                        // Add test to DOM dynamically
                        const testsBody = document.querySelector('.tests-body');
                        const emptyTests = testsBody.querySelector('.empty-tests');

                        // Remove empty state if exists
                        if (emptyTests) {
                            emptyTests.remove();
                        }

                        // Get current test count
                        const testItems = testsBody.querySelectorAll('.test-item');
                        const testIndex = testItems.length;

                        // Create new test item
                        const testItem = document.createElement('div');
                        testItem.className = 'test-item';
                        testItem.dataset.index = testIndex;
                        testItem.innerHTML = `
                        <div class="test-main">
                            <span class="test-name">${testData.testName}</span>
                            <span class="test-price">${new Intl.NumberFormat('en-IQ', { style: 'currency', currency: 'IQD', maximumFractionDigits: 0 }).format(testData.price)}</span>
                        </div>
                        <button class="remove-test-btn" onclick="removeTest(${testIndex})" style="display: flex;">
                            <i class="fas fa-trash"></i>
                        </button>
                    `;

                        // Append test item
                        testsBody.appendChild(testItem);

                        // Update test count
                        const testsCount = document.querySelector('.tests-count');
                        testsCount.textContent = `${testIndex + 1} <%= __('orders.tests') %>`;

                        // Update pricing from server response
                        updatePricing(data.data.order);

                        // Reset search input
                        const searchInput = document.getElementById('testSearchInput');
                        const searchClear = document.getElementById('testSearchClear');
                        searchInput.value = '';
                        searchClear.style.display = 'none';
                        selectedTest = null;
                        document.getElementById('selectedTestInput').value = '';
                        searchInput.focus();
                    } else {
                        showToast('error', data.message || 'Failed to add test');
                    }
                } catch (error) {
                    console.error('Add test error:', error);
                    showToast('error', 'Failed to add test');
                }
            }

            // Remove test from order
            async function removeTest(testIndex) {
                if (!confirm('Are you sure you want to remove this test?')) {
                    return;
                }

                try {
                    const response = await fetch(`${API_BASE}/${orderId}/tests/${testIndex}`, {
                        method: 'DELETE',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('success', 'Test removed successfully');

                        // Remove test from DOM
                        const testsBody = document.querySelector('.tests-body');
                        const testItem = testsBody.querySelector(`.test-item[data-index="${testIndex}"]`);

                        if (testItem) {
                            testItem.remove();

                            // Update test count
                            const testItems = testsBody.querySelectorAll('.test-item');
                            const testsCount = document.querySelector('.tests-count');

                            if (testItems.length === 0) {
                                // Show empty state
                                testsCount.textContent = `0 <%= __('orders.tests') %>`;
                                const emptyDiv = document.createElement('div');
                                emptyDiv.className = 'empty-tests';
                                emptyDiv.innerHTML = `
                                <i class="fas fa-vial"></i>
                                <span>No tests ordered</span>
                            `;
                                testsBody.appendChild(emptyDiv);
                            } else {
                                // Update count and reindex remaining tests
                                testsCount.textContent = `${testItems.length} <%= __('orders.tests') %>`;

                                // Reindex all test items
                                testItems.forEach((item, index) => {
                                    item.dataset.index = index;
                                    const removeBtn = item.querySelector('.remove-test-btn');
                                    removeBtn.setAttribute('onclick', `removeTest(${index})`);
                                });
                            }

                            // Update pricing from server response
                            updatePricing(data.data.order);
                        }
                    } else {
                        showToast('error', data.message || 'Failed to remove test');
                    }
                } catch (error) {
                    console.error('Remove test error:', error);
                    showToast('error', 'Failed to remove test');
                }
            }

            // Update pricing display
            function updatePricing(order) {
                if (order && order.pricing) {
                    const totalValue = document.querySelector('.total-value');
                    if (totalValue) {

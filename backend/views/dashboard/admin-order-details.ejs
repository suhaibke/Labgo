            // ----- Prescription quote: dynamic test rows (picked from the assigned lab's real tests) -----
            function addQuoteTestRow(testCode = '', price = '') {
                const container = document.getElementById('quoteTestRows');
                if (!container) return;

                if (labTests.length === 0) {
                    showToast('error', "<%= __('orders.assignLabFirst') || 'Assign a lab to this order first' %>");
                    return;
                }

                const row = document.createElement('div');
                row.className = 'quote-test-row';
                row.style.cssText = 'display:flex; gap:8px; align-items:center;';
                const options = labTests.map(t => {
                    const label = `${t.name}${t.code ? ' (' + t.code + ')' : ''} - ${t.price} IQD`;
                    const safeName = String(t.name).replace(/"/g, '&quot;');
                    const selected = t.code === testCode ? 'selected' : '';
                    return `<option value="${t.code}" data-name="${safeName}" data-price="${t.price}" ${selected}>${label}</option>`;
                }).join('');
                row.innerHTML = `
                    <select class="form-input quote-test-select" style="flex:2;" onchange="onQuoteTestSelect(this)">
                        <option value="">-- <%= __('orders.selectTest') || 'Select a test' %> --</option>
                        ${options}
                    </select>
                    <input type="number" class="form-input quote-test-price" placeholder="<%= __('orders.price') || 'Price' %> (IQD)" min="0" value="${price}" style="flex:1;" oninput="updateQuoteTotal()">
                    <button type="button" class="btn btn-secondary" onclick="this.parentElement.remove(); updateQuoteTotal();" style="padding:6px 10px;">
                        <i class="fas fa-times"></i>
                    </button>`;
                container.appendChild(row);
            }

            function onQuoteTestSelect(select) {
                const opt = select.selectedOptions[0];
                const row = select.closest('.quote-test-row');
                if (opt && opt.dataset.price) {
                    row.querySelector('.quote-test-price').value = opt.dataset.price;
                    updateQuoteTotal();
                }
            }

            function collectQuoteTests() {
                return Array.from(document.querySelectorAll('.quote-test-row')).map(row => {
                    const select = row.querySelector('.quote-test-select');
                    const opt = select.selectedOptions[0];
                    return {
                        name: opt && opt.value ? opt.dataset.name : '',
                        testCode: select.value || null,
                        price: parseFloat(row.querySelector('.quote-test-price').value),
                    };
                }).filter(t => t.name && !isNaN(t.price) && t.price >= 0);
            }

            function updateQuoteTotal() {
                const total = collectQuoteTests().reduce((sum, t) => sum + t.price, 0);
                const el = document.getElementById('quoteTotalValue');
                if (el) el.textContent = total.toLocaleString();
            }

            async function submitPrescriptionQuote(orderId) {
                const form = document.getElementById('prescriptionQuoteForm');
                const formData = new FormData(form);

                // Lab-test prescriptions use dynamic test rows; medicine
                // orders use the plain medicine name/type/price fields.
                if (document.getElementById('quoteTestRows')) {
                    const tests = collectQuoteTests();
                    if (tests.length === 0) {
                        showToast('error', "<%= __('orders.addAtLeastOneTest') || 'Add at least one test with a name and price' %>");
                        return;
                    }
                    formData.append('tests', JSON.stringify(tests));
                    formData.append('price', tests.reduce((sum, t) => sum + t.price, 0));
                } else if (!formData.get('price') || isNaN(parseFloat(formData.get('price')))) {
                    showToast('error', "<%= __('orders.priceRequired') || 'A valid price is required' %>");
                    return;
                }

                try {
                    const response = await fetch(`${API_BASE}/${orderId}/quote-prescription`, {
                        method: 'POST',
                        headers: { 'Authorization': `Bearer ${getToken()}` },
                        body: formData
                    });
                    const data = await response.json();

                    if (response.ok) {
                        showToast('success', data.message || 'Quote sent');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast('error', data.message || 'Failed to send quote');
                    }
                } catch (error) {
                    console.error('Error sending prescription quote:', error);
                    showToast('error', 'Failed to send quote');
                }
            }

            async function completeMedicineDelivery(orderId) {
                try {
                    const response = await fetch(`${API_BASE}/${orderId}/complete-delivery`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`,
                            'Content-Type': 'application/json'
                        }
                    });
                    const data = await response.json();
                    if (response.ok) {
                        showToast('success', data.message || 'Marked delivered');
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        showToast('error', data.message || 'Failed to mark delivered');
                    }
                } catch (error) {
                    console.error('Error completing delivery:', error);
                    showToast('error', 'Failed to mark delivered');
                }
            }

            // Get token from localStorage
            function getToken() {
                return localStorage.getItem('token') || '';
            }

            // Show toast notification
            function showToast(type, message) {
                const toast = document.getElementById('toast');
                const icon = toast.querySelector('.toast-icon i');
                const title = toast.querySelector('.toast-title');
                const msg = toast.querySelector('.toast-message');

                icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
                toast.classList.remove('success', 'error');
                toast.classList.add(type);
                title.textContent = type === 'success' ? "<%= __('common.success') %>" : "<%= __('common.error') %>";
                msg.textContent = message;

                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 3000);
            }

            // Hide toast
            function hideToast() {
                document.getElementById('toast').classList.remove('show');
            }

            // Close modals on overlay click
            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function (e) {
                    if (e.target === this) {
                        this.classList.remove('show');
                    }
                });
            });

            // Close image modal with Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.getElementById('imageModal').classList.remove('show');
                    document.getElementById('rejectModal').classList.remove('show');
                }
            });
        </script>
</body>

</html>
        <script>
            const orderId = '<%= order._id %>';
            let labId = '<%= order.labId?._id %>';
            const isNurseRequest = <%= order.isNurseRequest || false %>;
            const API_BASE = '/api/admin/orders';
            let isEditMode = false;
            let labTests = [];
            let selectedTest = null;
            let searchHighlightIndex = 0;
            let filteredTests = [];
            let allLabs = [];

            // Load lab tests on page load
            document.addEventListener('DOMContentLoaded', async function () {
                if (labId) {
                    await loadLabTests();
                    initTestSearch();
                }
                // Prescription quote test rows need labTests loaded first,
                // so the initial empty row's picker is populated correctly.
                if (document.getElementById('quoteTestRows')) {
                    addQuoteTestRow();
                }
            });

            // Lab Selection Functions
            async function showLabSelectionModal() {
                document.getElementById('labSelectionModal').classList.add('show');
                document.body.style.overflow = 'hidden';
                await loadAllLabs();
                initLabSearch();
            }

            function closeLabSelectionModal() {
                document.getElementById('labSelectionModal').classList.remove('show');
                document.body.style.overflow = '';
            }

            async function loadAllLabs() {
                const labsList = document.getElementById('labsList');
                labsList.innerHTML = '<div class="loading-labs"><i class="fas fa-spinner fa-spin"></i><span><%= __("common.loading") %>...</span></div>';
                
                try {
                    const response = await fetch(`${API_BASE}/labs/all`, {
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        allLabs = data.data.labs;
                        renderLabsList(allLabs);
                    } else {
                        labsList.innerHTML = '<div class="no-labs"><i class="fas fa-exclamation-circle"></i><span><%= __("orders.failedToLoadLabs") %></span></div>';
                    }
                } catch (error) {
                    console.error('Error loading labs:', error);
                    labsList.innerHTML = '<div class="no-labs"><i class="fas fa-exclamation-circle"></i><span><%= __("orders.failedToLoadLabs") %></span></div>';
                }
            }

            function renderLabsList(labs) {
                const labsList = document.getElementById('labsList');
                
                if (labs.length === 0) {
                    labsList.innerHTML = '<div class="no-labs"><i class="fas fa-flask"></i><span><%= __("orders.noLabsFound") %></span></div>';
                    return;
                }

                labsList.innerHTML = labs.map(lab => `
                    <div class="lab-item ${lab._id === labId ? 'selected' : ''}" onclick="selectLab('${lab._id}', '${lab.name.replace(/'/g, "\\'")}')">
                        <div class="lab-item-info">
                            <div class="lab-item-name">${lab.name}</div>
                            <div class="lab-item-details">
                                <span><i class="fas fa-map-marker-alt"></i> ${lab.city || '-'}</span>
                                <span><i class="fas fa-phone"></i> ${lab.phone || '-'}</span>
                            </div>
                        </div>
                        <div class="lab-item-action">
                            ${lab._id === labId ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-chevron-right"></i>'}
                        </div>
                    </div>
                `).join('');
            }

            function initLabSearch() {
                const searchInput = document.getElementById('labSearchInput');
                let debounceTimer;

                searchInput.value = '';
                searchInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        const query = this.value.trim().toLowerCase();
                        if (query.length > 0) {
                            const filtered = allLabs.filter(lab => 
                                lab.name.toLowerCase().includes(query) ||
                                (lab.city && lab.city.toLowerCase().includes(query))
                            );
                            renderLabsList(filtered);
                        } else {
                            renderLabsList(allLabs);
                        }
                    }, 150);
                });
            }

            async function selectLab(selectedLabId, labName) {
                try {
                    const response = await fetch(`${API_BASE}/${orderId}/assign-lab`, {
                        method: 'POST',

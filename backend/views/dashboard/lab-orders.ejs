<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>

<body>
    <%- include('../partials/lab-navbar') %>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/lab-orders-hub.css">
<%
    // Same wording as the lab app (Arabic / Kurdish / English; Turkish falls back to English).
    const L = currentLang === 'ar' ? 0 : currentLang === 'ku' ? 1 : 2;
    const tr = (ar, ku, en) => [ar, ku, en][L];
    const T = {
        send: tr('إرسال', 'ناردن', 'Send'),
        receive: tr('استلام', 'وەرگرتن', 'Receive'),
        step1: tr('اسم المريض', 'ناوی نەخۆش', 'Patient name'),
        step1Hint: tr('اختر مريضاً مسجلاً أو اكتب اسماً جديداً', 'نەخۆشێکی تۆمارکراو هەڵبژێرە یان ناوێکی نوێ بنووسە', 'Pick a registered patient or type a new name'),
        phoneNew: tr('رقم هاتف المريض (يُسجَّل كمريض جديد)', 'ژمارەی مۆبایلی نەخۆش', 'Patient phone (registered as a new patient)'),
        age: tr('العمر', 'تەمەن', 'Age'), years: tr('سنة', 'ساڵ', 'yrs'),
        male: tr('ذكر', 'نێر', 'Male'), female: tr('أنثى', 'مێ', 'Female'),
        step2: tr('الفحوصات', 'پشکنینەکان', 'Tests'),
        registered: tr('فحوصات المريض المسجلة — اضغط للإضافة', 'پشکنینە تۆمارکراوەکانی نەخۆش', "The patient's registered tests — tap to add"),
        searchTests: tr('بحث عن فحص', 'گەڕان بۆ پشکنین', 'Search tests'),
        step3: tr('المختبر المستلم', 'تاقیگەی وەرگر', 'Receiving lab'),
        labSearch: tr('بحث عن مختبر أو مدينة', 'گەڕان بۆ تاقیگە', 'Search labs or cities'),
        price: tr('السعر', 'نرخ', 'Price'), currency: tr('د.ع', 'د.ع', 'IQD'),
        priceTyped: tr('السعر المتفق عليه مع المختبر', 'نرخی ڕێککەوتوو', 'Price agreed with the lab'),
        step4: tr('إرسال', 'ناردن', 'Send'),
        tracking: tr('التتبع', 'بەدواداچوون', 'Tracking'),
        trackSearch: tr('بحث بالاسم أو الفحص أو رقم التتبع', 'گەڕان', 'Search name, test or tracking no.'),
        receiveTitle: tr('استلام العينات بالباركود', 'وەرگرتنی نموونە بە بارکۆد', 'Receive samples by barcode'),
        barcode: tr('الباركود أو رمز QR', 'بارکۆد یان QR', 'Barcode or QR code'),
        receivedTitle: tr('العينات المستلمة', 'نموونە وەرگیراوەکان', 'Received samples'),
        receivedSearch: tr('بحث بالاسم أو الرمز أو المختبر', 'گەڕان', 'Search name, code or lab'),
        all: tr('الكل', 'هەموو', 'All'), onWay: tr('في الطريق', 'لە ڕێگادا', 'On the way'),
        inLab: tr('في المختبر', 'لە تاقیگە', 'In the lab'), done: tr('مكتملة', 'تەواو', 'Completed'),
    };
%>

    <main class="la-main screen-enter sr">
        <section class="la-page-head sr-head">
            <div>
                <h1 class="la-h1"><%= __('labOrders.hubTitle', currentLang) %></h1>
                <p class="la-sub"><%= __('labOrders.hubSubtitle', currentLang) %></p>
            </div>
        </section>

        <!-- Send / Receive, as in the app -->
        <div class="la-seg sr-seg" role="tablist" id="srTabs">
            <button type="button" role="tab" data-tab="send" class="<%= tab === 'send' ? 'on' : '' %>" aria-selected="<%= tab === 'send' %>"><%= T.send %></button>
            <button type="button" role="tab" data-tab="receive" class="<%= tab === 'receive' ? 'on' : '' %>" aria-selected="<%= tab === 'receive' %>"><%= T.receive %><span class="sr-badge" id="receiveBadge" hidden></span></button>
        </div>

        <!-- ============ SEND ============ -->
        <section class="sr-pane sr-send" data-pane="send" <%= tab === 'send' ? '' : 'hidden' %>>
            <form class="la-card sr-form" id="sendForm" autocomplete="off" novalidate>
                <!-- 1. patient -->
                <h2 class="sr-step"><span>1</span><%= T.step1 %></h2>
                <p class="sr-hint"><%= T.step1Hint %></p>
                <div class="sr-combo" id="patientCombo">
                    <label class="la-search"><svg class="ic"><use href="#i-search"/></svg>
                        <input type="text" id="patientInput" placeholder="<%= T.step1 %>" maxlength="120" aria-autocomplete="list" aria-controls="patientList">
                    </label>
                    <div class="sr-drop" id="patientList" role="listbox" hidden></div>
                </div>
                <label class="la-search sr-phone" id="phoneRow" hidden><svg class="ic"><use href="#i-phone"/></svg>
                    <input type="tel" id="phoneInput" placeholder="<%= T.phoneNew %>" maxlength="20" dir="ltr">
                </label>
                <div class="sr-row">
                    <span class="sr-mini"><%= T.age %></span>
                    <input class="la-input sr-age" id="ageInput" type="text" inputmode="numeric" maxlength="3" placeholder="<%= T.age %>" dir="ltr">
                    <span class="sr-mini"><%= T.years %></span>
                    <div class="sr-gender" role="radiogroup">
                        <button type="button" data-gender="male" aria-label="<%= T.male %>" title="<%= T.male %>"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="m21 3-6.75 6.75"/><circle cx="10" cy="14" r="6"/></svg></button>
                        <button type="button" data-gender="female" aria-label="<%= T.female %>" title="<%= T.female %>"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v7"/><path d="M9 19h6"/><circle cx="12" cy="9" r="6"/></svg></button>
                    </div>
                </div>

                <!-- 2. tests -->
                <h2 class="sr-step"><span>2</span><%= T.step2 %></h2>
                <div id="registeredBox" hidden>
                    <p class="sr-hint"><%= T.registered %></p>
                    <div class="sr-chips" id="registeredTests"></div>
                </div>
                <div class="sr-combo" id="testCombo">
                    <label class="la-search"><svg class="ic"><use href="#i-search"/></svg>
                        <input type="text" id="testInput" placeholder="<%= T.searchTests %>" maxlength="120" aria-autocomplete="list" aria-controls="testList">
                    </label>
                    <div class="sr-drop" id="testList" role="listbox" hidden></div>
                </div>
                <div class="sr-chips sr-picked" id="pickedTests"></div>

                <!-- 3. lab -->
                <h2 class="sr-step"><span>3</span><%= T.step3 %></h2>
                <div class="sr-combo" id="labCombo">
                    <label class="la-search"><svg class="ic"><use href="#i-search"/></svg>
                        <input type="text" id="labInput" placeholder="<%= T.labSearch %>" maxlength="160" aria-autocomplete="list" aria-controls="labList">
                    </label>
                    <div class="sr-drop" id="labList" role="listbox" hidden></div>
                </div>
                <div id="labChosen"></div>
                <div id="priceBox" hidden>
                    <p class="sr-label"><%= T.price %> (<%= T.currency %>)</p>
                    <label class="la-search"><svg class="ic"><use href="#i-pencil"/></svg>
                        <input type="text" id="priceInput" inputmode="numeric" maxlength="12" dir="ltr">
                    </label>
                    <p class="sr-hint" id="priceHint"></p>
                </div>

                <!-- 4. send -->
                <button type="submit" class="la-btn sr-send-btn press" id="sendBtn"><svg class="ic flip-rtl"><use href="#i-send"/></svg>4. <%= T.step4 %></button>
            </form>

            <div class="sr-track">
                <h2 class="sr-title"><%= T.tracking %> <span class="la-count" id="trackCount">0</span></h2>
                <label class="la-search"><svg class="ic"><use href="#i-search"/></svg>
                    <input type="search" id="trackSearch" placeholder="<%= T.trackSearch %>">
                </label>
                <div id="trackList" class="sr-list"><div class="la-spinner"></div></div>
            </div>
        </section>

        <!-- ============ RECEIVE ============ -->
        <section class="sr-pane sr-receive" data-pane="receive" <%= tab === 'receive' ? '' : 'hidden' %>>
            <form class="la-card sr-scan" id="scanForm" autocomplete="off">
                <h2 class="sr-title"><%= T.receiveTitle %></h2>
                <label class="la-search sr-scan-field"><svg class="ic"><use href="#i-barcode"/></svg>
                    <input type="text" id="scanInput" placeholder="<%= T.barcode %>" maxlength="80" dir="ltr">
                </label>
                <button type="submit" class="la-btn press" id="scanBtn"><svg class="ic"><use href="#i-check"/></svg><%= T.receive %></button>
            </form>

            <div class="sr-recv">
                <h2 class="sr-title"><%= T.receivedTitle %> <span class="la-count" id="recvCount">0</span></h2>
                <div class="sr-recv-tools">
                    <label class="la-search"><svg class="ic"><use href="#i-search"/></svg>
                        <input type="search" id="recvSearch" placeholder="<%= T.receivedSearch %>">
                    </label>
                    <div class="la-chips" id="recvFilters">
                        <button type="button" class="la-chip on" data-f="all"><%= T.all %></button>
                        <button type="button" class="la-chip" data-f="on_the_way"><%= T.onWay %></button>
                        <button type="button" class="la-chip" data-f="received"><%= T.inLab %></button>
                        <button type="button" class="la-chip" data-f="completed"><%= T.done %></button>
                    </div>
                </div>
                <div id="recvList" class="sr-list sr-grid"><div class="la-spinner"></div></div>
            </div>
        </section>
    </main>

    <!-- result file (sent samples, LabGo orders, samples from labs) -->
    <input type="file" id="resultFile" accept=".pdf,.jpg,.jpeg,.png,.heic,.heif,.webp" hidden>
    <div id="toastContainer" class="la-toasts"></div>

    <script type="application/json" id="srData"><%- JSON.stringify({
        catalog: catalog,
        preselectOrderId: preselectOrderId,
        labelLang: ['ar', 'ku'].includes(currentLang) ? currentLang : 'en',
        lang: currentLang,
        t: {
            male: T.male, female: T.female, years: T.years, currency: T.currency,
            priceTyped: T.priceTyped,
            priceAuto: tr('سعر المختبر لهذه الفحوصات (B2B) — يمكنك تعديله', 'نرخی B2B', "The lab's B2B price for these tests — you can change it"),
            priceMissing: tr('بلا سعر عند المختبر', 'بێ نرخ', 'No price at this lab'),
            newPatient: tr('مريض جديد', 'نەخۆشی نوێ', 'New patient'),
            useLab: tr('استخدام مختبر جديد', 'تاقیگەی نوێ', 'Use a new lab'),
            addTest: tr('إضافة فحص', 'زیادکردن', 'Add test'),
            noLabs: tr('لا توجد مختبرات مطابقة', 'هیچ تاقیگەیەک نییە', 'No matching labs'),
            notOnLabgo: tr('غير مسجل في LabGo', 'لە LabGo نییە', 'Not on LabGo'),
            needName: tr('اكتب اسم المريض أو اختره', 'ناوی نەخۆش بنووسە', "Type or pick the patient's name"),
            needPhone: tr('أدخل رقم هاتف المريض الجديد', 'ژمارەی مۆبایل بنووسە', "Enter the new patient's phone"),
            needTests: tr('اختر فحصاً واحداً على الأقل', 'لانیکەم یەک پشکنین', 'Choose at least one test'),
            needLab: tr('اختر المختبر المستلم أو اكتب اسمه', 'تاقیگە هەڵبژێرە', 'Choose or type the receiving lab'),
            sent: tr('تم الإرسال ✓', 'نێردرا ✓', 'Sent ✓'),
            alreadySent: tr('هذه الفحوصات أُرسلت سابقاً لهذا المريض', 'پێشتر نێردراون', 'These tests were already sent for this patient'),
            error: tr('حدث خطأ، حاول مجدداً', 'هەڵەیەک ڕوویدا', 'Something went wrong, try again'),
            stepSent: tr('أُرسلت', 'نێردرا', 'Sent'), stepReceived: tr('استُلمت', 'وەرگیرا', 'Received'), stepResult: tr('النتيجة', 'ئەنجام', 'Result'),
            statusSent: tr('بانتظار النتيجة', 'چاوەڕێی ئەنجام', 'Awaiting result'), statusDone: tr('مكتملة', 'تەواو', 'Completed'),
            eta: tr('موعد النتيجة', 'کاتی ئەنجام', 'Result due'), trackingId: tr('رقم التتبع', 'ژمارەی بەدواداچوون', 'Tracking no.'),
            printLabel: tr('طباعة الملصق', 'چاپی لەیبڵ', 'Print label'), labelPdf: tr('ملصق PDF', 'PDF', 'Label PDF'),
            uploadResult: tr('رفع النتيجة', 'بارکردنی ئەنجام', 'Upload result'), viewResult: tr('عرض النتيجة', 'ئەنجام', 'View result'),
            enterResult: tr('إدخال النتيجة', 'ئەنجام بنووسە', 'Enter result'),
            toPatient: tr('إرسال للمريض', 'بۆ نەخۆش', 'Send to patient'), sentToPatient: tr('أُرسلت للمريض', 'نێردرا بۆ نەخۆش', 'Sent to patient'),
            del: tr('حذف', 'سڕینەوە', 'Delete'),
            confirmDel: tr('حذف هذا الإرسال من التتبع؟ لا يمكن التراجع، ويبقى طلب المريض كما هو.', 'بسڕدرێتەوە؟', "Delete this transfer from tracking? It cannot be undone; the patient's order stays."),
            noTracking: tr('لا توجد إرسالات بعد — أرسل أول عينة من النموذج', 'هیچ ناردنێک نییە', 'No transfers yet — send the first sample with the form'),
            noMatch: tr('لا توجد نتائج مطابقة', 'هیچ نییە', 'Nothing matches'),
            receiveBtn: tr('استلام', 'وەرگرتن', 'Receive'),
            received: tr('تم استلام العينة ✓', 'نموونە وەرگیرا ✓', 'Sample received ✓'),
            notFound: tr('لا توجد عينة أو طلب بهذا الرمز لمختبرك', 'هیچ نموونەیەک نییە', 'No sample or order with this code for your lab'),
            onWay: T.onWay, inLab: T.inLab, done: T.done,
            fromLabgo: tr('خدمة LabGo', 'خزمەتی LabGo', 'LabGo service'), fromLab: tr('من', 'لە', 'From'),
            noReceived: tr('لا توجد عينات مستلمة أو واردة', 'هیچ نموونەیەک نییە', 'No incoming or received samples'),
            uploaded: tr('تم رفع النتيجة ✓', 'ئەنجام بارکرا ✓', 'Result uploaded ✓'),
            fileTooBig: tr('الملف أكبر من 5 ميغابايت', 'فایلەکە گەورەیە', 'The file is larger than 5 MB'),
            forwarded: tr('أُرسلت النتيجة للمريض ✓', 'نێردرا ✓', 'Result sent to the patient ✓'),
            deleted: tr('تم الحذف', 'سڕدرایەوە', 'Deleted')
        }
    }).replace(/</g, '\\u003c') %></script>
    <script src="/js/lab-orders-hub.js"></script>
</body>
</html>

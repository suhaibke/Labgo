<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/lab-patient-tests.css">
</head>
<body>
    <%- include('../partials/lab-navbar') %>

    <main class="la-main screen-enter">
        <section class="la-page-head">
            <div>
                <h1 class="la-h1"><%= __('ordersHistory.title') %></h1>
                <p class="la-sub"><%= __('ordersHistory.subtitle') %></p>
            </div>
            <div style="display:flex;gap:8px;align-items:center">
            <a class="la-btn md press-95" href="/lab/patients/new"><svg class="ic"><use href="#i-user-plus"/></svg><%= __('labApp.addPatient') %></a>
            <button class="la-circle press-90" onclick="loadOrders()" aria-label="refresh" style="width:44px;height:44px">
                <svg class="ic" style="width:18px;height:18px"><use href="#i-refresh-cw"/></svg>
            </button>
            </div>
        </section>

        <section class="la-grid c3" style="margin-top:16px">
            <div class="la-card la-kpi stagger">
                <span class="la-kpi-ic"><svg class="ic"><use href="#i-circle-check"/></svg></span>
                <div><b id="statTotal">-</b><span><%= __('ordersHistory.stats.totalCompleted') %></span></div>
            </div>
            <div class="la-card la-kpi stagger" style="animation-delay:.05s">
                <span class="la-kpi-ic" style="background:var(--soft-green);color:var(--green-text)"><svg class="ic"><use href="#i-calendar"/></svg></span>
                <div><b id="statThisMonth">-</b><span><%= __('ordersHistory.stats.thisMonth') %></span></div>
            </div>
            <div class="la-card la-kpi stagger" style="animation-delay:.1s">
                <span class="la-kpi-ic" style="background:rgba(0,122,255,.12);color:var(--blue)"><svg class="ic"><use href="#i-wallet"/></svg></span>
                <div style="min-width:0"><b id="statRevenue" style="font-size:24px">-</b><span><%= __('ordersHistory.stats.totalRevenue') %></span></div>
            </div>
        </section>

        <section class="la-card stagger pt-filters" style="margin-top:12px;animation-delay:.12s">
            <div class="la-search pt-search">
                <svg class="ic"><use href="#i-search"/></svg>
                <input type="text" id="searchInput" placeholder="<%= __('ordersHistory.filters.searchPlaceholder') %>">
            </div>
            <label class="pt-date"><span><%= __('ordersHistory.filters.fromDate') %></span><input type="date" id="filterFromDate"></label>
            <label class="pt-date"><span><%= __('ordersHistory.filters.toDate') %></span><input type="date" id="filterToDate"></label>
            <button class="la-btn soft md press" onclick="clearFilters()">
                <svg class="ic"><use href="#i-x"/></svg><%= __('ordersHistory.filters.clear') %>
            </button>
        </section>

        <section class="la-card stagger" style="margin-top:12px;animation-delay:.16s;padding-top:6px">
            <div class="pt-table-wrap">
                <table class="pt-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th><%= __('ordersHistory.table.orderId') %></th>
                            <th><%= __('ordersHistory.table.patient') %></th>
                            <th><%= __('ordersHistory.table.tests') %></th>
                            <th><%= __('ordersHistory.table.completionDate') %></th>
                            <th><%= __('ordersHistory.table.amount') %></th>
                            <th><%= __('ordersHistory.table.results') %></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody"></tbody>
                </table>
            </div>
            <div class="la-empty-box" id="emptyState" style="display:none">
                <svg class="ic"><use href="#i-circle-check"/></svg>
                <p style="font-weight:700;color:var(--ink);margin:0 0 4px"><%= __('ordersHistory.empty.title') %></p>
                <p style="margin:0"><%= __('ordersHistory.empty.description') %></p>
            </div>
            <div class="la-spinner" id="loadingState"></div>
            <div class="pt-pagination" id="pagination">
                <button class="la-circle press-90" id="prevBtn" onclick="previousPage()" aria-label="previous"><svg class="ic flip-rtl"><use href="#i-chevron-left"/></svg></button>
                <span class="la-sub" id="paginationInfo">1 / 1</span>
                <button class="la-circle press-90" id="nextBtn" onclick="nextPage()" aria-label="next"><svg class="ic flip-rtl"><use href="#i-chevron-right"/></svg></button>
            </div>
        </section>
    </main>

    <!-- Order Detail Modal -->
    <div class="la-modal" id="orderModal" role="dialog" aria-modal="true">
        <div class="la-modal-bg" onclick="closeModal()"></div>
        <div class="la-modal-card">
            <div class="la-between">
                <h3 class="la-h2" style="font-size:18px"><%= __('ordersHistory.modal.title') %></h3>
                <button class="la-circle press-90" onclick="closeModal()" style="width:32px;height:32px;background:var(--segmented);border:0;box-shadow:none" aria-label="close">
                    <svg class="ic" style="width:16px;height:16px"><use href="#i-x"/></svg>
                </button>
            </div>
            <div id="modalBody" style="margin-top:12px"></div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="la-toast" id="toast" style="display:none"></div>

    <script>
        // State
        let currentPage = 1;
        const itemsPerPage = 20;
        let totalPages = 1;
        let stats = <%- JSON.stringify(stats) %>;
        let allOrders = [];
        const demographicsText = <%- JSON.stringify({
            male: __('common.male'),
            female: __('common.female'),
            years: __('common.years'),
            notAvailable: __('common.notAvailable'),
            gender: __('common.gender'),
            age: __('common.age')
        }) %>;

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            updateStats();
            loadOrders();
        });

        // Update statistics display
        function updateStats() {
            document.getElementById('statTotal').textContent = stats.total || 0;
            document.getElementById('statThisMonth').textContent = stats.thisMonth || 0;
            document.getElementById('statRevenue').textContent = formatCurrency(stats.revenue || 0);
        }

        // Load orders from API
        async function loadOrders() {
            showLoading(true);
            hideEmptyState();

            const params = new URLSearchParams({
                status: 'completed',
                page: 1,
                limit: 1000
            });

            // Get filter values
            const fromDate = document.getElementById('filterFromDate').value;
            const toDate = document.getElementById('filterToDate').value;
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();

            try {
                const response = await fetch(`/lab/api/orders?${params}`);
                const result = await response.json();

                if (result.success) {
                    let orders = result.data.orders || [];

                    // Client-side filtering
                    if (fromDate) {
                        orders = orders.filter(o => {
                            const completedDate = o.results && o.results.completedAt ? new Date(o.results.completedAt) : null;
                            return completedDate && new Date(fromDate) <= completedDate;
                        });
                    }
                    if (toDate) {
                        orders = orders.filter(o => {
                            const completedDate = o.results && o.results.completedAt ? new Date(o.results.completedAt) : null;
                            return completedDate && new Date(toDate) >= completedDate;
                        });
                    }
                    if (searchTerm) {
                        orders = orders.filter(o => {
                            const patientName = o.patientInfo?.name ? o.patientInfo.name.toLowerCase() : '';
                            const qrCode = o.qrCode ? o.qrCode.toLowerCase() : '';
                            return patientName.includes(searchTerm) || qrCode.includes(searchTerm);
                        });
                    }

                    allOrders = orders;
                    totalPages = Math.ceil(orders.length / itemsPerPage);
                    const paginatedOrders = orders.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);

                    renderOrders(paginatedOrders);
                    updatePagination();

                    if (orders.length === 0) {
                        showEmptyState();
                    }
                }
            } catch (error) {
                console.error('Load orders error:', error);
                showToast('<%= __('ordersHistory.error') %>', 'error');
            } finally {
                showLoading(false);
            }
        }

        // Render orders table
        function renderOrders(orders) {
            const tbody = document.getElementById('ordersTableBody');
            tbody.innerHTML = orders.map(order => {
                const patient = order.patientInfo || {};
                const patientName = patient.name || 'Unknown';
                const patientMeta = formatPatientMeta(patient);
                const testsCount = order.tests ? order.tests.length : 0;
                const completedDate = order.results && order.results.completedAt ? formatDate(order.results.completedAt) : '-';
                // Show lab's share (labAmount) instead of total
                const labAmount = order.financials && order.financials.labAmount ? formatCurrency(order.financials.labAmount) : '-';
                const reportUrl = order.results && order.results.reportUrl ? order.results.reportUrl : null;

                return `<tr class="order-row" data-order-id="${order._id}"><td><span class="order-id">${order.qrCode || 'N/A'}</span></td><td><div class="patient-cell"><div class="patient-avatar">${getInitials(patientName)}</div><div><div class="patient-name">${patientName}</div><div class="patient-phone">${patientMeta}</div></div></div></td><td><span class="tests-count">${testsCount} <%= __('ordersHistory.table.testsCount') %></span></td><td>${completedDate}</td><td><span class="amount">${labAmount}</span></td><td>${reportUrl ? `<a href="${reportUrl}" target="_blank" class="result-link"><svg class="ic"><use href="#i-download"/></svg> <%= __('ordersHistory.table.downloadResult') %></a>` : `<span class="no-results"><%= __('ordersHistory.table.noResults') %></span>`}</td><td><button class="btn-view-details" onclick="viewOrderDetails('${order._id}')"><svg class="ic"><use href="#i-eye"/></svg> <%= __('ordersHistory.table.viewDetails') %></button></td></tr>`;
            }).join('');
        }

        // View order details in modal
        async function viewOrderDetails(orderId) {
            try {
                const response = await fetch(`/lab/api/orders/${orderId}`);
                const result = await response.json();

                if (result.success) {
                    const order = result.data.order;
                    renderModalContent(order);
                    document.getElementById('orderModal').classList.add('active');
                }
            } catch (error) {
                console.error('View order details error:', error);
                showToast('<%= __('ordersHistory.error') %>', 'error');
            }
        }

        // Render modal content
        function renderModalContent(order) {
            const modalBody = document.getElementById('modalBody');
            const patient = order.patientInfo || {};
            const patientName = patient.name || 'Unknown';
            const tests = order.tests || [];
            // Show lab's share (labAmount) instead of total
            const labAmount = order.financials && order.financials.labAmount ? formatCurrency(order.financials.labAmount) : '0';
            const totalAmount = order.pricing && order.pricing.total ? formatCurrency(order.pricing.total) : '0';
            const labCommissionRate = order.financials && order.financials.labCommissionRate ? order.financials.labCommissionRate : 0;
            const reportUrl = order.results && order.results.reportUrl ? order.results.reportUrl : null;

            modalBody.innerHTML = `
                <div class="modal-section">
                    <h4><%= __('ordersHistory.modal.patientInfo') %></h4>
                    <p><strong>${patientName}</strong></p>
                    <p>${demographicsText.gender}: ${formatPatientGender(patient.gender)}</p>
                    <p>${demographicsText.age}: ${Number.isInteger(patient.age) ? `${patient.age} ${demographicsText.years}` : demographicsText.notAvailable}</p>
                </div>
                <div class="modal-section">
                    <h4><%= __('ordersHistory.modal.testsInfo') %></h4>
                    ${tests.map(test => `
                        <div class="test-item">
                            <span class="test-name">${test.testName || 'Unknown Test'}</span>
                            <span class="test-price">${test.price ? formatCurrency(test.price) : '0'}</span>
                        </div>
                    `).join('')}
                </div>
                <div class="modal-section">
                    <h4><%= __('ordersHistory.modal.paymentInfo') %></h4>
                    <p><%= __('ordersHistory.table.amount') %> (<%= __('common.total') %>): ${totalAmount}</p>
                    <p><%= __('finance.labShare') %> (${labCommissionRate}%): <strong>${labAmount}</strong></p>
                </div>
                <div class="modal-section">
                    <h4><%= __('ordersHistory.modal.resultsInfo') %></h4>
                    ${reportUrl ?
                        `<a href="${reportUrl}" target="_blank" class="btn-download-result">
                            <svg class="ic"><use href="#i-file-text"/></svg> <%= __('ordersHistory.modal.downloadResult') %>
                        </a>` :
                        `<p class="no-result"><%= __('ordersHistory.modal.noResultFile') %></p>`
                    }
                </div>
            `;
        }

        function formatPatientGender(gender) {
            if (gender === 'male') return demographicsText.male;
            if (gender === 'female') return demographicsText.female;
            return demographicsText.notAvailable;
        }

        function formatPatientMeta(patient) {
            const age = Number.isInteger(patient.age)
                ? `${patient.age} ${demographicsText.years}`
                : demographicsText.notAvailable;
            return `${formatPatientGender(patient.gender)} · ${age}`;
        }

        // Close modal
        function closeModal() {
            document.getElementById('orderModal').classList.remove('active');
        }

        // Clear filters
        function clearFilters() {
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';
            document.getElementById('searchInput').value = '';
            currentPage = 1;
            loadOrders();
        }

        // Pagination
        function previousPage() {
            if (currentPage > 1) {
                currentPage--;
                loadOrders();
            }
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                loadOrders();
            }
        }

        function updatePagination() {
            document.getElementById('paginationInfo').textContent = `Page ${currentPage} of ${totalPages}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;
            document.getElementById('nextBtn').disabled = currentPage === totalPages;
        }

        // Utility functions
        function formatCurrency(amount) {
            return new Intl.NumberFormat('<%= currentLang %>', {
                style: 'currency',
                currency: 'IQD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString('<%= currentLang %>');
        }

        function getInitials(name) {
            if (!name) return '??';
            return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
        }

        function showLoading(show) {
            document.getElementById('loadingState').style.display = show ? 'grid' : 'none';
            document.getElementById('ordersTable').style.display = show ? 'none' : 'table';
        }

        function showEmptyState() {
            document.getElementById('emptyState').style.display = 'block';
            document.getElementById('ordersTable').style.display = 'none';
            document.getElementById('pagination').style.display = 'none';
        }

        function hideEmptyState() {
            document.getElementById('emptyState').style.display = 'none';
            document.getElementById('ordersTable').style.display = 'table';
            document.getElementById('pagination').style.display = 'flex';
        }

        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `toast ${type}`;
            toast.style.display = 'block';
            setTimeout(() => toast.style.display = 'none', 3000);
        }

        // Debounce utility
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Event listeners
        document.getElementById('filterFromDate').addEventListener('change', () => { currentPage = 1; loadOrders(); });
        document.getElementById('filterToDate').addEventListener('change', () => { currentPage = 1; loadOrders(); });
        document.getElementById('searchInput').addEventListener('input', debounce(() => { currentPage = 1; loadOrders(); }, 300));

        // Close modal on backdrop click
        document.getElementById('orderModal').addEventListener('click', (e) => {
            if (e.target.id === 'orderModal') closeModal();
        });

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    </script>


</body>
</html>

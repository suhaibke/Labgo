<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= __('nurseManagement.title') %> - LabGo Admin
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-nurses.css">
    <style>
        body {
            font-family: <%=font %>;
        }
    </style>
</head>

<body>
    <!-- Admin Navbar -->
    <%- include('../partials/admin-navbar') %>

        <!-- Main Content -->
        <main class="admin-dashboard">
            <div class="nurse-management-container">

                <!-- Page Header -->
                <div class="page-header">
                    <div class="header-left">
                        <h1>
                            <%= __('nurseManagement.activeNurses') %>
                        </h1>
                        <p class="header-subtitle">
                            <%= __('nurseManagement.subtitle') %>
                        </p>
                    </div>
                    <div class="header-actions">
                        <button class="modern-btn blocked-btn" onclick="window.location.href='/admin/nurses/blocked'">
                            <i class="fas fa-user-slash"></i>
                            <span><%= __('nurseManagement.blockedNurses') %></span>
                            <span class="count-badge" id="blockedNursesCount">0</span>
                        </button>
                        <button class="modern-btn" style="margin-bottom: var(--spacing-md);"
                            onclick="window.location.href='/admin/nurse-applications'">
                            <i class="fas fa-clipboard-list"></i>
                            <span>
                                <%= __('nurseManagement.viewApplications') %>
                            </span>
                            <span class="count-badge" id="pendingApplicationsCount">0</span>
                        </button>
                        <button class="modern-btn refresh-btn" onclick="refreshData()">
                            <i class="fas fa-sync-alt"></i>
                            <span>
                                <%= __('common.refresh') %>
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Active Nurses Section -->
                <section class="main-section">
                    <div class="section-header">
                        <div class="section-title">
                            <i class="fas fa-user-nurse"></i>
                            <h2>
                                <%= __('nurseManagement.allNurses') %>
                            </h2>
                            <span class="count-badge" id="activeNursesCount">-</span>
                        </div>
                        <div class="section-actions">
                            <input type="text" id="nurseSearchInput" class="search-input"
                                placeholder="<%= __('nurseManagement.searchNurses') %>">
                        </div>
                    </div>

                    <!-- Nurses Grid -->
                    <div class="nurses-grid" id="nursesGrid">
                        <div class="loading-state">
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>
                                <%= __('nurseManagement.loadingNurses') %>
                            </span>
                        </div>
                    </div>

                    <!-- Nurses Pagination -->
                    <div class="pagination" id="nursesPagination"></div>
                </section>

            </div>
        </main>

        <!-- Nurse Details Modal -->
        <div class="modal-overlay" id="nurseModal">
            <div class="modal-container nurse-modal">
                <div class="modal-header">
                    <h3>
                        <%= __('nurseManagement.nurseDetails') %>
                    </h3>
                    <button class="modal-close-btn" onclick="closeNurseModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body" id="nurseModalBody">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
        </div>

        <!-- Edit Commission Modal -->
        <div class="modal-overlay" id="editCommissionModal">
            <div class="modal-container commission-modal">
                <div class="modal-header">
                    <h3>
                        <%= __('nurseManagement.editCommissionRate') %>
                    </h3>
                    <button class="modal-close-btn" onclick="closeEditCommissionModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="modal-description" id="currentCommissionDisplay"></p>
                    <div class="commission-input-group">
                        <label for="editCommissionRate">
                            <%= __('nurseManagement.commissionRate') %>
                        </label>
                        <div class="input-wrapper">
                            <input type="number" id="editCommissionRate" class="commission-input" min="0" max="100"
                                step="0.01" placeholder="<%= __('nurseManagement.commissionRatePlaceholder') %>">
                            <span class="input-suffix">%</span>
                        </div>
                        <small class="input-hint">
                            <%= __('nurseManagement.commissionRatePlaceholder') %>
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="modern-btn" onclick="closeEditCommissionModal()">
                        <span>
                            <%= __('common.cancel') %>
                        </span>
                    </button>
                    <button class="modern-btn confirm-btn" onclick="submitCommissionUpdate()">
                        <i class="fas fa-save"></i>
                        <span>
                            <%= __('common.save') %>
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Block Nurse Modal -->
        <div class="modal-overlay" id="blockNurseModal">
            <div class="modal-container block-modal">
                <div class="modal-header">
                    <div class="modal-header-content">
                        <div class="modal-icon-wrapper danger">
                            <i class="fas fa-ban"></i>
                        </div>
                        <div class="modal-header-text">
                            <h3><%= __('nurseManagement.blockNurse') %></h3>
                            <p class="modal-header-subtitle"><%= __('nurseManagement.blockNurseDescription') %></p>
                        </div>
                    </div>
                    <button class="modal-close-btn" onclick="closeBlockNurseModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="block-form-group">
                        <label for="nurseBlockReason" class="block-form-label">
                            <i class="fas fa-exclamation-circle"></i>
                            <%= __('nurseManagement.blockReason') %>
                            <span class="required-mark">*</span>
                        </label>
                        <textarea id="nurseBlockReason" class="block-textarea"
                            placeholder="<%= __('nurseManagement.blockReasonPlaceholder') %>"></textarea>
                        <p class="field-hint"><%= __('nurseManagement.blockReasonPlaceholder') %></p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="modern-btn secondary-btn" onclick="closeBlockNurseModal()">
                        <i class="fas fa-times"></i>
                        <span><%= __('common.cancel') %></span>
                    </button>
                    <button class="modern-btn danger-btn" onclick="submitBlockNurse()">
                        <i class="fas fa-ban"></i>
                        <span><%= __('nurseManagement.confirmBlock') %></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Unblock Nurse Modal -->
        <div class="modal-overlay" id="unblockNurseModal">
            <div class="modal-container unblock-modal">
                <div class="modal-header">
                    <div class="modal-header-content">
                        <div class="modal-icon-wrapper success">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="modal-header-text">
                            <h3><%= __('nurseManagement.unblockNurse') %></h3>
                            <p class="modal-header-subtitle"><%= __('nurseManagement.unblockNurseDescription') %></p>
                        </div>
                    </div>
                    <button class="modal-close-btn" onclick="closeUnblockNurseModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-footer">
                    <button class="modern-btn secondary-btn" onclick="closeUnblockNurseModal()">
                        <i class="fas fa-times"></i>
                        <span><%= __('common.cancel') %></span>
                    </button>
                    <button class="modern-btn success-btn" onclick="submitUnblockNurse()">
                        <i class="fas fa-check"></i>
                        <span><%= __('nurseManagement.confirmUnblock') %></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Notification -->
        <div class="toast-notification" id="toast">
            <div class="toast-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="toast-content">
                <h4 class="toast-title" id="toastTitle">
                    <%= __('common.success') %>
                </h4>
                <p class="toast-message" id="toastMessage">
                    <%= __('common.success') %>
                </p>
            </div>
            <button class="toast-close" onclick="hideToast()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <script>
            const API_BASE = '/api/admin/nurses';
            let currentNursePage = 1;
            let currentNurseId = null;

            // Initialize on page load
            document.addEventListener('DOMContentLoaded', function () {
                loadNurses();
                loadPendingApplicationsCount();
                loadBlockedNursesCount();

                document.getElementById('nurseSearchInput').addEventListener('input', debounce(() => {
                    currentNursePage = 1;
                    loadNurses();
                }, 500));
            });

            // Load blocked nurses count
            async function loadBlockedNursesCount() {
                try {
                    const response = await fetch(`${API_BASE}/blocked?limit=1`, {
                        headers: { 'Authorization': `Bearer ${getToken()}` }
                    });

                    const data = await response.json();

                    if (data.success) {
                        document.getElementById('blockedNursesCount').textContent = data.data.total;
                    }
                } catch (error) {
                    console.error('Error loading blocked nurses count:', error);
                }
            }

            // Load pending applications count
            async function loadPendingApplicationsCount() {
                try {
                    const response = await fetch(`${API_BASE}/stats/overview`, {
                        headers: { 'Authorization': `Bearer ${getToken()}` }
                    });

                    const data = await response.json();

                    if (data.success) {
                        const stats = data.data.stats;
                        const pendingCount = (stats?.pending || 0) + (stats?.underReview || 0);
                        document.getElementById('pendingApplicationsCount').textContent = pendingCount;
                    }
                } catch (error) {
                    console.error('Error loading stats:', error);
                }
            }

            // Load nurses
            async function loadNurses() {
                const searchQuery = document.getElementById('nurseSearchInput').value;

                const params = new URLSearchParams({
                    page: currentNursePage,
                    limit: 12
                });

                if (searchQuery) params.append('search', searchQuery);

                try {
                    const response = await fetch(`${API_BASE}/active?${params}`, {
                        headers: { 'Authorization': `Bearer ${getToken()}` }
                    });

                    const data = await response.json();

                    if (data.success) {
                        renderNurses(data.data.nurses);
                        renderPagination('nursesPagination', data.data.page, data.data.pages, (page) => {
                            currentNursePage = page;
                            loadNurses();
                        });
                        document.getElementById('activeNursesCount').textContent = data.data.total;
                    } else {
                        showError('<%= __('common.error') %>');
                    }
                } catch (error) {
                    console.error('Error loading nurses:', error);
                    showError('<%= __('common.error') %>');
                }
            }

            // Render nurses grid
            function renderNurses(nurses) {
                const container = document.getElementById('nursesGrid');

                if (nurses.length === 0) {
                    container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-user-nurse"></i>
                        <span><%= __('nurseManagement.noNursesFound') %></span>
                    </div>
                `;
                    return;
                }

                container.innerHTML = '<div class="nurses-cards">' + nurses.map(nurse => `
                <div class="nurse-card" onclick="window.location.href='/admin/nurses/${nurse._id}'">
                    <div class="card-header">
                        <div class="nurse-avatar">
                            <i class="fas fa-user-nurse"></i>
                        </div>
                        <div class="nurse-info">
                            <h4 class="nurse-name">${nurse.name}</h4>
                            <p class="nurse-email">${nurse.email}</p>
                        </div>
                        <span class="status-badge ${nurse.status === 'blocked' ? 'blocked' : 'active'}">${nurse.status === 'blocked' ? `<%= __('nurseManagement.blocked') %>` : '<%= __("nurseManagement.approved") %>'}</span>
                    </div>
                    <div class="card-body">
                        <div class="info-row">
                            <i class="fas fa-phone"></i>
                            <span>${nurse.phone}</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-star" style="color: #f59e0b;"></i>
                            <span>${nurse.averageRating ? nurse.averageRating.toFixed(1) : '0.0'} (${nurse.totalRatings || 0} <%= __('nurseManagement.reviews') %>)</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-calendar"></i>
                            <span><%= __('nurseManagement.joinedOn') %>: ${formatDate(nurse.createdAt)}</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="action-btn view" onclick="event.stopPropagation(); window.location.href='/admin/nurses/${nurse._id}'" title="<%= __('common.view') %>">
                            <i class="fas fa-eye"></i>
                        </button>
                        ${nurse.status === 'blocked' ? `
                            <button class="action-btn unblock" onclick="event.stopPropagation(); showUnblockNurseModal('${nurse._id}')" title="<%= __('nurseManagement.unblockNurse') %>">
                                <i class="fas fa-check"></i>
                            </button>
                        ` : `
                            <button class="action-btn block" onclick="event.stopPropagation(); showBlockNurseModal('${nurse._id}')" title="<%= __('nurseManagement.blockNurse') %>">
                                <i class="fas fa-ban"></i>
                            </button>
                        `}
                    </div>
                </div>
            `).join('') + '</div>';
            }

            // Open nurse modal
            async function openNurseModal(nurseId) {
                currentNurseId = nurseId;

                try {
                    const response = await fetch(`${API_BASE}/active/${nurseId}`, {
                        headers: { 'Authorization': `Bearer ${getToken()}` }
                    });

                    const data = await response.json();

                    if (data.success) {
                        console.log('Nurse data received:', data.data);
                        console.log('Applications:', data.data.applications);
                        renderNurseModal(data.data);
                        document.getElementById('nurseModal').classList.add('show');
                    }
                } catch (error) {
                    console.error('Error loading nurse:', error);
                    showError('<%= __('common.error') %>');
                }
            }

            function renderNurseModal(data) {
                const { nurse, applications, orders } = data;
                const modalBody = document.getElementById('nurseModalBody');

                modalBody.innerHTML = `
                <div class="nurse-details">
                    <section class="detail-section">
                        <h4><%= __('nurseManagement.personalInfo') %></h4>
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.name') %></span>
                                <span class="value">${nurse.name}</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.email') %></span>
                                <span class="value">${nurse.email}</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.phone') %></span>
                                <span class="value">${nurse.phone}</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.gender') %></span>
                                <span class="value">${nurse.gender}</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.joinedOn') %></span>
                                <span class="value">${formatDate(nurse.createdAt)}</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.rating') %></span>
                                <span class="value">${renderStarsSmall(nurse.averageRating || 0)} ${(nurse.averageRating || 0).toFixed(1)} (${nurse.totalRatings || 0})</span>
                            </div>
                            <div class="detail-item">
                                <span class="label"><%= __('nurseManagement.commissionRate') %></span>
                                <span class="value">${nurse.nurseCommissionRate || 0}%</span>
                            </div>
                        </div>
                    </section>

                    ${applications.length > 0 && (applications[0].nationalCardImageFront || applications[0].nationalCardImageBack || applications[0].certificateImage) ? `
                    <section class="detail-section">
                        <h4><%= __('nurseManagement.viewDocuments') %></h4>
                        <div class="documents-images-grid">
                            ${applications[0].nationalCardImageFront ? `
                            <div class="document-image-card">
                                <span class="document-label"><%= __('common.front') %> - <%= __('nurseManagement.nationalIdCard') %></span>
                                <img src="${applications[0].nationalCardImageFront}" alt="National ID Front" class="document-image" onclick="window.open(this.src, '_blank')">
                            </div>
                            ` : ''}
                            ${applications[0].nationalCardImageBack ? `
                            <div class="document-image-card">
                                <span class="document-label"><%= __('common.back') %> - <%= __('nurseManagement.nationalIdCard') %></span>
                                <img src="${applications[0].nationalCardImageBack}" alt="National ID Back" class="document-image" onclick="window.open(this.src, '_blank')">
                            </div>
                            ` : ''}
                            ${applications[0].certificateImage ? `
                            <div class="document-image-card">
                                <span class="document-label"><%= __('nurseManagement.nursingCertificate') %></span>
                                <img src="${applications[0].certificateImage}" alt="Nursing Certificate" class="document-image" onclick="window.open(this.src, '_blank')">
                            </div>
                            ` : ''}
                        </div>
                    </section>
                    ` : ''}

                    <section class="detail-section">
                        <h4><%= __('nurseManagement.actions') %></h4>
                        <div class="nurse-actions">
                            <button class="modern-btn confirm-btn" onclick="showEditCommissionModal('${nurse._id}', ${nurse.nurseCommissionRate || 0})">
                                <i class="fas fa-percentage"></i>
                                <span><%= __('nurseManagement.editCommissionRate') %></span>
                            </button>
                        </div>
                    </section>

                    ${applications.length > 0 ? `
                    <section class="detail-section">
                        <h4><%= __('nurseManagement.applicationHistory') %></h4>
                        <div class="applications-history">
                            ${applications.map(app => `
                                <div class="history-item">
                                    <span class="status-badge ${app.status}">${formatStatus(app.status)}</span>
                                    <span>${formatDate(app.submittedAt)}</span>
                                </div>
                            `).join('')}
                        </div>
                    </section>
                    ` : ''}

                    ${orders && orders.length > 0 ? `
                    <section class="detail-section">
                        <h4><%= __('nurseManagement.recentOrders') %></h4>
                        <div class="orders-list">
                            ${orders.map(order => `
                                <div class="order-item">
                                    <span>${order.patientId?.name || 'Unknown'}</span>
                                    <span class="status-badge ${order.status}">${order.status}</span>
                                </div>
                            `).join('')}
                        </div>
                    </section>
                    ` : ''}
                </div>
            `;
            }

            function closeNurseModal() {
                document.getElementById('nurseModal').classList.remove('show');
                currentNurseId = null;
            }

            function showEditCommissionModal(nurseId, currentRate) {
                currentNurseId = nurseId;
                document.getElementById('editCommissionRate').value = currentRate;
                document.getElementById('currentCommissionDisplay').textContent = '<%= __("nurseManagement.currentCommissionRate") %>'.replace('{rate}', currentRate);
                document.getElementById('editCommissionModal').classList.add('show');
            }

            function closeEditCommissionModal() {
                document.getElementById('editCommissionModal').classList.remove('show');
                document.getElementById('editCommissionRate').value = '';
                currentNurseId = null;
            }

            async function submitCommissionUpdate() {
                const commissionRate = document.getElementById('editCommissionRate').value.trim();

                if (!commissionRate) {
                    showToast('error', '<%= __('nurseManagement.commissionRateRequired') %>');
                    return;
                }

                const parsedRate = parseFloat(commissionRate);
                if (isNaN(parsedRate) || parsedRate < 0 || parsedRate > 100) {
                    showToast('error', '<%= __('nurseManagement.commissionRateInvalid') %>');
                    return;
                }

                try {
                    const response = await fetch(`${API_BASE}/active/${currentNurseId}/commission`, {
                        method: 'PATCH',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ commissionRate: parsedRate })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('success', '<%= __('nurseManagement.commissionRateUpdated') %>');
                        closeEditCommissionModal();
                        closeNurseModal();
                        loadNurses();
                    } else {
                        showToast('error', data.message);
                    }
                } catch (error) {
                    showToast('error', '<%= __('common.error') %>');
                }
            }

            // Block/Unblock nurse functions
            function showBlockNurseModal(nurseId) {
                currentNurseId = nurseId;
                document.getElementById('nurseBlockReason').value = '';
                document.getElementById('blockNurseModal').classList.add('show');
            }

            function closeBlockNurseModal() {
                document.getElementById('blockNurseModal').classList.remove('show');
                document.getElementById('nurseBlockReason').value = '';
                currentNurseId = null;
            }

            async function submitBlockNurse() {
                const reason = document.getElementById('nurseBlockReason').value.trim();

                if (!reason) {
                    showToast('error', '<%= __('nurseManagement.blockReasonRequired') %>');
                    return;
                }

                try {
                    const response = await fetch(`${API_BASE}/active/${currentNurseId}/block`, {
                        method: 'PATCH',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reason })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('success', '<%= __('nurseManagement.nurseBlocked') %>');
                        closeBlockNurseModal();
                        loadNurses();
                    } else {
                        showToast('error', data.message);
                    }
                } catch (error) {
                    showToast('error', '<%= __("common.error") %>');
                }
            }

            function showUnblockNurseModal(nurseId) {
                currentNurseId = nurseId;
                document.getElementById('unblockNurseModal').classList.add('show');
            }

            function closeUnblockNurseModal() {
                document.getElementById('unblockNurseModal').classList.remove('show');
                currentNurseId = null;
            }

            async function submitUnblockNurse() {
                try {
                    const response = await fetch(`${API_BASE}/active/${currentNurseId}/unblock`, {
                        method: 'PATCH',
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('success', '<%= __('nurseManagement.nurseUnblocked') %>');
                        closeUnblockNurseModal();
                        loadNurses();
                    } else {
                        showToast('error', data.message);
                    }
                } catch (error) {
                    showToast('error', '<%= __("common.error") %>');
                }
            }

            // Pagination
            function renderPagination(containerId, currentPage, totalPages, onPageChange) {
                const container = document.getElementById(containerId);

                if (totalPages <= 1) {
                    container.innerHTML = '';
                    return;
                }

                let html = '';

                if (currentPage > 1) {
                    html += `<button class="pagination-btn" onclick="pageChange(${currentPage - 1})"><i class="fas fa-chevron-left"></i></button>`;
                }

                for (let i = 1; i <= totalPages; i++) {
                    if (i === currentPage) {
                        html += `<button class="pagination-btn active">${i}</button>`;
                    } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                        html += `<button class="pagination-btn" onclick="pageChange(${i})">${i}</button>`;
                    } else if (i === currentPage - 2 || i === currentPage + 2) {
                        html += `<span class="pagination-ellipsis">...</span>`;
                    }
                }

                if (currentPage < totalPages) {
                    html += `<button class="pagination-btn" onclick="pageChange(${currentPage + 1})"><i class="fas fa-chevron-right"></i></button>`;
                }

                container.innerHTML = html;

                // Store the page change function
                container._onPageChange = onPageChange;
            }

            function pageChange(page) {
                const container = document.querySelector('.pagination:hover') || document.getElementById('nursesPagination');
                if (container && container._onPageChange) {
                    container._onPageChange(page);
                }
            }

            // Utility functions
            function formatStatus(status) {
                const statusMap = {
                    'pending': '<%= __("nurseManagement.pendingReview") %>',
                    'under_review': '<%= __("nurseManagement.underReview") %>',
                    'approved': '<%= __("nurseManagement.approved") %>',
                    'rejected': '<%= __("nurseManagement.rejected") %>',
                    'on_hold': '<%= __("nurseManagement.onHold") %>'
                };
                return statusMap[status] || status;
            }

            function formatDate(dateString) {
                if (!dateString) return '-';
                const date = new Date(dateString);
                return date.toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            function renderStarsSmall(rating) {
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    if (i <= rating) {
                        stars += '<i class="fas fa-star" style="color: #f59e0b; font-size: 12px;"></i>';
                    } else if (i - 0.5 <= rating) {
                        stars += '<i class="fas fa-star-half-alt" style="color: #f59e0b; font-size: 12px;"></i>';
                    } else {
                        stars += '<i class="far fa-star" style="color: #d1d5db; font-size: 12px;"></i>';
                    }
                }
                return stars;
            }

            function refreshData() {
                loadNurses();
                loadPendingApplicationsCount();
                showToast('success', '<%= __('common.success') %>');
            }

            function getToken() {
                return localStorage.getItem('token') || '';
            }

            function showToast(type, message) {
                const toast = document.getElementById('toast');
                const icon = toast.querySelector('.toast-icon i');
                const title = toast.querySelector('.toast-title');
                const msg = toast.querySelector('.toast-message');

                icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
                toast.classList.remove('success', 'error');
                toast.classList.add(type);
                title.textContent = type === 'success' ? '<%= __("common.success") %>' : '<%= __("common.error") %>';
                msg.textContent = message;

                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 3000);
            }

            function showError(message) {
                showToast('error', message);
            }

            function hideToast() {
                document.getElementById('toast').classList.remove('show');
            }

            // Close modals on overlay click
            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function (e) {
                    if (e.target === this) {
                        this.classList.remove('show');
                    }
                });
            });

            // Close modals with Escape key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-overlay').forEach(modal => {
                        modal.classList.remove('show');
                    });
                }
            });
        </script>
</body>

</html>
                                <th class="col-money"><%= __('finance.amount') %></th>
                                <th class="col-date"><%= __('finance.date') %></th>
                                <th class="col-actions"><%= __('actions') %></th>
                            </tr>
                        </thead>
                        <tbody id="patientOrdersBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closePatientDetails()"><%= __('finance.close') || 'Close' %></button>
            </div>
        </div>
    </div>

    <!-- Order Details Modal -->
    <div class="modal" id="orderDetailsModal">
        <div class="modal-content" style="max-width: 800px;">
            <div class="modal-header">
                <h3 class="modal-title"><%= __('finance.orderDetails') || 'Order Details' %></h3>
                <button class="modal-close" onclick="closeOrderDetails()">&times;</button>
            </div>
            <div class="modal-body" style="padding: 0;">
                <div id="orderDetailsContent">
                    <div style="text-align: center; padding: 40px;">
                        <i class="fas fa-spinner fa-spin" style="font-size: 24px;"></i>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeOrderDetails()"><%= __('finance.close') || 'Close' %></button>
            </div>
        </div>
    </div>

    <input type="hidden" id="selectedNurseId">

    <script>
        // Translations
        const i18n = <%- JSON.stringify({
            finance: {
                noNursesFound: __('finance.noNursesFound'),
                noPatientsFound: __('finance.noPatientsFound'),
                noLabsFound: __('finance.noLabsFound'),
                allSettled: __('finance.allSettled'),
                noPendingSettlements: __('finance.noPendingSettlements'),
                noTransactionsFound: __('finance.noTransactionsFound'),
                view: __('finance.view'),
                commissionFromNurse: __('finance.commissionFromNurse'),
                directPaymentsLab: __('finance.directPaymentsLab'),
                netEarningsAfterCommission: __('finance.netEarningsAfterCommission'),
                labShare: __('finance.labShare'),
                adminShare: __('finance.adminShare'),
                nurseEarningsLabel: __('finance.nurseEarningsLabel'),
                enterCommissionRate: __('finance.enterCommissionRate'),
                validRateRange: __('finance.validRateRange'),
                errorUpdatingRate: __('finance.errorUpdatingRate'),
                commissionUpdated: __('finance.commissionUpdated'),
                resetBalanceToZero: __('finance.resetBalanceToZero'),
                settle: __('finance.settle'),
                editRate: __('finance.editRate'),
                error: __('finance.settlementError'),
                labPayments: __('finance.labPayments'),
                nurseEarnings: __('finance.nurseEarnings'),
                commissionEarned: __('finance.commissionEarned'),
                adminSettlement: __('finance.adminSettlement'),
                labSettlementLabel: __('finance.labSettlementLabel'),
                balanceAdjustment: __('finance.balanceAdjustment'),
                orderPayment: __('finance.orderPayment'),
                selectDateRange: __('finance.selectDateRange'),
                invalidDateRange: __('finance.invalidDateRange'),
                allTime: __('finance.allTime')
            }
        }) %>;

        // State
        const state = {
            filter: { start: null, end: null },
            nurses: [],
            patients: [],
            labs: [],
            pending: [],
            transactions: [],
            orders: [],
            dateFilter: {
                mode: 'thisMonth', // today, thisMonth, lastMonth, thisYear, custom
                startDate: null,
                endDate: null
            }
        };

        // Token helper
        function getToken() {
            return localStorage.getItem('token') || '';
        }

        // Money formatter
        function formatMoney(amount) {
            if (!amount && amount !== 0) return '—';
            return new Intl.NumberFormat('<%= currentLang %>', {
                style: 'currency',
                currency: 'IQD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        // Date formatter
        function formatDate(date) {
            if (!date) return '—';
            return new Date(date).toLocaleDateString('<%= currentLang %>');
        }

        // ==================== DATE FILTER FUNCTIONS ====================

        // Get date range for preset
        function getDateRangeForPreset(preset) {
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            switch (preset) {
                case 'today':
                    return {
                        start: new Date(today.setHours(0, 0, 0, 0)),
                        end: new Date(new Date(today).setHours(23, 59, 59, 999))
                    };

                case 'thisMonth':
                    const firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
                    const lastDayOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);
                    return { start: firstDayOfMonth, end: lastDayOfMonth };

                case 'lastMonth':
                    const firstDayOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    const lastDayOfLastMonth = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59, 59, 999);
                    return { start: firstDayOfLastMonth, end: lastDayOfLastMonth };

                case 'thisYear':
                    const firstDayOfYear = new Date(now.getFullYear(), 0, 1);
                    const lastDayOfYear = new Date(now.getFullYear(), 11, 31, 23, 59, 59, 999);
                    return { start: firstDayOfYear, end: lastDayOfYear };

                case 'custom':
                    return {
                        start: state.dateFilter.startDate ? new Date(state.dateFilter.startDate) : null,
                        end: state.dateFilter.endDate ? new Date(state.dateFilter.endDate) : null
                    };

                default:
                    return { start: null, end: null };
            }
        }

        // Format date for input value (YYYY-MM-DD)
        function formatDateForInput(date) {
            if (!date) return '';
            const d = new Date(date);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Format date range for display
        function formatDateRangeDisplay(start, end) {
            if (!start && !end) return i18n.finance.allTime || 'All Time';

            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            const startStr = start ? start.toLocaleDateString('<%= currentLang %>', options) : '...';
            const endStr = end ? end.toLocaleDateString('<%= currentLang %>', options) : '...';

            if (start && end && start.getTime() === end.getTime()) {
                return startStr;
            }

            return `${startStr} → ${endStr}`;
        }

        // Apply date filter
        async function applyDateFilter(mode, customStart = null, customEnd = null) {
            state.dateFilter.mode = mode;

            if (mode === 'custom' && customStart && customEnd) {
                state.dateFilter.startDate = customStart;
                state.dateFilter.endDate = customEnd;

                // Set end date to end of day
                const endDate = new Date(customEnd);
                endDate.setHours(23, 59, 59, 999);
                state.dateFilter.endDate = endDate;
            } else {
                const range = getDateRangeForPreset(mode);
                state.dateFilter.startDate = range.start;
                state.dateFilter.endDate = range.end;
            }

            // Update filter state for API calls
            state.filter.start = state.dateFilter.startDate ? state.dateFilter.startDate.toISOString() : null;
            state.filter.end = state.dateFilter.endDate ? state.dateFilter.endDate.toISOString() : null;

            // Update UI
            updateDateFilterUI();

            // Reload data with new filter
            await loadDataWithFilter();
        }

        // Update date filter UI
        function updateDateFilterUI() {
            // Update display
            const displayEl = document.getElementById('dateRangeDisplay');
            displayEl.textContent = formatDateRangeDisplay(state.dateFilter.startDate, state.dateFilter.endDate);

            // Update preset buttons
            document.querySelectorAll('.date-preset-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.preset === state.dateFilter.mode);
            });

            // Show/hide custom inputs
            const customInputs = document.getElementById('customDateInputs');
            customInputs.classList.toggle('visible', state.dateFilter.mode === 'custom');

            // Update custom input values
            if (state.dateFilter.mode === 'custom') {
                document.getElementById('dateFrom').value = formatDateForInput(state.dateFilter.startDate);
                document.getElementById('dateTo').value = formatDateForInput(state.dateFilter.endDate);
            }
        }

        // Load all data with current filter
        async function loadDataWithFilter() {
            // Show loading state
            document.querySelector('.date-filter-container').classList.add('date-filter-loading');

            try {
                await Promise.all([
                    loadOverview(),
                    loadOrders(),
                    // Note: Other tabs (nurses, patients, labs, pending) could also be filtered
                    // but typically show all-time data while overview shows filtered data
                ]);
            } finally {
                // Remove loading state
                document.querySelector('.date-filter-container').classList.remove('date-filter-loading');
            }
        }

        // Get initials
        function getInitials(name) {
            if (!name) return '?';
            return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
        }

        // Get balance class
        function getBalanceClass(balance) {
            if (balance > 0) return 'badge-red';
            if (balance < 0) return 'badge-green';
            return 'badge-gray';
        }

        // Load Overview
        async function loadOverview() {
            try {
                const params = new URLSearchParams();
                if (state.filter.start) params.append('startDate', state.filter.start);
                if (state.filter.end) params.append('endDate', state.filter.end);

                const res = await fetch(`/api/admin/finance/overview?${params}`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    const overview = result.data.overview || {};
                    const nurseStats = result.data.nurseStats || {};
                    const pending = result.data.pendingSettlements || {};

                    const revenue = overview.totalRevenue || 0;
                    document.getElementById('statRevenue').textContent = formatMoney(revenue);
                    document.getElementById('statOrders').textContent = overview.orderCount || 0;
                    document.getElementById('statAdmin').textContent = formatMoney(overview.totalAdminAmount || 0);
                    document.getElementById('statNurse').textContent = formatMoney(nurseStats.totalNurseBalance || 0);
                    document.getElementById('statNurseCount').textContent = nurseStats.nurseCount || 0;
                    document.getElementById('statPending').textContent = formatMoney(pending.adminAmount || 0);
                    document.getElementById('statPendingCount').textContent = pending.adminOrderCount || 0;

                    document.getElementById('overviewRevenue').textContent = formatMoney(revenue);
                    document.getElementById('overviewAdmin').textContent = formatMoney(overview.totalAdminAmount || 0);
                    document.getElementById('overviewLab').textContent = formatMoney(overview.totalLabAmount || 0);
                    document.getElementById('overviewNurse').textContent = formatMoney(overview.totalNurseNetEarning || 0);

                    const total = revenue || 1;
                    const data = [
                        { type: i18n.finance.adminShare, amount: overview.totalAdminAmount || 0, desc: i18n.finance.commissionFromNurse, color: 'blue', icon: 'fa-chart-line' },
                        { type: i18n.finance.labPayments, amount: overview.totalLabAmount || 0, desc: i18n.finance.directPaymentsLab, color: 'purple', icon: 'fa-flask' },
                        { type: i18n.finance.nurseEarningsLabel, amount: overview.totalNurseNetEarning || 0, desc: i18n.finance.netEarningsAfterCommission, color: 'green', icon: 'fa-user-nurse' },
                    ];

                    document.getElementById('overviewBody').innerHTML = data.map(item => `
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar" style="width: 32px; height: 32px; font-size: 12px;">
                                        <i class="fas ${item.icon}"></i>
                                    </div>
                                    <strong>${item.type}</strong>
                                </div>
                            </td>
                            <td>${formatMoney(item.amount)}</td>
                            <td><span class="badge badge-${item.color}">${((item.amount / total) * 100).toFixed(1)}%</span></td>
                            <td style="color: var(--text-secondary);">${item.desc}</td>
                        </tr>
                    `).join('');

                    document.getElementById('badgeNurses').textContent = nurseStats.nurseCount || 0;
                    document.getElementById('badgePending').textContent = pending.adminOrderCount || 0;
                }
            } catch (e) {
                console.error('Overview error:', e);
            }
        }

        // Load Nurses
        async function loadNurses() {
            try {
                const res = await fetch('/api/admin/finance/nurses', {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    state.nurses = result.data.nurses || [];
                    document.getElementById('badgeNurses').textContent = state.nurses.length;
                    renderNurses(state.nurses);
                }
            } catch (e) {
                console.error('Nurses error:', e);
            }
        }

        // Render Nurses
        function renderNurses(nurses) {
            const tbody = document.getElementById('nursesBody');

            if (!nurses.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-user-nurse"></i><h3>${i18n.finance.noNursesFound}</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = nurses.map(n => `
                <tr>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar">${getInitials(n.name)}</div>
                            <div class="user-info">
                                <div class="user-name">${n.name || 'Unknown'}</div>
                                <div class="user-contact">${n.phone || ''}</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge ${getBalanceClass(n.nurseBalance)}">${formatMoney(n.nurseBalance)}</span></td>
                    <td>${n.stats?.totalOrders || 0}</td>
                    <td>${formatMoney(n.stats?.totalCollected)}</td>
                    <td>${formatMoney(n.totalPaidToAdmin)}</td>
                    <td>${formatDate(n.lastSettlementDate)}</td>
                    <td>
                        <div style="display: flex; gap: 6px; justify-content: center;">
                            <button class="btn btn-secondary btn-sm" onclick='viewNurseDetails("${n._id}", "${n.name}")'>
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-primary btn-sm" onclick='openSettle(${JSON.stringify({ id: n._id, name: n.name, balance: n.nurseBalance })})'>
                                ${i18n.finance.settle}
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Filter Nurses
        function filterNurses() {
            const query = document.getElementById('searchNurses').value.toLowerCase();
            const filtered = state.nurses.filter(n =>
                (n.name || '').toLowerCase().includes(query) ||
                (n.phone || '').includes(query)
            );
            renderNurses(filtered);
        }

        // Load Patients
        async function loadPatients() {
            try {
                const res = await fetch('/api/admin/finance/patients?limit=1000&sortBy=totalSpent&sortOrder=desc', {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    state.patients = result.data.patients || [];
                    document.getElementById('badgePatients').textContent = state.patients.length;

                    const totalCount = state.patients.length;
                    const totalSpent = state.patients.reduce((sum, p) => sum + (p.stats?.totalSpent || 0), 0);
                    const totalOrders = state.patients.reduce((sum, p) => sum + (p.stats?.totalOrders || 0), 0);
                    const avgOrder = totalOrders > 0 ? totalSpent / totalOrders : 0;

                    document.getElementById('patientTotalCount').textContent = totalCount;
                    document.getElementById('patientTotalSpent').textContent = formatMoney(totalSpent);
                    document.getElementById('patientTotalOrders').textContent = totalOrders;
                    document.getElementById('patientAvgOrder').textContent = totalOrders > 0 ? formatMoney(avgOrder) : '—';

                    document.getElementById('patientsTableWrapper').style.display = 'none';
                    document.getElementById('patientsEmptySearch').style.display = 'none';
                }
            } catch (e) {
                console.error('Patients error:', e);
            }
        }

        // Render Patients
        function renderPatients(patients) {
            const tbody = document.getElementById('patientsBody');

            if (!patients.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-users"></i><h3>${i18n.finance.noPatientsFound}</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = patients.map(p => {
                const stats = p.stats || {};
                return `
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar green">${getInitials(p.name)}</div>
                                <div class="user-info">
                                    <div class="user-name">${p.name || 'Unknown'}</div>
                                    <div class="user-contact">${p.phone || ''}</div>
                                </div>
                            </div>
                        </td>
                        <td>${stats.totalOrders || 0}</td>
                        <td>${formatMoney(stats.totalSpent)}</td>
                        <td>${stats.completedOrders || 0}</td>
                        <td>${formatMoney(stats.averageOrderValue)}</td>
                        <td>${formatDate(p.recentOrders?.[0]?.createdAt)}</td>
                        <td>
                            <button class="btn btn-secondary btn-sm" onclick="viewPatient('${p._id}')">
                                ${i18n.finance.view}
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Filter Patients
        function filterPatients() {
            const query = document.getElementById('searchPatients').value.toLowerCase().trim();
            const tableWrapper = document.getElementById('patientsTableWrapper');
            const emptySearch = document.getElementById('patientsEmptySearch');

            if (!query) {
                tableWrapper.style.display = 'none';
                emptySearch.style.display = 'none';
                return;
            }

            tableWrapper.style.display = 'block';
            emptySearch.style.display = 'none';

            const filtered = state.patients.filter(p =>
                (p.name || '').toLowerCase().includes(query) ||
                (p.phone || '').includes(query)
            );
            renderPatients(filtered);
        }

        // Load Labs
        async function loadLabs() {
            try {
                const res = await fetch('/api/admin/finance/labs', {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    state.labs = result.data.labs || [];
                    document.getElementById('badgeLabs').textContent = state.labs.length;
                    renderLabs(state.labs);
                }
            } catch (e) {
                console.error('Labs error:', e);
            }
        }

        // Render Labs
        function renderLabs(labs) {
            const tbody = document.getElementById('labsBody');

            if (!labs.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-flask"></i><h3>${i18n.finance.noLabsFound}</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = labs.map(l => {
                const stats = l.stats || {};
                return `
                    <tr>
                        <td><strong>${l.name || 'Unknown'}</strong></td>
                        <td><span class="badge badge-purple">${l.commissionRate || 0}%</span></td>
                        <td>${stats.totalOrders || 0}</td>
                        <td>${formatMoney(stats.totalRevenue)}</td>
                        <td>${formatMoney(stats.labAmount)}</td>
                        <td>${formatMoney(stats.adminAmount)}</td>
                        <td>
                            <button class="btn btn-secondary btn-sm" onclick="editCommission('${l._id}', ${l.commissionRate})">
                                ${i18n.finance.editRate}
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Filter Labs
        function filterLabs() {
            const query = document.getElementById('searchLabs').value.toLowerCase();
            const filtered = state.labs.filter(l =>
                (l.name || '').toLowerCase().includes(query)
            );
            renderLabs(filtered);
        }

        // Load Pending Settlements
        async function loadPending() {
            try {
                const res = await fetch('/api/admin/finance/pending-admin-settlements', {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    state.pending = result.data.settlements || [];
                    renderPending(state.pending);

                    const totalAmount = state.pending.reduce((sum, p) => sum + (p.adminAmount || 0), 0);
                    const totalOrders = state.pending.reduce((sum, p) => sum + (p.orderCount || 0), 0);
                    const nurseCount = new Set(state.pending.filter(p => p.nurseId?._id).map(p => p.nurseId._id)).size;

                    document.getElementById('pendingTotal').textContent = formatMoney(totalAmount);
                    document.getElementById('pendingOrders').textContent = totalOrders || 0;
                    document.getElementById('pendingNurses').textContent = nurseCount || 0;
                    document.getElementById('pendingAvg').textContent = totalOrders > 0 ? formatMoney(totalAmount / totalOrders) : '—';
                    document.getElementById('badgePending').textContent = state.pending.length || 0;
                }
            } catch (e) {
                console.error('Pending error:', e);
            }
        }

        // Render Pending
        function renderPending(pending) {
            const tbody = document.getElementById('pendingBody');

            if (!pending || !pending.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-check-circle" style="color: var(--accent-green);"></i><h3>${i18n.finance.allSettled}</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = pending.map(p => `
                <tr>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar">${getInitials(p.nurseId?.name)}</div>
                            <div class="user-info">
                                <div class="user-name">${p.nurseId?.name || 'Unknown'}</div>
                                <div class="user-contact">${p.nurseId?.phone || ''}</div>
                            </div>
                        </div>
                    </td>
                    <td>${p.orderCount || 0}</td>
                    <td>${p.labId?.name || '—'}</td>
                    <td>${formatMoney(p.totalAmount || 0)}</td>
                    <td>${formatMoney(p.adminAmount || 0)}</td>
                    <td><span class="badge badge-purple">${p.nurseCommissionRate || 0}%</span></td>
                    <td>${formatDate(p.latestOrderDate)}</td>
                </tr>
            `).join('');
        }

        // View Nurse Details
        async function viewNurseDetails(nurseId, nurseName) {
            document.getElementById('nurseDetailsTitle').textContent = nurseName;
            document.getElementById('nurseOrdersBody').innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px;"><i class="fas fa-spinner fa-spin"></i></td></tr>';
            document.getElementById('nurseDetailsModal').classList.add('show');

            try {
                const res = await fetch(`/api/admin/finance/nurses/${nurseId}/orders`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    const orders = result.data.orders || [];

                    const totalOrders = orders.length;
                    const totalCollected = orders.reduce((sum, o) => sum + (o.pricing?.total || 0), 0);
                    const totalNurseEarnings = orders.reduce((sum, o) => sum + (o.financials?.nurseNetEarning || 0), 0);
                    const totalAdminAmount = orders.reduce((sum, o) => sum + (o.financials?.adminAmount || 0), 0);

                    document.getElementById('nurseDetailOrders').textContent = totalOrders;
                    document.getElementById('nurseDetailCollected').textContent = formatMoney(totalCollected);
                    document.getElementById('nurseDetailEarnings').textContent = formatMoney(totalNurseEarnings);
                    document.getElementById('nurseDetailAdmin').textContent = formatMoney(totalAdminAmount);

                    const tbody = document.getElementById('nurseOrdersBody');

                    if (!orders.length) {
                        tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-clipboard-list"></i><h3>No orders found</h3></td></tr>`;
                        return;
                    }

                    tbody.innerHTML = orders.map(o => {
                        const statusBadges = {
                            'sample_collected': 'badge-orange',
                            'at_lab': 'badge-blue',
                            'completed': 'badge-green',
                            'cancelled': 'badge-red'
                        };
                        const statusClass = statusBadges[o.status] || 'badge-gray';

                        return `
                            <tr>
                                <td>
                                    <span class="badge ${statusClass}">${o.status}</span>
                                    <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">${o.qrCode || ''}</div>
                                </td>
                                <td>
                                    <div style="font-weight: 500;">${o.patientId?.name || 'Unknown'}</div>
                                    <div style="font-size: 11px; color: var(--text-secondary);">${o.patientId?.phone || ''}</div>
                                </td>
                                <td>${o.labId?.name || 'Unknown'}</td>
                                <td>${formatMoney(o.pricing?.total)}</td>
                                <td>${formatMoney(o.financials?.nurseNetEarning)}</td>
                                <td>${formatMoney(o.financials?.adminAmount)}</td>
                                <td>${formatDate(o.createdAt)}</td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (e) {
                console.error('Nurse details error:', e);
                document.getElementById('nurseOrdersBody').innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-exclamation-circle" style="color: var(--accent-red);"></i><h3>Error loading details</h3></td></tr>`;
            }
        }

        function closeNurseDetails() {
            document.getElementById('nurseDetailsModal').classList.remove('show');
        }

        function openSettle(data) {
            document.getElementById('selectedNurseId').value = data.id;
            document.getElementById('modalNurseName').textContent = data.name;
            document.getElementById('modalBalance').textContent = formatMoney(data.balance);
            document.getElementById('settleAmount').value = data.balance;
            document.getElementById('settleModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('settleModal').classList.remove('show');
        }

        async function settleBalance() {
            const id = document.getElementById('selectedNurseId').value;
            const amount = document.getElementById('settleAmount').value;
            const notes = document.getElementById('settleNotes').value;

            try {
                const res = await fetch(`/api/admin/finance/nurses/${id}/settle`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ amount: parseFloat(amount), notes })
                });

                const result = await res.json();
                if (result.success) {
                    closeModal();
                    await loadAll();
                } else {
                    alert(i18n.finance.error + ': ' + result.message);
                }
            } catch (e) {
                console.error('Settle error:', e);
                alert(i18n.finance.error);
            }
        }

        async function resetBalance() {
            if (!confirm(i18n.finance.resetBalanceToZero)) return;

            const id = document.getElementById('selectedNurseId').value;
            const notes = document.getElementById('settleNotes').value;

            try {
                const res = await fetch(`/api/admin/finance/nurses/${id}/reset`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ notes })
                });

                const result = await res.json();
                if (result.success) {
                    closeModal();
                    await loadAll();
                } else {
                    alert(i18n.finance.error + ': ' + result.message);
                }
            } catch (e) {
                console.error('Reset error:', e);
                alert(i18n.finance.error);
            }
        }

        async function editCommission(labId, currentRate) {
            const newRate = prompt(i18n.finance.enterCommissionRate, currentRate);
            if (newRate === null) return;

            const rate = parseFloat(newRate);
            if (isNaN(rate) || rate < 0 || rate > 100) {
                alert(i18n.finance.validRateRange);
                return;
            }

            try {
                const res = await fetch(`/api/admin/finance/labs/${labId}/commission`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ commissionRate: rate })
                });

                const result = await res.json();
                if (result.success) {
                    alert(i18n.finance.commissionUpdated);
                    await loadLabs();
                } else {
                    alert(i18n.finance.errorUpdatingRate + ': ' + result.message);
                }
            } catch (e) {
                console.error('Update error:', e);
                alert(i18n.finance.errorUpdatingRate);
            }
        }

        // ==================== ORDERS FUNCTIONS ====================

        // Load Orders
        async function loadOrders() {
            try {
                const params = new URLSearchParams();
                if (state.filter.start) params.append('startDate', state.filter.start);
                if (state.filter.end) params.append('endDate', state.filter.end);
                params.append('limit', '500');

                const res = await fetch(`/api/admin/orders/all?${params}`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    state.orders = result.data.orders || [];
                    document.getElementById('badgeOrders').textContent = state.orders.length;
                    
                    const totalCount = state.orders.length;
                    const totalRevenue = state.orders.reduce((sum, o) => sum + (o.pricing?.total || 0), 0);
                    const completedCount = state.orders.filter(o => o.status === 'completed').length;
                    const avgValue = totalCount > 0 ? totalRevenue / totalCount : 0;

                    document.getElementById('ordersTotalCount').textContent = totalCount;
                    document.getElementById('ordersTotalRevenue').textContent = formatMoney(totalRevenue);
                    document.getElementById('ordersCompleted').textContent = completedCount;
                    document.getElementById('ordersAvgValue').textContent = totalCount > 0 ? formatMoney(avgValue) : '—';

                    renderOrders(state.orders);
                }
            } catch (e) {
                console.error('Orders error:', e);
            }
        }

        // Render Orders
        function renderOrders(orders) {
            const tbody = document.getElementById('ordersBody');

            if (!orders || !orders.length) {
                tbody.innerHTML = `<tr><td colspan="8" class="empty-state"><i class="fas fa-receipt"></i><h3>No orders found</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = orders.map(o => `
                <tr onclick="viewOrderDetails('${o._id}')" style="cursor: pointer;">
                    <td><span class="badge ${getStatusBadgeClass(o.status)}">${o.status || 'Unknown'}</span></td>
                    <td><code style="font-size: 11px;">${o.qrCode || '—'}</code></td>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar green">${getInitials(o.patientId?.name)}</div>
                            <div class="user-info">
                                <div class="user-name">${o.patientId?.name || 'Unknown'}</div>
                                <div class="user-contact">${o.patientId?.phone || ''}</div>
                            </div>
                        </div>
                    </td>
                    <td>${o.nurseId?.name || '—'}</td>
                    <td>${o.labId?.name || '—'}</td>
                    <td>${formatMoney(o.pricing?.total || 0)}</td>
                    <td>${formatDate(o.createdAt)}</td>
                    <td>
                        <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); viewOrderDetails('${o._id}')">
                            ${i18n.finance.view}
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        // Filter Orders
        function filterOrders() {
            const query = document.getElementById('searchOrders').value.toLowerCase().trim();
            const statusFilter = document.getElementById('orderStatusFilter').value;

            let filtered = state.orders;

            if (statusFilter) {
                filtered = filtered.filter(o => o.status === statusFilter);
            }

            if (query) {
                filtered = filtered.filter(o =>
                    (o.patientId?.name || '').toLowerCase().includes(query) ||
                    (o.patientId?.phone || '').includes(query) ||
                    (o.nurseId?.name || '').toLowerCase().includes(query) ||
                    (o.labId?.name || '').toLowerCase().includes(query) ||
                    (o.qrCode || '').toLowerCase().includes(query)
                );
            }

            renderOrders(filtered);
        }

        // Get status badge class
        function getStatusBadgeClass(status) {
            switch(status) {
                case 'completed': return 'badge-green';
                case 'pending': return 'badge-orange';
                case 'confirmed': return 'badge-blue';
                case 'assigned': return 'badge-purple';
                case 'sample_collected': return 'badge-cyan';
                case 'at_lab': return 'badge-blue';
                case 'cancelled': return 'badge-red';
                default: return 'badge-gray';
            }
        }

        // ==================== VIEW ORDER DETAILS ====================

        async function viewOrderDetails(orderId) {
            document.getElementById('orderDetailsContent').innerHTML = `
                <div style="text-align: center; padding: 40px;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 24px;"></i>
                </div>
            `;
            document.getElementById('orderDetailsModal').classList.add('show');

            try {
                const res = await fetch(`/api/admin/orders/${orderId}`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    const order = result.data.order;
                    renderOrderDetails(order);
                } else {
                    document.getElementById('orderDetailsContent').innerHTML = `
                        <div style="text-align: center; padding: 40px; color: var(--accent-red);">
                            <i class="fas fa-exclamation-circle"></i>
                            <p>Failed to load order details</p>
                        </div>
                    `;
                }
            } catch (e) {
                console.error('Order details error:', e);
                document.getElementById('orderDetailsContent').innerHTML = `
                    <div style="text-align: center; padding: 40px; color: var(--accent-red);">
                        <i class="fas fa-exclamation-circle"></i>
                        <p>Error loading order details</p>
                    </div>
                `;
            }
        }

        function renderOrderDetails(order) {
            const tests = order.tests || [];
            const financials = order.financials || {};
            const pricing = order.pricing || {};
            const location = order.location || {};
            
            document.getElementById('orderDetailsContent').innerHTML = `
                <div style="padding: 20px 24px; background: var(--bg-tertiary);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                        <div>
                            <div style="font-size: 12px; color: var(--text-secondary);">QR Code</div>
                            <div style="font-size: 18px; font-weight: 600; font-family: monospace;">${order.qrCode || '—'}</div>
                        </div>
                        <span class="badge ${getStatusBadgeClass(order.status)}" style="font-size: 14px; padding: 8px 16px;">${order.status || 'Unknown'}</span>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                        <div style="background: var(--bg-primary); padding: 16px; border-radius: var(--radius-sm);">
                            <div style="font-size: 12px; color: var(--text-secondary);">Patient</div>
                            <div style="font-weight: 600;">${order.patientId?.name || 'Unknown'}</div>
                            <div style="font-size: 12px; color: var(--text-secondary);">${order.patientId?.phone || ''}</div>
                        </div>
                        <div style="background: var(--bg-primary); padding: 16px; border-radius: var(--radius-sm);">
                            <div style="font-size: 12px; color: var(--text-secondary);">Nurse</div>
                            <div style="font-weight: 600;">${order.nurseId?.name || 'Not Assigned'}</div>
                            <div style="font-size: 12px; color: var(--text-secondary);">${order.nurseId?.phone || ''}</div>
                        </div>
                        <div style="background: var(--bg-primary); padding: 16px; border-radius: var(--radius-sm);">
                            <div style="font-size: 12px; color: var(--text-secondary);">Lab</div>
                            <div style="font-weight: 600;">${order.labId?.name || 'Unknown'}</div>
                            <div style="font-size: 12px; color: var(--text-secondary);">${order.labId?.city || ''}</div>
                        </div>
                    </div>
                </div>

                <div style="padding: 20px 24px;">
                    <h4 style="margin-bottom: 12px; font-size: 14px; color: var(--text-secondary);">Tests (${tests.length})</h4>
                    <div style="background: var(--bg-tertiary); border-radius: var(--radius-sm); overflow: hidden;">
                        ${tests.map(test => `
                            <div style="display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--border-light);">
                                <div>
                                    <div style="font-weight: 500;">${test.testName || 'Unknown Test'}</div>
                                    <div style="font-size: 12px; color: var(--text-secondary);">${test.testCode || ''}</div>
                                </div>
                                <div style="font-weight: 600;">${formatMoney(test.price || 0)}</div>
                            </div>
                        `).join('')}
                    </div>
                </div>

                <div style="padding: 0 24px 20px;">
                    <h4 style="margin-bottom: 12px; font-size: 14px; color: var(--text-secondary);">Financial Breakdown</h4>
                    <div style="background: var(--bg-tertiary); border-radius: var(--radius-sm); padding: 16px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span>Subtotal</span>
                            <span>${formatMoney(pricing.subtotal || 0)}</span>
                        </div>
                        ${pricing.discount ? `
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--accent-green);">
                                <span>Discount</span>
                                <span>-${formatMoney(pricing.discount)}</span>
                            </div>
                        ` : ''}
                        <div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid var(--border); font-weight: 600; font-size: 16px;">
                            <span>Total</span>
                            <span>${formatMoney(pricing.total || 0)}</span>
                        </div>
                        <hr style="margin: 16px 0; border: none; border-top: 1px dashed var(--border);">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--accent-purple);">
                            <span>Lab Share</span>
                            <span>${formatMoney(financials.labAmount || 0)}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--accent-green);">
                            <span>Nurse Net Earning</span>
                            <span>${formatMoney(financials.nurseNetEarning || 0)}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; color: var(--accent-blue);">
                            <span>Admin Commission (${financials.nurseCommissionRate || 0}%)</span>
                            <span>${formatMoney(financials.adminAmount || 0)}</span>
                        </div>
                    </div>
                </div>

                ${location.address ? `
                    <div style="padding: 0 24px 20px;">
                        <h4 style="margin-bottom: 12px; font-size: 14px; color: var(--text-secondary);">Location</h4>
                        <div style="background: var(--bg-tertiary); border-radius: var(--radius-sm); padding: 16px;">
                            <div style="display: flex; align-items: flex-start; gap: 12px;">
                                <i class="fas fa-map-marker-alt" style="color: var(--accent-red); margin-top: 4px;"></i>
                                <div>
                                    <div style="font-weight: 500;">${location.address}</div>
                                    ${location.city ? `<div style="font-size: 12px; color: var(--text-secondary);">${location.city}</div>` : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                ` : ''}

                <div style="padding: 0 24px 20px;">
                    <h4 style="margin-bottom: 12px; font-size: 14px; color: var(--text-secondary);">Timeline</h4>
                    <div style="background: var(--bg-tertiary); border-radius: var(--radius-sm); padding: 16px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span>Created</span>
                            <span>${formatDate(order.createdAt)}</span>
                        </div>
                        ${order.paymentCollected?.collected ? `
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--accent-green);">
                                <span>Payment Collected</span>
                                <span>${formatDate(order.paymentCollected.collectedAt)}</span>
                            </div>
                        ` : ''}
                        ${order.qrScanned?.scanned ? `
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span>QR Scanned</span>
                                <span>${formatDate(order.qrScanned.scannedAt)}</span>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;
        }

        function closeOrderDetails() {
            document.getElementById('orderDetailsModal').classList.remove('show');
        }

        // ==================== VIEW PATIENT DETAILS ====================

        async function viewPatient(patientId) {
            document.getElementById('patientOrdersBody').innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px;"><i class="fas fa-spinner fa-spin"></i></td></tr>';
            document.getElementById('patientDetailsModal').classList.add('show');

            try {
                const res = await fetch(`/api/admin/finance/patients/${patientId}`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });
                const result = await res.json();

                if (result.success) {
                    const data = result.data;
                    const patient = data.patient;
                    const orders = data.orders || [];
                    const totals = data.totals || {};

                    // Update patient info
                    document.getElementById('patientAvatar').textContent = getInitials(patient.name);
                    document.getElementById('patientName').textContent = patient.name || 'Unknown';
                    document.getElementById('patientPhone').textContent = patient.phone || '—';
                    document.getElementById('patientEmail').textContent = patient.email || '—';
                    document.getElementById('patientDetailsTitle').textContent = patient.name || 'Patient Details';

                    // Update stats
                    document.getElementById('patientDetailOrders').textContent = totals.totalOrders || 0;
                    document.getElementById('patientDetailSpent').textContent = formatMoney(totals.totalSpent || 0);
                    const completedOrders = orders.filter(o => o.status === 'completed').length;
                    document.getElementById('patientDetailCompleted').textContent = completedOrders;
                    const avgOrder = totals.totalOrders > 0 ? (totals.totalSpent / totals.totalOrders) : 0;
                    document.getElementById('patientDetailAvg').textContent = totals.totalOrders > 0 ? formatMoney(avgOrder) : '—';

                    // Render orders
                    renderPatientOrders(orders);
                }
            } catch (e) {
                console.error('Patient details error:', e);
                document.getElementById('patientOrdersBody').innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: var(--accent-red);">Error loading patient details</td></tr>';
            }
        }

        function renderPatientOrders(orders) {
            const tbody = document.getElementById('patientOrdersBody');

            if (!orders || !orders.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="empty-state"><i class="fas fa-receipt"></i><h3>No orders found</h3></td></tr>`;
                return;
            }

            tbody.innerHTML = orders.map(o => `
                <tr onclick="viewOrderDetails('${o._id}')" style="cursor: pointer;">
                    <td><span class="badge ${getStatusBadgeClass(o.status)}">${o.status || 'Unknown'}</span></td>
                    <td><code style="font-size: 11px;">${o.qrCode || '—'}</code></td>
                    <td>${o.labId?.name || '—'}</td>
                    <td>${o.nurseId?.name || '—'}</td>
                    <td>${formatMoney(o.pricing?.total || 0)}</td>
                    <td>${formatDate(o.createdAt)}</td>
                    <td>
                        <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation(); viewOrderDetails('${o._id}')">
                            ${i18n.finance.view}
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function closePatientDetails() {
            document.getElementById('patientDetailsModal').classList.remove('show');
        }

        // Load all data
        async function loadAll() {
            await Promise.all([
                loadOverview(),
                loadOrders(),
                loadNurses(),
                loadPatients(),
                loadLabs(),
                loadPending()
            ]);
        }

        // Tab switching
        document.querySelectorAll('.nav-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('tab-' + this.dataset.tab).classList.add('active');
            });
        });

        // Date filter preset buttons
        document.querySelectorAll('.date-preset-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const preset = this.dataset.preset;
                applyDateFilter(preset);
            });
        });

        // Custom date inputs
        document.getElementById('applyDateFilter')?.addEventListener('click', function() {
            const fromVal = document.getElementById('dateFrom').value;
            const toVal = document.getElementById('dateTo').value;

            if (!fromVal || !toVal) {
                alert(i18n.finance.selectDateRange || 'Please select both from and to dates');
                return;
            }

            const fromDate = new Date(fromVal);
            const toDate = new Date(toVal);

            if (fromDate > toDate) {
                alert(i18n.finance.invalidDateRange || 'From date cannot be after to date');
                return;
            }

            applyDateFilter('custom', fromDate, toDate);
        });

        document.getElementById('clearDateFilter')?.addEventListener('click', function() {
            applyDateFilter('thisMonth'); // Reset to default
        });

        // Initial load - apply default date filter first
        (async function() {
            // Set default to current month
            await applyDateFilter('thisMonth');
            // Load all other data
            await Promise.all([
                loadNurses(),
                loadPatients(),
                loadLabs(),
                loadPending()
            ]);
        })();
    </script>
</body>
</html>

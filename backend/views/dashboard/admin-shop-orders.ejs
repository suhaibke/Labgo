<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('shop.shopOrders') || 'Shop Orders' %> - LabGo Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <style>
        body { font-family: <%= direction === 'rtl' ? "'Cairo', sans-serif" : "'Inter', sans-serif" %>; }
        
        .orders-container {
            padding: 100px 24px 40px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }
        
        .page-title {
            font-size: 28px;
            font-weight: 700;
            color: var(--gray-900);
        }
        
        /* Stats Row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }
        
        .stat-card {
            background: var(--white);
            padding: 24px;
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-100);
        }
        
        .stat-label {
            font-size: 13px;
            color: var(--gray-500);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--gray-900);
        }
        
        .stat-card.pending .stat-value { color: var(--warning); }
        .stat-card.processing .stat-value { color: var(--info); }
        .stat-card.done .stat-value { color: var(--success); }
        .stat-card.revenue .stat-value { color: var(--primary-500); }
        
        /* Filters */
        .filters-bar {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }
        
        .search-box {
            position: relative;
            flex: 1;
            min-width: 250px;
        }
        
        .search-box i {
            position: absolute;
            top: 50%;
            <%= direction === 'rtl' ? 'right' : 'left' %>: 16px;
            transform: translateY(-50%);
            color: var(--gray-400);
        }
        
        .search-input {
            width: 100%;
            padding: 12px 16px 12px 44px;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            font-size: 14px;
        }
        
        [dir="rtl"] .search-input {
            padding: 12px 44px 12px 16px;
        }
        
        .filter-select {
            padding: 12px 16px;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            font-size: 14px;
            background: var(--white);
            min-width: 150px;
        }
        
        .date-input {
            padding: 12px 16px;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            font-size: 14px;
        }
        
        /* Orders Table */
        .orders-card {
            background: var(--white);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-100);
            overflow: hidden;
        }
        
        .orders-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .orders-table th {
            padding: 16px 20px;
            text-align: <%= direction === 'rtl' ? 'right' : 'left' %>;
            font-size: 12px;
            font-weight: 600;
            color: var(--gray-500);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-100);
        }
        
        .orders-table td {
            padding: 16px 20px;
            border-bottom: 1px solid var(--gray-100);
            vertical-align: middle;
        }
        
        .orders-table tr:last-child td {
            border-bottom: none;
        }
        
        .orders-table tr:hover {
            background: var(--gray-50);
        }
        
        .order-number {
            font-weight: 600;
            color: var(--primary-500);
        }
        
        .customer-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        
        .customer-name {
            font-weight: 500;
            color: var(--gray-900);
        }
        
        .customer-phone {
            font-size: 13px;
            color: var(--gray-500);
        }
        
        .order-items {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        
        .order-item {
            font-size: 13px;
            color: var(--gray-600);
        }
        
        .order-item-count {
            font-size: 12px;
            color: var(--gray-400);
        }
        
        .order-total {
            font-weight: 600;
            color: var(--gray-900);
        }
        
        .order-date {
            font-size: 13px;
            color: var(--gray-600);
        }
        
        /* Status Badge */
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-badge.pending {
            background: rgba(255, 193, 7, 0.15);
            color: var(--warning);
        }
        
        .status-badge.processing {
            background: rgba(23, 162, 184, 0.15);
            color: var(--info);
        }
        
        .status-badge.done {
            background: rgba(76, 175, 80, 0.15);
            color: var(--success);
        }
        
        .status-badge.cancelled {
            background: rgba(244, 67, 54, 0.15);
            color: var(--error);
        }
        
        /* Status Update Dropdown */
        .status-dropdown {
            position: relative;
        }
        
        .status-dropdown-toggle {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            color: var(--gray-400);
        }
        
        .status-dropdown-menu {
            position: absolute;
            top: 100%;
            <%= direction === 'rtl' ? 'left' : 'right' %>: 0;
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--gray-100);
            z-index: 100;
            display: none;
            min-width: 160px;
        }
        
        .status-dropdown-menu.show {
            display: block;
        }
        
        .status-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            font-size: 14px;
            color: var(--gray-700);
            cursor: pointer;
            transition: background var(--transition-fast);
        }
        
        .status-option:hover {
            background: var(--gray-50);
        }
        
        .status-option.pending i { color: var(--warning); }
        .status-option.processing i { color: var(--info); }
        .status-option.done i { color: var(--success); }
        .status-option.cancelled i { color: var(--error); }
        
        /* Actions */
        .actions-cell {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition-fast);
        }
        
        .action-btn.view {
            background: var(--primary-100);
            color: var(--primary-600);
        }
        
        .action-btn.view:hover {
            background: var(--primary-500);
            color: white;
        }

        .action-btn.process {
            background: var(--info);
            color: white;
        }

        .action-btn.process:hover {
            background: #0c7cd5;
        }

        .action-btn.done {
            background: var(--success);
            color: white;
        }

        .action-btn.done:hover {
            background: #5cb85c;
        }

        .action-btn.cancel {
            background: var(--error);
            color: white;
        }

        .action-btn.cancel:hover {
            background: #d32f2f;
        }

        .action-btn.pending {
            background: var(--warning);
            color: white;
        }

        .action-btn.pending:hover {
            background: #e0a800;
        }

        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            border-top: 1px solid var(--gray-100);
        }
        
        .pagination-info {
            font-size: 14px;
            color: var(--gray-500);
        }
        
        .pagination-buttons {
            display: flex;
            gap: 8px;
        }
        
        .page-btn {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-md);
            border: 1px solid var(--gray-200);
            background: var(--white);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition-fast);
        }
        
        .page-btn:hover:not(:disabled) {
            background: var(--primary-500);
            color: white;
            border-color: var(--primary-500);
        }
        
        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .page-btn.active {
            background: var(--primary-500);
            color: white;
            border-color: var(--primary-500);
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
        
        .empty-state i {
            font-size: 64px;
            color: var(--gray-300);
            margin-bottom: 16px;
        }
        
        .empty-state h3 {
            font-size: 18px;
            color: var(--gray-700);
            margin-bottom: 8px;
        }
        
        .empty-state p {
            color: var(--gray-500);
            font-size: 14px;
        }
        
        /* Toast */
        .toast-container {
            position: fixed;
            top: 100px;
            <%= direction === 'rtl' ? 'left' : 'right' %>: 24px;
            z-index: 1200;
        }
        
        .toast {
            padding: 16px 20px;
            border-radius: var(--radius-lg);
            background: var(--white);
            box-shadow: var(--shadow-lg);
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            animation: toastSlide 0.3s ease;
        }
        
        .toast.success { border-<%= direction === 'rtl' ? 'right' : 'left' %>: 4px solid var(--success); }
        .toast.error { border-<%= direction === 'rtl' ? 'right' : 'left' %>: 4px solid var(--error); }
        
        @keyframes toastSlide {
            from { opacity: 0; transform: translateX(100px); }
            to { opacity: 1; transform: translateX(0); }
        }
        
        /* Loading */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid var(--gray-200);
            border-top-color: var(--primary-500);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        @media (max-width: 1024px) {
            .orders-table { display: block; overflow-x: auto; }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin-navbar') %>
    
    <div class="orders-container">
        <div class="page-header">
            <h1 class="page-title"><%= __('shop.shopOrders') || 'Shop Orders' %></h1>
        </div>
        
        <!-- Stats Row -->
        <div class="stats-row">
            <div class="stat-card pending">
                <div class="stat-label"><%= __('shop.pending') || 'Pending' %></div>
                <div class="stat-value" id="pendingCount">0</div>
            </div>
            <div class="stat-card processing">
                <div class="stat-label"><%= __('shop.processing') || 'Processing' %></div>
                <div class="stat-value" id="processingCount">0</div>
            </div>
            <div class="stat-card done">
                <div class="stat-label"><%= __('shop.done') || 'Completed' %></div>
                <div class="stat-value" id="doneCount">0</div>
            </div>
            <div class="stat-card revenue">
                <div class="stat-label"><%= __('shop.totalRevenue') || 'Total Revenue' %></div>
                <div class="stat-value" id="totalRevenue">0</div>
            </div>
        </div>
        
        <!-- Filters -->
        <div class="filters-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" class="search-input" id="searchInput" placeholder="<%= __('shop.searchOrders') || 'Search by order number or customer...' %>" onkeyup="debounceSearch()">
            </div>
            <select class="filter-select" id="statusFilter" onchange="loadOrders()">
                <option value=""><%= __('common.allStatuses') || 'All Statuses' %></option>
                <option value="pending"><%= __('shop.pending') || 'Pending' %></option>
                <option value="processing"><%= __('shop.processing') || 'Processing' %></option>
                <option value="done"><%= __('shop.done') || 'Done' %></option>
                <option value="cancelled"><%= __('common.cancelled') || 'Cancelled' %></option>
            </select>
            <input type="date" class="date-input" id="startDate" onchange="loadOrders()" title="Start Date">
            <input type="date" class="date-input" id="endDate" onchange="loadOrders()" title="End Date">
        </div>
        
        <!-- Orders Table -->
        <div class="orders-card">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th><%= __('shop.orderNumber') || 'Order #' %></th>
                        <th><%= __('common.customer') || 'Customer' %></th>
                        <th><%= __('shop.items') || 'Items' %></th>
                        <th><%= __('shop.total') || 'Total' %></th>
                        <th><%= __('common.status') || 'Status' %></th>
                        <th><%= __('common.date') || 'Date' %></th>
                        <th><%= __('common.actions') || 'Actions' %></th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody">
                </tbody>
            </table>
            
            <div class="empty-state" id="emptyState" style="display: none;">
                <i class="fas fa-shopping-bag"></i>
                <h3><%= __('shop.noOrdersFound') || 'No orders found' %></h3>
                <p><%= __('shop.noOrdersDesc') || 'Orders will appear here when customers make purchases' %></p>
            </div>
            
            <div class="pagination-container" id="paginationContainer">
                <div class="pagination-info" id="paginationInfo"></div>
                <div class="pagination-buttons" id="paginationButtons"></div>
            </div>
        </div>
    </div>
    
    <div class="toast-container" id="toastContainer"></div>
    <div class="loading-overlay" id="loadingOverlay" style="display: none;">
        <div class="spinner"></div>
    </div>
    
    <script>
        const currentLang = '<%= currentLang %>';
        const direction = '<%= direction %>';
        // Status translations
        const statusTexts = {
            pending: '<%= __("shop.pending") || "Pending" %>',
            processing: '<%= __("shop.processing") || "Processing" %>',
            done: '<%= __("shop.done") || "Done" %>',
            cancelled: '<%= __("common.cancelled") || "Cancelled" %>'
        };
        let currentPage = 1;
        let searchTimeout;
        let activeDropdown = null;
        
        // Get token from localStorage
        function getToken() {
            return localStorage.getItem('token') || '';
        }
        
        // Load orders
        async function loadOrders(page = 1) {
            currentPage = page;
            showLoading(true);
            
            const params = new URLSearchParams({
                page,
                limit: 10,
                search: document.getElementById('searchInput').value,
                status: document.getElementById('statusFilter').value,
                startDate: document.getElementById('startDate').value,
                endDate: document.getElementById('endDate').value
            });
            
            try {
                const response = await fetch(`/api/admin/shop/orders?${params}`, {
                    headers: {
                        'Authorization': `Bearer ${getToken()}`
                    }
                });
                const data = await response.json();
                
                if (data.success) {
                    renderOrders(data.data);
                    renderPagination(data.pagination);
                    updateStats();
                } else {
                    showToast(data.message || 'Failed to load orders', 'error');
                }
            } catch (error) {
                console.error('Load orders error:', error);
                showToast('Failed to load orders', 'error');
            } finally {
                showLoading(false);
            }
        }
        
        // Update stats
        async function updateStats() {
            try {
                const response = await fetch('/api/admin/shop/orders?limit=999999', {
                    headers: {
                        'Authorization': `Bearer ${getToken()}`
                    }
                });
                const data = await response.json();
                
                if (data.success) {
                    const orders = data.data;
                    const pending = orders.filter(o => o.status === 'pending').length;
                    const processing = orders.filter(o => o.status === 'processing').length;
                    const done = orders.filter(o => o.status === 'done').length;
                    const revenue = orders.filter(o => o.status !== 'cancelled').reduce((sum, o) => sum + o.pricing.total, 0);
                    
                    document.getElementById('pendingCount').textContent = pending;
                    document.getElementById('processingCount').textContent = processing;
                    document.getElementById('doneCount').textContent = done;
                    document.getElementById('totalRevenue').textContent = formatPrice(revenue);
                }
            } catch (error) {
                console.error('Update stats error:', error);
            }
        }
        
        // Render orders
        function renderOrders(orders) {
            const tbody = document.getElementById('ordersTableBody');
            const emptyState = document.getElementById('emptyState');
            const paginationContainer = document.getElementById('paginationContainer');
            
            if (orders.length === 0) {
                tbody.innerHTML = '';
                emptyState.style.display = 'block';
                paginationContainer.style.display = 'none';
                return;
            }
            
            emptyState.style.display = 'none';
            paginationContainer.style.display = 'flex';
            
            tbody.innerHTML = orders.map(order => `
                <tr>
                    <td><span class="order-number">${order.orderNumber}</span></td>
                    <td>
                        <div class="customer-info">
                            <span class="customer-name">${order.customer.name}</span>
                            <span class="customer-phone">${order.customer.phone}</span>
                        </div>
                    </td>
                    <td>
                        <div class="order-items">
                            ${order.items.slice(0, 2).map(item => `
                                <span class="order-item">${item.name?.[currentLang] || item.name?.en || 'Product'} × ${item.quantity}</span>
                            `).join('')}
                            ${order.items.length > 2 ? `<span class="order-item-count">+${order.items.length - 2} more</span>` : ''}
                        </div>
                    </td>
                    <td><span class="order-total">${formatPrice(order.pricing.total)}</span></td>
                    <td>
                        <span class="status-badge ${order.status}">${getStatusText(order.status)}</span>
                    </td>
                    <td><span class="order-date">${formatDate(order.createdAt)}</span></td>
                    <td>
                        <div class="actions-cell">
                            <a href="/admin/shop/orders/${order._id}" class="action-btn view" title="View Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            `).join('');
        }
        
        // Toggle status dropdown
        function toggleStatusDropdown(event, orderId) {
            event.stopPropagation();
            
            if (activeDropdown && activeDropdown !== orderId) {
                document.getElementById(`dropdown-${activeDropdown}`).classList.remove('show');
            }
            
            const dropdown = document.getElementById(`dropdown-${orderId}`);
            dropdown.classList.toggle('show');
            activeDropdown = dropdown.classList.contains('show') ? orderId : null;
        }
        
        // Close dropdowns on outside click
        document.addEventListener('click', () => {
            if (activeDropdown) {
                document.getElementById(`dropdown-${activeDropdown}`).classList.remove('show');
                activeDropdown = null;
            }
        });
        
        // Update order status
        async function updateOrderStatus(orderId, status) {
            try {
                const response = await fetch(`/api/admin/shop/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${getToken()}`
                    },
                    body: JSON.stringify({ status })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showToast('Order status updated', 'success');
                    loadOrders(currentPage);
                } else {
                    showToast(data.message || 'Failed to update status', 'error');
                }
            } catch (error) {
                console.error('Update status error:', error);
                showToast('Failed to update status', 'error');
            }
        }
        
        // Render pagination
        function renderPagination(pagination) {
            if (!pagination) return;
            
            const { page, totalPages, total, limit } = pagination;
            const start = (page - 1) * limit + 1;
            const end = Math.min(page * limit, total);
            
            document.getElementById('paginationInfo').textContent = `Showing ${start}-${end} of ${total} orders`;
            
            let buttons = '';
            buttons += `<button class="page-btn" onclick="loadOrders(${page - 1})" ${page <= 1 ? 'disabled' : ''}><i class="fas fa-chevron-${direction === 'rtl' ? 'right' : 'left'}"></i></button>`;
            
            for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) {
                buttons += `<button class="page-btn ${i === page ? 'active' : ''}" onclick="loadOrders(${i})">${i}</button>`;
            }
            
            buttons += `<button class="page-btn" onclick="loadOrders(${page + 1})" ${page >= totalPages ? 'disabled' : ''}><i class="fas fa-chevron-${direction === 'rtl' ? 'left' : 'right'}"></i></button>`;
            
            document.getElementById('paginationButtons').innerHTML = buttons;
        }
        
        // Helpers
        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadOrders(), 300);
        }
        
        function getStatusText(status) {
            return statusTexts[status] || status;
        }

        function formatPrice(price) {
            return new Intl.NumberFormat('<%= currentLang %>', { style: 'decimal' }).format(price) + ' IQD';
        }
        
        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('<%= currentLang %>', { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }
        
        function showLoading(show) {
            document.getElementById('loadingOverlay').style.display = show ? 'flex' : 'none';
        }
        
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', loadOrders);
    </script>
</body>
</html>

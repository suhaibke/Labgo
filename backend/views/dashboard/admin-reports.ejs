<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= __('reports.title') %> - LabGo Admin
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <style>
        body {
            font-family: <%=font %>;
        }

        .reports-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            color: #1d1d1f;
            margin: 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .stat-card.warning {
            background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
            border-color: #fed7aa;
        }

        .stat-card.danger {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            border-color: #fecaca;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            font-size: 20px;
        }

        .stat-card.warning .stat-icon {
            background: #f97316;
            color: white;
        }

        .stat-card.danger .stat-icon {
            background: #ef4444;
            color: white;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #1d1d1f;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 14px;
            color: #6b7280;
        }

        .section-card {
            background: white;
            border-radius: 16px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            margin-bottom: 24px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 24px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #1d1d1f;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title i {
            color: #ef4444;
        }

        .filter-tabs {
            display: flex;
            gap: 8px;
        }

        .filter-tab {
            padding: 8px 16px;
            border-radius: 20px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            background: white;
            font-size: 13px;
            font-weight: 500;
            color: #6b7280;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .filter-tab:hover {
            background: #f3f4f6;
        }

        .filter-tab.active {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
            border-color: transparent;
        }

        .ratings-table {
            width: 100%;
            border-collapse: collapse;
        }

        .ratings-table th {
            padding: 14px 20px;
            text-align: start;
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: #f9fafb;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        }

        .ratings-table td {
            padding: 16px 20px;
            font-size: 14px;
            color: #374151;
            border-bottom: 1px solid rgba(0, 0, 0, 0.04);
        }

        .ratings-table tr:hover {
            background: #f9fafb;
        }

        .ratings-table tr:last-child td {
            border-bottom: none;
        }

        .type-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .type-badge.lab {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .type-badge.nurse {
            background: #ede9fe;
            color: #7c3aed;
        }

        .rating-stars {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .rating-stars i {
            font-size: 14px;
        }

        .rating-stars i.active {
            color: #f59e0b;
        }

        .rating-stars i.inactive {
            color: #d1d5db;
        }

        .rating-value {
            margin-left: 8px;
            font-weight: 600;
            color: #ef4444;
        }

        .reason-text {
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #6b7280;
        }

        .target-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .target-name {
            font-weight: 600;
            color: #1d1d1f;
        }

        .target-id {
            font-size: 12px;
            color: #9ca3af;
        }

        .view-btn {
            padding: 8px 14px;
            border-radius: 8px;
            border: none;
            background: #f3f4f6;
            color: #374151;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .view-btn:hover {
            background: #e5e7eb;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-state i {
            font-size: 48px;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state p {
            color: #9ca3af;
            font-size: 14px;
        }

        .loading-state {
            padding: 40px 20px;
            text-align: center;
            color: #6b7280;
        }

        .loading-state i {
            font-size: 24px;
            margin-bottom: 8px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            padding: 20px;
            border-top: 1px solid rgba(0, 0, 0, 0.06);
        }

        .pagination-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid rgba(0, 0, 0, 0.1);
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 500;
            color: #374151;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .pagination-btn:hover {
            background: #f3f4f6;
        }

        .pagination-btn.active {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white;
            border-color: transparent;
        }

        [dir="rtl"] .rating-value {
            margin-left: 0;
            margin-right: 8px;
        }

        /* Clickable Row Styles */
        .ratings-table tbody tr {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .ratings-table tbody tr:hover {
            background-color: #f0f9ff !important;
        }

        /* Apple-Style Rating Detail Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            animation: modalFadeIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .modal-overlay.show {
            display: flex;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(40px) saturate(200%);
            -webkit-backdrop-filter: blur(40px) saturate(200%);
            border-radius: 20px;
            max-width: 540px;
            width: 90%;
            max-height: 85vh;
            overflow: hidden;
            box-shadow:
                0 0 0 1px rgba(0, 0, 0, 0.04),
                0 4px 6px -1px rgba(0, 0, 0, 0.05),
                0 20px 50px -12px rgba(0, 0, 0, 0.15);
            animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.97);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 28px 28px 20px;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.8), transparent);
        }

        .modal-title {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: #1d1d1f;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-title i {
            font-size: 18px;
            color: #f59e0b;
        }

        .modal-close {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: rgba(0, 0, 0, 0.04);
            color: #86868b;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .modal-close:hover {
            background: rgba(0, 0, 0, 0.08);
            color: #1d1d1f;
            transform: scale(1.05);
        }

        .modal-body {
            padding: 8px 28px 28px;
            overflow-y: auto;
            max-height: calc(85vh - 80px);
        }

        /* Rating Hero Section */
        .rating-hero {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 24px;
            background: linear-gradient(135deg, #fef9f3 0%, #fef3c7 100%);
            border-radius: 16px;
            margin-bottom: 24px;
        }

        .rating-stars-large {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .rating-stars-large i {
            font-size: 28px;
        }

        .rating-stars-large i.active {
            color: #f59e0b;
        }

        .rating-stars-large i.inactive {
            color: rgba(0, 0, 0, 0.1);
        }

        .rating-score {
            text-align: center;
        }

        .rating-score-number {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: -1px;
            color: #1d1d1f;
            line-height: 1;
        }

        .rating-score-divider {
            font-size: 20px;
            color: rgba(0, 0, 0, 0.3);
            margin: 0 2px;
        }

        .rating-score-max {
            font-size: 28px;
            font-weight: 600;
            color: rgba(0, 0, 0, 0.3);
        }

        /* Detail Sections */
        .detail-section {
            margin-bottom: 24px;
        }

        .detail-section:last-child {
            margin-bottom: 0;
        }

        .detail-section-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #86868b;
            margin-bottom: 10px;
            padding-left: 4px;
        }

        .detail-card {
            background: #f9f9f9;
            border-radius: 12px;
            padding: 16px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .detail-card-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
        }

        .detail-card-icon.star { background: #fef3c7; color: #f59e0b; }
        .detail-card-icon.comment { background: #eef2ff; color: #6366f1; }
        .detail-card-icon.order { background: #f3f4f6; color: #6b7280; }
        .detail-card-icon.lab { background: #dbeafe; color: #1d4ed8; }
        .detail-card-icon.nurse { background: #ede9fe; color: #7c3aed; }
        .detail-card-icon.user { background: #d1fae5; color: #10b981; }
        .detail-card-icon.calendar { background: #fee2e2; color: #ef4444; }

        .detail-card-content {
            flex: 1;
            min-width: 0;
        }

        .detail-card-label {
            font-size: 12px;
            font-weight: 600;
            color: #86868b;
            margin-bottom: 2px;
        }

        .detail-card-value {
            font-size: 15px;
            font-weight: 500;
            color: #1d1d1f;
            line-height: 1.4;
        }

        .detail-card-value-sub {
            font-size: 13px;
            color: #86868b;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Reason Box */
        .reason-box {
            background: linear-gradient(135deg, #fef9f3 0%, #fef3c7 100%);
            border-radius: 12px;
            padding: 18px;
            margin-top: 8px;
        }

        .reason-box-text {
            font-size: 15px;
            line-height: 1.6;
            color: #1d1d1f;
            font-weight: 400;
        }

        .reason-box-empty {
            color: #86868b;
            font-style: italic;
        }

        /* Action Button */
        .modal-action-btn {
            width: 100%;
            padding: 14px 20px;
            background: #1d1d1f;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: -0.2px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .modal-action-btn:hover {
            background: #000;
            transform: scale(1.02);
        }

        .modal-action-btn:active {
            transform: scale(0.98);
        }

        /* Scrollbar Styling */
        .modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .modal-body::-webkit-scrollbar-track {
            background: transparent;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: 4px;
        }

        .modal-body::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.25);
        }
    </style>
</head>

<body>
    <%- include('../partials/admin-navbar') %>

        <main class="admin-dashboard">
            <div class="reports-container">
                <!-- Page Header -->
                <div class="page-header">
                    <h1>
                        <%= __('reports.title') %>
                    </h1>
                </div>

                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card" style="background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); border-color: #c7d2fe;">
                        <div class="stat-icon" style="background: #6366f1; color: white;">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="stat-value" id="totalAllRatings">-</div>
                        <div class="stat-label">
                            <%= __('reports.totalRatings') || 'Total Ratings' %>
                        </div>
                    </div>
                    <div class="stat-card" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-color: #a7f3d0;">
                        <div class="stat-icon" style="background: #10b981; color: white;">
                            <i class="fas fa-flask"></i>
                        </div>
                        <div class="stat-value" id="avgLabRating">-</div>
                        <div class="stat-label">
                            <%= __('reports.avgLabRating') || 'Avg Lab Rating' %>
                        </div>
                    </div>
                    <div class="stat-card" style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-color: #e9d5ff;">
                        <div class="stat-icon" style="background: #8b5cf6; color: white;">
                            <i class="fas fa-user-nurse"></i>
                        </div>
                        <div class="stat-value" id="avgNurseRating">-</div>
                        <div class="stat-label">
                            <%= __('reports.avgNurseRating') || 'Avg Nurse Rating' %>
                        </div>
                    </div>
                    <div class="stat-card warning">
                        <div class="stat-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-value" id="totalBadRatings">-</div>
                        <div class="stat-label">
                            <%= __('reports.totalBadRatings') %>
                        </div>
                    </div>
                </div>

                <!-- Main Tabs -->
                <div class="main-tabs" style="display: flex; gap: 12px; margin-bottom: 24px;">
                    <button class="main-tab active" onclick="switchMainTab('all')" id="mainTabAll" style="padding: 12px 24px; border-radius: 12px; border: 2px solid #6366f1; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-star"></i>
                        <%= __('reports.allRatings') || 'All Ratings' %>
                    </button>
                    <button class="main-tab" onclick="switchMainTab('bad')" id="mainTabBad" style="padding: 12px 24px; border-radius: 12px; border: 2px solid #ef4444; background: white; color: #ef4444; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-thumbs-down"></i>
                        <%= __('reports.badRatings') %>
                    </button>
                </div>

                <!-- Ratings Section -->
                <div class="section-card">
                    <div class="section-header">
                        <div class="section-title">
                            <i class="fas fa-star" id="sectionIcon"></i>
                            <span id="sectionTitleText"><%= __('reports.allRatings') || 'All Ratings' %></span>
                        </div>
                        <div class="filter-tabs">
                            <button class="filter-tab active" data-type="all" onclick="filterByType('all')">
                                <%= __('common.all') %>
                            </button>
                            <button class="filter-tab" data-type="lab" onclick="filterByType('lab')">
                                <i class="fas fa-flask"></i>
                                <%= __('reports.labs') %>
                            </button>
                            <button class="filter-tab" data-type="nurse" onclick="filterByType('nurse')">
                                <i class="fas fa-user-nurse"></i>
                                <%= __('reports.nurses') %>
                            </button>
                        </div>
                    </div>

                    <div id="ratingsTableContainer">
                        <table class="ratings-table">
                            <thead>
                                <tr>
                                    <th>
                                        <%= __('reports.type') %>
                                    </th>
                                    <th>
                                        <%= __('reports.orderId') %>
                                    </th>
                                    <th>
                                        <%= __('reports.rating') %>
                                    </th>
                                    <th>
                                        <%= __('reports.target') %>
                                    </th>
                                    <th>
                                        <%= __('reports.patient') %>
                                    </th>
                                    <th>
                                        <%= __('reports.date') %>
                                    </th>
                                    <th>
                                        <%= __('common.actions') %>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="ratingsTableBody">
                                <tr>
                                    <td colspan="7" class="loading-state">
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <p>
                                            <%= __('common.loading') %>
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination" id="pagination"></div>
                </div>
            </div>
        </main>

        <!-- Rating Detail Modal -->
        <div class="modal-overlay" id="ratingModal">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title">
                        <i class="fas fa-star" style="color: #f59e0b;"></i>
                        <span id="modalTitle">Rating Details</span>
                    </div>
                    <button class="modal-close" onclick="closeRatingModal()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body" id="modalBody">
                    <!-- Content will be dynamically inserted -->
                </div>
            </div>
        </div>

        <script>
            const API_BASE = '/api/admin/reports';
            let currentType = 'all';
            let currentPage = 1;
            let currentMainTab = 'all'; // 'all' or 'bad'

            document.addEventListener('DOMContentLoaded', function () {
                loadAllRatings(); // Start with all ratings
                loadBadRatingsStats(); // Also load bad ratings stats for the card
            });

            function switchMainTab(tab) {
                currentMainTab = tab;
                currentPage = 1;
                
                // Update main tab styles
                const allTab = document.getElementById('mainTabAll');
                const badTab = document.getElementById('mainTabBad');
                const sectionIcon = document.getElementById('sectionIcon');
                const sectionTitle = document.getElementById('sectionTitleText');
                
                if (tab === 'all') {
                    allTab.style.background = 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)';
                    allTab.style.color = 'white';
                    badTab.style.background = 'white';
                    badTab.style.color = '#ef4444';
                    sectionIcon.className = 'fas fa-star';
                    sectionIcon.style.color = '#6366f1';
                    sectionTitle.textContent = '<%= __('reports.allRatings') || 'All Ratings' %>';
                    loadAllRatings();
                } else {
                    allTab.style.background = 'white';
                    allTab.style.color = '#6366f1';
                    badTab.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
                    badTab.style.color = 'white';
                    sectionIcon.className = 'fas fa-thumbs-down';
                    sectionIcon.style.color = '#ef4444';
                    sectionTitle.textContent = '<%= __('reports.badRatings') %>';
                    loadBadRatings();
                }
            }

            function filterByType(type) {
                currentType = type;
                currentPage = 1;

                // Update active tab
                document.querySelectorAll('.filter-tab').forEach(tab => {
                    tab.classList.remove('active');
                });
                document.querySelector(`[data-type="${type}"]`).classList.add('active');

                if (currentMainTab === 'all') {
                    loadAllRatings();
                } else {
                    loadBadRatings();
                }
            }

            async function loadAllRatings() {
                const tbody = document.getElementById('ratingsTableBody');
                tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="loading-state">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p><%= __('common.loading') %></p>
                    </td>
                </tr>
            `;

                try {
                    const params = new URLSearchParams({
                        page: currentPage,
                        limit: 20
                    });

                    if (currentType !== 'all') {
                        params.append('type', currentType);
                    }

                    const response = await fetch(`${API_BASE}/all-ratings?${params}`, {
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        updateAllStats(data.data.stats);
                        renderRatingsTable(data.data.ratings);
                        renderPagination(data.data.pagination, 'loadAllRatings');
                    } else {
                        tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="empty-state">
                                <i class="fas fa-exclamation-circle"></i>
                                <p>${data.message || 'Failed to load data'}</p>
                            </td>
                        </tr>
                    `;
                    }
                } catch (error) {
                    console.error('Error loading all ratings:', error);
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="empty-state">
                            <i class="fas fa-exclamation-circle"></i>
                            <p><%= __('common.error') %></p>
                        </td>
                    </tr>
                `;
                }
            }

            async function loadBadRatings() {
                const tbody = document.getElementById('ratingsTableBody');
                tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="loading-state">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p><%= __('common.loading') %></p>
                    </td>
                </tr>
            `;

                try {
                    const params = new URLSearchParams({
                        page: currentPage,
                        limit: 20
                    });

                    if (currentType !== 'all') {
                        params.append('type', currentType);
                    }

                    const response = await fetch(`${API_BASE}/bad-ratings?${params}`, {
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        updateBadStats(data.data.stats);
                        renderRatingsTable(data.data.badRatings);
                        renderPagination(data.data.pagination, 'loadBadRatings');
                    } else {
                        tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="empty-state">
                                <i class="fas fa-exclamation-circle"></i>
                                <p>${data.message || 'Failed to load data'}</p>
                            </td>
                        </tr>
                    `;
                    }
                } catch (error) {
                    console.error('Error loading bad ratings:', error);
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="empty-state">
                            <i class="fas fa-exclamation-circle"></i>
                            <p><%= __('common.error') %></p>
                        </td>
                    </tr>
                `;
                }
            }

            async function loadBadRatingsStats() {
                try {
                    const response = await fetch(`${API_BASE}/bad-ratings?page=1&limit=1`, {
                        headers: {
                            'Authorization': `Bearer ${getToken()}`
                        }
                    });

                    const data = await response.json();

                    if (data.success && data.data.stats) {
                        updateBadStats(data.data.stats);
                    }
                } catch (error) {
                    console.error('Error loading bad ratings stats:', error);
                }
            }

            function updateAllStats(stats) {
                document.getElementById('totalAllRatings').textContent = stats.total || 0;
                document.getElementById('avgLabRating').textContent = stats.avgLabRating || '0.0';
                document.getElementById('avgNurseRating').textContent = stats.avgNurseRating || '0.0';
            }

            function updateBadStats(stats) {
                const total = stats.total || (stats.totalLabBadRatings || 0) + (stats.totalNurseBadRatings || 0);
                document.getElementById('totalBadRatings').textContent = total;
            }

            function renderRatingsTable(ratings) {
                const tbody = document.getElementById('ratingsTableBody');

                if (!ratings || ratings.length === 0) {
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="fas fa-check-circle" style="color: #10b981;"></i>
                            <p><%= __('reports.noBadRatings') %></p>
                        </td>
                    </tr>
                `;
                    return;
                }

                tbody.innerHTML = ratings.map(rating => `
                <tr onclick="openRatingModal(this)" data-rating='${JSON.stringify(rating).replace(/'/g, "&#39;")}'>
                    <td>
                        <span class="type-badge ${rating.type}">
                            <i class="fas fa-${rating.type === 'lab' ? 'flask' : 'user-nurse'}"></i>
                            ${rating.type === 'lab' ? '<%= __('reports.lab') %>' : '<%= __('reports.nurse') %>'}
                        </span >
                    </td >
                    <td>
                        <span class="target-id">${rating.qrCode || rating.orderId.slice(-8)}</span>
                    </td>
                    <td>
                        <div class="rating-stars">
                            ${renderStars(rating.rating)}
                            <span class="rating-value">${rating.rating}/5</span>
                        </div>
                    </td>
                    <td>
                        <div class="target-info">
                            <span class="target-name">${rating.target?.name || '-'}</span>
                            <span class="target-id">${rating.target?.phone || rating.target?.city || ''}</span>
                        </div>
                    </td>
                    <td>
                        <div class="target-info">
                            <span class="target-name">${rating.patient?.name || '-'}</span>
                            <span class="target-id">${rating.patient?.phone || ''}</span>
                        </div>
                    </td>
                    <td>${formatDate(rating.ratedAt)}</td>
                    <td>
                        <button class="view-btn" onclick="viewOrder('${rating.orderId}')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr >
                `).join('');
        }

        function renderStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                stars += `<i class="fas fa-star ${i <= rating ? 'active' : 'inactive'}"></i>`;
            }
            return stars;
        }

        function renderPagination(pagination, callback) {
            const container = document.getElementById('pagination');
            
            if (!pagination || pagination.pages <= 1) {
                container.innerHTML = '';
                return;
            }

            let html = '';
            
            // Previous button
            if (pagination.page > 1) {
                html += `<button class="pagination-btn" onclick="goToPage(${pagination.page - 1})"><i class="fas fa-chevron-left"></i></button>`;
            }
            
            // Page numbers
            for (let i = 1; i <= pagination.pages; i++) {
                if (i === pagination.page) {
                    html += `<button class="pagination-btn active">${i}</button>`;
                } else if (i === 1 || i === pagination.pages || (i >= pagination.page - 1 && i <= pagination.page + 1)) {
                    html += `<button class="pagination-btn" onclick="goToPage(${i})">${i}</button>`;
                } else if (i === pagination.page - 2 || i === pagination.page + 2) {
                    html += '<span>...</span>';
                }
            }
            
            // Next button
            if (pagination.page < pagination.pages) {
                html += `<button class="pagination-btn" onclick="goToPage(${pagination.page + 1})"><i class="fas fa-chevron-right"></i></button>`;
            }
            
            container.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            if (currentMainTab === 'all') {
                loadAllRatings();
            } else {
                loadBadRatings();
            }
        }

        function viewOrder(orderId) {
            window.location.href = `/admin/orders/${orderId}/details`;
        }

            function formatDate(dateString) {
                if (!dateString) return '-';
                const date = new Date(dateString);
                return date.toLocaleDateString('<%= currentLang %>' === 'ar' ? 'ar-IQ' : 'en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function getToken() {
                return localStorage.getItem('token') || '';
            }

            // Rating Modal Functions
            function openRatingModal(rowElement) {
                const modal = document.getElementById('ratingModal');
                const modalBody = document.getElementById('modalBody');
                const modalTitle = document.getElementById('modalTitle');

                // Get rating data from row
                const rating = JSON.parse(rowElement.dataset.rating);

                // Update title
                modalTitle.textContent = rating.type === 'lab' ? 'Lab Rating' : 'Nurse Rating';

                // Build modal content with Apple-style design
                modalBody.innerHTML = `
                    <!-- Rating Hero Section -->
                    <div class="rating-hero">
                        <div class="rating-stars-large">
                            ${renderModalStars(rating.rating)}
                        </div>
                        <div class="rating-score">
                            <div class="rating-score-number">${rating.rating || 0}</div>
                            <div class="rating-score-divider">/</div>
                            <div class="rating-score-max">5</div>
                        </div>
                    </div>

                    <!-- Reason Section -->
                    <div class="detail-section">
                        <div class="detail-section-title">Feedback</div>
                        <div class="reason-box">
                            <div class="reason-box-text ${!rating.reason ? 'reason-box-empty' : ''}">
                                ${rating.reason ? escapeHtml(rating.reason) : 'No feedback provided'}
                            </div>
                        </div>
                    </div>

                    <!-- Details Section -->
                    <div class="detail-section">
                        <div class="detail-section-title">Details</div>

                        <div class="detail-card" style="margin-bottom: 10px;">
                            <div class="detail-card-icon order">
                                <i class="fas fa-hashtag"></i>
                            </div>
                            <div class="detail-card-content">
                                <div class="detail-card-label">Order ID</div>
                                <div class="detail-card-value">${rating.qrCode || rating.orderId?.slice(-8) || '-'}</div>
                            </div>
                        </div>

                        <div class="detail-card" style="margin-bottom: 10px;">
                            <div class="detail-card-icon ${rating.type === 'lab' ? 'lab' : 'nurse'}">
                                <i class="fas fa-${rating.type === 'lab' ? 'flask' : 'user-nurse'}"></i>
                            </div>
                            <div class="detail-card-content">
                                <div class="detail-card-label">${rating.type === 'lab' ? '<%= __('reports.lab') %>' : '<%= __('reports.nurse') %>'}</div>
                                <div class="detail-card-value">${rating.target?.name || '-'}</div>
                                ${rating.target?.city ? `<div class="detail-card-value-sub"><i class="fas fa-map-marker-alt"></i> ${rating.target.city}</div>` : ''}
                            </div>
                        </div>

                        <div class="detail-card" style="margin-bottom: 10px;">
                            <div class="detail-card-icon user">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="detail-card-content">
                                <div class="detail-card-label"><%= __('reports.patient') %></div>
                                <div class="detail-card-value">${rating.patient?.name || '-'}</div>
                                ${rating.patient?.phone ? `<div class="detail-card-value-sub"><i class="fas fa-phone"></i> ${rating.patient.phone}</div>` : ''}
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-card-icon calendar">
                                <i class="fas fa-calendar"></i>
                            </div>
                            <div class="detail-card-content">
                                <div class="detail-card-label">Date</div>
                                <div class="detail-card-value">${
                                    rating.ratedAt
                                        ? new Date(rating.ratedAt).toLocaleDateString(
                                            '<%= currentLang %>' === 'ar' ? 'ar-IQ' : 'en-GB',
                                            { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }
                                        )
                                        : '-'
                                }</div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <button class="modal-action-btn" onclick="viewOrder('${rating.orderId}')">
                        <i class="fas fa-eye"></i>
                        View Full Order Details
                    </button>
                `;

                modal.classList.add('show');
            }

            function renderModalStars(rating) {
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += `<i class="fas fa-star ${i <= (rating || 0) ? 'active' : 'inactive'}"></i>`;
                }
                return stars;
            }

            function closeRatingModal() {
                const modal = document.getElementById('ratingModal');
                modal.classList.remove('show');
            }

            // Close modal on overlay click
            document.addEventListener('click', function(e) {
                const modal = document.getElementById('ratingModal');
                if (e.target === modal) {
                    closeRatingModal();
                }
            });

            // Close modal on Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeRatingModal();
                }
            });
        </script>
</body>

</html>
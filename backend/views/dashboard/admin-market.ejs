<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مراجعة المتجر - LabGo Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-nurses.css">
    <style>
        body { font-family: <%= font %>; }
        .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
        .card { background: #fff; border-radius: 16px; padding: 14px; border: 1px solid #eef0f3; }
        .card.new { border-color: #FF5A00; }
        .imgs { display: flex; gap: 6px; overflow-x: auto; margin: 8px 0; }
        .imgs img { width: 96px; height: 96px; object-fit: cover; border-radius: 10px; cursor: zoom-in; }
        .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #f1f2f4; }
        .pill.pending, .pill.open { background: #FFF0E6; color: #FF5A00; }
        .pill.approved, .pill.closed { background: #E6F7ED; color: #0E7A3E; }
        .pill.rejected { background: #FDECEC; color: #C81E1E; }
        .pill.in_progress { background: #EAF2FF; color: #1d4ed8; }
        .muted { color: #6b7280; font-size: 12px; }
        .row { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
        .actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
        .actions button { border: 0; border-radius: 999px; padding: 8px 14px; font: inherit; font-weight: 700; cursor: pointer; background: #f1f2f4; }
        .actions button.ok { background: #0E7A3E; color: #fff; }
        .actions button.no { background: #C81E1E; color: #fff; }
        .filters { display: flex; gap: 8px; margin: 0 0 14px; flex-wrap: wrap; }
        .filters button { border: 1px solid #e5e7eb; background: #fff; border-radius: 999px; padding: 8px 14px; font: inherit; font-weight: 700; cursor: pointer; }
        .filters button.on { background: #111; color: #fff; border-color: #111; }
        p.msg { white-space: pre-wrap; margin: 6px 0; }
        textarea { width: 100%; border: 1px solid #e5e7eb; border-radius: 12px; padding: 8px; font: inherit; }
        .ltr { direction: ltr; unicode-bidi: isolate; }
    </style>
</head>
<body>
    <%- include('../partials/admin-navbar') %>
    <main class="admin-dashboard">
        <div class="nurse-management-container">
            <div class="page-header">
                <div class="header-left">
                    <h1>مراجعة متجر المختبرات</h1>
                    <p class="header-subtitle">المنتجات والمزادات والمختبرات المعروضة للبيع لا تظهر للمختبرات إلا بعد موافقتك. يبدأ عدّاد المزاد من لحظة الموافقة.</p>
                </div>
                <div class="header-actions"><button class="modern-btn refresh-btn" onclick="view === 'orders' ? loadOrders() : load()"><i class="fas fa-sync-alt"></i><span>تحديث</span></button></div>
            </div>
            <div class="filters" id="views">
                <button data-v="listings" class="on"><i class="fas fa-store"></i> الإعلانات</button>
                <button data-v="orders"><i class="fas fa-receipt"></i> الطلبات بين المختبرات <span id="ordersBadge" class="pill pending" style="display:none"></span></button>
            </div>
            <div class="filters" id="orderFilters" style="display:none">
                <button data-s="" class="on">الكل</button>
                <button data-s="new">جديد</button>
                <button data-s="preparing">قيد التجهيز</button>
                <button data-s="shipped">تم الشحن</button>
                <button data-s="delivered">تم التوصيل</button>
                <button data-s="cancelled">ملغي</button>
            </div>
            <div id="orderTotals" class="muted" style="display:none;margin:0 0 12px"></div>
            <div class="cards" id="orders" style="display:none"></div>
            <div class="filters" id="filters">
                <button data-s="pending" class="on">بانتظار المراجعة</button>
                <button data-s="approved">معروض</button>
                <button data-s="rejected">مرفوض</button>
                <button data-s="">الكل</button>
            </div>
            <div class="cards" id="list"></div>
        </div>
    </main>
    <script>
        function token() { return localStorage.getItem('token') || (document.cookie.split('; ').find(r => r.startsWith('token=')) || '').split('=')[1]; }
        const headers = () => ({ Authorization: `Bearer ${token()}`, 'Content-Type': 'application/json' });
        const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => '&#' + c.charCodeAt(0) + ';');
        const day = (d) => d ? new Date(d).toLocaleString('en-GB', { dateStyle: 'short', timeStyle: 'short' }) : '—';
        const money = (n) => Number(n || 0).toLocaleString('en-US');
        const imgs = (list) => (list && list.length) ? '<div class="imgs">' + list.map((u) => `<a href="${esc(u)}" target="_blank" rel="noopener"><img src="${esc(u)}" alt=""></a>`).join('') + '</div>' : '';
        let filter = '';
        document.querySelectorAll('#filters button').forEach((b) => b.addEventListener('click', () => {
            document.querySelectorAll('#filters button').forEach((x) => x.classList.toggle('on', x === b));
            filter = b.dataset.s; load();
        }));

        filter = 'pending';
        const KIND = { product: 'منتج', auction: 'مزاد', lab_sale: 'مختبر للبيع', lab_auction: 'مختبر في المزاد' };
        const STATUS = { pending: 'بانتظار المراجعة', approved: 'معروض', rejected: 'مرفوض' };
        async function load() {
            const res = await fetch('/api/admin/hub/market' + (filter ? `?status=${filter}` : ''), { headers: headers() });
            const data = await res.json();
            const list = document.getElementById('list');
            if (!data.success) { list.innerHTML = 'تعذر التحميل'; return; }
            list.innerHTML = data.data.items.map((l) => `
                <div class="card ${l.approvalStatus === 'pending' ? 'new' : ''}">
                    <div class="row"><b>${esc(l.title)}</b><span class="pill ${l.approvalStatus}">${STATUS[l.approvalStatus]}</span></div>
                    <div class="muted">${KIND[l.kind] || l.kind} · ${esc(l.labId ? l.labId.name : '—')} · <span class="ltr">${esc(l.labId ? l.labId.phone : '')}</span></div>
                    ${imgs(l.images)}
                    <div><b class="ltr">${money(l.price)} IQD</b> ${l.kind === 'product' ? `· الكمية ${esc(l.stock)} ${esc(l.unit)}` : ''} ${l.kind.includes('auction') ? `· مدة المزاد ${esc(l.durationDays)} يوم · مزايدات ${(l.bids || []).length} · الأعلى ${money(l.currentBid)}` : ''}</div>
                    ${l.category ? `<div class="muted">${esc(l.category)} ${l.condition ? '· ' + esc(l.condition) : ''} ${l.code ? '· ' + esc(l.code) : ''}</div>` : ''}
                    ${l.location ? `<div class="muted">${esc(l.location)} ${l.area ? '· ' + esc(l.area) : ''}</div>` : ''}
                    ${l.equipment ? `<div class="muted">الأجهزة: ${esc(l.equipment)}</div>` : ''}
                    ${l.description ? `<p class="msg">${esc(l.description)}</p>` : ''}
                    <div class="muted">${day(l.createdAt)}${l.rejectReason ? ' · السبب: ' + esc(l.rejectReason) : ''}</div>
                    <div class="actions">
                        ${l.approvalStatus !== 'approved' ? `<button class="ok" onclick="review('${l._id}','approve')"><i class="fas fa-check"></i> موافقة ونشر</button>` : ''}
                        ${l.approvalStatus !== 'rejected' ? `<button class="no" onclick="review('${l._id}','reject')"><i class="fas fa-times"></i> رفض</button>` : ''}
                    </div>
                </div>`).join('') || '<p class="muted">لا يوجد شيء هنا</p>';
        }
        async function review(id, action) {
            let reason = '';
            if (action === 'reject') { reason = prompt('سبب الرفض (يصل للمختبر):') || ''; }
            await fetch(`/api/admin/hub/market/${id}`, { method: 'PATCH', headers: headers(), body: JSON.stringify({ action, reason }) });
            load();
        }
        load();

        // ---------- orders between labs ----------
        const ORDER = { new: 'جديد', preparing: 'قيد التجهيز', shipped: 'تم الشحن', delivered: 'تم التوصيل', cancelled: 'ملغي' };
        const ORDER_PILL = { new: 'pending', preparing: 'in_progress', shipped: 'in_progress', delivered: 'approved', cancelled: 'rejected' };
        let orderFilter = '', view = 'listings';
        const labLine = (l) => l ? `${esc(l.name)}${l.city ? ' · ' + esc(l.city) : ''} · <span class="ltr">${esc(l.phone || '')}</span>` : '—';
        async function loadOrders() {
            const res = await fetch('/api/admin/hub/market/orders' + (orderFilter ? `?status=${orderFilter}` : ''), { headers: headers() });
            const data = await res.json();
            const box = document.getElementById('orders');
            if (!data.success) { box.innerHTML = 'تعذر التحميل'; return; }
            const t = data.data.totals || [], sum = (k) => (t.find((x) => x._id === k) || { count: 0, total: 0 });
            const all = t.reduce((a, x) => a + x.count, 0);
            document.getElementById('orderTotals').innerHTML = `إجمالي الطلبات <b>${all}</b> · جديد <b>${sum('new').count}</b> · قيد التجهيز <b>${sum('preparing').count}</b> · تم التوصيل <b>${sum('delivered').count}</b> بقيمة <b class="ltr">${money(sum('delivered').total)} IQD</b> · ملغي <b>${sum('cancelled').count}</b>`;
            box.innerHTML = data.data.items.map((o) => `
                <div class="card ${o.adminSeenAt ? '' : 'new'}">
                    <div class="row"><b><span class="ltr">#${esc(o.orderNo)}</span> · ${esc(o.title)}</b><span class="pill ${ORDER_PILL[o.status]}">${ORDER[o.status]}</span></div>
                    <div class="muted">${o.kind === 'interest' ? 'طلب شراء مختبر' : 'شراء منتج · الكمية ' + esc(o.quantity)} · ${day(o.createdAt)}</div>
                    <div style="margin:8px 0"><b class="ltr">${money(o.total)} IQD</b></div>
                    <div class="muted"><b>المشتري:</b> ${labLine(o.buyerLabId)}</div>
                    <div class="muted"><b>البائع:</b> ${labLine(o.sellerLabId)}</div>
                    <div class="muted"><b>هاتف الطلب:</b> <span class="ltr">${esc(o.phone)}</span>${o.address ? ' · ' + esc(o.address) : ''}</div>
                    ${o.note ? `<p class="msg">${esc(o.note)}</p>` : ''}
                    <div class="actions">
                        <select onchange="moveOrder('${o._id}', this.value)" style="border:1px solid #e5e7eb;border-radius:999px;padding:8px 12px;font:inherit;font-weight:700">
                            ${Object.keys(ORDER).map((k) => `<option value="${k}" ${k === o.status ? 'selected' : ''}>${ORDER[k]}</option>`).join('')}
                        </select>
                    </div>
                </div>`).join('') || '<p class="muted">لا توجد طلبات</p>';
            // opening the list clears the "new orders" badge
            if (data.data.unseen) fetch('/api/admin/hub/market/orders/seen', { method: 'POST', headers: headers() });
            document.getElementById('ordersBadge').style.display = 'none';
        }
        async function moveOrder(id, status) {
            if (!confirm('تغيير حالة الطلب إلى «' + ORDER[status] + '»؟ سيصل إشعار للمختبرين.')) { loadOrders(); return; }
            await fetch(`/api/admin/hub/market/orders/${id}`, { method: 'PATCH', headers: headers(), body: JSON.stringify({ status }) });
            loadOrders();
        }
        function showView(v) {
            view = v;
            document.querySelectorAll('#views button').forEach((x) => x.classList.toggle('on', x.dataset.v === v));
            const orders = v === 'orders';
            document.getElementById('filters').style.display = orders ? 'none' : '';
            document.getElementById('list').style.display = orders ? 'none' : '';
            ['orderFilters', 'orderTotals', 'orders'].forEach((id) => { document.getElementById(id).style.display = orders ? '' : 'none'; });
            if (orders) loadOrders();
        }
        document.querySelectorAll('#views button').forEach((b) => b.addEventListener('click', () => showView(b.dataset.v)));
        document.querySelectorAll('#orderFilters button').forEach((b) => b.addEventListener('click', () => {
            document.querySelectorAll('#orderFilters button').forEach((x) => x.classList.toggle('on', x === b));
            orderFilter = b.dataset.s; loadOrders();
        }));
        fetch('/api/admin/hub/counts', { headers: headers() }).then((r) => r.json()).then((d) => {
            if (d.success && d.data.orders) { const b = document.getElementById('ordersBadge'); b.textContent = d.data.orders; b.style.display = 'inline-block'; }
        }).catch(() => {});
        if (location.hash === '#orders') showView('orders');
    </script>
</body>
</html>

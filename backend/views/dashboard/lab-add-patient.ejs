<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>

<body>
    <%- include('../partials/lab-navbar') %>
    <link rel="stylesheet" href="/css/lab-add-patient.css">
<%
    // Words this layout adds (Arabic / Kurdish / English; Turkish falls back to English).
    const L = currentLang === 'ar' ? 0 : currentLang === 'ku' ? 1 : 2;
    const tr = (ar, ku, en) => [ar, ku, en][L];
%>

    <main class="la-main ap-page">
        <header class="ap-head">
            <h1 class="la-h1"><%= __('labApp.addPatient') %></h1>
            <p class="la-sub"><%= __('walkIn.subtitle') %></p>
        </header>

        <form id="apForm" class="ap-grid" autocomplete="off" novalidate>
            <div class="ap-col">
                <!-- patient, phone, doctor, tests -->
                <section class="la-card ap-card pop-in">
                    <!-- row 1: name, with age and gender small beside it -->
                    <div class="ap-row ap-row-name">
                        <label class="ap-field ap-name">
                            <span class="la-label"><%= __('walkIn.fullName') %> <b class="ap-req">*</b></span>
                            <input class="la-input" id="apName" required autocomplete="off" role="combobox" aria-controls="apNameHits" aria-expanded="false">
                            <div class="ap-results ap-name-hits" id="apNameHits" role="listbox" hidden></div>
                        </label>
                        <div class="ap-field ap-age-field">
                            <span class="la-label"><%= __('walkIn.age') %></span>
                            <div class="ap-age">
                                <input class="la-input" id="apAge" inputmode="numeric" maxlength="3" placeholder="30" dir="ltr">
                                <div class="ap-mini-seg" id="apAgeUnit" role="radiogroup" aria-label="<%= __('walkIn.age') %>">
                                    <button type="button" class="on" data-v="Y" title="<%= __('results.unitYears') %>"><%= __('results.unitYears') %></button>
                                    <button type="button" data-v="M" title="<%= __('results.unitMonths') %>"><%= __('results.unitMonths') %></button>
                                    <button type="button" data-v="D" title="<%= __('results.unitDays') %>"><%= __('results.unitDays') %></button>
                                </div>
                            </div>
                        </div>
                        <div class="ap-field ap-gender-field">
                            <span class="la-label"><%= __('walkIn.gender') %></span>
                            <div class="ap-mini-seg" id="apGender" role="radiogroup" aria-label="<%= __('walkIn.gender') %>">
                                <button type="button" data-v="male"><%= __('common.male') %></button>
                                <button type="button" data-v="female"><%= __('common.female') %></button>
                            </div>
                        </div>
                    </div>

                    <!-- row 2: phone, with the doctor beside it -->
                    <div class="ap-row ap-row-2">
                        <label class="ap-field">
                            <span class="la-label"><%= __('walkIn.phone') %> <b class="ap-req">*</b></span>
                            <span class="ap-input-wrap">
                                <svg class="ic"><use href="#i-phone"/></svg>
                                <input class="la-input" id="apPhone" type="tel" inputmode="tel" dir="ltr" placeholder="07XX XXX XXXX" required aria-describedby="apPhoneHint">
                            </span>
                            <small class="ap-hint" id="apPhoneHint"><%= __('walkIn.phoneOrId') %></small>
                            <small class="ap-found" id="apFound" hidden><svg class="ic"><use href="#i-circle-check"/></svg><%= __('walkIn.knownPatient') %><b id="apFoundNo" dir="ltr"></b></small>
                        </label>
                        <label class="ap-field">
                            <span class="la-label"><%= __('walkIn.doctor') %></span>
                            <span class="ap-input-wrap">
                                <svg class="ic"><use href="#i-stethoscope"/></svg>
                                <input class="la-input" id="apDoctor" list="apDoctors" placeholder="<%= __('walkIn.doctorPlaceholder') %>">
                            </span>
                            <datalist id="apDoctors"></datalist>
                        </label>
                    </div>

                    <!-- row 3: test search; tests appear while typing -->
                    <div class="ap-tests-head">
                        <span class="la-label"><%= __('walkIn.tests') %></span>
                        <span class="ap-count" id="apCount">0</span>
                    </div>
                    <div class="ap-combo">
                        <label class="la-search ap-search">
                            <svg class="ic"><use href="#i-search"/></svg>
                            <input id="apSearch" placeholder="<%= tr('ابحث عن فحص أو باقة بالاسم أو الرمز', 'گەڕان بۆ پشکنین یان پاکێج', 'Search a test or package by name or code') %>" aria-label="<%= __('walkIn.tests') %>" aria-controls="apResults" aria-autocomplete="list">
                            <kbd class="ap-kbd">Enter</kbd>
                        </label>
                        <div class="ap-results" id="apResults" role="listbox" hidden></div>
                    </div>
                    <div id="apSelected" class="ap-selected"></div>
                    <p class="ap-hint ap-empty-hint" id="apNoTests"><%= tr('اكتب اسم الفحص أو رمزه، ثم اختره أو اضغط Enter', 'ناو یان کۆدی پشکنین بنووسە', 'Type a test name or code, then pick it or press Enter') %></p>
                </section>

                <!-- the sample: type, urgency, a short note -->
                <section class="la-card ap-card ap-sample-card fade-up">
                    <div class="ap-sample-row">
                        <span class="ap-sample-title"><%= tr('العينة', 'نموونە', 'Sample') %></span>
                        <div class="ap-mini-seg ap-sample-seg" id="apSample" role="radiogroup" aria-label="<%= __('walkIn.sampleType') %>">
                            <% [['blood', 'walkIn.blood'], ['urine', 'walkIn.urine'], ['stool', 'walkIn.stool'], ['swab', 'walkIn.swab'], ['csf', 'walkIn.csf']].forEach(function (s, i) { %>
                                <button type="button" class="<%= i === 0 ? 'on' : '' %>" data-v="<%= s[0] %>"><%= __(s[1]) %></button>
                            <% }); %>
                        </div>
                        <div class="ap-mini-seg ap-urgency" id="apUrgency" role="radiogroup" aria-label="<%= __('walkIn.urgency') %>">
                            <button type="button" class="on" data-v="routine"><%= __('walkIn.routine') %></button>
                            <button type="button" data-v="urgent"><%= __('walkIn.urgent') %></button>
                        </div>
                    </div>
                    <span class="ap-input-wrap ap-note">
                        <svg class="ic"><use href="#i-sticky-note"/></svg>
                        <input class="la-input" id="apNotes" maxlength="300" placeholder="<%= __('walkIn.notes') %> — <%= __('walkIn.notesPlaceholder') %>" aria-label="<%= __('walkIn.notes') %>">
                    </span>
                </section>
            </div>

            <!-- side: B2B, price, print on save, save -->
            <aside class="ap-col ap-side">
                <section class="la-card ap-card ap-pay pop-in">
                    <div class="ap-b2b-row">
                        <span class="ap-b2b-text">
                            <b><%= tr('سعر الشركات', 'نرخی کۆمپانیا', 'Company price') %></b>
                            <small><%= tr('لعيادة أو شركة: يُحتسب سعر B2B', 'نرخی B2B', 'For a clinic or company: B2B prices apply') %></small>
                        </span>
                        <button type="button" class="ap-b2b" id="apB2b" role="switch" aria-checked="false">B2B</button>
                    </div>
                    <label class="ap-field ap-company" id="apCompanyRow" hidden>
                        <span class="la-label"><%= __('walkIn.company') %> <b class="ap-req">*</b></span>
                        <input class="la-input" id="apCompany" list="apCompanies" placeholder="<%= tr('اسم العيادة أو الشركة', 'ناوی کلینیک یان کۆمپانیا', 'Clinic or company name') %>">
                        <datalist id="apCompanies"></datalist>
                    </label>

                    <!-- the price, as a receipt printer: its screen shows the total, its paper the live receipt -->
                    <section class="ap-printer" id="apPrinter" data-stage="idle" aria-label="<%= tr('الوصل', 'پسوولە', 'Receipt') %>">
                        <div class="ap-machine">
                            <div class="ap-printer-head">
                                <span class="ap-status" role="status" aria-live="polite">
                                    <span class="ap-status-ic" aria-hidden="true">
                                        <svg class="ap-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
                                        <svg class="ap-ok" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.7 7.7-5.5 5.5a1 1 0 0 1-1.4 0l-2.5-2.5a1 1 0 1 1 1.4-1.4l1.8 1.8 4.8-4.8a1 1 0 1 1 1.4 1.4Z"/></svg>
                                        <span class="ap-idle-dot"></span>
                                    </span>
                                    <span class="ap-status-text" id="apStatusText"><%= tr('جاهز للطباعة', 'ئامادەیە', 'Ready to print') %></span>
                                </span>
                                <span class="ap-printer-count" id="apPrinterCount" dir="ltr">0</span>
                            </div>
                            <div class="ap-screen">
                                <span class="ap-price-label"><%= __('walkIn.total') %></span>
                                <b class="ap-total" id="apTotal" dir="ltr">0</b>
                            </div>
                            <div class="ap-lines">
                                <div class="ap-line"><span><%= __('walkIn.subtotal') %></span><b id="apSubtotal" dir="ltr">0</b></div>
                                <label class="ap-line">
                                    <span><%= __('walkIn.discount') %></span>
                                    <input class="la-input ap-discount" id="apDiscount" inputmode="numeric" placeholder="0" dir="ltr">
                                </label>
                            </div>
                            <span class="ap-slot" aria-hidden="true"></span>
                        </div>
                        <div class="ap-output">
                            <div class="ap-feed" id="apFeed">
                                <article class="ap-paper" id="apPaper" aria-hidden="true">
                                    <header class="ap-r-head">
                                        <b><%= lab.name %></b>
                                        <span id="apRDate" dir="ltr"></span>
                                    </header>
                                    <div class="ap-r-who">
                                        <span id="apRName">—</span>
                                        <span id="apRMeta" dir="ltr"></span>
                                    </div>
                                    <div class="ap-r-rule"></div>
                                    <ul class="ap-r-lines" id="apRLines"></ul>
                                    <div class="ap-r-rule"></div>
                                    <div class="ap-r-row" id="apRDiscRow" hidden><span><%= __('walkIn.discount') %></span><span id="apRDisc" dir="ltr"></span></div>
                                    <div class="ap-r-row ap-r-total"><span><%= __('walkIn.total') %></span><span id="apRTotal" dir="ltr">0</span></div>
                                    <p class="ap-r-foot" id="apRFoot"><%= tr('شكراً لزيارتكم', 'سوپاس', 'Thank you') %></p>
                                </article>
                            </div>
                        </div>
                    </section>

                    <!-- before saving: options and save -->
                    <div class="ap-before" id="apBefore">
                        <div class="ap-toggle-row">
                            <span class="ap-toggle-text"><svg class="ic"><use href="#i-printer"/></svg><%= tr('طباعة الوصل عند الحفظ', 'چاپی پسوولە لە کاتی پاشەکەوت', 'Print the receipt on save') %></span>
                            <button type="button" class="la-switch" id="apPrintOnSave" role="switch" aria-checked="false" aria-label="<%= tr('طباعة الوصل عند الحفظ', 'چاپی پسوولە', 'Print the receipt on save') %>"></button>
                        </div>
                        <div class="ap-toggle-row">
                            <span class="ap-toggle-text"><svg class="ic"><use href="#i-clock"/></svg><%= __('walkIn.payLater') %></span>
                            <button type="button" class="la-switch" id="apPayLater" role="switch" aria-checked="false" aria-label="<%= __('walkIn.payLater') %>"></button>
                        </div>
                        <button type="submit" class="la-btn block press-95 ap-submit" id="apSubmit">
                            <svg class="ic"><use href="#i-check"/></svg><span><%= tr('حفظ', 'پاشەکەوت', 'Save') %></span>
                        </button>
                        <p class="ap-error" id="apError" role="alert" hidden></p>
                    </div>

                    <!-- after saving: print the receipt or the tube label, like the app -->
                    <div class="ap-after" id="apAfter" hidden>
                        <p class="ap-after-meta"><span id="apDoneName"></span><b dir="ltr" id="apDoneCode"></b><span id="apDoneNoWrap" hidden><%= __('walkIn.patientNo') %> <b dir="ltr" id="apDoneNo"></b></span></p>
                        <div class="ap-after-print">
                            <button type="button" class="la-btn press-95" id="apPrintReceipt"><svg class="ic"><use href="#i-printer"/></svg><%= tr('طباعة الوصل', 'چاپی پسوولە', 'Print receipt') %></button>
                            <div class="ap-label-group">
                                <button type="button" class="la-btn soft press-95" id="apPrintLabel"><svg class="ic"><use href="#i-test-tube"/></svg><%= tr('ليبل التيوب', 'لیبڵی تیوب', 'Tube label') %></button>
                                <span class="ap-copies" role="group" aria-label="<%= tr('عدد النسخ', 'ژمارەی کۆپی', 'Copies') %>">
                                    <button type="button" data-d="-1" aria-label="−">−</button><b id="apCopies" dir="ltr">1</b><button type="button" data-d="1" aria-label="+">+</button>
                                </span>
                            </div>
                        </div>
                        <div class="ap-after-links">
                            <button type="button" class="la-btn chip press-95" id="apAnother"><svg class="ic"><use href="#i-plus"/></svg><%= __('walkIn.addAnother') %></button>
                            <a class="ap-link" id="apGoResults"><%= __('results.enterResults') %></a>
                            <a class="ap-link" id="apGoOrder"><%= __('orders.orderDetails') %></a>
                        </div>
                    </div>
                    <iframe class="ap-print-frame" id="apPrintFrame" title="print" tabindex="-1" aria-hidden="true"></iframe>
                </section>
            </aside>
        </form>

    </main>

    <script id="apCatalog" type="application/json"><%- catalogJson %></script>
    <script id="apStrings" type="application/json"><%- JSON.stringify({
        iqd: __('walkIn.iqd'), noTests: __('walkIn.noTests'), noMatch: __('walkIn.noMatch'),
        needPhone: __('walkIn.needPhone'), needName: __('walkIn.needName'), needTests: __('walkIn.needTests'),
        saving: __('results.saving'), error: __('walkIn.saveError'), packageLabel: __('walkIn.package'), remove: __('common.delete'),
        needCompany: tr('اكتب اسم العيادة أو الشركة لسعر B2B', 'ناوی کۆمپانیا بنووسە', 'Enter the clinic or company name for B2B prices'),
        b2bPrice: tr('سعر B2B', 'نرخی B2B', 'B2B price'),
        added: tr('أُضيف', 'زیادکرا', 'Added'),
        stIdle: tr('جاهز للطباعة', 'ئامادەیە', 'Ready to print'),
        stProcessing: tr('جاري حفظ المريض', 'پاشەکەوت دەکرێت', 'Saving the patient'),
        stPrinting: tr('جاري طباعة الوصل', 'چاپ دەکرێت', 'Printing the receipt'),
        stComplete: tr('تم الحفظ', 'پاشەکەوت کرا', 'Saved'),
        noTestsYet: tr('لا تحاليل بعد', 'هیچ پشکنینێک نییە', 'No tests yet'),
        thanks: tr('شكراً لزيارتكم', 'سوپاس', 'Thank you')
    }).replace(/</g, '\\u003c') %></script>
    <script>window.AP_LANG = '<%= currentLang %>';</script>
    <script src="/js/lab-add-patient.js"></script>
</body>

</html>

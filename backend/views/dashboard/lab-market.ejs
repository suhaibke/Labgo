             ['location', 'mkLocation'], ['area', 'mkArea'], ['equipment', 'mkEquipment'], ['days', 'mkDays'], ['description', 'mkDesc']].forEach(function (p) {
                var el = document.getElementById(p[1]);
                if (!el.closest('[data-for]') || !el.closest('[data-for]').hidden) fd.append(p[0], el.value.trim());
            });
            files.forEach(function (f) { fd.append('images', f); });
            var btn = document.getElementById('mkSave'); btn.disabled = true;
            fetch('/lab/api/market', { method: 'POST', body: fd }).then(function (r) { return r.json(); }).then(function (res) {
                if (!res.success) { err.textContent = res.message || T.error; err.hidden = false; return; }
                items.unshift(res.data); add.classList.remove('active');
                document.querySelector('#mkTabs a[data-k="mine"]').click();
                window.laToast(T.sent);
            }).catch(function () { window.laToast(T.error); }).finally(function () { btn.disabled = false; });
        });

        load();
        loadOrders();
    })();
    </script>
</body>

</html>

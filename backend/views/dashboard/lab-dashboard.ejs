<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>

<body>
    <%- include('../partials/lab-navbar') %>
    <%
      const L = (k) => __('labApp.' + k);
      const now = new Date();
      const locale = { ar: 'ar-IQ', ku: 'ckb-IQ', en: 'en-GB', tr: 'tr-TR' }[currentLang] || 'en-GB';
      let dateText;
      try { dateText = now.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }); }
      catch (e) { dateText = now.toDateString(); }
      const greeting = now.getHours() < 12 ? L('greetingMorning') : L('greetingEvening');
      const days = Array.isArray(monthlyStats) ? monthlyStats : [];
      const monthTests = days.reduce((a, d) => a + (d.tests || 0), 0);
      const maxDay = Math.max(1, ...days.map((d) => d.tests || 0));
      const today = now.getDate();
      const total = stats.totalTestsPerformed || 0;
      const pending = stats.pendingPatientTests || 0;
      const donePct = total > 0 ? Math.max(0, Math.min(1, (total - pending) / total)) : 0;
      const circ = 2 * Math.PI * 40;
      // cumulative tests for the growth line (viewBox 320 x 118)
      let run = 0;
      const cum = days.map((d) => (run += d.tests || 0));
      const cmax = Math.max(1, run);
      const pts = cum.map((v, i) => `${days.length > 1 ? (i * 320 / (days.length - 1)).toFixed(1) : 0},${(108 - (v / cmax) * 90).toFixed(1)}`);
      const statusKey = (s) => (s === 'Completed' ? 'completed' : s === 'In Progress' ? 'inProgress' : 'pending');
      const pillClass = (s) => (s === 'Pending' ? 'accent' : 'neutral');
      const initials = (n) => String(n || '?').split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
    %>

    <%
      const W = (k) => __('labWeb.' + k);
      const delta = (v, suffix) => { const n = Number(v) || 0; return { cls: n > 0 ? 'green' : n < 0 ? 'red' : 'neutral', txt: (n > 0 ? '+' : '') + n + (suffix || '%') }; };
      const pillFor = (s) => (s === 'Completed' ? 'green' : s === 'In Progress' ? 'blue' : 'amber');
      const kpis = [
        { label: W('patientsServed'), value: stats.totalPatientsServed, icon: 'users', d: delta(stats.patientGrowth) },
        { label: W('testsDone'), value: total, icon: 'flask-conical', d: delta(stats.testsGrowth) },
        { label: W('pendingNow'), value: pending, icon: 'hourglass', d: delta(stats.pendingChange), invert: true },
        { label: W('avgRating'), value: stats.averageRating.toFixed(1), icon: 'star', d: delta(stats.ratingChange, '') },
      ];
    %>
    <main class="la-main screen-enter">
        <div class="la-page-head">
            <div>
                <p class="la-eyebrow" style="margin:0 0 6px"><%= dateText %></p>
                <h1 class="la-h1"><%= greeting %><%= ['ar', 'ku'].includes(currentLang) ? '،' : ',' %> <%= user.name %></h1>
                <p class="la-sub" style="margin-top:4px"><%= W('overviewSub') %></p>
            </div>
            <div class="la-page-actions">
                <a href="/lab/orders" class="la-btn secondary"><svg class="ic"><use href="#i-clipboard-list"/></svg><%= W('openOrders') %></a>
                <% if (typeof labCan !== 'function' || labCan('/lab/patients/new')) { %>
                <a href="/lab/patients/new" class="la-btn"><svg class="ic"><use href="#i-user-plus"/></svg><%= L('addPatient') %></a>
                <% } %>
            </div>
        </div>

        <!-- KPIs -->
        <div class="dash-kpis">
            <% kpis.forEach(function (k, i) { const dc = k.invert ? (k.d.cls === 'green' ? 'red' : k.d.cls === 'red' ? 'green' : 'neutral') : k.d.cls; %>
            <section class="la-card dash-kpi stagger" style="animation-delay:<%= (i * .04).toFixed(2) %>s">
                <div class="la-between">
                    <span class="dash-kpi-label"><%= k.label %></span>
                    <span class="dash-kpi-ic"><svg class="ic"><use href="#i-<%= k.icon %>"/></svg></span>
                </div>
                <b class="dash-kpi-value num" <% if (typeof k.value === 'number') { %>data-count="<%= k.value %>"<% } %>><%= typeof k.value === 'number' ? k.value.toLocaleString('en-US') : k.value %></b>
                <div class="dash-kpi-foot">
                    <span class="la-pill <%= dc %>" dir="ltr"><%= k.d.txt %></span>
                    <span><%= L('vsLastMonth') %></span>
                </div>
            </section>
            <% }); %>
        </div>

        <!-- Charts -->
        <div class="dash-charts">
            <section class="la-card flush">
                <div class="la-card-head">
                    <div>
                        <h2 class="la-h2"><%= W('dailyVolume') %></h2>
                        <p class="la-sub"><%= W('testsThisMonth') %>: <b style="color:var(--ink)" class="num"><%= monthTests.toLocaleString('en-US') %></b></p>
                    </div>
                    <span class="la-pill dot accent"><%= W('today') %></span>
                </div>
                <div class="la-card-body">
                    <div class="dash-bars" dir="ltr">
                        <% days.forEach(function (d, i) { %>
                            <div class="dash-bar-col <%= (i + 1) === today ? 'on' : '' %>" title="<%= d.month %>: <%= d.tests %>">
                                <span class="bar-grow" style="height:<%= Math.max(2, (d.tests || 0) / maxDay * 100) %>%;animation-delay:<%= (i * 0.012).toFixed(3) %>s"></span>
                            </div>
                        <% }); %>
                    </div>
                    <div class="dash-axis" dir="ltr">
                        <span>1</span><span><%= Math.ceil(days.length / 2) || 15 %></span><span><%= days.length || 30 %></span>
                    </div>
                </div>
            </section>

            <section class="la-card flush">
                <div class="la-card-head"><h2 class="la-h2"><%= W('completion') %></h2></div>
                <div class="la-card-body dash-donut-body">
                    <div class="la-donut">
                        <svg viewBox="0 0 100 100" class="la-donut-svg">
                            <circle cx="50" cy="50" r="40" fill="none" stroke="var(--track)" stroke-width="9"/>
                            <circle cx="50" cy="50" r="40" fill="none" stroke="var(--accent)" stroke-width="9" stroke-linecap="round"
                                    stroke-dasharray="<%= circ %>" stroke-dashoffset="<%= circ * (1 - donePct) %>"/>
                        </svg>
                        <div class="la-donut-center"><b class="num"><%= Math.round(donePct * 100) %>%</b><span><%= W('done') %></span></div>
                    </div>
                    <dl class="dash-legend">
                        <div><dt><i style="background:var(--accent)"></i><%= L('completed') %></dt><dd class="num"><%= (total - pending).toLocaleString('en-US') %></dd></div>
                        <div><dt><i style="background:var(--track)"></i><%= L('pending') %></dt><dd class="num"><%= pending.toLocaleString('en-US') %></dd></div>
                        <div><dt><i style="background:var(--blue)"></i><%= L('tests') %></dt><dd class="num"><%= total.toLocaleString('en-US') %></dd></div>
                    </dl>
                </div>
            </section>
        </div>

        <div class="dash-grid">
            <!-- Recent reports -->
            <section class="la-card flush">
                <div class="la-card-head" style="flex-wrap:wrap">
                    <h2 class="la-h2"><%= L('recentReports') %></h2>
                    <div class="la-toolbar">
                        <div class="la-search" style="height:34px;min-width:200px">
                            <svg class="ic"><use href="#i-search"/></svg>
                            <input id="recentSearch" placeholder="<%= L('search') %>" aria-label="<%= L('search') %>">
                        </div>
                        <div class="la-seg" id="recentFilters">
                            <button class="la-chip on" data-f="all"><%= L('all') %></button>
                            <button class="la-chip" data-f="Pending"><%= L('pending') %></button>
                            <button class="la-chip" data-f="In Progress"><%= L('inProgress') %></button>
                            <button class="la-chip" data-f="Completed"><%= L('completed') %></button>
                        </div>
                    </div>
                </div>
                <div style="overflow-x:auto">
                    <table class="la-table">
                        <thead><tr><th><%= W('colPatient') %></th><th><%= W('colTest') %></th><th><%= W('colTime') %></th><th><%= W('colStatus') %></th><th></th></tr></thead>
                        <tbody id="recentList">
                        <% recentTests.forEach(function (t) { const nm = (t.patientInfo && t.patientInfo.name) || __('common.notAvailable'); %>
                            <tr class="dash-row" data-href="/lab/orders/<%= t._id %>" data-status="<%= t.status %>" data-search="<%= nm + ' ' + (t.testName || '') %>">
                                <td><span class="la-row-flex" style="gap:10px"><span class="la-avatar" style="width:30px;height:30px;font-size:11.5px"><%= initials(nm) %></span><b style="font-weight:600"><%= nm %></b></span></td>
                                <td class="la-muted-2"><%= t.testName %></td>
                                <td class="la-muted num" dir="ltr" style="text-align:start"><%= new Date(t.requestDate).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></td>
                                <td><span class="la-pill dot <%= pillFor(t.status) %>"><%= L(statusKey(t.status)) %></span></td>
                                <td style="text-align:end"><svg class="ic flip-rtl" style="width:16px;height:16px;color:var(--muted)"><use href="#i-chevron-right"/></svg></td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <div class="la-empty-box" id="recentEmpty" style="<%= recentTests.length ? 'display:none' : '' %>">
                    <svg class="ic"><use href="#i-inbox"/></svg><b><%= L('noResults') %></b>
                </div>
                <div class="la-card-foot" style="text-align:center">
                    <a href="/lab/orders" style="font-size:13px;font-weight:600;color:var(--accent)"><%= L('viewAll') %></a>
                </div>
            </section>

            <!-- Quick actions -->
            <aside class="la-card flush">
                <div class="la-card-head"><h2 class="la-h2"><%= L('quickActions') %></h2></div>
                <div class="dash-actions">
                    <% [
                        ['/lab/patients/new', 'user-plus', L('addPatient')],
                        ['/lab/tests', 'flask-conical', L('addTest')],
                        ['/lab/patient-tests', 'test-tube', L('viewTests')],
                        ['/lab/external-transfers', 'arrow-left-right', __('navigation.externalTransfers')],
                        ['/lab/reports', 'chart-line', L('reports')],
                        ['/lab/settings', 'settings', L('settings')],
                       ].filter(function (a) { return typeof labCan !== 'function' || labCan(a[0]); }).forEach(function (a) { %>
                        <a href="<%= a[0] %>" class="dash-action">
                            <span class="la-icon-circle"><svg class="ic"><use href="#i-<%= a[1] %>"/></svg></span>
                            <span><%= a[2] %></span>
                            <svg class="ic flip-rtl chev"><use href="#i-chevron-right"/></svg>
                        </a>
                    <% }); %>
                </div>
            </aside>
        </div>
    </main>

    <style>
        html.la .dash-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 20px; }
        html.la .dash-kpi { padding: 18px 20px; }
        html.la .dash-kpi-label { font-size: 13px; color: var(--muted-2); font-weight: 500; }
        html.la .dash-kpi-ic { width: 30px; height: 30px; border-radius: var(--r-sm); display: grid; place-items: center; background: var(--chip-bg); color: var(--muted-2); }
        html.la .dash-kpi-ic .ic { width: 16px; height: 16px; }
        html.la .dash-kpi-value { display: block; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-top: 10px; }
        html.la .dash-kpi-foot { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 12px; color: var(--muted); }
        html.la .dash-charts { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; margin-top: 16px; }
        html.la .dash-bars { height: 180px; display: flex; align-items: flex-end; gap: 4px; }
        html.la .dash-bar-col { flex: 1; height: 100%; display: flex; align-items: flex-end; border-radius: 4px; }
        html.la .dash-bar-col:hover { background: var(--chip-bg); }
        html.la .dash-bar-col span { width: 100%; background: color-mix(in srgb, var(--accent) 22%, var(--track)); border-radius: 4px 4px 1px 1px; }
        html.la .dash-bar-col.on span { background: var(--accent); }
        html.la .dash-axis { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line); }
        html.la .dash-donut-body { display: flex; align-items: center; gap: 24px; }
        html.la .la-donut { width: 132px; height: 132px; display: grid; flex-shrink: 0; }
        html.la .la-donut > * { grid-area: 1 / 1; }
        html.la .la-donut-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        html.la[dir="rtl"] .la-donut-svg { transform: scaleX(-1) rotate(-90deg); }
        html.la .la-donut-center { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        html.la .la-donut-center b { font-size: 24px; line-height: 1; font-weight: 700; }
        html.la .la-donut-center span { font-size: 12px; color: var(--muted); margin-top: 4px; }
        html.la .dash-legend { flex: 1; margin: 0; display: grid; gap: 10px; }
        html.la .dash-legend div { display: flex; justify-content: space-between; align-items: center; font-size: 13px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
        html.la .dash-legend div:last-child { border-bottom: 0; padding-bottom: 0; }
        html.la .dash-legend dt { display: flex; align-items: center; gap: 8px; color: var(--muted-2); }
        html.la .dash-legend dd { margin: 0; font-weight: 600; }
        html.la .dash-legend i { width: 8px; height: 8px; border-radius: 2px; }
        html.la .dash-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; margin-top: 16px; }
        html.la .dash-row { cursor: pointer; }
        html.la #recentFilters .la-chip { height: 28px; border: 0; background: transparent; padding: 0 10px; font-size: 12.5px; }
        html.la #recentFilters .la-chip.on { background: var(--card); color: var(--ink); box-shadow: var(--shadow-md); }
        html.la .dash-actions { padding: 6px; }
        html.la .dash-action { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: var(--r-sm); font-size: 13.5px; font-weight: 500; }
        html.la .dash-action:hover { background: var(--chip-bg); }
        html.la .dash-action > span:nth-child(2) { flex: 1; }
        html.la .dash-action .chev { width: 16px; height: 16px; color: var(--muted); }
        @media (max-width: 1280px) { html.la .dash-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 1100px) { html.la .dash-grid, html.la .dash-charts { grid-template-columns: minmax(0, 1fr); } }
        @media (max-width: 560px) { html.la .dash-kpis { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; } html.la .dash-kpi-value { font-size: 22px; } html.la .dash-donut-body { flex-direction: column; } }
    </style>

    <script>
        (function () {
            document.querySelectorAll('[data-count]').forEach(function (el) {
                var end = parseInt(el.getAttribute('data-count'), 10) || 0, t0 = performance.now();
                function step(t) {
                    var p = Math.min(1, (t - t0) / 500), e = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(end * e).toLocaleString('en-US');
                    if (p < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            });
            var filter = 'all', q = '';
            var rows = Array.prototype.slice.call(document.querySelectorAll('#recentList tr'));
            rows.forEach(function (r) { r.addEventListener('click', function () { window.location.href = r.dataset.href; }); });
            function apply() {
                var shown = 0;
                rows.forEach(function (r) {
                    var ok = (filter === 'all' || r.dataset.status === filter) && (!q || r.dataset.search.toLowerCase().indexOf(q) !== -1);
                    r.style.display = ok ? '' : 'none';
                    if (ok) shown++;
                });
                document.getElementById('recentEmpty').style.display = shown ? 'none' : '';
            }
            document.getElementById('recentSearch').addEventListener('input', function (e) { q = e.target.value.trim().toLowerCase(); apply(); });
            document.querySelectorAll('#recentFilters .la-chip').forEach(function (b) {
                b.addEventListener('click', function () {
                    document.querySelectorAll('#recentFilters .la-chip').forEach(function (x) { x.classList.remove('on'); });
                    b.classList.add('on'); filter = b.dataset.f; apply();
                });
            });
        })();
    </script>
</body>

</html>

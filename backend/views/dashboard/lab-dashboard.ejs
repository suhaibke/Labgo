<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>

<body>
    <%- include('../partials/lab-navbar') %>
    <%
      const L = (k) => __('labApp.' + k);
      const now = new Date();
      const locale = { ar: 'ar-IQ', ku: 'ckb-IQ', en: 'en-GB', tr: 'tr-TR' }[currentLang] || 'en-GB';
      let dateText;
      try { dateText = now.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' }); }
      catch (e) { dateText = now.toDateString(); }
      const greeting = now.getHours() < 12 ? L('greetingMorning') : L('greetingEvening');
      const days = Array.isArray(monthlyStats) ? monthlyStats : [];
      const monthTests = days.reduce((a, d) => a + (d.tests || 0), 0);
      const maxDay = Math.max(1, ...days.map((d) => d.tests || 0));
      const today = now.getDate();
      const total = stats.totalTestsPerformed || 0;
      const pending = stats.pendingPatientTests || 0;
      const donePct = total > 0 ? Math.max(0, Math.min(1, (total - pending) / total)) : 0;
      const circ = 2 * Math.PI * 40;
      // cumulative tests for the growth line (viewBox 320 x 118)
      let run = 0;
      const cum = days.map((d) => (run += d.tests || 0));
      const cmax = Math.max(1, run);
      const pts = cum.map((v, i) => `${days.length > 1 ? (i * 320 / (days.length - 1)).toFixed(1) : 0},${(108 - (v / cmax) * 90).toFixed(1)}`);
      const statusKey = (s) => (s === 'Completed' ? 'completed' : s === 'In Progress' ? 'inProgress' : 'pending');
      const pillClass = (s) => (s === 'Pending' ? 'accent' : 'neutral');
      const initials = (n) => String(n || '?').split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
    %>

    <main class="la-main screen-enter">
        <!-- Header (same as the app's Reports screen) -->
        <header style="padding-top:12px">
            <p style="margin:0;font-size:14px;font-weight:500;color:var(--muted)"><%= dateText %></p>
            <h1 class="la-h1-xl"><%= lab.name %> — <%= L('reportsWord') %></h1>
            <p style="margin:4px 0 0;font-size:15px;color:var(--muted-2)"><%= greeting %> • <%= user.name %></p>
        </header>

        <!-- Stat cards: the app's four swipeable cards, side by side on wide screens -->
        <div class="la-stat-scroller" id="statCards">
            <!-- 1. Patients / tests -->
            <section class="la-card la-stat stagger">
                <div class="la-stat-head">
                    <span class="la-chip-sm"><svg class="ic" style="color:var(--accent)"><use href="#i-flask-conical"/></svg><%= L('totalPatients') %></span>
                </div>
                <div class="la-stat-body">
                    <div class="la-stat-text">
                        <p class="la-stat-label"><%= L('patients') %></p>
                        <p class="la-stat-big" data-count="<%= stats.totalPatientsServed %>"><%= stats.totalPatientsServed.toLocaleString('en-US') %></p>
                        <p class="la-stat-label"><span data-count="<%= total %>"><%= total.toLocaleString('en-US') %></span> <%= L('tests') %></p>
                    </div>
                    <div class="la-donut-wrap">
                        <div class="la-donut">
                            <svg viewBox="0 0 100 100" class="la-donut-svg">
                                <circle cx="50" cy="50" r="40" fill="none" stroke="var(--track)" stroke-width="11"/>
                                <circle cx="50" cy="50" r="40" fill="none" stroke="var(--accent)" stroke-width="11" stroke-linecap="round"
                                        stroke-dasharray="<%= circ %>" stroke-dashoffset="<%= circ * (1 - donePct) %>"/>
                            </svg>
                            <div class="la-donut-center">
                                <b><%= Math.round(donePct * 100) %>%</b>
                                <span><%= L('completed') %></span>
                            </div>
                        </div>
                        <div class="la-legend">
                            <p><i style="background:var(--muted)"></i><%= L('completed') %> <%= (total - pending).toLocaleString('en-US') %></p>
                            <p><i style="background:#FF5A00"></i><%= L('pending') %> <%= pending %></p>
                        </div>
                    </div>
                </div>
                <div class="la-stat-pills">
                    <span><%= L('completed') %> <%= (total - pending).toLocaleString('en-US') %></span>
                    <span class="on"><%= L('pending') %> <%= pending %></span>
                    <span>★ <%= stats.averageRating.toFixed(1) %></span>
                </div>
            </section>

            <!-- 2. Tests per day this month -->
            <section class="la-card la-stat stagger" style="animation-delay:.05s">
                <div class="la-stat-head">
                    <h2 class="la-stat-title"><%= L('monthTests') %></h2>
                    <span class="la-faint"><%= L('perDay') %></span>
                </div>
                <div class="la-stat-body">
                    <div class="la-stat-text">
                        <p class="la-stat-label"><%= L('monthTests') %></p>
                        <p class="la-stat-big" data-count="<%= monthTests %>"><%= monthTests.toLocaleString('en-US') %></p>
                        <p class="la-stat-label"><%= L('perDay') %></p>
                    </div>
                    <div class="la-bars">
                        <% days.forEach(function (d, i) { %>
                            <span class="bar-grow <%= (i + 1) === today ? 'on' : '' %>" title="<%= d.month %>: <%= d.tests %>"
                                  style="height:<%= Math.max(4, (d.tests || 0) / maxDay * 84) %>px;animation-delay:<%= (i * 0.015).toFixed(3) %>s"></span>
                        <% }); %>
                    </div>
                </div>
                <div class="la-stat-pills">
                    <span><%= L('totalTests') %></span>
                    <span class="on"><%= monthTests.toLocaleString('en-US') %></span>
                    <span><%= stats.testsGrowth >= 0 ? '+' : '' %><%= stats.testsGrowth %>%</span>
                </div>
            </section>

            <!-- 3. Growth -->
            <section class="la-card la-stat stagger" style="animation-delay:.1s">
                <div class="la-stat-head">
                    <h2 class="la-stat-title"><%= L('growth') %></h2>
                    <span class="la-pill neutral"><%= L('vsLastMonth') %></span>
                </div>
                <div class="la-stat-body">
                    <div class="la-stat-text">
                        <p class="la-stat-label"><%= L('growth') %></p>
                        <p class="la-stat-big"><%= stats.patientGrowth >= 0 ? '+' : '' %><%= stats.patientGrowth %>%</p>
                        <p class="la-stat-label"><%= L('patients') %></p>
                    </div>
                    <div class="la-line">
                        <svg viewBox="0 0 320 118" preserveAspectRatio="none">
                            <polyline points="<%= pts.join(' ') %>" fill="none" stroke="var(--accent)" stroke-width="3"
                                      stroke-linecap="round" stroke-linejoin="round" class="chart-line"/>
                        </svg>
                    </div>
                </div>
                <div class="la-stat-pills">
                    <span><%= L('patients') %> <%= stats.patientGrowth >= 0 ? '+' : '' %><%= stats.patientGrowth %>%</span>
                    <span class="on"><%= L('tests') %> <%= stats.testsGrowth >= 0 ? '+' : '' %><%= stats.testsGrowth %>%</span>
                    <span><%= L('pending') %> <%= stats.pendingChange > 0 ? '+' : '' %><%= stats.pendingChange %>%</span>
                </div>
            </section>

            <!-- 4. Rating -->
            <section class="la-card la-stat stagger" style="animation-delay:.15s">
                <div class="la-stat-head">
                    <h2 class="la-stat-title"><%= L('rating') %></h2>
                    <span class="la-faint"><%= lab.totalReviews || 0 %> <%= L('reviews') %></span>
                </div>
                <div class="la-stat-body">
                    <div class="la-stat-text">
                        <p class="la-stat-label"><%= L('rating') %></p>
                        <p class="la-stat-big"><%= stats.averageRating.toFixed(1) %></p>
                        <p class="la-stat-label"><%= stats.ratingChange >= 0 ? '+' : '' %><%= stats.ratingChange %> <%= L('vsLastMonth') %></p>
                    </div>
                    <div class="la-stars-bars">
                        <% [1, 2, 3, 4, 5].forEach(function (n) { const full = stats.averageRating >= n - 0.25; %>
                            <span class="bar-grow" style="height:<%= 20 + n * 13 %>%;opacity:<%= full ? 1 : .35 %>;animation-delay:<%= (n * .05).toFixed(2) %>s"></span>
                        <% }); %>
                    </div>
                </div>
                <div class="la-stat-pills">
                    <% [1, 2, 3, 4, 5].forEach(function (n) { %>
                        <span class="<%= Math.round(stats.averageRating) === n ? 'on ink' : '' %>"><%= n %>★</span>
                    <% }); %>
                </div>
            </section>
        </div>
        <div class="la-dots" id="statDots" aria-hidden="true" dir="ltr">
            <span class="on"></span><span></span><span></span><span></span>
        </div>

        <div class="la-dash-grid">
            <!-- Recent reports (same rows as the app) -->
            <section>
                <div class="la-search" style="margin-top:12px">
                    <svg class="ic"><use href="#i-search"/></svg>
                    <input id="recentSearch" placeholder="<%= L('search') %>" aria-label="<%= L('search') %>">
                </div>
                <div class="la-chips" style="margin-top:12px" id="recentFilters">
                    <button class="la-chip on press-95" data-f="all"><%= L('all') %></button>
                    <button class="la-chip press-95" data-f="Pending"><%= L('pending') %></button>
                    <button class="la-chip press-95" data-f="In Progress"><%= L('inProgress') %></button>
                    <button class="la-chip press-95" data-f="Completed"><%= L('completed') %></button>
                </div>
                <div class="la-between" style="margin-top:16px">
                    <h2 class="la-h2"><%= L('recentReports') %></h2>
                    <a href="/lab/orders" style="font-size:13px;font-weight:700;color:var(--accent)"><%= L('viewAll') %></a>
                </div>
                <div class="la-grid c2" style="margin-top:12px" id="recentList">
                    <% recentTests.forEach(function (t, i) { %>
                        <a href="/lab/orders/<%= t._id %>" class="la-row press stagger" style="animation-delay:<%= (i * .03).toFixed(2) %>s"
                           data-status="<%= t.status %>" data-search="<%= ((t.patientInfo && t.patientInfo.name) || '') + ' ' + (t.testName || '') %>">
                            <span class="la-avatar"><%= initials(t.patientInfo && t.patientInfo.name) %></span>
                            <span class="main">
                                <span class="name"><%= (t.patientInfo && t.patientInfo.name) || __('common.notAvailable') %></span>
                                <span class="meta"><%= t.testName %></span>
                            </span>
                            <span class="end">
                                <span class="time"><%= new Date(t.requestDate).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></span>
                                <span class="la-pill <%= pillClass(t.status) %>"><%= L(statusKey(t.status)) %></span>
                            </span>
                        </a>
                    <% }); %>
                </div>
                <p class="la-empty" id="recentEmpty" style="<%= recentTests.length ? 'display:none' : '' %>"><%= L('noResults') %></p>
            </section>

            <!-- Quick actions (web extra) -->
            <aside>
                <h2 class="la-h2" style="margin-top:16px"><%= L('quickActions') %></h2>
                <div class="la-stack" style="margin-top:12px">
                    <% [
                        ['/lab/tests', 'flask-conical', L('addTest')],
                        ['/lab/patient-tests', 'test-tube', L('viewTests')],
                        ['/lab/reports', 'chart-line', L('reports')],
                        ['/lab/settings', 'settings', L('settings')],
                       ].forEach(function (a) { %>
                        <a href="<%= a[0] %>" class="la-card la-between press" style="display:flex">
                            <span class="la-row-flex" style="font-weight:700">
                                <span class="la-icon-circle"><svg class="ic"><use href="#i-<%= a[1] %>"/></svg></span><%= a[2] %>
                            </span>
                            <svg class="ic flip-rtl" style="width:18px;height:18px;color:var(--muted)"><use href="#i-chevron-right"/></svg>
                        </a>
                    <% }); %>
                </div>
            </aside>
        </div>
    </main>

    <style>
        html.la .la-stat-scroller { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
        @media (min-width: 1880px) { html.la .la-stat-scroller { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
        html.la .la-stat { height: 230px; display: flex; flex-direction: column; gap: 10px; overflow: hidden; }
        html.la .la-stat-head { height: 32px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-shrink: 0; }
        html.la .la-stat-title { margin: 0; font-size: 15px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        html.la .la-faint { font-size: 11px; color: var(--muted); opacity: .7; white-space: nowrap; }
        html.la .la-chip-sm { display: inline-flex; align-items: center; gap: 6px; background: var(--chip-bg); border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 700; white-space: nowrap; }
        html.la .la-chip-sm .ic { width: 13px; height: 13px; }
        html.la .la-stat-body { height: 110px; display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        html.la .la-stat-text { flex: 1; min-width: 0; }
        html.la .la-stat-label { margin: 0; font-size: 13px; line-height: 1.1; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        html.la .la-stat-label + .la-stat-big { margin-top: 0; }
        html.la .la-stat-big { margin: 0 0 4px; font-size: 48px; line-height: 1.1; font-weight: 900; white-space: nowrap; }
        html.la .la-donut-wrap { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; }
        html.la .la-donut { width: 84px; height: 84px; display: grid; flex-shrink: 0; }
        html.la .la-donut > * { grid-area: 1 / 1; }
        html.la .la-donut-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        html.la[dir="rtl"] .la-donut-svg { transform: scaleX(-1) rotate(-90deg); }
        html.la .la-donut-center { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        html.la .la-donut-center b { font-size: 18px; line-height: 1; font-weight: 900; }
        html.la .la-donut-center span { font-size: 10px; color: var(--muted); margin-top: 4px; }
        html.la .la-legend p { margin: 0 0 6px; font-size: 12px; line-height: 1.25; display: flex; align-items: center; gap: 6px; white-space: nowrap; }
        html.la .la-legend i { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        html.la .la-bars { flex: 1; min-width: 0; height: 84px; display: flex; align-items: flex-end; gap: 2px; }
        html.la .la-bars span { flex: 1; background: var(--track); border-radius: 6px 6px 0 0; }
        html.la .la-bars span.on { background: var(--accent); }
        html.la .la-line { flex: 1; min-width: 0; height: 84px; }
        html.la .la-line svg { width: 100%; height: 100%; overflow: hidden; }
        html.la .la-stars-bars { flex: 1; min-width: 0; height: 84px; display: flex; align-items: flex-end; justify-content: center; gap: 8px; }
        html.la .la-stars-bars span { width: 26px; background: var(--accent); border-radius: 6px 6px 0 0; }
        html.la .la-stat-pills { height: 28px; display: flex; gap: 6px; flex-shrink: 0; }
        html.la .la-stat-pills span { flex: 1; min-width: 0; display: grid; place-items: center; font-size: 11px; font-weight: 700; border-radius: 999px; background: var(--chip-bg); color: var(--muted-2); border: 1px solid var(--line); white-space: nowrap; overflow: hidden; }
        html.la .la-stat-pills span.on { background: #FF5A00; color: #fff; border: 0; }
        html.la .la-stat-pills span.on.ink { background: var(--ink); color: var(--app-bg); }
        html.la .la-dots { display: none; justify-content: center; gap: 6px; margin-top: 8px; }
        html.la .la-dots span { width: 8px; height: 8px; border-radius: 999px; background: var(--track); transition: width .15s var(--ease-ui), background-color .15s; }
        html.la .la-dots span.on { width: 24px; background: var(--accent); }
        html.la .la-dash-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; }
        @media (max-width: 1100px) {
            html.la .la-dash-grid { grid-template-columns: minmax(0, 1fr); }
        }
        /* phone: the four cards become one swipeable card, like the app */
        @media (max-width: 700px) {
            html.la .la-stat-scroller { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; gap: 12px; }
            html.la .la-stat-scroller::-webkit-scrollbar { display: none; }
            html.la .la-stat { min-width: 100%; scroll-snap-align: center; }
            html.la .la-dots { display: flex; }
            html.la .la-grid.c2 { grid-template-columns: minmax(0, 1fr); }
        }
    </style>

    <script>
        (function () {
            // Count-up like the app (600ms, ease-out cubic)
            document.querySelectorAll('[data-count]').forEach(function (el) {
                var end = parseInt(el.getAttribute('data-count'), 10) || 0, t0 = performance.now();
                function step(t) {
                    var p = Math.min(1, (t - t0) / 600), e = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(end * e).toLocaleString('en-US');
                    if (p < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            });

            // Search + status filter on the recent list
            var filter = 'all', q = '';
            var rows = Array.prototype.slice.call(document.querySelectorAll('#recentList .la-row'));
            function apply() {
                var shown = 0;
                rows.forEach(function (r) {
                    var ok = (filter === 'all' || r.dataset.status === filter) &&
                             (!q || r.dataset.search.toLowerCase().indexOf(q) !== -1);
                    r.style.display = ok ? '' : 'none';
                    if (ok) shown++;
                });
                document.getElementById('recentEmpty').style.display = shown ? 'none' : '';
            }
            document.getElementById('recentSearch').addEventListener('input', function (e) { q = e.target.value.trim().toLowerCase(); apply(); });
            document.querySelectorAll('#recentFilters .la-chip').forEach(function (b) {
                b.addEventListener('click', function () {
                    document.querySelectorAll('#recentFilters .la-chip').forEach(function (x) { x.classList.remove('on'); });
                    b.classList.add('on'); filter = b.dataset.f; apply();
                });
            });

            // Dots follow the swipeable cards on phones
            var sc = document.getElementById('statCards'), dots = document.querySelectorAll('#statDots span');
            sc.addEventListener('scroll', function () {
                // index of the card closest to the centre (works in LTR and RTL)
                var mid = sc.getBoundingClientRect().left + sc.clientWidth / 2, best = 0, bestD = 1e9;
                Array.prototype.forEach.call(sc.children, function (c, k) {
                    var r = c.getBoundingClientRect(), dd = Math.abs(r.left + r.width / 2 - mid);
                    if (dd < bestD) { bestD = dd; best = k; }
                });
                dots.forEach(function (d, k) { d.classList.toggle('on', k === best); });
            }, { passive: true });

        })();
    </script>
</body>

</html>

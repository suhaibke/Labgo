        }

        // Navigate to order details page
        function openOrderModal(orderId) {
            window.location.href = `/admin/orders/${orderId}/details`;
        }

        // Toggle view
        function toggleView(view) {
            currentView = view;
            document.getElementById('tableView').style.display = view === 'table' ? 'block' : 'none';
            document.getElementById('gridView').style.display = view === 'grid' ? 'block' : 'none';
            document.getElementById('tableViewBtn').classList.toggle('active', view === 'table');
            document.getElementById('gridViewBtn').classList.toggle('active', view === 'grid');
            renderOrders();
        }

        // Pagination functions
        function changePage(direction) {
            const maxPage = Math.ceil(filteredOrders.length / itemsPerPage);
            currentPage = Math.max(1, Math.min(currentPage + direction, maxPage));
            renderOrders();
        }

        function updatePagination() {
            const totalPages = Math.ceil(filteredOrders.length / itemsPerPage);
            const start = (currentPage - 1) * itemsPerPage + 1;
            const end = Math.min(currentPage * itemsPerPage, filteredOrders.length);

            document.getElementById('paginationInfo').textContent = `Showing ${start}-${end} of ${filteredOrders.length} orders`;

            document.getElementById('prevPageBtn').disabled = currentPage === 1;
            document.getElementById('nextPageBtn').disabled = currentPage === totalPages || totalPages === 0;

            // Generate page numbers
            const numbersContainer = document.getElementById('paginationNumbers');
            let pages = [];
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    pages.push(i);
                } else if (pages[pages.length - 1] !== '...') {
                    pages.push('...');
                }
            }

            numbersContainer.innerHTML = pages.map(page => {
                if (page === '...') {
                    return '<span class="pagination-ellipsis">...</span>';
                }
                return `<button class="pagination-number ${page === currentPage ? 'active' : ''}" onclick="goToPage(${page})">${page}</button>`;
            }).join('');
        }

        function goToPage(page) {
            currentPage = page;
            renderOrders();
        }

        // Filter functions
        function setupFilters() {
            document.getElementById('searchInput').addEventListener('input', debounce(applyFilters, 300));
        }

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();

            filteredOrders = allOrders.filter(order => {
                // Status section filter
                if (selectedStatusSection !== 'all') {
                    const statusMap = {
                        'pending': ['pending', 'quoted'],
                        'waiting-nurse': ['confirmed'],
                        'accepted': ['nurse_assigned'],
                        'collected': ['sample_collected'],
                        'in-lab': ['at_lab'],
                        'done': ['completed'],
                        'cancelled': ['cancelled']
                    };
                    const allowedStatuses = statusMap[selectedStatusSection] || [];
                    if (!allowedStatuses.includes(order.status)) return false;
                }

                // Search filter
                if (search) {
                    const searchableText = [
                        order.qrCode,
                        order.patientId?.name,
                        order.patientId?.phone,
                        order.labId?.name
                    ].join(' ').toLowerCase();

                    if (!searchableText.includes(search)) return false;
                }

                return true;
            });

            // Sort filtered orders
            sortOrders();

            // Reset to first page
            currentPage = 1;

            // Re-render
            renderOrders();
        }

        // Sort functions
        function sortOrders() {
            filteredOrders.sort((a, b) => {
                let aVal, bVal;

                switch (currentSort.field) {
                    case 'patient':
                        aVal = a.patientId?.name || '';
                        bVal = b.patientId?.name || '';
                        break;
                    case 'lab':
                        aVal = a.labId?.name || '';
                        bVal = b.labId?.name || '';
                        break;
                    case 'total':
                        aVal = a.pricing?.subtotal || 0;
                        bVal = b.pricing?.subtotal || 0;
                        break;
                    case 'status':
                        const statusOrder = { pending: 1, quoted: 2, confirmed: 3, nurse_assigned: 4, sample_collected: 5, at_lab: 6, completed: 7, cancelled: 8 };
                        aVal = statusOrder[a.status] || 0;
                        bVal = statusOrder[b.status] || 0;
                        break;
                    case 'createdAt':
                    default:
                        aVal = new Date(a.createdAt);
                        bVal = new Date(b.createdAt);
                        break;
                }

                if (aVal < bVal) return currentSort.direction === 'asc' ? -1 : 1;
                if (aVal > bVal) return currentSort.direction === 'asc' ? 1 : -1;
                return 0;
            });
        }

        // Setup event listeners
        function setupEventListeners() {
            // Table sorting
            document.querySelectorAll('.sortable').forEach(th => {
                th.addEventListener('click', () => {
                    const field = th.dataset.sort;
                    if (currentSort.field === field) {
                        currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                    } else {
                        currentSort.field = field;
                        currentSort.direction = 'asc';
                    }

                    // Update sort icons
                    document.querySelectorAll('.sortable i').forEach(icon => {
                        icon.className = 'fas fa-sort';
                    });
                    th.querySelector('i').className = `fas fa-sort-${currentSort.direction === 'asc' ? 'up' : 'down'}`;

                    sortOrders();
                    renderOrders();
                });
            });

        }

        // Refresh orders
        async function refreshOrders() {
            await loadOrders();
            showToast('success', '<%= __('orders.refreshSuccess') %>');
        }

        // Export orders
        function exportOrders() {
            // Create CSV
            const headers = ['QR Code', 'Patient', 'Phone', 'Lab', 'Tests', 'Urgency', 'Status', 'Total', 'Date'];
            const rows = filteredOrders.map(order => [
                order.qrCode,
                order.patientId?.name || '',
                order.patientId?.phone || '',
                order.labId?.name || '',
                order.tests?.map(t => t.testName).join('; ') || '',
                order.urgency,
                getStatusText(order.status),
                order.pricing?.subtotal || 0,
                formatDateTime(order.createdAt)
            ]);

            const csv = [headers, ...rows].map(row => row.join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `orders_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);

            showToast('success', '<%= __('orders.exportSuccess') %>');
        }

        // Utility functions
        function getToken() {
            return localStorage.getItem('token') || '';
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-IQ', { style: 'currency', currency: 'IQD', maximumFractionDigits: 0 }).format(amount).replace('IQD', 'IQD');
        }

        function formatDate(date) {
            return new Date(date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        function formatTime(date) {
            return new Date(date).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
        }

        function formatDateTime(date) {
            return `${formatDate(date)} ${formatTime(date)}`;
        }

        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        function truncateText(text, maxLength) {
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        function getStatusText(status) {
            const statusMap = {
                pending: "<%= __('orders.statusValues.pending') %>",
                quoted: "<%= __('orders.statusValues.quoted') %>",
                confirmed: "<%= __('orders.statusValues.confirmed') %>",
                nurse_assigned: "<%= __('orders.statusValues.nurseAssigned') %>",
                sample_collected: "<%= __('orders.statusValues.sampleCollected') %>",
                at_lab: "<%= __('orders.statusValues.atLab') %>",
                completed: "<%= __('orders.statusValues.completed') %>",
                cancelled: "<%= __('orders.statusValues.cancelled') %>"
            };
            return statusMap[status] || status;
        }

        function showLoading(show) {
            document.getElementById('loadingState').style.display = show ? 'flex' : 'none';
            document.getElementById('tableView').style.display = show ? 'none' : (currentView === 'table' ? 'block' : 'none');
            document.getElementById('gridView').style.display = show ? 'none' : (currentView === 'grid' ? 'block' : 'none');
        }

        function updateEmptyState() {
            const isEmpty = filteredOrders.length === 0;
            document.getElementById('emptyState').style.display = isEmpty ? 'flex' : 'none';
            document.getElementById('tableView').style.display = isEmpty ? 'none' : (currentView === 'table' ? 'block' : 'none');
            document.getElementById('gridView').style.display = isEmpty ? 'none' : (currentView === 'grid' ? 'block' : 'none');
            document.getElementById('pagination').style.display = isEmpty ? 'none' : 'flex';
        }

        function showToast(type, message) {
            const toast = document.getElementById('toast');
            const icon = toast.querySelector('.toast-icon i');
            const title = toast.querySelector('.toast-title');
            const msg = toast.querySelector('.toast-message');

            icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            toast.classList.remove('success', 'error');
            toast.classList.add(type);
            title.textContent = type === 'success' ? "<%= __('common.success') %>" : "<%= __('common.error') %>";
            msg.textContent = message;

            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function hideToast() {
            document.getElementById('toast').classList.remove('show');
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // ================== CREATE ORDER MODAL ==================

        let currentStep = 1;
        const totalSteps = 6;
        let createOrderData = {
            patientId: null,
            location: null,
            labId: null,
            labName: null,
            tests: [],
            scheduledDate: null,
            timeSlot: null,
            patientNotes: null,
            beneficiary: null
        };
        let availableLabs = [];
        let availableTests = [];

        function openCreateOrderModal() {
            document.getElementById('createOrderModal').classList.add('show');
            resetCreateOrderForm();
            loadLabs();
            // Set min date for scheduled date to today
            document.getElementById('orderScheduledDate').min = new Date().toISOString().split('T')[0];
        }

        function closeCreateOrderModal() {
            document.getElementById('createOrderModal').classList.remove('show');
            resetCreateOrderForm();
        }

        function resetCreateOrderForm() {
            currentStep = 1;
            createOrderData = {
                patientId: null,
                location: null,
                labId: null,
                labName: null,
                tests: [],
                scheduledDate: null,
                timeSlot: null,
                patientNotes: null,
                beneficiary: null
            };

            // Reset all form fields
            document.getElementById('patientSearchInput').value = '';
            document.getElementById('patientSearchResults').innerHTML = '';
            document.getElementById('selectedPatientDisplay').style.display = 'none';

            document.getElementById('orderAddress').value = '';
            document.getElementById('orderLatitude').value = '';
            document.getElementById('orderLongitude').value = '';
            document.getElementById('orderLandmark').value = '';
            document.getElementById('orderBuildingName').value = '';
            document.getElementById('orderFloorNumber').value = '';
            document.getElementById('orderApartmentNumber').value = '';
            document.getElementById('orderInstructions').value = '';
            document.getElementById('selectedLocationDisplay').style.display = 'none';
            document.getElementById('mapSearchInput').value = '';

            // Reset map
            if (locationMarker && locationMap) {
                locationMap.removeLayer(locationMarker);
                locationMarker = null;
            }
            if (locationMap) {
                locationMap.remove();
                locationMap = null;
            }

            document.getElementById('orderScheduledDate').value = '';
            document.getElementById('orderTimeSlot').value = '';
            document.getElementById('orderPatientNotes').value = '';
            document.getElementById('orderForOther').checked = false;
            document.getElementById('beneficiaryFields').style.display = 'none';

            document.getElementById('testSearchInput').value = '';

            updateStepIndicator();
            showStep(1);
        }

        function updateStepIndicator() {
            document.querySelectorAll('.step-indicator .step').forEach((step, index) => {
                const stepNum = index + 1;
                step.classList.remove('active', 'completed');
                if (stepNum === currentStep) {
                    step.classList.add('active');
                } else if (stepNum < currentStep) {
                    step.classList.add('completed');
                }
            });
        }

        function showStep(step) {
            document.querySelectorAll('.step-content').forEach(content => {
                content.classList.remove('active');
            });
            document.querySelector(`.step-content[data-step="${step}"]`).classList.add('active');

            // Update navigation buttons
            document.getElementById('prevStepBtn').style.display = step > 1 ? 'inline-flex' : 'none';
            document.getElementById('nextStepBtn').style.display = step < totalSteps ? 'inline-flex' : 'none';
            document.getElementById('submitOrderBtn').style.display = step === totalSteps ? 'inline-flex' : 'none';
        }

        function nextStep() {
            if (!validateCurrentStep()) return;

            if (currentStep < totalSteps) {
                saveCurrentStepData();
                currentStep++;
                updateStepIndicator();
                showStep(currentStep);

                // Initialize map when entering step 2
                if (currentStep === 2) {
                    initMapIfNeeded();
                }

                // Load data for specific steps
                if (currentStep === 4 && createOrderData.labId) {
                    loadLabTests(createOrderData.labId);
                }
                if (currentStep === 6) {
                    populateReviewSection();
                }
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                updateStepIndicator();
                showStep(currentStep);

                // Initialize map when entering step 2
                if (currentStep === 2) {
                    initMapIfNeeded();
                }
            }
        }

        function validateCurrentStep() {
            switch (currentStep) {
                case 1: // Patient
                    if (!createOrderData.patientId) {
                        showToast('error', '<%= __('orders.errors.patientRequired') || 'Please select a registered patient' %>');
                        return false;
                    }
                    return true;

                case 2: // Location
                    const address = document.getElementById('orderAddress').value.trim();
                    const lat = document.getElementById('orderLatitude').value;
                    const lng = document.getElementById('orderLongitude').value;
                    if (!address || !lat || !lng) {
                        showToast('error', '<%= __('orders.errors.locationRequired') || 'Address and coordinates are required' %>');
                        return false;
                    }
                    return true;

                case 3: // Lab
                    if (!createOrderData.labId) {
                        showToast('error', '<%= __('orders.errors.labRequired') || 'Please select a lab' %>');
                        return false;
                    }
                    return true;

                case 4: // Tests
                    if (createOrderData.tests.length === 0) {
                        showToast('error', '<%= __('orders.errors.testsRequired') || 'Please select at least one test' %>');
                        return false;
                    }
                    return true;

                default:
                    return true;
            }
        }

        function saveCurrentStepData() {
            switch (currentStep) {
                case 2: // Location
                    createOrderData.location = {
                        address: document.getElementById('orderAddress').value.trim(),
                        coordinates: {
                            latitude: parseFloat(document.getElementById('orderLatitude').value),
                            longitude: parseFloat(document.getElementById('orderLongitude').value)
                        },
                        landmark: document.getElementById('orderLandmark').value.trim(),
                        buildingName: document.getElementById('orderBuildingName').value.trim(),
                        floorNumber: document.getElementById('orderFloorNumber').value.trim(),
                        apartmentNumber: document.getElementById('orderApartmentNumber').value.trim(),
                        instructions: document.getElementById('orderInstructions').value.trim()
                    };
                    break;

                case 5: // Optional details
                    createOrderData.scheduledDate = document.getElementById('orderScheduledDate').value || null;
                    const timeSlotValue = document.getElementById('orderTimeSlot').value;
                    if (timeSlotValue) {
                        const [start, end] = timeSlotValue.split('-');
                        createOrderData.timeSlot = { start, end };
                    } else {
                        createOrderData.timeSlot = null;
                    }
                    createOrderData.patientNotes = document.getElementById('orderPatientNotes').value.trim();

                    if (document.getElementById('orderForOther').checked) {
                        createOrderData.beneficiary = {
                            isForOtherPerson: true,
                            name: document.getElementById('beneficiaryName').value.trim(),
                            phone: document.getElementById('beneficiaryPhone').value.trim(),
                            relationship: document.getElementById('beneficiaryRelationship').value,
                            gender: document.getElementById('beneficiaryGender').value
                        };
                    } else {
                        createOrderData.beneficiary = null;
                    }
                    break;
            }
        }

        // Patient search with debounce
        let patientSearchTimeout;
        async function searchPatients(query) {
            clearTimeout(patientSearchTimeout);

            if (query.length < 2) {
                document.getElementById('patientSearchResults').innerHTML = '';
                return;
            }

            patientSearchTimeout = setTimeout(async () => {
                try {
                    const response = await fetch(`${API_BASE}/patients/search?q=${encodeURIComponent(query)}`, {
                        headers: { 'Authorization': `Bearer ${getToken()}` }
                    });

                    const data = await response.json();

                    if (data.success && data.data.patients.length > 0) {
                        document.getElementById('patientSearchResults').innerHTML = data.data.patients.map(patient => `
                            <div class="patient-result-item" onclick="selectPatient('${patient._id}', '${escapeHtml(patient.name)}', '${patient.phone || ''}')">
                                <div class="patient-avatar-small"><i class="fas fa-user"></i></div>
                                <div class="patient-result-info">
                                    <span class="name">${escapeHtml(patient.name)}</span>
                                    <span class="phone">${patient.phone || ''}</span>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        document.getElementById('patientSearchResults').innerHTML = '<p class="no-results"><%= __('orders.noPatientFound') || 'No patients found' %></p>';
                    }
                } catch (error) {
                    console.error('Patient search error:', error);
                }
            }, 300);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function selectPatient(id, name, phone) {
            createOrderData.patientId = id;

            document.getElementById('selectedPatientName').textContent = name;
            document.getElementById('selectedPatientPhone').textContent = phone;
            document.getElementById('selectedPatientDisplay').style.display = 'flex';
            document.getElementById('patientSearchResults').innerHTML = '';
            document.getElementById('patientSearchInput').value = '';
        }

        function clearSelectedPatient() {
            createOrderData.patientId = null;
            document.getElementById('selectedPatientDisplay').style.display = 'none';
        }

        // Load labs
        async function loadLabs() {
            try {
                const response = await fetch(`${API_BASE}/labs/all`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });

                const data = await response.json();

                if (data.success) {
                    availableLabs = data.data.labs;
                    renderLabsGrid();
                }
            } catch (error) {
                console.error('Load labs error:', error);
            }
        }

        function renderLabsGrid() {
            const grid = document.getElementById('labsGrid');
            grid.innerHTML = availableLabs.map(lab => `
                <div class="lab-card ${createOrderData.labId === lab._id ? 'selected' : ''}"
                     onclick="selectLab('${lab._id}', '${escapeHtml(lab.name)}')">
                    <div class="lab-card-content">
                        <h4>${escapeHtml(lab.name)}</h4>
                        <p><i class="fas fa-map-marker-alt"></i> ${escapeHtml(lab.city || '-')}</p>
                        <p><i class="fas fa-phone"></i> ${lab.phone || '-'}</p>
                    </div>
                    <div class="lab-check"><i class="fas fa-check-circle"></i></div>
                </div>
            `).join('');
        }

        function selectLab(labId, labName) {
            createOrderData.labId = labId;
            createOrderData.labName = labName;
            createOrderData.tests = []; // Clear tests when lab changes
            renderLabsGrid();
        }

        // Load lab tests
        async function loadLabTests(labId) {
            document.getElementById('testsGrid').innerHTML = '<div class="loading-spinner"></div>';

            try {
                const response = await fetch(`${API_BASE}/lab/${labId}/tests`, {
                    headers: { 'Authorization': `Bearer ${getToken()}` }
                });

                const data = await response.json();

                if (data.success) {
                    availableTests = data.data.tests;
                    renderTestsGrid();
                }
            } catch (error) {
                console.error('Load tests error:', error);
                document.getElementById('testsGrid').innerHTML = '<p class="error-message"><%= __('orders.errors.loadTestsFailed') || 'Failed to load tests' %></p>';
            }
        }

        function renderTestsGrid(filter = '') {
            const filteredTests = filter
                ? availableTests.filter(t =>
                    t.name.toLowerCase().includes(filter.toLowerCase()) ||
                    t.code.toLowerCase().includes(filter.toLowerCase())
                  )
                : availableTests;

            document.getElementById('testsGrid').innerHTML = filteredTests.map(test => {
                const isSelected = createOrderData.tests.some(t => t.testId === test._id);
                return `
                    <div class="test-card ${isSelected ? 'selected' : ''}"
                         onclick="toggleTest('${test._id}', '${escapeHtml(test.name)}', '${escapeHtml(test.code)}', ${test.price}, '${escapeHtml(test.category || 'General')}')">
                        <div class="test-card-content">
                            <span class="test-name">${escapeHtml(test.name)}</span>
                            <span class="test-code">${escapeHtml(test.code)}</span>
                        </div>
                        <div class="test-price">${formatCurrency(test.price)}</div>
                        <div class="test-check"><i class="fas fa-check-circle"></i></div>
                    </div>
                `;
            }).join('');

            updateSelectedTestsSummary();
        }

        function filterTests(query) {
            renderTestsGrid(query);
        }

        function toggleTest(testId, testName, testCode, price, category) {
            const existingIndex = createOrderData.tests.findIndex(t => t.testId === testId);

            if (existingIndex > -1) {
                createOrderData.tests.splice(existingIndex, 1);
            } else {
                createOrderData.tests.push({ testId, testName, testCode, price, category });
            }

            renderTestsGrid(document.getElementById('testSearchInput').value);
        }

        function updateSelectedTestsSummary() {
            const total = createOrderData.tests.reduce((sum, t) => sum + t.price, 0);
            document.getElementById('testsTotal').textContent = formatCurrency(total);

            document.getElementById('selectedTestsList').innerHTML = createOrderData.tests.map(test => `
                <div class="selected-test-item">
                    <span>${escapeHtml(test.testName)}</span>
                    <span>${formatCurrency(test.price)}</span>
                </div>
            `).join('') || '<p class="no-tests"><%= __('orders.noTestsSelected') || 'No tests selected' %></p>';
        }

        function toggleBeneficiarySection() {
            const isChecked = document.getElementById('orderForOther').checked;
            document.getElementById('beneficiaryFields').style.display = isChecked ? 'block' : 'none';
        }

        function populateReviewSection() {
            // Save step 5 data before populating review
            saveCurrentStepData();

            // Patient
            const patientHtml = `<p><strong>${document.getElementById('selectedPatientName').textContent}</strong><br>${document.getElementById('selectedPatientPhone').textContent}</p>`;
            document.getElementById('reviewPatient').innerHTML = patientHtml;

            // Location
            document.getElementById('reviewLocation').innerHTML = `
                <p>${escapeHtml(createOrderData.location?.address || '')}</p>
                ${createOrderData.location?.landmark ? `<p><small>Landmark: ${escapeHtml(createOrderData.location.landmark)}</small></p>` : ''}
            `;

            // Lab
            document.getElementById('reviewLab').innerHTML = `<p>${escapeHtml(createOrderData.labName || '')}</p>`;

            // Tests
            const testsTotal = createOrderData.tests.reduce((sum, t) => sum + t.price, 0);
            document.getElementById('reviewTests').innerHTML = `
                <div class="review-tests-list">
                    ${createOrderData.tests.map(t => `
                        <div class="review-test-item">
                            <span>${escapeHtml(t.testName)}</span>
                            <span>${formatCurrency(t.price)}</span>
                        </div>
                    `).join('')}
                </div>
            `;

            // Schedule
            document.getElementById('reviewSchedule').innerHTML = createOrderData.scheduledDate
                ? `<p>${createOrderData.scheduledDate}${createOrderData.timeSlot ? ` (${createOrderData.timeSlot.start}-${createOrderData.timeSlot.end})` : ''}</p>`
                : `<p><%= __('orders.asap') || 'As soon as possible' %></p>`;

            // Pricing
            document.getElementById('reviewPricing').innerHTML = `
                <div class="pricing-breakdown">
                    <div class="pricing-row">
                        <span><%= __('orders.subtotal') || 'Subtotal' %></span>
                        <span>${formatCurrency(testsTotal)}</span>
                    </div>
                    <div class="pricing-row total">
                        <span><%= __('orders.total') || 'Total' %></span>
                        <span>${formatCurrency(testsTotal)}</span>
                    </div>
                </div>
            `;
        }

        async function submitOrder() {
            const submitBtn = document.getElementById('submitOrderBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <%= __('common.creating') || 'Creating...' %>';

            try {
                const orderPayload = {
                    patientId: createOrderData.patientId,
                    location: createOrderData.location,
                    labId: createOrderData.labId,
                    tests: createOrderData.tests,
                    scheduledDate: createOrderData.scheduledDate,
                    timeSlot: createOrderData.timeSlot,
                    patientNotes: createOrderData.patientNotes,
                    beneficiary: createOrderData.beneficiary
                };

                const response = await fetch(`${API_BASE}/create`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${getToken()}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(orderPayload)
                });

                const data = await response.json();

                if (data.success) {
                    showToast('success', '<%= __('orders.orderCreatedSuccess') || 'Order created successfully' %>');
                    closeCreateOrderModal();
                    loadOrders(); // Refresh the orders list
                } else {
                    showToast('error', data.message || '<%= __('orders.errors.createFailed') || 'Failed to create order' %>');
                }
            } catch (error) {
                console.error('Submit order error:', error);
                showToast('error', '<%= __('orders.errors.createFailed') || 'Failed to create order' %>');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check"></i> <%= __('orders.createOrder') || 'Create Order' %>';
            }
        }

        // ================== MAP FUNCTIONALITY ==================

        let locationMap = null;
        let locationMarker = null;

        function initLocationMap() {
            if (locationMap) {
                locationMap.remove();
            }

            // Default center: Baghdad, Iraq
            const defaultLat = 33.3152;
            const defaultLng = 44.3661;

            locationMap = L.map('locationMap').setView([defaultLat, defaultLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(locationMap);

            // Add click event to map
            locationMap.on('click', function(e) {
                setLocationMarker(e.latlng.lat, e.latlng.lng);
                reverseGeocode(e.latlng.lat, e.latlng.lng);
            });

            // Try to get user's current location
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        locationMap.setView([position.coords.latitude, position.coords.longitude], 15);
                    },
                    function(error) {
                        console.log('Geolocation error:', error);
                    }
                );
            }
        }

        function setLocationMarker(lat, lng) {
            if (locationMarker) {
                locationMarker.setLatLng([lat, lng]);
            } else {
                locationMarker = L.marker([lat, lng], {
                    draggable: true
                }).addTo(locationMap);

                // Handle marker drag
                locationMarker.on('dragend', function(e) {
                    const pos = e.target.getLatLng();
                    reverseGeocode(pos.lat, pos.lng);
                });
            }

            // Update coordinate fields
            document.getElementById('orderLatitude').value = lat.toFixed(6);
            document.getElementById('orderLongitude').value = lng.toFixed(6);

            // Show coordinates display
            document.getElementById('displayCoords').textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
        }

        async function reverseGeocode(lat, lng) {
            try {
                const response = await fetch(
                    `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`,
                    {
                        headers: {
                            'Accept-Language': '<%= currentLang %>'
                        }
                    }
                );

                const data = await response.json();

                if (data && data.display_name) {
                    document.getElementById('orderAddress').value = data.display_name;
                    document.getElementById('displayAddress').textContent = data.display_name;
                    document.getElementById('selectedLocationDisplay').style.display = 'flex';

                    // Update marker popup
                    if (locationMarker) {
                        locationMarker.bindPopup(data.display_name).openPopup();
                    }
                }
            } catch (error) {
                console.error('Reverse geocoding error:', error);
                // Still show the location even if geocoding fails
                document.getElementById('displayAddress').textContent = '<%= __('orders.locationSelected') || 'Location selected' %>';
                document.getElementById('selectedLocationDisplay').style.display = 'flex';
            }
        }

        async function searchAddress() {
            const query = document.getElementById('mapSearchInput').value.trim();
            if (!query) return;

            try {
                const response = await fetch(
                    `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=iq&limit=1`,
                    {
                        headers: {
                            'Accept-Language': '<%= currentLang %>'
                        }
                    }
                );

                const data = await response.json();

                if (data && data.length > 0) {
                    const result = data[0];
                    const lat = parseFloat(result.lat);
                    const lng = parseFloat(result.lon);

                    locationMap.setView([lat, lng], 17);
                    setLocationMarker(lat, lng);

                    document.getElementById('orderAddress').value = result.display_name;
                    document.getElementById('displayAddress').textContent = result.display_name;
                    document.getElementById('selectedLocationDisplay').style.display = 'flex';

                    if (locationMarker) {
                        locationMarker.bindPopup(result.display_name).openPopup();
                    }
                } else {
                    showToast('error', '<%= __('orders.addressNotFound') || 'Address not found' %>');
                }
            } catch (error) {
                console.error('Address search error:', error);
                showToast('error', '<%= __('orders.searchError') || 'Search failed. Please try again.' %>');
            }
        }

        function handleMapSearchKeypress(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                searchAddress();
            }
        }

        // Initialize map when Step 2 becomes active
        function initMapIfNeeded() {
            if (currentStep === 2 && !locationMap) {
                setTimeout(initLocationMap, 100);
            } else if (currentStep === 2 && locationMap) {
                // Invalidate size in case modal was resized
                setTimeout(() => locationMap.invalidateSize(), 100);
            }
        }
    </script>
</body>
</html>

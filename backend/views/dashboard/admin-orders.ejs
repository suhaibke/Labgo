<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('orders.title') %> - LabGo Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-orders.css">
    <style>
        body {
            font-family: <%= font %>;
        }
    </style>
</head>
<body>
    <!-- Admin Navbar -->
    <%- include('../partials/admin-navbar') %>

    <!-- Orders Dashboard -->
    <main class="admin-dashboard">
        <div class="orders-dashboard-container">

            <!-- Page Header -->
            <div class="orders-page-header">
                <div class="header-content">
                    <h1><%= __('orders.title') %></h1>
                    <p class="header-subtitle"><%= __('orders.manageOrders') %></p>
                </div>
                <div class="header-actions">
                    <button class="primary-btn" onclick="openCreateOrderModal()">
                        <i class="fas fa-plus"></i>
                        <%= __('orders.createOrder') || 'Create Order' %>
                    </button>
                    <button class="secondary-btn" onclick="refreshOrders()">
                        <i class="fas fa-sync-alt"></i>
                        <%= __('common.refresh') %>
                    </button>
                </div>
            </div>

            <!-- Status Sections Row -->
            <div class="status-sections-row">
                <div class="status-section-card pending" data-section="pending" onclick="filterByStatusSection('pending')">
                    <div class="section-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="pendingSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.pending') %></span>
                    </div>
                </div>

                <div class="status-section-card waiting-nurse" data-section="waiting-nurse" onclick="filterByStatusSection('waiting-nurse')">
                    <div class="section-icon">
                        <i class="fas fa-user-clock"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="waitingNurseSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.waitingForNurse') %></span>
                    </div>
                </div>

                <div class="status-section-card accepted" data-section="accepted" onclick="filterByStatusSection('accepted')">
                    <div class="section-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="acceptedSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.accepted') %></span>
                    </div>
                </div>

                <div class="status-section-card collected" data-section="collected" onclick="filterByStatusSection('collected')">
                    <div class="section-icon">
                        <i class="fas fa-vial"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="collectedSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.collected') %></span>
                    </div>
                </div>

                <div class="status-section-card in-lab" data-section="in-lab" onclick="filterByStatusSection('in-lab')">
                    <div class="section-icon">
                        <i class="fas fa-flask"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="inLabSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.inLab') %></span>
                    </div>
                </div>

                <div class="status-section-card done" data-section="done" onclick="filterByStatusSection('done')">
                    <div class="section-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="doneSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.done') %></span>
                    </div>
                </div>

                <div class="status-section-card cancelled" data-section="cancelled" onclick="filterByStatusSection('cancelled')">
                    <div class="section-icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="cancelledSectionCount">-</span>
                        <span class="section-label"><%= __('orders.statusSections.cancelled') %></span>
                    </div>
                </div>

                <div class="status-section-card all" data-section="all" onclick="filterByStatusSection('all')">
                    <div class="section-icon">
                        <i class="fas fa-list"></i>
                    </div>
                    <div class="section-content">
                        <span class="section-count" id="allSectionCount">-</span>
                        <span class="section-label"><%= __('common.all') %></span>
                    </div>
                </div>
            </div>

            <!-- Filters and Search Bar -->
            <div class="orders-filter-bar">
                <div class="filter-left">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" placeholder="<%= __('orders.searchOrders') %>">
                    </div>
                    
                </div>
                <div class="filter-right">
                    <button class="icon-btn" onclick="toggleView('grid')" id="gridViewBtn" title="Grid View">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button class="icon-btn active" onclick="toggleView('table')" id="tableViewBtn" title="Table View">
                        <i class="fas fa-list"></i>
                    </button>
                    <div class="divider"></div>
                    <button class="icon-btn" onclick="exportOrders()" title="Export">
                        <i class="fas fa-download"></i>
                    </button>
                </div>
            </div>

            <!-- Loading State -->
            <div class="orders-loading" id="loadingState">
                <div class="loading-spinner"></div>
                <p><%= __('orders.loading') %></p>
            </div>

            <!-- Empty State -->
            <div class="orders-empty" id="emptyState" style="display: none;">
                <div class="empty-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <h3><%= __('orders.noOrders') %></h3>
                <p><%= __('orders.noOrdersDesc') %></p>
            </div>

            <!-- Orders Table View -->
            <div class="orders-table-wrapper" id="tableView">
                <div class="orders-table-container">
                    <table class="orders-modern-table" id="ordersTable">
                        <thead>
                            <tr>
                                <th class="sortable" data-sort="patient">
                                    <%= __('orders.patientName') %>
                                    <i class="fas fa-sort"></i>
                                </th>
                                <th class="sortable" data-sort="lab">
                                    <%= __('orders.lab') %>
                                    <i class="fas fa-sort"></i>
                                </th>
                                <th><%= __('orders.testType') %></th>
                                <th><%= __('orders.location') %></th>
                                <th class="sortable" data-sort="total">
                                    <%= __('orders.total') %>
                                    <i class="fas fa-sort"></i>
                                </th>
                                <th class="sortable" data-sort="status">
                                    <%= __('orders.status') %>
                                    <i class="fas fa-sort"></i>
                                </th>
                                <th class="sortable" data-sort="createdAt">
                                    <%= __('orders.orderDate') %>
                                    <i class="fas fa-sort"></i>
                                </th>
                                <th><%= __('common.actions') %></th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            <!-- Orders will be loaded dynamically -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="orders-pagination" id="pagination">
                    <div class="pagination-info">
                        <span id="paginationInfo">Showing 0-0 of 0 orders</span>
                    </div>
                    <div class="pagination-controls">
                        <button class="pagination-btn" id="prevPageBtn" onclick="changePage(-1)" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <div class="pagination-numbers" id="paginationNumbers">
                            <!-- Page numbers will be generated -->
                        </div>
                        <button class="pagination-btn" id="nextPageBtn" onclick="changePage(1)" disabled>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Orders Grid View -->
            <div class="orders-grid-wrapper" id="gridView" style="display: none;">
                <div class="orders-grid" id="ordersGrid">
                    <!-- Order cards will be loaded dynamically -->
                </div>
            </div>

        </div>
    </main>


    <!-- Create Order Modal -->
    <div class="modal-overlay" id="createOrderModal">
        <div class="modal-container create-order-modal">
            <div class="modal-header">
                <div class="modal-title">
                    <h2><%= __('orders.createNewOrder') || 'Create New Order' %></h2>
                </div>
                <button class="modal-close-btn" onclick="closeCreateOrderModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Step Indicator -->
            <div class="step-indicator">
                <div class="step active" data-step="1">
                    <div class="step-number">1</div>
                    <span class="step-label"><%= __('orders.steps.patient') || 'Patient' %></span>
                </div>
                <div class="step-connector"></div>
                <div class="step" data-step="2">
                    <div class="step-number">2</div>
                    <span class="step-label"><%= __('orders.steps.location') || 'Location' %></span>
                </div>
                <div class="step-connector"></div>
                <div class="step" data-step="3">
                    <div class="step-number">3</div>
                    <span class="step-label"><%= __('orders.steps.lab') || 'Lab' %></span>
                </div>
                <div class="step-connector"></div>
                <div class="step" data-step="4">
                    <div class="step-number">4</div>
                    <span class="step-label"><%= __('orders.steps.tests') || 'Tests' %></span>
                </div>
                <div class="step-connector"></div>
                <div class="step" data-step="5">
                    <div class="step-number">5</div>
                    <span class="step-label"><%= __('orders.steps.details') || 'Details' %></span>
                </div>
                <div class="step-connector"></div>
                <div class="step" data-step="6">
                    <div class="step-number">6</div>
                    <span class="step-label"><%= __('orders.steps.review') || 'Review' %></span>
                </div>
            </div>

            <div class="modal-body">
                <!-- Step 1: Patient Selection -->
                <div class="step-content active" data-step="1">
                    <h3><%= __('orders.selectPatient') || 'Select Patient' %></h3>
                    <div class="patient-search-section">
                        <div class="search-box-large">
                            <i class="fas fa-search"></i>
                            <input type="text" id="patientSearchInput"
                                   placeholder="<%= __('orders.searchPatientPlaceholder') || 'Search by name or phone...' %>"
                                   oninput="searchPatients(this.value)">
                        </div>
                        <div class="patient-search-results" id="patientSearchResults">
                            <!-- Results will be populated dynamically -->
                        </div>
                    </div>
                    <div class="selected-patient-display" id="selectedPatientDisplay" style="display: none;">
                        <div class="selected-patient-card">
                            <i class="fas fa-user-check"></i>
                            <div class="patient-details">
                                <span class="patient-name" id="selectedPatientName"></span>
                                <span class="patient-phone" id="selectedPatientPhone"></span>
                            </div>
                            <button class="clear-btn" onclick="clearSelectedPatient()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Location -->
                <div class="step-content" data-step="2">
                    <h3><%= __('orders.enterLocation') || 'Enter Location' %></h3>

                    <!-- Map Container -->
                    <div class="map-section">
                        <label><%= __('orders.selectOnMap') || 'Select Location on Map' %> *</label>
                        <p class="map-hint"><%= __('orders.mapHint') || 'Click on the map to select the delivery location' %></p>
                        <div id="locationMap" class="location-map"></div>
                        <div class="map-search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" id="mapSearchInput" placeholder="<%= __('orders.searchAddress') || 'Search for an address...' %>" onkeypress="handleMapSearchKeypress(event)">
                            <button type="button" class="map-search-btn" onclick="searchAddress()">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Selected Address Display -->
                    <div class="selected-location-display" id="selectedLocationDisplay" style="display: none;">
                        <div class="selected-location-card">
                            <i class="fas fa-map-marker-alt"></i>
                            <div class="location-details">
                                <span class="location-address" id="displayAddress"></span>
                                <span class="location-coords" id="displayCoords"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><%= __('orders.address') || 'Address' %> *</label>
                        <textarea id="orderAddress" rows="2" placeholder="<%= __('orders.addressPlaceholder') || 'Address will be filled from map...' %>" readonly></textarea>
                    </div>
                    <div class="form-row coordinates-row">
                        <div class="form-group">
                            <label><%= __('orders.latitude') || 'Latitude' %> *</label>
                            <input type="number" id="orderLatitude" step="any" placeholder="33.3152" readonly>
                        </div>
                        <div class="form-group">
                            <label><%= __('orders.longitude') || 'Longitude' %> *</label>
                            <input type="number" id="orderLongitude" step="any" placeholder="44.3661" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label><%= __('orders.landmark') || 'Landmark' %></label>
                            <input type="text" id="orderLandmark" placeholder="<%= __('orders.landmarkPlaceholder') || 'Near mosque, school, etc.' %>">
                        </div>
                        <div class="form-group">
                            <label><%= __('orders.buildingName') || 'Building Name' %></label>
                            <input type="text" id="orderBuildingName" placeholder="<%= __('orders.buildingNamePlaceholder') || 'Building name' %>">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label><%= __('orders.floorNumber') || 'Floor' %></label>
                            <input type="text" id="orderFloorNumber" placeholder="<%= __('orders.floorNumberPlaceholder') || 'Floor number' %>">
                        </div>
                        <div class="form-group">
                            <label><%= __('orders.apartmentNumber') || 'Apartment' %></label>
                            <input type="text" id="orderApartmentNumber" placeholder="<%= __('orders.apartmentNumberPlaceholder') || 'Apt number' %>">
                        </div>
                    </div>
                    <div class="form-group">
                        <label><%= __('orders.instructions') || 'Instructions' %></label>
                        <textarea id="orderInstructions" rows="2" placeholder="<%= __('orders.instructionsPlaceholder') || 'Special delivery instructions...' %>"></textarea>
                    </div>
                </div>

                <!-- Step 3: Lab Selection -->
                <div class="step-content" data-step="3">
                    <h3><%= __('orders.selectLab') || 'Select Lab' %></h3>
                    <div class="labs-grid" id="labsGrid">
                        <div class="loading-spinner"></div>
                    </div>
                </div>

                <!-- Step 4: Tests Selection -->
                <div class="step-content" data-step="4">
                    <h3><%= __('orders.selectTests') || 'Select Tests' %></h3>
                    <div class="tests-search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="testSearchInput"
                               placeholder="<%= __('orders.searchTestsPlaceholder') || 'Search tests...' %>"
                               oninput="filterTests(this.value)">
                    </div>
                    <div class="tests-selection-grid" id="testsGrid">
                        <!-- Tests will be loaded when lab is selected -->
                    </div>
                    <div class="selected-tests-summary" id="selectedTestsSummary">
                        <div class="summary-header">
                            <span><%= __('orders.selectedTests') || 'Selected Tests' %></span>
                            <span id="testsTotal">0 IQD</span>
                        </div>
                        <div class="selected-tests-list" id="selectedTestsList">
                            <!-- Selected tests will appear here -->
                        </div>
                    </div>
                </div>

                <!-- Step 5: Optional Details -->
                <div class="step-content" data-step="5">
                    <h3><%= __('orders.optionalDetails') || 'Optional Details' %></h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label><%= __('orders.scheduledDate') || 'Scheduled Date' %></label>
                            <input type="date" id="orderScheduledDate" min="">
                        </div>
                        <div class="form-group">
                            <label><%= __('orders.timeSlot') || 'Time Slot' %></label>
                            <select id="orderTimeSlot">
                                <option value=""><%= __('orders.selectTimeSlot') || 'Select time slot' %></option>
                                <option value="08:00-10:00">08:00 - 10:00</option>
                                <option value="10:00-12:00">10:00 - 12:00</option>
                                <option value="12:00-14:00">12:00 - 14:00</option>
                                <option value="14:00-16:00">14:00 - 16:00</option>
                                <option value="16:00-18:00">16:00 - 18:00</option>
                                <option value="18:00-20:00">18:00 - 20:00</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label><%= __('orders.patientNotes') || 'Patient Notes' %></label>
                        <textarea id="orderPatientNotes" rows="3" placeholder="<%= __('orders.patientNotesPlaceholder') || 'Any notes about the patient or order...' %>"></textarea>
                    </div>
                    <div class="beneficiary-section">
                        <label class="checkbox-label">
                            <input type="checkbox" id="orderForOther" onchange="toggleBeneficiarySection()">
                            <span><%= __('orders.orderForSomeoneElse') || 'Order for someone else' %></span>
                        </label>
                        <div class="beneficiary-fields" id="beneficiaryFields" style="display: none;">
                            <div class="form-row">
                                <div class="form-group">
                                    <label><%= __('orders.beneficiaryName') || 'Beneficiary Name' %></label>
                                    <input type="text" id="beneficiaryName" placeholder="<%= __('common.enterName') || 'Enter name' %>">
                                </div>
                                <div class="form-group">
                                    <label><%= __('orders.beneficiaryPhone') || 'Beneficiary Phone' %></label>
                                    <input type="tel" id="beneficiaryPhone" placeholder="07xxxxxxxxx">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label><%= __('orders.relationship') || 'Relationship' %></label>
                                    <select id="beneficiaryRelationship">
                                        <option value=""><%= __('common.select') || 'Select' %></option>
                                        <option value="spouse"><%= __('orders.relationships.spouse') || 'Spouse' %></option>
                                        <option value="child"><%= __('orders.relationships.child') || 'Child' %></option>
                                        <option value="parent"><%= __('orders.relationships.parent') || 'Parent' %></option>
                                        <option value="sibling"><%= __('orders.relationships.sibling') || 'Sibling' %></option>
                                        <option value="other"><%= __('orders.relationships.other') || 'Other' %></option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label><%= __('common.gender') || 'Gender' %></label>
                                    <select id="beneficiaryGender">
                                        <option value=""><%= __('common.selectGender') || 'Select Gender' %></option>
                                        <option value="male"><%= __('common.male') || 'Male' %></option>
                                        <option value="female"><%= __('common.female') || 'Female' %></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 6: Review & Submit -->
                <div class="step-content" data-step="6">
                    <h3><%= __('orders.reviewOrder') || 'Review Order' %></h3>
                    <div class="review-grid">
                        <div class="review-section">
                            <h4><i class="fas fa-user"></i> <%= __('orders.patient') || 'Patient' %></h4>
                            <div id="reviewPatient"></div>
                        </div>
                        <div class="review-section">
                            <h4><i class="fas fa-map-marker-alt"></i> <%= __('orders.location') || 'Location' %></h4>
                            <div id="reviewLocation"></div>
                        </div>
                        <div class="review-section">
                            <h4><i class="fas fa-flask"></i> <%= __('orders.lab') || 'Lab' %></h4>
                            <div id="reviewLab"></div>
                        </div>
                        <div class="review-section full-width">
                            <h4><i class="fas fa-vial"></i> <%= __('orders.tests') || 'Tests' %></h4>
                            <div id="reviewTests"></div>
                        </div>
                        <div class="review-section">
                            <h4><i class="fas fa-calendar"></i> <%= __('orders.schedule') || 'Schedule' %></h4>
                            <div id="reviewSchedule"></div>
                        </div>
                        <div class="review-section">
                            <h4><i class="fas fa-money-bill-wave"></i> <%= __('orders.pricing') || 'Pricing' %></h4>
                            <div id="reviewPricing"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="secondary-btn" id="prevStepBtn" onclick="prevStep()" style="display: none;">
                    <i class="fas fa-arrow-left"></i>
                    <%= __('common.previous') || 'Previous' %>
                </button>
                <button class="primary-btn" id="nextStepBtn" onclick="nextStep()">
                    <%= __('common.next') || 'Next' %>
                    <i class="fas fa-arrow-right"></i>
                </button>
                <button class="primary-btn success" id="submitOrderBtn" onclick="submitOrder()" style="display: none;">
                    <i class="fas fa-check"></i>
                    <%= __('orders.createOrder') || 'Create Order' %>
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toast">
        <div class="toast-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="toast-content">
            <h4 class="toast-title" id="toastTitle">Success</h4>
            <p class="toast-message" id="toastMessage">Operation completed successfully</p>
        </div>
        <button class="toast-close" onclick="hideToast()">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <script>
        // Global variables
        let allOrders = [];
        let filteredOrders = [];
        let currentPage = 1;
        let itemsPerPage = 10;
        let currentSort = { field: 'createdAt', direction: 'desc' };
        let currentView = 'table';
        let selectedOrderId = null;
        let selectedStatusSection = 'all';

        // API endpoints
        const API_BASE = '/api/admin/orders';

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadOrders();
            setupEventListeners();
            setupFilters();
            // Set 'all' as default on first load
            filterByStatusSection('all');
        });

        // Load orders from API
        async function loadOrders() {
            showLoading(true);
            try {
                const response = await fetch(`${API_BASE}/all?page=1&limit=1000`, {
                    headers: {
                        'Authorization': `Bearer ${getToken()}`
                    }
                });

                if (!response.ok) throw new Error('Failed to load orders');

                const data = await response.json();
                allOrders = data.data.orders || [];
                filteredOrders = [...allOrders];

                updateStatusSections(allOrders);
                renderOrders();
                showLoading(false);

            } catch (error) {
                console.error('Error loading orders:', error);
                showToast('error', '<%= __('orders.errorLoading') %>');
                showLoading(false);
            }
        }

        // Update status sections counts
        function updateStatusSections(orders) {
            const sections = {
                pending: orders.filter(o => o.status === 'pending' || o.status === 'quoted').length,
                waitingNurse: orders.filter(o => o.status === 'confirmed').length,
                accepted: orders.filter(o => o.status === 'nurse_assigned').length,
                collected: orders.filter(o => o.status === 'sample_collected').length,
                inLab: orders.filter(o => o.status === 'at_lab').length,
                done: orders.filter(o => o.status === 'completed').length,
                cancelled: orders.filter(o => o.status === 'cancelled').length,
                all: orders.length
            };

            document.getElementById('pendingSectionCount').textContent = sections.pending;
            document.getElementById('waitingNurseSectionCount').textContent = sections.waitingNurse;
            document.getElementById('acceptedSectionCount').textContent = sections.accepted;
            document.getElementById('collectedSectionCount').textContent = sections.collected;
            document.getElementById('inLabSectionCount').textContent = sections.inLab;
            document.getElementById('doneSectionCount').textContent = sections.done;
            document.getElementById('cancelledSectionCount').textContent = sections.cancelled;
            document.getElementById('allSectionCount').textContent = sections.all;
        }

        // Filter by status section
        function filterByStatusSection(section) {
            selectedStatusSection = section;

            // Update active state on cards
            document.querySelectorAll('.status-section-card').forEach(card => {
                card.classList.remove('active');
            });
            document.querySelector(`.status-section-card[data-section="${section}"]`).classList.add('active');

            // Apply filters
            applyFilters();
        }

        // Render orders based on current view
        function renderOrders() {
            if (currentView === 'table') {
                renderTableView();
            } else {
                renderGridView();
            }
            updatePagination();
            updateEmptyState();
        }

        // Render table view
        function renderTableView() {
            const tbody = document.getElementById('ordersTableBody');
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageOrders = filteredOrders.slice(start, end);

            tbody.innerHTML = pageOrders.map(order => `
                <tr class="order-row" data-status="${order.status}" onclick="openOrderModal('${order._id}')">
                    <td>
                        <div class="patient-cell">
                            <div class="patient-avatar-circle">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="patient-info">
                                <span class="patient-name">${order.patientId?.name || '-'}</span>
                                <span class="patient-contact">${order.patientId?.phone || '-'}</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="lab-name">${order.labId?.name || '-'}</span>
                    </td>
                    <td>
                        <div class="tests-list">
                            ${order.tests?.slice(0, 2).map(test => `
                                <span class="test-tag">${test.testName}</span>
                            `).join('') || '-'}
                            ${order.tests?.length > 2 ? `<span class="test-tag more">+${order.tests.length - 2}</span>` : ''}
                        </div>
                    </td>
                    <td>
                        <div class="location-cell">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>${truncateText(order.location?.address || '-', 30)}</span>
                        </div>
                    </td>
                    <td>
                        <span class="amount">${formatCurrency(order.pricing?.subtotal || 0)}</span>
                    </td>
                    <td>
                        <span class="status-badge ${order.status}">${getStatusText(order.status)}</span>
                        ${order.prescriptionType === 'medicine' ? '<span class="status-badge quoted"><%= __("orders.medicineOrder") || "Medicine" %></span>' : ''}
                    </td>
                    <td>
                        <span class="date">${formatDate(order.createdAt)}</span>
                        <span class="time">${formatTime(order.createdAt)}</span>
                    </td>
                    <td>
                        <div class="action-buttons" onclick="event.stopPropagation()">
                            <button class="action-btn view" onclick="openOrderModal('${order._id}')" title="<%= __('common.view') %>">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Render grid view
        function renderGridView() {
            const grid = document.getElementById('ordersGrid');
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageOrders = filteredOrders.slice(start, end);

            grid.innerHTML = pageOrders.map(order => `
                <div class="order-card" data-status="${order.status}" onclick="openOrderModal('${order._id}')">
                    <div class="order-card-header">
                        <div class="order-qr">
                            <span>${order.qrCode}</span>
                            ${order.adminConfirmation?.confirmed ? '<i class="fas fa-check-circle confirmed"></i>' : ''}
                        </div>
                        <span class="status-badge ${order.status}">${getStatusText(order.status)}</span>
                        ${order.prescriptionType === 'medicine' ? '<span class="status-badge quoted"><%= __("orders.medicineOrder") || "Medicine" %></span>' : ''}
                    </div>
                    <div class="order-card-body">
                        <div class="order-patient">
                            <div class="avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="info">
                                <h4>${order.patientId?.name || '-'}</h4>
                                <span>${order.patientId?.phone || '-'}</span>
                            </div>
                        </div>
                        <div class="order-lab">
                            <i class="fas fa-flask"></i>
                            <span>${order.labId?.name || '-'}</span>
                        </div>
                        <div class="order-tests">
                            ${order.tests?.slice(0, 3).map(test => `
                                <span class="test-mini">${test.testName}</span>
                            `).join('') || '-'}
                        </div>
                        <div class="order-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>${truncateText(order.location?.address || '-', 40)}</span>
                        </div>
                    </div>
                    <div class="order-card-footer">
                        <div class="order-date">
                            <i class="far fa-calendar"></i>
                            <span>${formatDate(order.createdAt)}</span>
                        </div>
                    </div>
                </div>

<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title><%= t.title %> · <%= d.code %></title>
<style>
<%- fontFaces %>
/* Same design as the lab app's shipping label (sheets.dart _ShippingLabel) */
@page { size: 100mm 70mm; margin: 0; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: #fff; }
body { font-family: "Inter", "IBM Plex Sans Arabic", -apple-system, sans-serif; color: #111; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.sheet { width: 100mm; height: 70mm; padding: 3mm; }
.label { height: 100%; border: 2px dashed #FF5A00; border-radius: 16px; padding: 3.2mm 3.6mm; display: flex; flex-direction: column; }
.top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.title { font-size: 15pt; font-weight: 800; line-height: 1.15; }
.pill { background: #FFF0E6; color: #FF5A00; border-radius: 999px; padding: 2px 8px; font-size: 8pt; font-weight: 700; white-space: nowrap; direction: ltr; }
.who { margin-top: 2.2mm; font-size: 9pt; }
.who b { font-weight: 700; }
.line { margin-top: 1mm; font-size: 8.5pt; color: #666; }
.codes { flex: 1; display: flex; align-items: center; justify-content: space-around; gap: 4mm; margin-top: 2mm; }
.code-col { display: flex; flex-direction: column; align-items: center; }
.box { background: #fff; border: 1px solid #E5E5E5; border-radius: 6px; padding: 4px; display: flex; align-items: center; justify-content: center; }
.qr { width: 20mm; height: 20mm; }
.qr svg { width: 100%; height: 100%; display: block; }
.bar { height: 13mm; padding: 4px 6px; }
.bar svg { height: 100%; width: auto; display: block; }
.cap { margin-top: 1mm; font-size: 7pt; color: #8A8A8E; letter-spacing: 1.6px; direction: ltr; }
.note { margin-top: 1.5mm; font-size: 6.8pt; color: #666; line-height: 1.45; }
.auto { unicode-bidi: plaintext; }
html[dir="ltr"] .auto { text-align: left; }
html[dir="rtl"] .auto { text-align: right; }
bdi { unicode-bidi: isolate; direction: ltr; }
/* on screen: centred with a print button */
@media screen {
  body { background: #EDEDED; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 16px; }
  .sheet { background: #fff; border-radius: 22px; box-shadow: 0 10px 15px -3px rgba(0,0,0,.1); transform-origin: top center; }
  .actions { display: flex; gap: 8px; }
  .actions button { border: 0; border-radius: 999px; padding: 12px 22px; font: inherit; font-weight: 700; font-size: 15px; cursor: pointer; background: #FF5A00; color: #fff; }
}
@media print { .actions { display: none; } }
</style>
</head>
<body>
<div class="sheet">
  <div class="label">
    <div class="top">
      <div class="title"><%= t.title %></div>
      <span class="pill"><%= d.code %></span>
    </div>
    <div class="who auto"><b><%= d.patient %></b><% if (d.tests) { %> • <%= d.tests %><% } %></div>
    <div class="line"><%= t.sending %>: <bdi><%= d.fromLab %></bdi> <%= t.dir === 'rtl' ? '←' : '→' %> <%= t.receiving %>: <bdi><%= d.toLab %></bdi></div>
    <div class="line"><%= t.date %>: <bdi><%= d.date %></bdi> • <%= t.eta %>: <bdi><%= d.eta %></bdi><% if (d.reference) { %> • <%= t.ref %>: <bdi><%= d.reference %></bdi><% } %></div>
    <div class="codes">
      <div class="code-col"><div class="box qr"><%- d.qrSvg %></div><div class="cap">QR</div></div>
      <div class="code-col"><div class="box bar"><%- d.barcodeSvg %></div><div class="cap"><%= d.code %></div></div>
    </div>
    <div class="note"><%= t.note %></div>
  </div>
</div>
<div class="actions"><button type="button" onclick="window.print()">🖨 <%= t.title %></button></div>
<% if (autoPrint) { %><script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });</script><% } %>
</body>
</html>

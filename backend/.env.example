# ========================================
# LabGo Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# Node Environment
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# MongoDB Database
# ========================================
MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/?directConnection=true

# OR use Docker MongoDB (uncomment if using docker-compose mongodb)
# MONGODB_URI=mongodb://root:your-password@mongodb:27017/?directConnection=true
# MONGO_USERNAME=root
# MONGO_PASSWORD=your-password
# MONGO_DATABASE=labgo
# MONGODB_PORT=27017

# ========================================
# JWT Authentication
# ========================================
# Required in production. Generate one with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=10y

# ========================================
# Cloudflare R2 Storage
# ========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=labgo
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# ========================================
# OTP Service (SMS Verification via OTPiq / WhatsApp)
# ========================================
OTPIQ_API_KEY=your-otpiq-api-key

# ========================================
# Telegram Bot Notifications
# ========================================
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram chat IDs to notify for new orders
# Default recipients: 562278615, 7639343315, 396182332, 5288412453
TELEGRAM_NOTIFICATION_USERS=562278615,7639343315,396182332,5288412453

# ========================================
# Docker Configuration
# ========================================
BACKEND_PORT=3000

# ========================================
# CORS Configuration (if needed)
# ========================================
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Lab result PDF reports
# Public address printed in the report's verification QR code (e.g. https://labgo.iq)
PUBLIC_BASE_URL=
# Chromium used to build the PDF (the Docker image sets this; also /usr/bin/chromium on Debian)
PUPPETEER_EXECUTABLE_PATH=
# Optional separate secret for report verification codes (defaults to JWT_SECRET)
REPORT_SIGNING_SECRET=
